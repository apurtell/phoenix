# This file defines the fleet suite, which exercises the Distributed Pherf tier against the
# harness cluster through the pherf-distributed driver. Each test executes one replicate: the
# prepare phase loads the co-generated table across every agent, the run phase measures the
# open-loop workload of point lookups across the fleet, and the restore phase drops the table.
# Every replicate produces one run bundle containing one controller bundle. Because all three
# replicates pass identical arguments, the shared seed, agents, weights, and row counts produce
# identical data-plane identities across replicates.
#
# Execute this suite through px-pherf, which provisions the cluster together with the tier:
#   px-pherf --class measurement run fleet.suite
#   px-pherf --class validation run fleet.suite -- --only r1
#
# When running Pherf -analyze, point it at <bundle>/drivers/pherf-distributed/controller inside
# each replicate bundle rather than at the bundle root.

suite: fleet
description: Three replicates of the Distributed Pherf fleet against the harness cluster
class: measurement
timeout: 1200

test: r1
  name: Replicate 1 of the fleet
  driver: pherf-distributed
  args: --scenario pherf/px_fleet_scenario.xml --schema pherf/px_fleet_schema.sql
  args: --rows 20000 --rate 300 --duration-ms 60000 --threads 12

test: r2
  name: Replicate 2 of the fleet
  needs: r1
  driver: pherf-distributed
  args: --scenario pherf/px_fleet_scenario.xml --schema pherf/px_fleet_schema.sql
  args: --rows 20000 --rate 300 --duration-ms 60000 --threads 12

test: r3
  name: Replicate 3 of the fleet
  needs: r2
  driver: pherf-distributed
  args: --scenario pherf/px_fleet_scenario.xml --schema pherf/px_fleet_schema.sql
  args: --rows 20000 --rate 300 --duration-ms 60000 --threads 12

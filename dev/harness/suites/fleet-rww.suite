# This file defines the fleet read-what-you-wrote suite, which executes a co-generated scenario on
# the Distributed Pherf tier through the pherf-distributed driver. Each test runs one replicate: the
# prepare phase loads the rows for each slot through its assigned agent, and the run phase reads
# every committed key in each slot via an open loop of point lookups, deletes the first 5 blocks of
# each slot, and counts both the deleted range and the remainder of the first 2000 rows. Any missing
# key or mismatched count fails the run.
#
# The weights 1,2 allocate 2000 and 4000 rows to the two agents at offsets 0 and 2000, with target
# rates of 80 and 160 per second. Because each offset is a multiple of the 50-row block size, the
# scenario's literal ranges align with block boundaries and each slot holds the 2000 rows inspected
# by the scenario's count queries. The suite omits a thread count argument so that each query set
# retains its concurrency of 1, and both replicates share identical arguments so that the same plan
# seed produces identical slot seeds and Poisson arrival schedules.
#
# Execute this suite through px-pherf, which provisions the cluster together with the tier:
#   px-pherf --class validation run fleet-rww.suite

suite: fleet-rww
description: Co-generated read-what-you-wrote across the agents of the fleet, two replicates
class: validation
timeout: 900

test: r1
  name: Replicate 1 of read-what-you-wrote
  driver: pherf-distributed
  args: --scenario pherf/px_rww_scenario.xml --schema pherf/px_rww_schema.sql
  args: --agents 2 --weights 1,2 --rows 6000 --rate 240 --duration-ms 30000

test: r2
  name: Replicate 2 of read-what-you-wrote
  needs: r1
  driver: pherf-distributed
  args: --scenario pherf/px_rww_scenario.xml --schema pherf/px_rww_schema.sql
  args: --agents 2 --weights 1,2 --rows 6000 --rate 240 --duration-ms 30000

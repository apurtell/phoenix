<!--
  The read-what-you-wrote scenario of fleet-rww.suite, for the
  pherf-distributed driver. The table is co-generated: the seed is fixed, and
  the key column K1 uses no slot token, so K1 is the global row index. Each
  agent loads the rows of its slot, from ${pherf.slot.offset}, in blocks of
  50. The three query sets of the run then operate on those rows only:

  1. lookup: an open loop of point lookups (px_rww_profile.xml). Each lookup
     counts the rows of one committed key and expects 1, so a missing key
     fails the operation. One worker reads one walk pass over the rows of the
     slot in the first rowCount arrivals, so every committed key is read.
  2. delete: a closed loop of 5 range deletes. Each DELETE removes the next
     block of the slot, so the 5 deletes remove the first 250 rows.
  3. deleted and rest: two counts over fixed ranges of the slot. The deleted
     range, the first 250 rows, holds 0 rows. The rest range, the next 1750
     rows, holds 1750, so the deletes removed the target rows and no other
     row of the first 2000. No other slot writes these ranges.

  The driver gives the rows, the rate and the duration. A slot offset must be
  a multiple of the block size, so that the literal bound 250 is a block
  bound. The smallest slot must hold at least 2000 rows, so that the rest
  range is in the slot.
-->
<datamodel name="px_rww">
  <datamapping>
    <column>
      <type>BIGINT</type>
      <userDefined>true</userDefined>
      <dataSequence>SEQUENTIAL</dataSequence>
      <minValue>0</minValue>
      <maxValue>1000000000000</maxValue>
      <name>K1</name>
    </column>
    <column>
      <type>VARCHAR</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <length>12</length>
      <prefix>n</prefix>
      <name>NAME</name>
    </column>
    <column>
      <type>INTEGER</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <minValue>0</minValue>
      <maxValue>1000</maxValue>
      <name>QTY</name>
    </column>
  </datamapping>
  <scenarios>
    <scenario tableName="PX_PHERF.RWW" rowCount="1000" name="px_rww">
      <coGeneration seed="8070" offset="${pherf.slot.offset}" blockSize="50"/>
      <querySet concurrency="1" profile="px_rww_profile.xml">
        <query id="lookup" expectedAggregateRowCount="1"
               statement="SELECT COUNT(*) FROM PX_PHERF.RWW WHERE K1 = [K1]"/>
      </querySet>
      <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="5"
                executionDurationInMs="30000">
        <query id="delete" kind="DELETE"
               statement="DELETE FROM PX_PHERF.RWW WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
      </querySet>
      <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1"
                executionDurationInMs="30000">
        <query id="deleted" expectedAggregateRowCount="0"
               statement="SELECT COUNT(*) FROM PX_PHERF.RWW
                 WHERE K1 &gt;= ${pherf.slot.offset} AND K1 &lt; ${pherf.slot.offset} + 250"/>
        <query id="rest" expectedAggregateRowCount="1750"
               statement="SELECT COUNT(*) FROM PX_PHERF.RWW
                 WHERE K1 &gt;= ${pherf.slot.offset} + 250
                   AND K1 &lt; ${pherf.slot.offset} + 2000"/>
      </querySet>
    </scenario>
  </scenarios>
</datamodel>

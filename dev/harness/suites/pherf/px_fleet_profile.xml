<!--
  The workload profile of px_fleet_scenario.xml: one flat open-loop stage of
  point lookups. The pherf-distributed driver gives the fleet rate and the
  run duration, so the stage here is the shape of the curve only. LATE with
  no lag limit runs every arrival.
-->
<workloadProfile>
  <openLoop arrival="UNIFORM" lagPolicy="LATE">
    <stage durationMs="10000" rate="20"/>
  </openLoop>
  <mix>
    <operation kind="SELECT" weight="100"/>
  </mix>
</workloadProfile>

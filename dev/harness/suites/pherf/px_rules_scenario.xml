<!--
  The rule-based scenario of fleet-rules.suite, for the pherf-distributed
  driver. It uses no co-generation: the rules of the columns make the data, as
  in a traditional Pherf scenario. The key K is SEQUENTIAL with the slot token
  ${pherf.slot.prefix} as its prefix, so each agent loads keys that no other
  agent loads. The query set is a closed loop that runs each query in turn,
  first on 1 thread and then on 2 threads, 300 times on each thread.

  The count query expects 4000 rows, the fleet row count of the suite. Each
  agent reads the whole table, so this checks that the loads of all agents
  together wrote 4000 different rows. Pherf reads the first column of a
  statement with COUNT( as the row count, so the aggregate query puts the
  count first. The driver gives the rows only. This document gives the
  concurrency, the executions and the duration.
-->
<datamodel name="px_rules">
  <datamapping>
    <column>
      <type>VARCHAR</type>
      <userDefined>true</userDefined>
      <dataSequence>SEQUENTIAL</dataSequence>
      <length>10</length>
      <prefix>${pherf.slot.prefix}</prefix>
      <name>K</name>
    </column>
    <column>
      <type>VARCHAR</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <length>12</length>
      <prefix>n</prefix>
      <name>NAME</name>
    </column>
    <column>
      <type>INTEGER</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <minValue>0</minValue>
      <maxValue>1000</maxValue>
      <name>QTY</name>
    </column>
    <column>
      <type>CHAR</type>
      <userDefined>true</userDefined>
      <dataSequence>LIST</dataSequence>
      <length>3</length>
      <name>KIND</name>
      <valuelist>
        <datavalue distribution="60">
          <value>AAA</value>
        </datavalue>
        <datavalue distribution="30">
          <value>BBB</value>
        </datavalue>
        <datavalue distribution="10">
          <value>CCC</value>
        </datavalue>
      </valuelist>
    </column>
  </datamapping>
  <scenarios>
    <scenario tableName="PX_PHERF.RULES" rowCount="1000" name="px_rules">
      <querySet concurrency="1-2" executionType="SERIAL" executionDurationInMs="60000"
                numberOfExecutions="300">
        <query id="count" expectedAggregateRowCount="4000"
               statement="SELECT COUNT(*) FROM PX_PHERF.RULES"/>
        <query id="point" statement="SELECT NAME, QTY FROM PX_PHERF.RULES WHERE K = [K]"/>
        <query id="agg"
               statement="SELECT COUNT(*), KIND, AVG(QTY) FROM PX_PHERF.RULES GROUP BY KIND"/>
        <query id="range" statement="SELECT COUNT(*) FROM PX_PHERF.RULES WHERE QTY &gt; 500"/>
      </querySet>
    </scenario>
  </scenarios>
</datamodel>

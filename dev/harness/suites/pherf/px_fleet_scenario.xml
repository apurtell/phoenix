<!--
  The Pherf scenario of the fleet suite, for the pherf-distributed driver. The
  table is co-generated: the seed is fixed, and the key column K1 uses no slot
  token, so a key depends only on its global row index. The row offset of each
  agent comes from the slot token ${pherf.slot.offset}, so the agents load
  disjoint ranges, and a later test with the same agents, weights and rows
  reads the same ranges. The query set is open loop: px_fleet_profile.xml
  gives its rate curve, which the driver scales to the fleet rate and the run
  duration. Each operation is a point lookup of a committed key.
-->
<datamodel name="px_fleet">
  <datamapping>
    <column>
      <type>BIGINT</type>
      <userDefined>true</userDefined>
      <dataSequence>SEQUENTIAL</dataSequence>
      <minValue>0</minValue>
      <maxValue>1000000000000</maxValue>
      <name>K1</name>
    </column>
    <column>
      <type>VARCHAR</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <length>12</length>
      <prefix>n</prefix>
      <name>NAME</name>
    </column>
    <column>
      <type>INTEGER</type>
      <userDefined>true</userDefined>
      <dataSequence>RANDOM</dataSequence>
      <minValue>0</minValue>
      <maxValue>1000</maxValue>
      <name>QTY</name>
    </column>
  </datamapping>
  <scenarios>
    <scenario tableName="PX_PHERF.FLEET" rowCount="1000" name="px_fleet">
      <coGeneration seed="8070" offset="${pherf.slot.offset}" blockSize="50"/>
      <querySet concurrency="1" profile="px_fleet_profile.xml">
        <query id="lookup" statement="SELECT NAME, QTY FROM PX_PHERF.FLEET WHERE K1 = [K1]"/>
      </querySet>
    </scenario>
  </scenarios>
</datamodel>

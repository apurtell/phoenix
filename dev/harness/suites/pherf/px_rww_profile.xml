<!--
  The workload profile of the lookup query set of px_rww_scenario.xml: one
  flat open-loop stage. The pherf-distributed driver gives the fleet rate and
  the run duration, so the stage here is the shape of the curve only. The
  arrivals are POISSON, and each slot takes its own arrival seed from the slot
  token ${pherf.slot.seed}. The same plan seed gives the same arrivals again.
  LATE with no lag limit runs every arrival. With no mix, the one query runs
  for each arrival.
-->
<workloadProfile>
  <openLoop arrival="POISSON" seed="${pherf.slot.seed}" lagPolicy="LATE">
    <stage durationMs="10000" rate="20"/>
  </openLoop>
</workloadProfile>

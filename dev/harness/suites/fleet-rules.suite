# This file defines the rule-based fleet suite, which executes a traditional Pherf scenario on the
# Distributed Pherf tier through the pherf-distributed driver. Column rules generate the dataset
# without co-generation: the prepare phase loads 2000 rows through each of the 2 agents using a
# distinct per-agent key prefix, and the run phase executes the scenario's closed-loop workload on
# each agent. The suite specifies only the total row count because a closed-loop workload takes no
# target rate, leaving the scenario document to define the concurrency, execution count, and
# duration just as in a standalone Pherf run.
#
# Execute this suite through px-pherf, which provisions the cluster together with the tier:
#   px-pherf --class validation run fleet-rules.suite

suite: fleet-rules
description: A rule-based closed-loop Pherf scenario across the agents of the fleet
class: validation
timeout: 900

test: rules
  name: Rule-based closed loop across the fleet
  driver: pherf-distributed
  args: --scenario pherf/px_rules_scenario.xml --schema pherf/px_rules_schema.sql
  args: --rows 4000

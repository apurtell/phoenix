# Stage 8 of the configuration loader is generated with every deployment.
env/ports.generated.env

# Stage 3 belongs to the operator of one host.
env/local.env

# Stage 7 records the hash of an artifact that carried no declared pin.
versions.local.env

# A rendered deployment directory and a staged build context belong under
# $PX_OUT. A directory with one of these names is a leftover.
deployment/
image/stage/

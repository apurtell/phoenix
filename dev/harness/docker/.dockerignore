# The image build context lives under $PX_OUT/images/, never in the tree.
# scripts/stage-artifacts.sh fills it with the files of docker/image at its
# root, the fetched distributions under dist/ and the local Phoenix build
# under phoenix/. Everything is excluded first, then exactly those entries are
# admitted again, so a file that no step staged cannot reach the image. A new
# entry of docker/image must be admitted here too, or the build that copies
# it fails.
*
!Dockerfile
!*.sh
!bin/
!conf/
!lib/
!dist/
!phoenix/

# Leftovers inside the admitted entries.
**/.DS_Store
**/*.swp
**/*.log

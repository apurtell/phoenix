# The Log4j 1 configuration of the Hadoop roles, and of the Hadoop commands
# that a client role runs. Hadoop logs through the reload4j implementation of
# the Log4j 1 API, so it does not read log4j2.properties.
#
# Every line goes to the console, which the backend reads as the instance
# log, and to a rolling file under PX_LOG_DIR. The file holds no Log4j
# variable reference, because the renderer refuses every placeholder that it
# does not expand itself.

log4j.rootLogger=INFO,console,RFA

log4j.appender.console=org.apache.log4j.ConsoleAppender
log4j.appender.console.target=System.err
log4j.appender.console.layout=org.apache.log4j.PatternLayout
log4j.appender.console.layout.ConversionPattern=%d{ISO8601} %-5p [%t] %c{2}: %m%n

log4j.appender.RFA=org.apache.log4j.RollingFileAppender
log4j.appender.RFA.File=${PX_RENDER_LOG_FILE}
log4j.appender.RFA.MaxFileSize=64MB
log4j.appender.RFA.MaxBackupIndex=5
log4j.appender.RFA.layout=org.apache.log4j.PatternLayout
log4j.appender.RFA.layout.ConversionPattern=%d{ISO8601} %-5p [%t] %c{2}: %m%n

# The audit and state change loggers write one line per operation, which
# would bury the daemon messages.
log4j.logger.org.apache.hadoop.hdfs.server.namenode.FSNamesystem.audit=WARN
log4j.logger.org.apache.hadoop.hdfs.StateChange=WARN
log4j.logger.org.apache.hadoop.yarn.server.resourcemanager.RMAuditLogger=WARN
log4j.logger.org.apache.hadoop.yarn.server.nodemanager.NMAuditLogger=WARN

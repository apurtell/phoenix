# The Log4j 2 configuration of the HBase roles, of ZooKeeper, and of the
# Phoenix client roles.
#
# Every line goes to the console, which the backend reads as the instance
# log. Every line also goes to a rolling file under PX_LOG_DIR, which a
# collector copies into the result bundle. The file holds no Log4j lookup, because the renderer
# refuses every placeholder that it does not expand itself.

status = warn
dest = err
name = PxHarness

appender.console.type = Console
appender.console.name = console
appender.console.target = SYSTEM_ERR
appender.console.layout.type = PatternLayout
appender.console.layout.pattern = %d{ISO8601} %-5p [%t] %c{2}: %m%n

appender.file.type = RollingFile
appender.file.name = file
appender.file.fileName = ${PX_RENDER_LOG_FILE}
appender.file.filePattern = ${PX_RENDER_LOG_FILE}.%i
appender.file.layout.type = PatternLayout
appender.file.layout.pattern = %d{ISO8601} %-5p [%t] %c{2}: %m%n
appender.file.policies.type = Policies
appender.file.policies.size.type = SizeBasedTriggeringPolicy
appender.file.policies.size.size = 64MB
appender.file.strategy.type = DefaultRolloverStrategy
appender.file.strategy.max = 5

rootLogger = INFO,console,file

logger.zookeeper.name = org.apache.zookeeper
logger.zookeeper.level = WARN

logger.hadoop.name = org.apache.hadoop
logger.hadoop.level = WARN

logger.hbase.name = org.apache.hadoop.hbase
logger.hbase.level = INFO

logger.phoenix.name = org.apache.phoenix
logger.phoenix.level = INFO

<!--
  The Hadoop core configuration of every role that reads or writes HDFS.
  render.sh fills every placeholder and refuses an unset one, so no default
  host, port or path of the distribution applies.
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode-0:${PX_PORT_NAMENODE_RPC}</value>
  </property>
  <property>
    <!-- Every derived local path of Hadoop lies below the instance data
         directory, never in the container root file system. -->
    <name>hadoop.tmp.dir</name>
    <value>${PX_DATA_DIR}/hadoop-tmp</value>
  </property>
  <property>
    <name>io.file.buffer.size</name>
    <value>131072</value>
  </property>
</configuration>

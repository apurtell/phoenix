# The configuration of the single ZooKeeper server. ZooKeeper does not scale
# in this topology, so the file names no ensemble. It binds every interface
# of its container, and a peer reaches it as zookeeper-0.

tickTime=2000
initLimit=10
syncLimit=5
dataDir=${PX_DATA_DIR}/zookeeper
clientPort=${PX_PORT_ZOOKEEPER_CLIENT}
clientPortAddress=${PX_BIND_HOST}

# One client container opens many connections from its one address, so the
# per-address connection limit of 60 would refuse a busy driver.
maxClientCnxns=0

# The embedded admin server binds port 8080 by default, which the host often
# uses for something else. The harness does not need it.
admin.enableServer=false

# The healthcheck sends ruok. The other words serve a diagnosis.
4lw.commands.whitelist=ruok,srvr,mntr,stat

autopurge.snapRetainCount=3
autopurge.purgeInterval=1

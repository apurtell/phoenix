# The Phoenix client properties of the client, tooling and probe roles. A
# driver reads the JDBC URL from this file, so no driver composes a host or a
# port. The HBase client settings repeat hbase-site.xml for a client program
# that reads a properties file and not a class path resource. The URL names
# a host of the harness network, so a client runs inside a container of it.

phoenix.jdbc.url=jdbc:phoenix:zookeeper-0:${PX_PORT_ZOOKEEPER_CLIENT}:/hbase
hbase.zookeeper.quorum=zookeeper-0
hbase.zookeeper.property.clientPort=${PX_PORT_ZOOKEEPER_CLIENT}
zookeeper.znode.parent=/hbase

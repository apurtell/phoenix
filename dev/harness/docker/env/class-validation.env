# Defines the validation run class, serving as the counterpart to env/class-measurement.env with
# the same stage 4 configuration loader rules, the same variable keys, and reduced resource
# allocations.
#
# This file provides the reduced sizing table for a container engine provisioned with approximately
# 16 GiB of memory. Because a validation run verifies functional build correctness rather than
# performance, its timing results are classified as ADVISORY, and its smaller Java heaps carry no
# penalty for the properties that this class evaluates. The topology deploys one instance of each
# scaled role, sets HDFS replication equal to the DataNode count, omits the Secondary NameNode, and
# leaves the YARN tier unrendered unless a run explicitly requests it with PX_YARN=1.
#
# All memory figures are expressed in MiB and carry the same semantics defined in
# env/class-measurement.env. On a 16 GiB container engine, preflight admission allows
# 16384 - 4096 = 12288 MiB after reserving host headroom. Without YARN, the container memory limits
# sum to 8704 MiB; the YARN tier adds 3328 MiB, bringing the combined footprint with YARN to
# 12032 MiB. Both totals fit within a 16 GiB engine, and even with YARN enabled the total remains
# 256 MiB below the 12288 MiB preflight admission threshold of a 16 GiB engine. Consequently, any
# test suite that requires YARN runs against this same sizing table without needing a second
# validation profile. When YARN is omitted, 3584 MiB of admissible capacity remains free to host
# one or two distributed Pherf workload agents.

# --- Topology -------------------------------------------------------------------
PX_YARN=0
PX_SNN=0
PX_DN_COUNT=1
PX_NM_COUNT=1
PX_RS_COUNT=1
PX_HDFS_REPLICATION=1

# --- Host safety --------------------------------------------------------------
# Because a validation run does not evaluate timing results, pairing a wait duration of 0 with no
# quiet-host requirement disables the quiet-host check completely so that it takes zero samples.
PX_QUIET_HOST_WAIT_S=0
PX_REQUIRE_QUIET_HOST=0
PX_PREFLIGHT_MIN_DISK_MIB=4096
PX_PREFLIGHT_MIN_CPUS=2

# --- HBase memory fractions -------------------------------------------------------
# Retains the same heap fractions used by the measurement sizing table because the smaller
# RegionServer heap still requires the same proportional headroom for the Phoenix global memory
# pool.
PX_HBASE_BLOCKCACHE_SIZE=0.30
PX_HBASE_MEMSTORE_SIZE=0.35

# --- YARN allocations ------------------------------------------------------------
# A single NodeManager must simultaneously host a MapReduce ApplicationMaster and one task
# process, requiring 1024 + 512 = 1536 MiB of schedulable capacity. The NodeManager container holds
# that task allocation alongside its own daemon process: 1536 + 256 heap + 32 direct = 1824 MiB out
# of the 2048 MiB container limit.
PX_NM_RESOURCE_MIB=1536
PX_NM_VCORES=2
PX_YARN_MIN_ALLOC_MIB=512
PX_YARN_MAX_ALLOC_MIB=1536
PX_MR_AM_MIB=1024
PX_MR_TASK_MIB=512

# --- Sizing ---------------------------------------------------------------------
PX_ZK_MEM_MIB=512
PX_ZK_HEAP_MIB=256
PX_ZK_DIRECT_MIB=64
PX_ZK_JDK=17

PX_NN_MEM_MIB=1024
PX_NN_HEAP_MIB=768
PX_NN_DIRECT_MIB=64
PX_NN_JDK=17

# The Secondary NameNode is omitted by default in the validation run class, but these sizing values
# take effect whenever a run explicitly enables it with PX_SNN=1.
PX_SNN_MEM_MIB=1024
PX_SNN_HEAP_MIB=512
PX_SNN_DIRECT_MIB=128
PX_SNN_JDK=17

PX_DN_MEM_MIB=1024
PX_DN_HEAP_MIB=512
PX_DN_DIRECT_MIB=128
PX_DN_JDK=17

PX_RM_MEM_MIB=768
PX_RM_HEAP_MIB=512
PX_RM_DIRECT_MIB=64
PX_RM_JDK=17

PX_NM_MEM_MIB=2048
PX_NM_HEAP_MIB=256
PX_NM_DIRECT_MIB=32
PX_NM_JDK=17

PX_JHS_MEM_MIB=512
PX_JHS_HEAP_MIB=256
PX_JHS_DIRECT_MIB=32
PX_JHS_JDK=17

# The HBase Master consumes more than 256 MiB outside its heap, and a region drain adds further
# overhead. A 768 MiB heap allows a drain operation to push the master above its 1024 MiB limit,
# where the kernel kills the process.
PX_MASTER_MEM_MIB=1024
PX_MASTER_HEAP_MIB=512
PX_MASTER_DIRECT_MIB=128
PX_MASTER_JDK=17

PX_RS_MEM_MIB=2560
PX_RS_HEAP_MIB=1792
PX_RS_DIRECT_MIB=256
PX_RS_JDK=17

PX_CLIENT_MEM_MIB=1536
PX_CLIENT_HEAP_MIB=1024
PX_CLIENT_DIRECT_MIB=128
PX_CLIENT_JDK=17

PX_TOOLING_MEM_MIB=512
PX_TOOLING_HEAP_MIB=256
PX_TOOLING_DIRECT_MIB=64
PX_TOOLING_JDK=17

PX_SETUP_MEM_MIB=512
PX_SETUP_HEAP_MIB=256
PX_SETUP_DIRECT_MIB=64
PX_SETUP_JDK=17

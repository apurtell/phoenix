# TIME RESULTS FROM A RUN WITH THIS FILE ARE ADVISORY. COUNT RESULTS REMAIN AUTHORITATIVE.
#
# This file provides the per-role configuration overrides required to fit a measurement-shaped run
# within a 24 GiB container engine. It does not define a standalone run class; instead, apply it on
# top of the measurement class at a configuration precedence stage that overrides the class
# defaults:
#   --config "$PX_HOME/docker/env/override-24gib.env"   (stage 2), or
#   placing the same definitions in docker/env/local.env (stage 3).
# Values supplied in the environment or on the command line still take precedence over this file,
# so setting PX_RS_COUNT=1 or PX_RS_COUNT=3 selects those alternative RegionServer counts.
#
# The following topology and sizing adjustments explain why timing results are ADVISORY:
#   - The cluster runs between 1 and 3 RegionServers (2 by default), each configured with a
#     2.25 GiB heap instead of 3 GiB. As a result, per-RegionServer garbage collection and block
#     cache behavior diverges from the committed sizing table, and aggregate cluster throughput is
#     a fraction of the baseline.
#   - The HDFS layer runs 2 DataNodes with a replication factor of 2, so the write pipeline spans
#     two hops.
#   - The YARN layer runs 1 NodeManager; YARN configuration is rendered and the service is started
#     only when a workflow step requires it.
#   - The Secondary NameNode is omitted.
#   - Every other service role runs with a reduced heap allocation, and the host retains less memory
#     for the operating system page cache outside container limits than a 48 GiB engine provides.
# Deterministic count metrics do not depend on these resource and topology reductions, which is why
# count results remain authoritative.
#
# The memory budget arithmetic is derived from the reference host container engine, which reports
# 25167863808 bytes (24001 MiB) of total memory. Preflight validation reserves 4096 MiB of host
# headroom, leaving an admissible container budget of 19905 MiB. With 2 RegionServers, the
# aggregate container memory limits total 15872 MiB without YARN and 19200 MiB with YARN enabled,
# which remains 705 MiB below the 19905 MiB limit. With 1 RegionServer, the totals are 12288 MiB
# without YARN and 15616 MiB with YARN. With 3 RegionServers, the total without YARN is 19456 MiB
# (449 MiB below the 19905 MiB limit), whereas enabling YARN increases the total to 22784 MiB
# (2879 MiB above the limit). Consequently, running 3 RegionServers requires setting PX_YARN=0, and
# preflight validation rejects the deployment otherwise. The committed sizing table with YARN
# enabled requires 41984 MiB, which does not fit within this container engine and is likewise
# rejected during preflight validation.

# --- The 5-RegionServer variant -------------------------------------------------
# Uncomment the eight variable assignments below by removing the leading "# " prefix to deploy a
# 5-RegionServer topology. Because these declarations appear above the baseline defaults later in
# this file—and the configuration loader retains the first value assigned to each variable name—
# they take precedence when enabled. Without YARN, the container memory budget sums to 19328 MiB
# (18.88 GiB): 5 x 2432 MiB RegionServers + 1536 MiB client + 512 MiB ZooKeeper + 1024 MiB NameNode
# + 2 x 1024 MiB DataNodes + 1024 MiB master + 512 MiB tooling + 512 MiB setup, leaving 577 MiB
# below the 19905 MiB preflight limit. Round A4 verified that this topology fits the engine budget
# and sustains cluster readiness. YARN remains disabled in this configuration.
# PX_RS_COUNT=5
# PX_YARN=0
# PX_RS_MEM_MIB=2432
# PX_RS_HEAP_MIB=1664
# PX_RS_DIRECT_MIB=256
# PX_CLIENT_MEM_MIB=1536
# PX_CLIENT_HEAP_MIB=1024
# PX_CLIENT_DIRECT_MIB=128

# --- Topology -------------------------------------------------------------------
PX_YARN=1
PX_SNN=0
PX_DN_COUNT=2
PX_NM_COUNT=1
PX_RS_COUNT=2
PX_HDFS_REPLICATION=2

# --- YARN allocations ------------------------------------------------------------
# Configure the YARN container memory allocation so that the single NodeManager can concurrently
# host one ApplicationMaster and one MapReduce task (1024 + 512 = 1536 MiB) alongside its own
# daemon footprint (1536 + 256 + 32 = 1824 MiB out of the 2048 MiB container limit). Both base
# class files already set the remaining three YARN sizing parameters to the required values.
PX_MR_TASK_MIB=512

# --- Sizing ---------------------------------------------------------------------
# Configure the per-role container memory, heap, and direct memory allocations in MiB. Any service
# role that is not explicitly named in this file retains the JDK selection defined by the active
# run class.
PX_ZK_MEM_MIB=512
PX_ZK_HEAP_MIB=256
PX_ZK_DIRECT_MIB=64

PX_NN_MEM_MIB=1024
PX_NN_HEAP_MIB=768
PX_NN_DIRECT_MIB=64

PX_DN_MEM_MIB=1024
PX_DN_HEAP_MIB=512
PX_DN_DIRECT_MIB=128

PX_RM_MEM_MIB=768
PX_RM_HEAP_MIB=512
PX_RM_DIRECT_MIB=64

PX_NM_MEM_MIB=2048
PX_NM_HEAP_MIB=256
PX_NM_DIRECT_MIB=32

PX_JHS_MEM_MIB=512
PX_JHS_HEAP_MIB=256
PX_JHS_DIRECT_MIB=32

# The HBase Master consumes more than 256 MiB outside its heap, and a region drain adds further
# overhead. A 768 MiB heap allows a drain operation to push the master above its 1024 MiB limit,
# where the kernel kills the process.
PX_MASTER_MEM_MIB=1024
PX_MASTER_HEAP_MIB=512
PX_MASTER_DIRECT_MIB=128

PX_RS_MEM_MIB=3584
PX_RS_HEAP_MIB=2304
PX_RS_DIRECT_MIB=384

PX_CLIENT_MEM_MIB=3072
PX_CLIENT_HEAP_MIB=2304
PX_CLIENT_DIRECT_MIB=256

PX_TOOLING_MEM_MIB=512
PX_TOOLING_HEAP_MIB=256
PX_TOOLING_DIRECT_MIB=64

PX_SETUP_MEM_MIB=512
PX_SETUP_HEAP_MIB=256
PX_SETUP_DIRECT_MIB=64

# Defines the measurement run class, which corresponds to stage 4 of the configuration loader. This
# file is loaded whenever the active run class is set to measurement via the command line, the
# environment, or env/local.env. A run class selects default configuration values only and never
# alters an execution code path: this file contains variable assignments exclusively and applies
# equally to both backends.
#
# This file establishes the full resource sizing table for a container engine provisioned with
# approximately 48 GiB of memory and serves as the committed default for measurement runs. Running
# on a smaller container engine does not modify this table; instead, it changes what the preflight
# check admits. Preflight sums the container memory limits rendered by compose.gen.sh and compares
# that total against the engine memory minus 4 GiB reserved for host headroom. On a 48 GiB engine,
# that admissible allowance is 49152 - 4096 = 45056 MiB, whereas the table below with YARN enabled
# consumes 41984 MiB. For a 24 GiB container engine, env/override-24gib.env provides the
# corresponding override set.
#
# All memory figures are expressed in MiB, and each service role is governed by four values.
# MEM_MIB defines the container memory limit. HEAP_MIB defines the fixed Java heap size, where -Xms
# equals -Xmx so that the heap never resizes during a measurement run. DIRECT_MIB defines the JVM
# direct memory limit. JDK specifies the major Java version for the role: 11, 17, or 21. The sum of
# the heap and direct memory allocations must remain strictly below the container memory limit; the
# remaining capacity accommodates the JVM metaspace, the code cache, garbage collector structures,
# and thread stacks. Every Java role runs with the G1 garbage collector.
#
# The service roles and their configuration key prefixes are: ZK for zookeeper, NN for namenode,
# SNN for secondarynamenode, DN for datanode, RM for resourcemanager, NM for nodemanager, JHS for
# jobhistory, MASTER for hbase-master, RS for regionserver, CLIENT for client (the workload
# client), TOOLING for tooling, and SETUP for setup (the one-shot NameNode format and bootstrap
# probe).
#
# At the default scale of three instances per scaled role, the container memory limits sum to
# 31744 MiB without YARN and 41984 MiB with YARN included. These figures correspond to the 31 GiB
# and 41 GiB footprints referenced in the architecture design, with the YARN tier accounting for
# the 10240 MiB difference between the two totals.
#
# The RegionServer represents the largest single container allocation, pairing a 4.5 GiB container
# limit with a 3 GiB G1 heap. The workload client is the second-largest allocation
# (4608 > 4096 > 2560 > 2048). Each RegionServer reserves 1024 MiB outside of heap and direct
# memory to hold the native memory structures for 30 RPC handlers and the Phoenix coprocessor
# pools. The workload client heap matches the allocation used by the shipped Pherf launcher.
#
# Each scaled role (datanode, nodemanager, and regionserver) supports between 1 and 9 instances.
# Nine instances is the ceiling because the debug ports assigned to a scaled role occupy a single
# ten-port decade above its base port: 15011-15019, 15021-15029, and 15031-15039.
#
# Subsequent implementation rounds append their own measurement defaults to this file.

# --- Distributed Pherf ---------------------------------------------------------
# Setting PX_PHERF=1 renders the Distributed Pherf tier with one controller and between 1 and 9
# agents. The controller runs with a 1024 MiB container memory limit and each agent runs with a
# 1536 MiB limit that accommodates both the agent daemon JVM and one Pherf child JVM, giving a tier
# footprint of 1024 + 3 x 1536 = 5632 MiB (5.5 GiB). Preflight includes this tier alongside the
# other on-demand role groups. On a 48 GiB container engine, enabling both YARN and the Distributed
# Pherf tier brings the full sizing table to 41984 + 5632 = 47616 MiB, exceeding the 45056 MiB
# preflight admission limit, whereas disabling YARN (PX_YARN=0) reduces the total to 37376 MiB
# (7680 MiB below the limit).
PX_PHERF_AGENT_COUNT=3
PX_PHERF_CONTROLLER_MEM_MIB=1024
PX_PHERF_AGENT_MEM_MIB=1536

# --- Topology -------------------------------------------------------------------
# Renders the YARN service tier into the topology, leaving its containers created but stopped until
# a workflow step explicitly starts the YARN role group.
PX_YARN=1
# Includes the Secondary NameNode role in the rendered cluster topology.
PX_SNN=1
PX_DN_COUNT=3
PX_NM_COUNT=3
PX_RS_COUNT=3
# Specifies the requested HDFS block replication factor. The topology generator automatically caps
# this value at the active DataNode count whenever the requested factor exceeds it.
PX_HDFS_REPLICATION=3

# --- Host safety --------------------------------------------------------------
# A measurement run requires a quiet host. The quiet-host check waits up to 300 seconds for host
# load to fall within the threshold, and because a quiet host is mandatory, a host that remains
# busy fails the run.
PX_QUIET_HOST_WAIT_S=300
PX_REQUIRE_QUIET_HOST=1
# The disk floor ensures sufficient free space under PX_OUT to store the diagnostic bundles and
# logs produced by a full deployment, while the processor floor prevents the full deployment
# sizing table from contending with itself.
PX_PREFLIGHT_MIN_DISK_MIB=20480
PX_PREFLIGHT_MIN_CPUS=8

# --- Collectors ---------------------------------------------------------------
# A measurement run enables the full set of diagnostic collectors around the run verb, comprising
# async-profiler, JFR, jHiccup, the host and container resource samplers, and the Phoenix trace
# counters.
PX_COLLECTORS=profile,jfr,hiccup,host,container,trace

# --- HBase memory fractions -------------------------------------------------------
# Combining the shipped defaults (0.4 for the block cache and 0.4 for the global memstore) with the
# 15 percent Phoenix global memory pool would consume 2916 MiB of the 3072 MiB RegionServer heap
# before any RPC work occurs. These reduced fractions leave sufficient heap headroom for active RPC
# processing.
PX_HBASE_BLOCKCACHE_SIZE=0.30
PX_HBASE_MEMSTORE_SIZE=0.35

# --- YARN allocations ------------------------------------------------------------
# Because each MapReduce task executes as a child process of the NodeManager within the same
# container memory limit, the NodeManager can advertise only the container capacity remaining beyond
# its own daemon footprint: 2560 - 512 heap - 128 direct - 384 daemon overhead = 1536 MiB. Leaving
# this resource limit unset would cause YARN to advertise its default of 8192 MiB and 8 cores,
# allowing task allocations that exceed the container limit and get killed.
PX_NM_RESOURCE_MIB=1536
PX_NM_VCORES=2
PX_YARN_MIN_ALLOC_MIB=512
PX_YARN_MAX_ALLOC_MIB=1536
PX_MR_AM_MIB=1024
PX_MR_TASK_MIB=1024

# --- Sizing ---------------------------------------------------------------------
PX_ZK_MEM_MIB=1024
PX_ZK_HEAP_MIB=512
PX_ZK_DIRECT_MIB=128
PX_ZK_JDK=17

PX_NN_MEM_MIB=2048
PX_NN_HEAP_MIB=1536
PX_NN_DIRECT_MIB=128
PX_NN_JDK=17

PX_SNN_MEM_MIB=1024
PX_SNN_HEAP_MIB=512
PX_SNN_DIRECT_MIB=128
PX_SNN_JDK=17

PX_DN_MEM_MIB=2048
PX_DN_HEAP_MIB=1024
PX_DN_DIRECT_MIB=256
PX_DN_JDK=17

PX_RM_MEM_MIB=1536
PX_RM_HEAP_MIB=1024
PX_RM_DIRECT_MIB=128
PX_RM_JDK=17

PX_NM_MEM_MIB=2560
PX_NM_HEAP_MIB=512
PX_NM_DIRECT_MIB=128
PX_NM_JDK=17

PX_JHS_MEM_MIB=1024
PX_JHS_HEAP_MIB=512
PX_JHS_DIRECT_MIB=128
PX_JHS_JDK=17

PX_MASTER_MEM_MIB=2048
PX_MASTER_HEAP_MIB=1024
PX_MASTER_DIRECT_MIB=256
PX_MASTER_JDK=17

PX_RS_MEM_MIB=4608
PX_RS_HEAP_MIB=3072
PX_RS_DIRECT_MIB=512
PX_RS_JDK=17

PX_CLIENT_MEM_MIB=4096
PX_CLIENT_HEAP_MIB=3072
PX_CLIENT_DIRECT_MIB=256
PX_CLIENT_JDK=17

PX_TOOLING_MEM_MIB=1024
PX_TOOLING_HEAP_MIB=256
PX_TOOLING_DIRECT_MIB=64
PX_TOOLING_JDK=17

PX_SETUP_MEM_MIB=512
PX_SETUP_HEAP_MIB=256
PX_SETUP_DIRECT_MIB=64
PX_SETUP_JDK=17

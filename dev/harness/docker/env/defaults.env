# Defines the baseline configuration defaults for the harness. This file represents stage 5 of the
# configuration loader and is its only mandatory stage: a configuration load that cannot read this
# file fails.
#
# Because every preceding loader stage takes precedence over stage 5, values defined here carry the
# lowest priority in the harness. Override settings for a single host in env/local.env and for a
# specific run class in env/class-<class>.env; both files override this baseline and neither is
# committed to version control.
#
# Each line must be a KEY=VALUE assignment, a comment, or a blank line. The loader parses this file
# as plain text and never sources it as shell script, so every value is interpreted literally with
# no variable expansion or command substitution. For that reason, no setting here references $HOME
# or any other variable.
#
# Role sizing tables and instance counts are defined in the run-class configuration files
# (env/class-<class>.env), while pinned component versions reside in docker/versions.env.

# --- Output ------------------------------------------------------------------
# The output root directory is intentionally left unset here because values in this file are parsed
# literally and cannot expand $HOME. Instead, lib/common.sh defaults the output root to
# $HOME/phoenix-harness at runtime and rejects any path located inside the working tree. Define an
# absolute path in env/local.env to relocate it.
# PX_OUT=

# Defines the directory for backend state, which holds the scope record, the capability cache, and
# the forward records. A relative path resolves beneath the output root directory.
PX_STATE_DIR=state

# --- Backend -----------------------------------------------------------------
# Selects the substrate backend that every harness command binds. The Kubernetes backend arrives
# with the second backend round and reads this same variable name.
PX_BACKEND=compose

# Defines the label namespace that scopes every resource created by the harness. Every operation
# filters on this prefix so that objects managed by other tools are never modified.
PX_LABEL_PREFIX=px.harness

# Sets the naming prefix applied to each deployment scope. The full scope name combines this prefix
# with the cluster identifier.
PX_PROJECT_PREFIX=px

# --- Switches ----------------------------------------------------------------
# Behavioral execution switches; see lib/varnames.txt for the full specification of each variable.
PX_VERBOSE=0
PX_DRY_RUN=0
PX_KEEP=0
PX_FORCE=0

# --- Timeouts ----------------------------------------------------------------
# Every wait operation in the harness is bounded by a finite timeout measured in seconds. When a
# wait expires, it returns exit code 4 and leaves the caller to decide whether the expiration
# constitutes a failure or a skip. This file serves as the single authoritative source for these
# default durations, and any in-code fallback for an unset variable name uses the exact value
# defined here.
PX_TIMEOUT_DEFAULT=300
# Sets the default shared execution time bound for the prepare and run verbs of px-run; when running
# a suite, px-suite supplies each test's configured timeout instead.
PX_TIMEOUT_RUN=3600
PX_TIMEOUT_READY=600
PX_TIMEOUT_EXEC=600
PX_TIMEOUT_TEARDOWN=300
PX_TIMEOUT_SCALE=600
PX_TIMEOUT_GROUP=600
PX_TIMEOUT_STOP=120
PX_POLL_INTERVAL_S=2
PX_TIMEOUT_BUILD=3600

# Sets the maximum time, in seconds, allowed for instance creation, including any first-time volume
# initialization.
PX_TIMEOUT_PROVISION=900

# Sets the timeout, in seconds, for draining regions before a graceful restart. Bounding this wait
# ensures that a decommission operation that cannot finish fails the step promptly instead of
# holding the run indefinitely.
PX_TIMEOUT_DRAIN=600

# Sets the maximum time, in seconds, allowed for downloading a single pinned component distribution
# archive, which may be several hundred MiB in size.
PX_TIMEOUT_FETCH=1800

# --- Host safety -------------------------------------------------------------
# Host preflight requires at least this much free disk space, in MiB, beneath PX_OUT on the host,
# along with at least this many processors both on the host and inside the container engine. Each
# run class overrides these minimums to match the resource footprint of its deployment.
PX_PREFLIGHT_MIN_DISK_MIB=4096
PX_PREFLIGHT_MIN_CPUS=2

# The health monitor polls every instance and the host at this interval, in seconds, recording the
# memory usage of each instance and tearing down the cluster if available host memory falls below
# this threshold, in MiB.
PX_MONITOR_INTERVAL_S=30
PX_MONITOR_HOST_FREE_MIB=1024

# Two behavioral settings and a load threshold govern the quiet-host check. The wait setting bounds
# how long the check pauses for a quiet host, in seconds, where a wait of 0 takes a single sample.
# Combining a wait of 0 with PX_REQUIRE_QUIET_HOST=0 disables the check completely so that it takes
# no sample and tags the run as contaminated. If the wait expires while the host remains busy, a
# run that requires a quiet host fails, whereas any other run proceeds tagged as contaminated. A
# host is considered quiet when its one-minute load is at most this percentage of its processors.
# The measurement run class enables this check.
PX_QUIET_HOST_WAIT_S=0
PX_REQUIRE_QUIET_HOST=0
PX_QUIET_HOST_LOAD_PCT=25

# --- Build -------------------------------------------------------------------
# Selects the major JDK version used for the Maven build; the project builds and executes its tests
# on Java 17.
PX_BUILD_JDK=17
PX_BUILD_DISTRIBUTED=0

# --- Deployment --------------------------------------------------------------
# Setting this flag to 1 attaches the JVM debug agent to every Java service role and publishes its
# debug port to the host. Because the topology generator consumes this setting, changes take effect
# on the next topology render.
PX_JVM_DEBUG=0

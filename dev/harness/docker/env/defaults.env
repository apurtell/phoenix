# Defines the baseline configuration defaults for the harness. This file represents stage 5 of the
# configuration loader and is its only mandatory stage: a configuration load that cannot read this
# file fails.
#
# Because every preceding loader stage takes precedence over stage 5, values defined here carry the
# lowest priority in the harness. Override settings for a single host in env/local.env and for a
# specific run class in env/class-<class>.env; both files override this baseline and neither is
# committed to version control.
#
# Each line must be a KEY=VALUE assignment, a comment, or a blank line. The loader parses this file
# as plain text and never sources it as shell script, so every value is interpreted literally with
# no variable expansion or command substitution. For that reason, no setting here references $HOME
# or any other variable.
#
# Only harness-generic parameters belong in this file. The sizing table, role counts, and component
# versions are provided by the topology generator.

# --- Output ------------------------------------------------------------------
# The output root directory is intentionally left unset in this file. Because values here are read
# literally without expanding $HOME, lib/common.sh supplies the default of $HOME/phoenix-harness at
# runtime and rejects any path located inside the working tree. To relocate the output root, define
# an absolute path for PX_OUT in env/local.env.
# PX_OUT=

# Defines the directory for backend state, which holds the scope record, the capability cache, and
# the forward records. A relative path resolves beneath the output root directory.
PX_STATE_DIR=state

# --- Backend -----------------------------------------------------------------
# Selects the substrate backend that every harness command binds. The Kubernetes backend arrives
# with the second backend round and reads this same variable name.
PX_BACKEND=compose

# Defines the label namespace that scopes every resource created by the harness. Every operation
# filters on this prefix so that objects managed by other tools are never modified.
PX_LABEL_PREFIX=px.harness

# Sets the naming prefix applied to each deployment scope. The full scope name combines this prefix
# with the cluster identifier.
PX_PROJECT_PREFIX=px

# --- Switches ----------------------------------------------------------------
# Controls whether debug diagnostic messages are emitted. Passing the command-line verbosity flag
# enables this setting for a single invocation.
PX_VERBOSE=0

# Instructs commands to report their intended execution plan without modifying state. A dry run
# performs no backend calls.
PX_DRY_RUN=0

# Preserves data volumes, temporary directories, and the deployment scope after a run completes,
# intended strictly for post-run triage.
PX_KEEP=0

# Allows execution to proceed past a safety refusal when explicitly accepted by the operator. This
# override is never enabled by default.
PX_FORCE=0

# --- Timeouts ----------------------------------------------------------------
# Every wait operation in the harness is bounded by a finite timeout measured in seconds. When a
# wait expires, it returns exit code 4 and leaves the caller to decide whether the timeout
# constitutes a failure or a skip. This file serves as the single authoritative source for these
# default durations, and any in-code fallback for an unset variable uses the exact value defined
# here.

# Sets the fallback timeout, in seconds, used by any operation that does not define a dedicated
# timeout variable of its own.
PX_TIMEOUT_DEFAULT=300
# Sets the default shared execution time bound for the prepare and run verbs of px-run; when running
# a suite, px-suite supplies each test's configured timeout instead.
PX_TIMEOUT_RUN=3600

# Sets the maximum time, in seconds, allowed for instance creation, including any first-time volume
# initialization.
PX_TIMEOUT_PROVISION=900

# Sets the timeout, in seconds, for the readiness barrier across an entire deployment.
PX_TIMEOUT_READY=600

# Sets the timeout, in seconds, for executing a single command inside a single instance.
PX_TIMEOUT_EXEC=600

# Sets the timeout, in seconds, allowed for removing instances during teardown.
PX_TIMEOUT_TEARDOWN=300

# Sets the timeout, in seconds, for draining regions prior to a graceful restart. Bounding this
# wait ensures that a decommission operation that cannot complete fails the step promptly instead of
# stalling the entire run.
PX_TIMEOUT_DRAIN=600

# Sets the timeout, in seconds, for changing the instance count of a role, including waiting for any
# newly added instance to reach readiness.
PX_TIMEOUT_SCALE=600

# Sets the timeout, in seconds, for stopping or starting an entire role group.
PX_TIMEOUT_GROUP=600

# Sets the timeout, in seconds, for stopping an instance while preserving its state.
PX_TIMEOUT_STOP=120

# Sets the delay, in seconds, between consecutive probes during a readiness poll.
PX_POLL_INTERVAL_S=2

# Unified cluster lifecycle entry point for provisioning, teardown, configuration validation, log
# streaming, state inspection, and fault injection. This command serves as the operator-facing
# front end to the substrate contract: it binds a single backend implementation, resolves the scope
# of the target cluster, and dispatches operations through the contract interface.
#
# Four architectural rules govern this script:
#   1. The command remains agnostic of container runtimes, role names, cluster sizes, and network
#      ports. Every cluster operation is dispatched through sb_call so that one implementation
#      drives every backend uniformly.
#   2. Optional contract functions are probed for support before invocation. When a capability is
#      absent, the command exits with the unsupported status code and reports the capability
#      detail so calling harnesses can record the test step as skipped.
#   3. Scope identifiers are owned exclusively by the backend. This command persists the identifier
#      returned by sb_scope_create in the contract's scope record file, and subsequent commands
#      recover it via sb_scope_resolve so no higher layer ever synthesizes a scope identifier.
#   4. The config subcommand performs no backend calls whatsoever, enabling the self-test suite to
#      verify the runtime isolation boundary by asserting an empty runtime invocation log.
#
# Fault-injection verbs append an entry to the contract's planned-action record before executing.
# Because px-run consults that record during health checks, intentional operator kills, signals,
# graceful restarts, and scaling adjustments are not misclassified as unplanned anomalies. A role
# group transition discovers its affected member roles only from the backend response, so it records
# its planned-action rows immediately after the backend call returns.
#
# Each command tears down only the resources that it provisioned. A failed up operation tears its
# cluster down automatically so that a cluster that outlives its purpose does not continue holding
# host memory needed by the operator, whereas passing --keep leaves the deployment in place for
# diagnostic inspection. Once up brings a cluster up, the cluster remains running until it is
# explicitly removed by px-cluster down, which is idempotent.
#
# The up subcommand persists a cluster record capturing the bring-up configuration, and every
# subsequent command targeting that cluster loads the record as a configuration stage. The scale
# subcommand updates the recorded instance count in place, and down removes the record.
#
# While a cluster is running, two host-level safeguards execute alongside it: a sleep inhibitor
# keeps the host awake for the lifetime of the cluster, and the health monitor (px-tool monitor)
# tears the cluster down if available host memory becomes critically low. The up subcommand starts
# both safeguards, and every teardown path stops them.
#
# The matrix subcommand executes a single test suite across multiple version sets. Each version set
# is defined by a configuration file, and every lifecycle phase for that set (build, bring-up,
# suite execution, and teardown) executes as a child command that loads that file. Because each
# child inherits only the operator-supplied configuration, settings resolved by this parent process
# cannot mask the child's version set. The matrix tears down each set's cluster upon completion or
# when interrupted by a signal.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# The substrate contract also sources common.sh, and both libraries guard against multiple loads;
# sourcing both files explicitly documents the two direct library dependencies of this command
# while executing only a single load.
# shellcheck source=SCRIPTDIR/../lib/backend/contract.sh
. "$SELF/../lib/backend/contract.sh"
# The push subcommand reads the manifest of a bundle through the bundle library.
# shellcheck source=SCRIPTDIR/../lib/bundle.sh
. "$SELF/../lib/bundle.sh"
# The matrix subcommand ranks the session severities of its version sets on the suite severity
# lattice.
# shellcheck source=SCRIPTDIR/../suites/lib/common.sh
. "$SELF/../suites/lib/common.sh"

set -euo pipefail

# This command intentionally omits the report-only ERR trap provided by px_trap_enable. Enabling
# that trap requires set -E, which propagates the trap into every command substitution, whereas
# this script routinely captures expected non-zero exit codes from command substitutions: exit code
# 6 from an existence probe, 3 from a refused preflight check, 4 from an expired wait, and non-zero
# probe statuses for each variable recorded by the configuration loader. Firing the ERR trap on
# those expected outcomes would emit spurious failure diagnostics that violate the harness output
# design, while set -e remains active to abort on any unguarded failure.

# Token grammar for operator-supplied role, group, port, and signal identifiers; cluster names are
# validated separately against SB_CLUSTER_RE from the substrate contract.
PC_NAME_RE='^[A-Za-z0-9][A-Za-z0-9_.-]*$'

# Authoritative set of supported subcommands. A single list drives both membership validation and
# command dispatch, ensuring that no new subcommand can be routed without being registered here.
PC_SUBCOMMANDS="render up down status ready config validate logs exec cp-in cp-out
scale group kill signal restart endpoint version matrix"

# Timeout and interval variable names inspected by the validate subcommand: integer whole-second
# timeouts in the first list, and potentially fractional second intervals in the second.
PC_TIMEOUT_NAMES="PX_TIMEOUT_DEFAULT PX_TIMEOUT_PROVISION PX_TIMEOUT_READY
PX_TIMEOUT_EXEC PX_TIMEOUT_TEARDOWN PX_TIMEOUT_DRAIN PX_TIMEOUT_SCALE
PX_TIMEOUT_GROUP PX_TIMEOUT_STOP"
PC_SECONDS_NAMES="PX_POLL_INTERVAL_S"

# Holds the scope identifier of an in-progress cluster bring-up so the exit hook can tear it down.
PC_UP_SCOPE=""
PC_CHECKS=""
PC_FAILS=0
PC_ARGS=()
# Additional configuration files supplied via --config, which each version set in a matrix run reads
# after its own version set file.
PC_FILES=()

## @description  Prints top-level invocation usage text, which px_usage_error displays on a global
##               usage error.
## @return       Writes the usage text to stdout and exits with 0.
usage() {
  cat <<'EOF'
Usage: px-cluster [global option...] <subcommand> [argument...]

Provisions, inspects and removes one harness cluster through the substrate
contract. It selects a backend and calls that backend's implementation.

Global options. They come before the subcommand.
  -h, --help             print this text and exit 0
  -v, --verbose          report debug detail on stderr
  -n, --dry-run          report the planned contract calls and change nothing
      --keep             keep data and state for a diagnosis
      --strict           refuse a name that lib/varnames.txt does not declare
      --backend NAME     backend to bind, default compose
      --cluster ID       cluster name, default from the configuration
      --class NAME       run class, validation or measurement: it selects the
                         defaults of env/class-NAME.env
      --config FILE      extra configuration file, strongest file stage,
                         repeatable
  -e, --set NAME=VALUE   set one configuration value, repeatable

Subcommands.
  render [OPTION...]     render the deployment directory of the run class
  up [DIR]               preflight and provision a deployment, then wait for
                         ready. With no DIR it renders the run class first
  down                   tear the cluster down and remove its scope
  status                 report the instance inventory and role group state
  ready                  wait for readiness
  config                 report the resolved configuration and each origin
  validate               check the configuration and the backend preflight
  logs ROLE INDEX        stream the log of one instance
  exec ROLE INDEX -- CMD run one command in an instance
  cp-in ROLE INDEX L R   stage a local path into an instance
  cp-out ROLE INDEX R L  retrieve a path from an instance, under $PX_OUT
  scale ROLE COUNT       change the instance count of one scaled role
  group ACTION GROUP     start, stop or report one role group
  kill ROLE INDEX        terminate one instance abruptly
  signal ROLE INDEX SIG  deliver one signal to an instance
  restart ROLE INDEX     drain, restart and rebalance one instance
  endpoint ROLE INDEX P  report the host address of one named port
  version                report the backend and contract versions
  matrix SUITE FILE...   run SUITE against each version set FILE: build, stage,
                         up, run and down for each one

Run 'px-cluster <subcommand> --help' for the options of that subcommand.

Exit codes: 0 ok, 1 failure, 2 usage, 3 cluster anomaly, 4 timeout,
5 unsupported, 6 no such object. The exec subcommand passes the status of
its command through.
EOF
}

## @description  Prints the invocation syntax and option reference for a single subcommand.
## @return       Writes the usage text to stdout and exits with 0.
pc_sub_usage() {
  case "${1:-}" in
  render) cat <<'EOF'
Usage: px-cluster [--class NAME] [--config FILE] render [OPTION...]
  Renders the deployment directory of the cluster from the run class and
  the configuration, by default into $PX_OUT/deploy/<cluster>, and writes
  its path. It calls the generator of the backend and passes each OPTION
  on: -e NAME=VALUE (for example -e PX_RS_COUNT=3), --out DIR, --check and
  the others that the generator lists. It makes no backend call. It refuses
  to replace the deployment directory of a cluster that is up, exit 2.
EOF
    ;;
  up) cat <<'EOF'
Usage: px-cluster up [--timeout S] [--ready-timeout S] [--no-wait] [DIR]
  DIR is the rendered deployment directory, default PX_DEPLOYMENT_DIR. With
  neither, a run class (--class or PX_RUN_CLASS) renders the deployment
  first, so a class and a topology file (--config FILE) are enough. A
  cluster of the same name that is up refuses that render, exit 2.
  The host preflight runs before the cluster is created: a deployment that
  the engine cannot hold is refused with the arithmetic, exit 3.
  The image PX_IMAGE_TAG must exist first: scripts/build-phoenix.sh builds
  the Phoenix jars, then scripts/stage-artifacts.sh builds the image. An
  image that the host does not hold refuses the bring-up before the
  preflight, exit 2, with those two commands.
  --timeout S        provision timeout, default PX_TIMEOUT_PROVISION
  --ready-timeout S  readiness timeout, default PX_TIMEOUT_READY
  --no-wait          create the instances and do not wait for readiness
  While the cluster is up, a sleep inhibitor holds the host awake and the
  health monitor (px-tool monitor) samples its memory; px-cluster down
  stops both. A start that fails or is interrupted tears the cluster down,
  unless PX_TEARDOWN is 0 or --keep is given. A preflight exits 1 when the
  engine does not answer and 5 when it refuses the client.
EOF
    ;;
  down) cat <<'EOF'
Usage: px-cluster down [--keep]
  --keep  keep the data, the state and the scope for a diagnosis
EOF
    ;;
  status) cat <<'EOF'
Usage: px-cluster status [--group NAME] [ROLE [INDEX]]
  ROLE and INDEX narrow the inventory to one role or one instance.
  --group NAME  also report this role group, repeatable. A group name comes
                from the rendered deployment.
EOF
    ;;
  ready) cat <<'EOF'
Usage: px-cluster ready [--timeout S] [ROLE...]
  With no role it waits for every instance in the scope.
  --timeout S  readiness timeout, default PX_TIMEOUT_READY
  Exit 0 all ready, 3 an instance terminated while waiting, 4 timeout.
EOF
    ;;
  config) cat <<'EOF'
Usage: px-cluster config
  Writes one row per resolved value: name, value and origin, tab separated,
  sorted by name. It makes no backend call.
EOF
    ;;
  validate) cat <<'EOF'
Usage: px-cluster validate [--no-backend] [DIR]
  DIR is a rendered deployment directory to check, default PX_DEPLOYMENT_DIR.
  --no-backend  check the configuration only and make no backend call
  Exit 0 when no check failed, 1 when one did. A warning does not fail.
EOF
    ;;
  logs) cat <<'EOF'
Usage: px-cluster logs ROLE INDEX [--since S] [--previous] [-f|--follow]
  --since S   report only the last S seconds
  --previous  read the log of the instance before an unplanned restart
  --follow    keep the stream open
EOF
    ;;
  exec) cat <<'EOF'
Usage: px-cluster exec ROLE INDEX [--timeout S] -- COMMAND [ARGUMENT...]
  --timeout S  command timeout, default PX_TIMEOUT_EXEC
  The status of the command passes through. 124 means the timeout expired,
  125 the command could not start, 126 not executable, 127 not found.
EOF
    ;;
  cp-in) cat <<'EOF'
Usage: px-cluster cp-in ROLE INDEX LOCAL_PATH REMOTE_PATH
  Stages a local file or directory into one instance.
EOF
    ;;
  cp-out) cat <<'EOF'
Usage: px-cluster cp-out ROLE INDEX REMOTE_PATH LOCAL_PATH
  Retrieves a path from one instance. LOCAL_PATH must resolve under PX_OUT.
EOF
    ;;
  scale) cat <<'EOF'
Usage: px-cluster scale ROLE COUNT [--timeout S]
  COUNT is 1 to 9, the parity limit both backends keep.
  --timeout S  scale timeout, default PX_TIMEOUT_SCALE
EOF
    ;;
  group) cat <<'EOF'
Usage: px-cluster group <start|stop|status> GROUP [--timeout S]
  start   start a stopped group and wait for its readiness
  stop    stop every instance of the group and keep its state
  status  report running against desired
  --timeout S  group timeout, default PX_TIMEOUT_GROUP
  A start re-runs the memory check before it starts anything.
EOF
    ;;
  kill) cat <<'EOF'
Usage: px-cluster kill ROLE INDEX [--mode hard|delete]
  hard    stop the process with no graceful shutdown, keep the instance
  delete  remove the instance object, default hard
  The action is recorded as planned, so px-run does not read it as an
  unplanned change.
EOF
    ;;
  signal) cat <<'EOF'
Usage: px-cluster signal ROLE INDEX SIGNAL
  SIGNAL is a name, for example QUIT for a thread dump, STOP and CONT for a
  pause, TERM for a graceful shutdown. The action is recorded as planned.
EOF
    ;;
  restart) cat <<'EOF'
Usage: px-cluster restart ROLE INDEX [--drain-timeout S] [--ready-timeout S]
  Drains the hosted regions, restarts the instance, waits for readiness and
  rebalances. An exited instance starts with no drain, no stop and no
  rebalance. The action is recorded as planned.
  --drain-timeout S  drain timeout, default PX_TIMEOUT_DRAIN
  --ready-timeout S  readiness timeout, default PX_TIMEOUT_READY
EOF
    ;;
  endpoint) cat <<'EOF'
Usage: px-cluster endpoint ROLE INDEX PORT_NAME [--release]
  Writes one row: host and port, tab separated. The host is on the loopback
  interface.
  --release  release this endpoint instead of discovering it
EOF
    ;;
  version) cat <<'EOF'
Usage: px-cluster version
  Reports the harness contract revision, the bound backend and the versions
  the backend's tooling reports.
EOF
    ;;
  matrix) cat <<'EOF'
Usage: px-cluster [--class NAME] [--config FILE] matrix SUITE FILE...
  Runs the suite SUITE against each version set in order. A version set is a
  configuration FILE that selects the HBase profile, the HBase and the Hadoop
  release and the JDKs, for example PX_PHOENIX_HBASE_PROFILE,
  PX_DIST_HBASE_VERSION, PX_DIST_HADOOP_VERSION and PX_<ROLE>_JDK. For each
  set it runs scripts/build-phoenix.sh and scripts/stage-artifacts.sh,
  brings the cluster up, runs px-suite and brings the cluster down. A set
  reads its FILE before each --config FILE of this command. A set that fails
  does not stop the next one.
  Writes one row per set: set, file, profile, HBase, Hadoop, JDKs, session,
  last step and exit code. The rows are also in $PX_OUT/matrix/<id>/matrix.tsv,
  and the session record of each set names its version set.
  Exit 0 when every set passed, else the exit code of the first set that did
  not, 2 usage, 6 no such FILE.
EOF
    ;;
  *) usage ;;
  esac
}

## @description  Reports a usage error for a specific subcommand, prints its usage text, and
##               terminates the process.
## @return       Writes the error and usage text to stderr and exits with 2.
pc_sub_usage_error() {
  local sub=$1
  shift
  px_error "$*"
  pc_sub_usage "$sub" >&2
  exit "$PX_EXIT_USAGE"
}

## @description  Checks whether a given word is a recognized subcommand of this utility.
## @return       Exits with 0 when the word is a valid subcommand, or 1 otherwise.
pc_is_subcommand() {
  local name
  for name in $PC_SUBCOMMANDS; do
    if [ "$name" = "${1:-}" ]; then
      return 0
    fi
  done
  return 1
}

# Parses subcommand options (name, spec, argument...) into local variables in the caller's scope and
# collects remaining positional arguments into PC_ARGS. Each specification token takes the form
# --opt=var for value options or --flag=var=value for boolean flags.
## @description  Parses subcommand options into caller local variables and positional words into
##               PC_ARGS.
## @return       Exits with 0, or exits with 2 on an unknown option or a missing option value.
pc_opts() {
  local _sub=$1 _spec=$2 _word _rest _found
  shift 2
  PC_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
    --)
      shift
      PC_ARGS+=("$@")
      break
      ;;
    -*)
      _found=0
      for _word in $_spec; do
        [ "${_word%%=*}" = "$1" ] || continue
        _found=1
        _rest=${_word#*=}
        case "$_rest" in
        *=*) printf -v "${_rest%%=*}" '%s' "${_rest#*=}" ;;
        *)
          [ $# -ge 2 ] || pc_sub_usage_error "$_sub" "$1 needs a value"
          printf -v "$_rest" '%s' "$2"
          shift
          ;;
        esac
        break
      done
      [ "$_found" = 1 ] || pc_sub_usage_error "$_sub" "unknown option $1"
      ;;
    *) PC_ARGS+=("$1") ;;
    esac
    shift
  done
}

# Validates that an operator-supplied role, group, port, or signal name is a plain token. Enforcing
# a narrow grammar keeps any identifier that reaches a label or a file path predictable.
## @description  Verifies that an operator-supplied role, group, port, or signal name is a plain
##               token.
## @return       Exits with 0 when valid, or exits with 2 on an empty or malformed value.
pc_require_name() {
  local label=$1 value=${2:-}
  if [ -z "$value" ]; then
    px_die "$PX_EXIT_USAGE" "name a $label"
  fi
  if ! [[ $value =~ $PC_NAME_RE ]]; then
    px_die "$PX_EXIT_USAGE" "invalid $label '$value'"
  fi
}

# Verifies that an instance index is a whole number; the backend determines whether the instance
# actually exists and returns exit code 6 when it does not.
## @description  Validates that an instance index is a whole number.
## @return       Exits with 0 if valid, or exits with 2 on any other value.
pc_require_index() {
  if ! [[ ${1:-} =~ $PX_RE_INT ]]; then
    px_die "$PX_EXIT_USAGE" "an instance index is a whole number, got '${1:-}'"
  fi
}

## @description  Validates both the role name and the numeric index identifying a single instance.
## @return       Exits with 0 when valid, or exits with 2 on a malformed role name or index.
pc_require_instance() {
  pc_require_name role "$1"
  pc_require_index "$2"
}

## @description  Resolves a timeout duration in whole seconds.
## @return       Writes the resolved seconds to stdout and exits with 0, or exits with 2 when the
##               value is not a whole number.
pc_timeout() {
  local name=$1 value=${2:-}
  if [ -z "$value" ]; then
    value=${!name:-}
  fi
  if [ -z "$value" ]; then
    value=${PX_TIMEOUT_DEFAULT:-300}
  fi
  if ! [[ $value =~ $PX_RE_INT ]]; then
    px_die "$PX_EXIT_USAGE" "$name needs whole seconds, got '$value'"
  fi
  printf '%s\n' "$value"
}

# Formats tab-separated rows from stdin as a column-aligned table headed by the field names of a
# contract schema so that this file never hardcodes column names or column numbers.
## @description  Formats TSV rows from stdin as a column-aligned table under a contract schema.
## @return       Writes the formatted table to stdout and exits with 0, or exits with 1 on an
##               unknown schema.
pc_table() {
  local fields
  fields="$(sb_schema_fields "${1:-}")" ||
    px_die "$PX_EXIT_FAIL" "no such contract schema: ${1:-}"
  # Explicit tab splitting via split preserves empty columns in their positional slots, and omitting
  # right-padding on the final column ensures that no rendered line ends with trailing whitespace.
  awk -F '\t' -v head="$fields" '
    function row(a, i, s) {
      for (i = 1; i < n; i++) s = s sprintf("%-" w[i] "s  ", a[i])
      print s a[n]
    }
    BEGIN { n = split(head, h, " "); for (i = 1; i <= n; i++) w[i] = length(h[i]) }
    $0 != "" {
      r[++m] = $0
      for (i = 1; i <= n && i <= NF; i++) if (length($i) > w[i]) w[i] = length($i)
    }
    END { row(h); for (j = 1; j <= m; j++) { split(r[j], f, "\t"); row(f) } }
  '
}

## @description  Persists the scope identifier of the cluster created by this command.
## @return       Exits with 0, or exits with 1 when the record cannot be written, or with the
##               sb_scope_record status (2 on a refused state directory, 1 when it cannot be made).
pc_scope_save() {
  local file status=0
  file="$(sb_scope_record)" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "cannot place the scope record of cluster $PX_CLUSTER_ID"
  fi
  printf '%s\n' "$1" >"$file" ||
    px_die "$PX_EXIT_FAIL" "cannot write the scope record $file"
  px_debug "recorded scope $1 in $file"
}

# Preserves any record belonging to a different scope because a caller can target an explicit scope
# via PX_SCOPE_ID.
## @description  Removes the scope record, cluster record, and deployment record for the cluster
##               once its scope (id) has been removed.
## @return       Exits with 0.
pc_scope_forget() {
  local file status=0 recorded=""
  file="$(sb_scope_record)" || status=$?
  if [ "$status" != 0 ] || [ ! -f "$file" ]; then
    return 0
  fi
  IFS= read -r recorded <"$file" || true
  [ "$recorded" = "${1:-}" ] || return 0
  rm -f "$file" || px_debug "cannot remove $file"
  pc_record_forget
  file="$(sb_deployment_record)" || return 0
  rm -f "$file" || px_debug "cannot remove $file"
}

# Emits every setting taken from the command line, a --config file, or the target file as a
# flattened NAME='VALUE' entry that the configuration loader reads back byte for byte. PX_BACKEND
# and PX_RUN_CLASS are always included so that subsequent commands resolve the same backend and run
# class.
## @description  Emits the flattened settings for this command as one NAME='VALUE' row per variable.
## @return       Writes the rows to stdout and exits with 0, or exits with 1 if any value contains
##               a newline.
pc_record_rows() {
  local name origin value rows=""
  while IFS="$PX_TAB" read -r name origin; do
    [ -n "$name" ] || continue
    case " $PX_CONFIG_RECORD_SKIP " in
    *" $name "*) continue ;;
    esac
    value=${!name:-}
    case "$name" in
    PX_BACKEND | PX_RUN_CLASS) [ -n "$value" ] || continue ;;
    *)
      if [ "$origin" != cli ] && [ "$origin" != target ] &&
        ! px_word_at "$origin" ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; then
        continue
      fi
      ;;
    esac
    case "$value" in
    *"$PX_NL"*) px_die "$PX_EXIT_FAIL" "$name holds a newline, which the record cannot hold" ;;
    esac
    rows="$rows$name='$value'$PX_NL"
  done <<EOF
$PX_CONFIG_ORIGINS
EOF
  printf '%s' "$rows"
}

## @description  Deduplicates NAME='VALUE' rows from stdin so that the last entry for each name
##               wins while filtering out any variable listed in PX_CONFIG_RECORD_SKIP.
## @return       Writes the merged rows sorted by variable name to stdout and exits with 0.
pc_rows_merge() {
  awk -v skip=" $PX_CONFIG_RECORD_SKIP " 'NF { n = substr($0, 1, index($0, "=") - 1) }
    NF && index(skip, " " n " ") == 0 { row[n] = $0 } END { for (n in row) print row[n] }' |
    LC_ALL=C sort
}

# When bringing up a cluster from a pre-rendered directory, the render settings from render.env in
# that directory are merged into the cluster record, with the bring-up command's settings taking
# precedence.
## @description  Persists the cluster record for a bring-up from a deployment directory (dir).
## @return       Exits with 0, or exits with 1 if a value contains a newline or the record cannot
##               be written.
pc_record_save() {
  local file=$PX_CONFIG_RECORD rows
  [ -n "$file" ] || px_die "$PX_EXIT_FAIL" "cluster $PX_CLUSTER_ID has no place for its record"
  rows="$(pc_record_rows)" || exit $?
  if ! {
    printf '# cluster %s, brought up by px-cluster up at %s\n' "$PX_CLUSTER_ID" "$(px_timestamp)"
    { grep -v '^#' "$1/render.env" 2>/dev/null || true; printf '%s\n' "$rows"; } | pc_rows_merge
  } >"$file.tmp" || ! mv -f "$file.tmp" "$file"; then
    px_die "$PX_EXIT_FAIL" "cannot write the cluster record $file"
  fi
  px_debug "recorded the configuration of cluster $PX_CLUSTER_ID in $file"
}

# Records the effective render settings in render.env inside the deployment directory (dir), with
# each positional NAME=VALUE argument overriding the value of NAME. A subsequent bring-up from that
# directory merges render.env into the cluster record so that later scale operations re-render with
# the original render settings.
## @description  Writes the effective render settings (dir, NAME=VALUE...) to render.env.
## @return       Exits with 0, or exits with 1 if a value contains a newline or the file cannot be
##               written.
pc_render_record() {
  local dir=$1 rows pair
  shift
  rows="$(pc_record_rows)" || exit $?
  rows="$rows$PX_NL"
  for pair in "$@"; do
    rows="$rows${pair%%=*}='${pair#*=}'$PX_NL"
  done
  if ! {
    printf '# the settings of the render at %s\n' "$(px_timestamp)"
    printf '%s' "$rows" | pc_rows_merge
  } >"$dir/render.env"; then
    px_die "$PX_EXIT_FAIL" "cannot write $dir/render.env"
  fi
}

## @description  Deletes the cluster record file, logging an INFO line prefixed with the supplied
##               message (message) or a DEBUG line when no message is provided.
## @return       Exits with 0.
pc_record_forget() {
  [ -n "$PX_CONFIG_RECORD" ] && [ -f "$PX_CONFIG_RECORD" ] || return 0
  rm -f "$PX_CONFIG_RECORD" || px_debug "cannot remove $PX_CONFIG_RECORD"
  if [ -n "${1:-}" ]; then
    px_info "$1 $PX_CONFIG_RECORD"
  else
    px_debug "removed the cluster record $PX_CONFIG_RECORD"
  fi
}

## @description  Updates the value of a single variable (file, name, value) in a cluster record or
##               render.env file.
## @return       Exits with 0, returns 6 if the file does not exist, or returns 1 on a write error.
pc_record_set() {
  local file=$1
  [ -n "$file" ] && [ -f "$file" ] || return "$PX_EXIT_NO_OBJECT"
  if ! {
    sed -n 1p "$file"
    {
      awk -v n="$2=" 'NR > 1 && index($0, n) != 1' "$file"
      printf "%s='%s'\n" "$2" "$3"
    } | LC_ALL=C sort
  } >"$file.tmp" || ! mv -f "$file.tmp" "$file"; then
    return "$PX_EXIT_FAIL"
  fi
}

## @description  Persists the deployment directory of the newly created cluster so the memory check
##               can sum its resource requirements before a subsequent group start.
## @return       Exits with 0, or exits with 1 on a write failure or 2 on a refused state directory.
pc_deployment_save() {
  local file status=0
  file="$(sb_deployment_record)" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "cannot place the deployment record of cluster $PX_CLUSTER_ID"
  fi
  printf '%s\n' "$1" >"$file" ||
    px_die "$PX_EXIT_FAIL" "cannot write the deployment record $file"
}

## @description  Renders the deployment directory for the run class through the backend generator.
## @return       Writes the directory path to stdout; exits 0, 1 if the directory cannot be written,
##               2 on usage or an invalid value, or 6 on an absent --config file.
pc_render() { "$PX_HOME/$PX_DEPLOY_SUBDIR/compose.gen.sh" "$@"; }

# Prevents rendering (generator option...) into the recorded deployment directory of a running
# cluster because rendering overwrites the files in that directory.
## @description  Refuses a render targeting the recorded deployment directory of an active cluster.
## @return       Exits with 0, or exits with 2 on a refusal, or 2 or 1 when the state directory is
##               refused.
pc_render_guard() {
  local out="deploy/$PX_CLUSTER_ID" file dir="" target
  while [ $# -gt 0 ]; do
    case "$1" in
    --check) return 0 ;;
    --out) [ $# -lt 2 ] || out=$2 ;;
    esac
    shift
  done
  ! px_is_dry_run || return 0
  file="$(sb_deployment_record)" || exit $?
  [ -f "$file" ] || return 0
  IFS= read -r dir <"$file" || true
  target="$(px_out_resolve "$out" 2>/dev/null)" || return 0
  if [ -n "$dir" ] && [ "$target" = "$dir" ]; then
    px_die "$PX_EXIT_USAGE" "cluster $PX_CLUSTER_ID is up from $dir, and a render replaces" \
      "its files: run px-cluster down first, or render into another directory with --out"
  fi
}

# Executes the host preflight check (verifying container engine health, port availability, and total
# memory capacity) against a rendered deployment directory.
## @description  Runs the host preflight (engine, ports, memory sum) against a deployment directory.
## @return       Exits 0 if the host can hold it, or with the preflight status: 1 on no engine reply
##               or measurement, 2 on usage, 3 if refused, 4 on expiration, or 5 on client refusal.
pc_preflight() {
  local status=0
  # Export private configuration variables so the child process sees the container engine bound by
  # this process.
  px_with_private px_timeout "${PX_TIMEOUT_DEFAULT:-300}" "$PX_HOME/scripts/preflight.sh" \
    --deployment "$1" >&2 || status=$?
  case "$status" in
  0) return 0 ;;
  124 | 137) px_die "$PX_EXIT_TIMEOUT" "the preflight expired after ${PX_TIMEOUT_DEFAULT:-300}s" ;;
  esac
  px_die "$status" "the preflight refused the deployment $1, so no instance is created"
}

## @description  Halts cluster bring-up when the host lacks an image required by the deployment dir.
## @return       Exits with 0, or exits with 2 reporting the commands that build the image, or with
##               the sb_image_present status when the container engine does not respond.
pc_image_check() {
  local rows status=0 missing
  rows="$(sb_call sb_image_present "$1")" || status=$?
  case "$status" in
  0) return 0 ;;
  6) ;;
  *) px_die "$status" "cannot ask the engine for the images that $1 names" ;;
  esac
  missing="$(printf '%s\n' "$rows" | awk -F '\t' '$2 == "" { print $1; exit }')"
  px_die "$PX_EXIT_USAGE" "the host holds no image $missing, which $1 names, so no" \
    "instance is created. Build it with the configuration of the render:" \
    "$PX_HOME/scripts/build-phoenix.sh, then" \
    "$PX_HOME/scripts/stage-artifacts.sh --tag $missing"
}

## @description  Records an operator action in the planned-action log or terminates the process.
## @return       Exits with 0, or exits with the failure status of sb_planned_record (2 or 1).
pc_planned() {
  local status=0
  sb_planned_record "$@" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "cannot record the planned $2, so it does not start"
  fi
}

## @description  Appends a validation check row for the validate subcommand and tallies failures.
## @return       Exits with 0.
pc_check() {
  local row
  row="$(px_tsv_row "$1" "$2" "$(px_tsv_clean "${3:-}")")" || return 0
  PC_CHECKS="$PC_CHECKS$row$PX_NL"
  if [ "$2" = fail ]; then
    PC_FAILS=$((PC_FAILS + 1))
  fi
}

# Serializes teardown of a scope (scope, keep) under its down lock so that a concurrent second
# removal waits for the first to finish and then succeeds as already complete.
## @description  Tears down and removes every instance of a single scope under its teardown lock.
## @return       Exits 0, 1 if the lock wait expired, or the status of the failed backend step.
pc_teardown() {
  local scope=$1 lock bound=${PX_TIMEOUT_TEARDOWN:-} status=0
  lock="$(px_guard_path down "$scope")" || return $?
  # A single removal executes both sb_teardown and sb_scope_delete, each bounded by
  # PX_TIMEOUT_TEARDOWN, so the lock wait allows twice that duration. The backend falls back to 300
  # seconds whenever the configured value is not a positive integer number of seconds, and the lock
  # applies the same fallback so a malformed setting cannot block teardown.
  case "$bound" in
  '' | *[!0-9]*) bound=300 ;;
  esac
  [ "$((10#$bound))" -gt 0 ] || bound=300
  px_lock "$lock" $((2 * 10#$bound)) || return "$PX_EXIT_FAIL"
  pc_teardown_locked "$@" || status=$?
  px_unlock "$lock"
  return "$status"
}

## @description  Removes every instance of a scope (scope, keep) while pc_teardown holds the lock.
## @return       Exits 0 (including when another removal already deleted the scope), or returns the
##               backend status when instance teardown or scope removal fails.
pc_teardown_locked() {
  local scope=$1 keep=$2 status=0
  sb_call sb_scope_exists "$scope" || status=$?
  if [ "$status" = "$PX_EXIT_NO_OBJECT" ]; then
    px_info "scope $scope already came down"
    # When a scope has already disappeared, such as after a crash, its host guards and persisted
    # state records are stale and should be cleaned up.
    pc_guards_stop "$scope"
    [ "$keep" = 1 ] || pc_scope_forget "$scope"
    return 0
  fi
  status=0
  # Discovered endpoints may hold background port-forwarding processes; release them before
  # tearing down instances when the backend implements this optional contract function so that
  # teardown leaves no orphaned processes behind.
  if sb_supports sb_endpoint_release; then
    sb_call sb_endpoint_release "$scope" "" "" all ||
      px_debug "endpoint release reported $?"
  fi
  sb_call sb_teardown "$scope" "$keep" || status=$?
  if [ "$status" != 0 ]; then
    px_error "teardown of scope $scope did not complete"
    return "$status"
  fi
  # Because no instances remain running, stop the sleep inhibitor and the health monitor even when
  # the scope data is retained for diagnostic inspection.
  pc_guards_stop "$scope"
  if [ "$keep" = 1 ]; then
    px_info "scope $scope and its data stay for a diagnosis"
    return 0
  fi
  sb_call sb_scope_delete "$scope" || status=$?
  pc_scope_forget "$scope"
  if [ "$status" != 0 ]; then
    px_error "scope $scope could not be removed"
    return "$status"
  fi
}

# Holds the host awake and launches the health monitor for a cluster (scope) coming up; both
# remain active until stopped by pc_guards_stop.
## @description  Starts the sleep inhibitor and health monitor for a cluster (scope) coming up.
## @return       Exits with 0, or 1 if there is no state directory, no run directory, or no
##               monitor record within 10 s.
pc_guards_start() {
  local scope=$1 dir record pid status=0
  px_inhibit_start "cluster-$scope"
  record="$(px_guard_path monitor "$scope")" || return "$PX_EXIT_FAIL"
  px_guard_stop "$record"
  dir="$(px_run_dir monitor)" || status=$?
  if [ "$status" != 0 ]; then
    px_error "no run directory for the health monitor of scope $scope"
    return "$PX_EXIT_FAIL"
  fi
  # Because the monitor daemon outlives this process, redirect its standard streams to its run
  # directory so it does not hold open any file descriptors inherited from the caller.
  (PX_RUN_DIR=$dir px_with_private "$PX_HOME/bin/px-tool" monitor -e "PX_SCOPE_ID=$scope") \
    </dev/null >"$dir/monitor.out" 2>"$dir/monitor.log" &
  pid=$!
  if ! px_wait_until 10 0.1 test -f "$record"; then
    # Terminate a slow-starting monitor process so it cannot begin watching the scope after cluster
    # bring-up has already aborted.
    px_kill_tree "$pid" || true
    px_error "the health monitor of scope $scope did not start, see $dir/monitor.log"
    return "$PX_EXIT_FAIL"
  fi
}

## @description  Stops the health monitor for a cluster (scope), removes its heartbeat file, and
##               releases the sleep inhibitor.
## @return       Exits with 0.
pc_guards_stop() {
  local record
  px_guard_release monitor "$1"
  # Because the monitor may continue refreshing its heartbeat until it terminates, remove the
  # heartbeat file only after stopping the monitor so a stale heartbeat without an active monitor
  # cannot satisfy a subsequent probe.
  record="$(px_guard_path monitor "$1" 2>/dev/null)" && rm -f "$record.heartbeat"
  px_guard_release inhibit "cluster-$1"
}

## @description  Applies the failure teardown policy when the exit hook detects an unfinished
##               cluster bring-up caused by an abort, an interrupt, or a termination signal.
## @return       Exits with 0.
pc_up_abandon() {
  [ -n "$PC_UP_SCOPE" ] || return 0
  px_warn "the bring-up of scope $PC_UP_SCOPE did not finish"
  pc_up_failed "$PC_UP_SCOPE"
}

## @description  Applies the failure teardown policy when cluster bring-up does not succeed.
## @return       Exits with 0, emitting a warning if teardown fails so the caller still reports the
##               status of the failed start.
pc_up_failed() {
  local scope=$1 status=0
  PC_UP_SCOPE=""
  if px_is_keep; then
    px_info "scope $scope stays for a diagnosis: run px-cluster down to remove it"
    return 0
  fi
  px_info "the start failed, so scope $scope comes down (teardown by default)"
  pc_teardown "$scope" 0 || status=$?
  if [ "$status" != 0 ]; then
    px_warn "teardown reported $(sb_exit_name "$status"): run px-cluster down"
  fi
}

## @description  Emits the dry-run execution plan rows for bringing up a deployment directory (dir,
##               provision bound, readiness bound).
## @return       Writes the plan rows to stdout and exits with 0.
pc_up_plan() {
  local script
  script="$(px_preflight_script 2>/dev/null)" || script=none
  px_plan image sb_image_present "$1"
  px_plan preflight "$script" --deployment "$1"
  px_plan scope sb_scope_create "$PX_CLUSTER_ID"
  px_plan provision sb_provision "<scope>" "$1" "$2"
  [ "$PC_WAIT" = 0 ] || px_plan ready sb_wait_ready "<scope>" "$3"
}

## @description  Provisions a cluster from a rendered deployment directory and waits for readiness.
## @return       Exits 0, 1 if the monitor or provisioning fails, 2 on usage or a recorded cluster,
##               3 on a concurrent cluster, preflight refusal, or exit, 4 on timeout, 6 on no image.
pc_up() {
  local dir timeout ready scope rows status=0
  dir=${1:-${PX_DEPLOYMENT_DIR:-}}
  if [ -z "$dir" ] && [ -z "${PX_RUN_CLASS:-}" ]; then
    px_die "$PX_EXIT_USAGE" "name a rendered deployment directory, set PX_DEPLOYMENT_DIR, or" \
      "name a run class to render one"
  fi
  timeout="$(pc_timeout PX_TIMEOUT_PROVISION "")" || exit $?
  ready="$(pc_timeout PX_TIMEOUT_READY "$PC_TIMEOUT")" || exit $?
  # Reject the bring-up before rendering whenever the cluster is already recorded, because rendering
  # overwrites the files in its target directory. When PX_FORCE=1 authorizes replacing a stale
  # record, remove it first so that none of its persisted values leak into the new render.
  if ! px_is_dry_run; then
    pc_up_gate pc_check_record
    pc_record_forget "PX_FORCE=1 removes the stale record"
  fi
  # When a run class is specified without a deployment directory, render the deployment first to
  # support one-command bring-up where a run class and a topology file select every configuration
  # value. In dry-run mode, the deployment is rendered into a temporary scratch directory that the
  # exit hook removes upon termination.
  if [ -z "$dir" ] && px_is_dry_run; then
    px_plan render "$(pc_generator)" --class "$PX_RUN_CLASS" --cluster "$PX_CLUSTER_ID"
    PC_PLAN_DIR="$(px_run_dir plan)" || exit $?
    dir="$(pc_render -e PX_DRY_RUN=0 --out "$PC_PLAN_DIR")" ||
      px_die "$?" "the render of the $PX_RUN_CLASS deployment failed"
  elif [ -z "$dir" ]; then
    dir="$(pc_render)" || exit $?
    pc_render_record "$dir"
    px_info "rendered the $PX_RUN_CLASS deployment of cluster $PX_CLUSTER_ID into $dir"
  fi
  [ -d "$dir" ] || px_die "$PX_EXIT_USAGE" "no such deployment directory: $dir"
  dir="$(px_realpath "$dir")" ||
    px_die "$PX_EXIT_FAIL" "cannot resolve the deployment directory: $dir"
  # The configuration loader only reads the port map from PX_DEPLOYMENT_DIR automatically; when a
  # deployment directory is supplied as a positional argument, load its port map explicitly here.
  px_config_load_ports "$dir"
  if px_is_dry_run; then
    pc_up_plan "$dir" "$timeout" "$ready"
    return 0
  fi
  # Verify required container images before running host preflight checks: no preflight check can
  # compensate for a missing image, and rejecting a deployment that exceeds host capacity before
  # creating any instances is far cheaper than letting the container engine thrash.
  pc_image_check "$dir"
  pc_preflight "$dir"
  scope="$(sb_call sb_scope_create "$PX_CLUSTER_ID")" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "cannot create a scope for cluster $PX_CLUSTER_ID." \
      "A cluster of that name may be up already: run px-cluster down."
  fi
  # Once the scope exists, any unfinished bring-up (including one interrupted by a signal) is torn
  # down according to the teardown policy via pc_up_abandon in the exit hook.
  PC_UP_SCOPE=$scope
  pc_scope_save "$scope"
  pc_deployment_save "$dir"
  pc_record_save "$dir"
  # Because the setup bootstrap probe verifies the monitor heartbeat, it cannot pass without a
  # running monitor; if the monitor fails to start, abort bring-up immediately before provisioning
  # any instances.
  if ! pc_guards_start "$scope"; then
    pc_up_failed "$scope"
    exit "$PX_EXIT_FAIL"
  fi
  px_info "provisioning cluster $PX_CLUSTER_ID in scope $scope from $dir"
  rows="$(sb_call sb_provision "$scope" "$dir" "$timeout")" || status=$?
  pc_table instance <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_error "provision failed: $(sb_exit_name "$status")"
    pc_up_failed "$scope"
    exit "$status"
  fi
  if [ "$PC_WAIT" = 0 ]; then
    PC_UP_SCOPE=""
    px_info "readiness not waited for: run px-cluster ready when you need it"
    return 0
  fi
  rows="$(sb_call sb_wait_ready "$scope" "$ready")" || status=$?
  pc_table ready <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_error "readiness: $(sb_exit_name "$status")"
    pc_up_failed "$scope"
  fi
  PC_UP_SCOPE=""
  exit "$status"
}

# Because a telemetry collection is a live process rather than persisted data, state, or scope, down
# stops every recorded collection prior to teardown—even when --keep is specified or no scope is
# present—so that remote artifacts are retrieved while the cluster instances are still running. A
# failed stop operation emits only a warning. Each stop call is bounded by the timeout budget for
# stopping every collector, and because px-collect stop replaces the record file rather than
# mutating it in place, the loop can safely continue reading the original stream.
## @description  Stops every telemetry collection listed in the cluster's collection record.
## @return       Exits with 0.
pc_collect_stop() {
  local record line status bound
  record="$(pb_collect_record)" || return 0
  [ -f "$record" ] || return 0
  bound=$((${PX_TIMEOUT_VERB:-300} * $(pb_collect_steps "$PB_COLLECTORS")))
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    px_plan collect px-collect stop "$line" && continue
    status=0
    px_timeout "$bound" "$PX_HOME/bin/px-collect" stop "$line" </dev/null >&2 || status=$?
    case "$status" in
    0 | 1) ;;
    *) px_warn "px-collect stop $line reported $(px_exit_name "$status")" ;;
    esac
  done <"$record"
  px_is_dry_run || rm -f "$record"
}

# Teardown is idempotent: if no scope is recorded for the cluster, down exits with 0, and any stale
# cluster record left behind without a corresponding scope record is cleaned up as well.
## @description  Removes all cluster instances and deletes the enclosing scope so no orphaned state
##               survives a run, or retains the data and scope for diagnostic inspection on --keep.
## @return       Exits 0 (including when nothing is recorded), 1 if resources remain, or 2 on usage.
pc_down() {
  local keep=0 scope status=0
  if px_is_keep; then
    keep=1
  fi
  pc_label_check "$keep"
  pc_collect_stop
  scope="$(sb_scope_resolve || exit "$?")" || status=$?
  case "$status" in
  0) ;;
  "$PX_EXIT_NO_OBJECT")
    if [ "$keep" = 0 ] && ! px_is_dry_run; then
      pc_record_forget "removed the record of a cluster that has no scope,"
    fi
    px_info "no cluster $PX_CLUSTER_ID is recorded"
    pc_down_label
    return 0
    ;;
  *) px_die "$status" "cannot read the scope record of cluster $PX_CLUSTER_ID" ;;
  esac
  if px_is_dry_run; then
    px_plan teardown sb_teardown "$scope" "$keep"
    [ "$keep" = 1 ] || px_plan delete sb_scope_delete "$scope"
    pc_down_label
    return 0
  fi
  pc_teardown "$scope" "$keep" || exit $?
  if [ "$keep" = 0 ]; then
    px_info "cluster $PX_CLUSTER_ID is down"
  fi
}

# Displays the cluster instance inventory along with the state of any requested role groups. Because
# group names are defined by the rendered deployment, the operator explicitly names each group to
# inspect.
## @description  Reports the instance inventory and the state of each named role group.
## @return       Exits 0, 2 on usage, or 6 when the specified role, index, group, or scope does not
##               exist.
pc_status() {
  local group role="" index="" scope rows grows="" row status=0
  for group in ${PC_GROUPS[@]+"${PC_GROUPS[@]}"}; do
    pc_require_name "group" "$group"
  done
  role=${1:-}
  index=${2:-}
  if [ -n "$role" ]; then
    pc_require_name "role" "$role"
  fi
  if [ -n "$index" ]; then
    pc_require_index "$index"
  fi
  scope="$(sb_scope_require)" || exit $?
  if [ -n "$index" ]; then
    rows="$(sb_call sb_list "$scope" "$role" "$index")" || status=$?
  elif [ -n "$role" ]; then
    rows="$(sb_call sb_list "$scope" "$role")" || status=$?
  else
    rows="$(sb_call sb_list "$scope")" || status=$?
  fi
  pc_table instance <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    exit "$status"
  fi
  while IFS= read -r group; do
    [ -n "$group" ] || continue
    row="$(sb_call sb_group_status "$scope" "$group")" || status=$?
    grows="$grows$row$PX_NL"
  done <<EOF
$groups
EOF
  if [ -n "$grows" ]; then
    printf '\n'
    pc_table group <<EOF
$grows
EOF
  fi
  exit "$status"
}

## @description  Waits for readiness across the entire cluster scope or the specified roles.
## @return       Exits 0 when all are ready, 1 if the runtime did not answer, 2 on usage, 3 if an
##               instance terminated, 4 on a timeout, or 6 on a missing scope or empty role match.
pc_ready() {
  local timeout scope rows role status=0
  for role in "$@"; do
    pc_require_name "role" "$role"
  done
  timeout="$(pc_timeout PX_TIMEOUT_READY "$PC_TIMEOUT")" || exit $?
  scope="$(sb_scope_require)" || exit $?
  rows="$(sb_call sb_wait_ready "$scope" "$timeout" "$@")" || status=$?
  pc_table ready <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_error "readiness: $(sb_exit_name "$status")"
  fi
  exit "$status"
}

# Each PATTERN is a shell glob supporting * and ? wildcards on the variable name, which the filter
# translates into an anchored regular expression. Supplying multiple patterns selects the union of
# all matching variable names.
## @description  Reports every resolved configuration value, or those matching any supplied glob
##               pattern (pattern...), alongside the precedence stage that defined it.
## @return       Writes the resolved TSV rows to stdout and exits 0, or exits 6 if no name matches.
pc_config() {
  local rows status=0
  if [ $# -eq 0 ]; then
    px_config_dump
    return 0
  fi
  rows="$(px_config_dump | PC_PATTERNS="$*" awk -F '\t' "$(px_awk_glob)"'
    BEGIN { n = split(ENVIRON["PC_PATTERNS"], w, " "); for (i = 1; i <= n; i++) re[i] = glob(w[i]) }
    { for (i = 1; i <= n; i++) if ($1 ~ re[i]) { print; m = 1; next } }
    END { exit !m }')" || status=$?
  [ "$status" = 0 ] || px_die "$PX_EXIT_NO_OBJECT" "no configuration value matches $*"
  printf '%s\n' "$rows"
}

## @description  Validates the configuration, output policy, and backend before provisioning.
## @return       Writes check rows to stdout; exits 0 when no check fails, 1 when any check fails,
##               or 2 on a usage error.
pc_validate() {
  local no_backend=0 dir="" name root undeclared="" scope="" rows bad=0
  local backend file status=0
  pc_opts validate "--no-backend=no_backend=1" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -le 1 ] || pc_sub_usage_error validate "one directory, got: $*"
  dir=${1:-${PX_DEPLOYMENT_DIR:-}}
  root="$(px_out_root)" || status=$?
  if [ "$status" = 0 ]; then
    pc_check output_root ok "$root"
  else
    pc_check output_root fail "PX_OUT is refused, see the message above"
  fi
  pc_check cluster_name ok "$PX_CLUSTER_ID"
  bad=0
  for name in $PC_TIMEOUT_NAMES; do
    if [ -n "${!name:-}" ] && ! [[ ${!name} =~ $PX_RE_INT ]]; then
      pc_check "$name" fail "not whole seconds: ${!name}"
      bad=1
    fi
  done
  for name in $PC_SECONDS_NAMES; do
    if [ -n "${!name:-}" ] && ! [[ ${!name} =~ $PX_RE_SECONDS ]]; then
      pc_check "$name" fail "not a number of seconds: ${!name}"
      bad=1
    fi
  done
  if [ "$bad" = 0 ]; then
    pc_check timeouts ok "every set timeout value is a number"
  fi
  while IFS= read -r name; do
    name=${name%%"$PX_TAB"*}
    case "$name" in
    PX_*)
      if ! px_config_known "$name"; then
        undeclared="$undeclared $name"
      fi
      ;;
    esac
  done <<EOF
$(px_config_dump)
EOF
  if [ -n "$undeclared" ]; then
    pc_check declared_names warn "add to lib/varnames.txt:$undeclared"
  else
    pc_check declared_names ok "every PX_ name is declared"
  fi
  if [ -z "$dir" ]; then
    pc_check deployment_dir warn "none named, px-cluster up needs one"
  elif [ ! -d "$dir" ]; then
    pc_check deployment_dir fail "no such directory: $dir"
  else
    pc_check deployment_dir ok "$dir"
    # As with the up subcommand, a deployment directory passed on the command line is known only
    # at this stage; load its port map here so the backend preflight can verify those ports.
    px_config_load_ports "$dir"
  fi
  backend="${PX_BACKEND:-compose}"
  file="$PX_HOME/lib/backend/$backend.sh"
  if [ -f "$file" ]; then
    pc_check backend_file ok "$file"
  else
    pc_check backend_file fail "no such backend file: $file"
  fi
  if [ "$no_backend" = 0 ] && [ -f "$file" ]; then
    pc_validate_backend "$backend"
  elif [ "$no_backend" = 1 ]; then
    pc_check backend warn "--no-backend was given, no backend call was made"
  fi
  pc_table check <<EOF
$PC_CHECKS
EOF
  if [ "$PC_FAILS" -gt 0 ]; then
    px_error "$PC_FAILS check(s) failed"
    exit "$PX_EXIT_FAIL"
  fi
  return 0
}

## @description  Executes the backend half of validation by binding the backend, reporting any
##               missing required contract functions, and running the backend preflight checks.
## @return       Appends check rows, increments the failure count, and exits with 0.
pc_validate_backend() {
  local backend=$1 missing rows row value column counted=0 scope="" status=0
  sb_load "$backend"
  if missing="$(sb_verify_backend)"; then
    pc_check backend_complete ok "$backend implements every required verb"
  else
    pc_check backend_complete fail "missing: $(px_tsv_clean "$missing")"
    return 0
  fi
  if px_is_dry_run; then
    pc_check preflight warn "dry run, the backend preflight was not called"
    return 0
  fi
  scope="$(sb_scope_resolve)" || scope=""
  if [ -z "$scope" ]; then
    scope="$(sb_call sb_scope_create "$PX_CLUSTER_ID")" || status=$?
    if [ "$status" != 0 ]; then
      pc_check scope fail \
        "cannot create a scope to check: $(sb_exit_name "$status")"
      return 0
    fi
    px_on_exit sb_call sb_scope_delete "$scope"
    px_debug "created scope $scope for the checks, it is removed at exit"
  fi
  status=0
  rows="$(sb_call sb_preflight "$scope")" || status=$?
  # Preflight output already conforms to the check schema and is appended directly to the report.
  # Count every failed row using the schema's status column index, since each row represents a
  # distinct refusal that the operator must resolve.
  PC_CHECKS="$PC_CHECKS$rows$PX_NL"
  column="$(sb_schema_index check status)" || column=2
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    value="$(px_tsv_field "$column" "$row")" || value=""
    if [ "$value" = fail ]; then
      PC_FAILS=$((PC_FAILS + 1))
      counted=$((counted + 1))
    fi
  done <<EOF
$rows
EOF
  # If a backend fails before it can emit any preflight check rows, record a synthetic failure row
  # so the preflight refusal is still counted.
  if [ "$status" != 0 ] && [ "$counted" = 0 ]; then
    pc_check preflight fail \
      "the backend preflight reported $(sb_exit_name "$status")"
  fi
}

# Streams the raw log bytes of a single instance without modification so that operators and cluster
# health checks inspect the exact same byte stream.
## @description  Streams the unmodified log bytes of a single cluster instance.
## @return       Exits with the backend status: 0, 2 on usage, 5 if previous logs are unsupported,
##               or 6 if no such instance exists.
pc_logs() {
  local since="-" previous=0 follow=0 role index scope detail status=0
  pc_opts logs "--since=since --previous=previous=1 -f=follow=1 --follow=follow=1" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -eq 2 ] || pc_sub_usage_error logs "name a role and an index"
  role=$1 index=$2
  pc_require_instance "$role" "$index"
  if [ "$since" != "-" ] && ! [[ $since =~ $PX_RE_INT ]]; then
    pc_sub_usage_error logs "--since takes whole seconds, got '$since'"
  fi
  scope="$(sb_scope_require "" "in PX_SCOPE_ID")" || exit $?
  if [ "$previous" = 1 ] && ! sb_capability logs_previous >/dev/null; then
    detail="$(sb_capability_detail logs_previous)" || detail=""
    px_die "$PX_EXIT_UNSUPPORTED" \
      "this backend keeps no previous instance log: $detail." \
      "The restart count and the termination reason carry that evidence."
  fi
  sb_call sb_logs "$scope" "$role" "$index" "$since" "$previous" "$follow" ||
    status=$?
  exit "$status"
}

## @description  Executes a single command inside a target cluster instance.
## @return       Exits with the command status, 2 on usage, 6 on no such instance, 124 on an expired
##               timeout, 125 if it could not start, 126 if not executable, or 127 if not found.
pc_exec() {
  local role=$1 index=$2 timeout scope status=0
  shift 2
  pc_require_instance "$role" "$index"
  timeout="$(pc_timeout PX_TIMEOUT_EXEC "$PC_TIMEOUT")" || exit $?
  scope="$(sb_scope_require)" || exit $?
  px_plan exec sb_exec "$scope" "$role" "$index" "$timeout" -- "$@" && return 0
  sb_call sb_exec "$scope" "$role" "$index" "$timeout" -- "$@" || status=$?
  # Mark the exit status as already handled because it belongs to the executed remote command,
  # suppressing the exit hook's diagnostic summary line.
  px_exit_noted "$status"
  exit "$status"
}

## @description  Stages a local path into an instance or retrieves a remote path from an instance.
## @return       Exits 0, 1 if the copy failed, 2 on usage or a destination outside PX_OUT, or 6 if
##               no such instance exists.
pc_cp() {
  local direction=$1 role index source target scope sub status=0
  shift
  sub="cp-$direction"
  pc_opts "$sub" "" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -eq 4 ] ||
    pc_sub_usage_error "$sub" "name a role, an index, a source and a target"
  role=$1 index=$2 source=$3 target=$4
  pc_require_instance "$role" "$index"
  scope="$(sb_scope_require "" "in PX_SCOPE_ID")" || exit $?
  if [ "$direction" = in ]; then
    [ -e "$source" ] ||
      px_die "$PX_EXIT_USAGE" "no such local path: $source"
    source="$(px_realpath "$source")" ||
      px_die "$PX_EXIT_FAIL" "cannot resolve $source"
  else
    target="$(px_out_resolve "$target")" || exit $?
  fi
  pc_plan "sb_copy_$direction $scope $role $index $source $target" && return 0
  sb_call "sb_copy_$direction" "$scope" "$role" "$index" "$source" "$target" ||
    status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "copy $direction failed for $role/$index"
  fi
}

## @description  Adjusts the replica count of a scalable role within the one-to-nine instance parity
##               limit enforced across both backends.
## @return       Exits 0, 1 if scaling failed, 2 on usage or an out-of-range count, or 4 on timeout.
pc_scale() {
  local timeout="" role count scope rows status=0
  pc_opts scale "--timeout=timeout" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -eq 2 ] || pc_sub_usage_error scale "name a role and a count"
  role=$1
  count=$2
  pc_require_name "role" "$role"
  if ! [[ $count =~ ^[1-9]$ ]]; then
    px_die "$PX_EXIT_USAGE" \
      "the instance count is 1 to 9, the parity limit of both backends," \
      "got '$count'"
  fi
  timeout="$(pc_timeout PX_TIMEOUT_SCALE "$timeout")" || exit $?
  scope="$(sb_scope_require "" "in PX_SCOPE_ID")" || exit $?
  pc_plan "sb_scale $scope $role $count $timeout" && return 0
  pc_planned "$scope" scale "$role" "" "count $count"
  rows="$(sb_call sb_scale "$scope" "$role" "$count" "$timeout")" || status=$?
  pc_table instance <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_die "$status" "scale of $role to $count failed"
  fi
}

## @description  Records a role-group transition as planned by writing one entry for each distinct
##               role in the backend response; rows without a role cover no instances.
## @return       Exits with 0.
pc_group_planned() {
  local scope=$1 action=$2 group=$3 schema=$4 rows=$5 column row role seen=""
  column="$(sb_schema_index "$schema" role)" || return 0
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    role="$(px_tsv_field "$column" "$row")" || continue
    case "$PX_NL$seen" in
    *"$PX_NL$role$PX_NL"*) continue ;;
    esac
    seen="$seen$role$PX_NL"
    sb_planned_record "$scope" "group_$action" "$role" "" "group $group" ||
      px_warn "the planned group_$action of $role is not recorded"
  done <<EOF
$rows
EOF
  if [ -z "$seen" ]; then
    px_warn "the group $action of $group named no role, so nothing is recorded" \
      "as planned"
  fi
}

# Starts, stops, or queries the state of a named role group, re-running the host memory check before
# starting a group.
## @description  Starts, stops, or reports the state of a single role group.
## @return       Exits 0, 1 if the action or memory check failed, 2 on usage or an unknown group, 3
##               if an instance terminated or the memory check refused the start, or 4 on a timeout.
pc_group() {
  local action=$1 group=$2 timeout scope rows schema status=0
  pc_require_name "group" "$group"
  timeout="$(pc_timeout PX_TIMEOUT_GROUP "$PC_TIMEOUT")" || exit $?
  scope="$(sb_scope_require)" || exit $?
  if [ "$action" = status ]; then
    rows="$(sb_call sb_group_status "$scope" "$group")" || status=$?
    pc_table group <<EOF
$rows
EOF
    exit "$status"
  fi
  px_plan group "sb_group_$action" "$scope" "$group" "$timeout" && return 0
  schema=stopped
  if [ "$action" = start ]; then
    schema=ready
    px_memory_recheck ||
      px_die "$?" "the memory check refused the start of group $group"
  fi
  rows="$(sb_call "sb_group_$action" "$scope" "$group" "$timeout")" || status=$?
  pc_group_planned "$scope" "$action" "$group" "$schema" "$rows"
  pc_table "$schema" <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_die "$status" "group $action of $group failed"
  fi
}

## @description  Terminates a single instance abruptly to inject a fault at a test milestone.
## @return       Exits 0, 1 if termination failed, 2 on usage or an unknown mode, or 6 if no such
##               instance exists.
pc_kill() {
  local mode=$PC_MODE role=$1 index=$2 scope status=0
  pc_require_instance "$role" "$index"
  if ! sb_valid_value kill_mode "$mode"; then
    px_die "$PX_EXIT_USAGE" \
      "unknown kill mode '$mode', one of: $(sb_vocabulary kill_mode)"
  fi
  scope="$(sb_scope_require)" || exit $?
  px_plan kill sb_kill "$scope" "$role" "$index" "$mode" && return 0
  pc_planned "$scope" kill "$role" "$index" "mode $mode"
  sb_call sb_kill "$scope" "$role" "$index" "$mode" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "kill of $role/$index failed"
  fi
}

## @description  Delivers a named signal to a single instance, such as QUIT for a JVM thread dump.
## @return       Exits 0, 1 if delivery failed, 2 on usage, 5 if the backend does not support signal
##               delivery, or 6 if no such instance exists.
pc_signal() {
  local role index signal scope detail status=0
  pc_opts signal "" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -eq 3 ] || pc_sub_usage_error signal "name a role, an index and a signal"
  role=$1 index=$2 signal=$3
  pc_require_instance "$role" "$index"
  pc_require_name "signal name" "$signal"
  scope="$(sb_scope_require "" "in PX_SCOPE_ID")" || exit $?
  if ! sb_supports sb_signal; then
    detail="$(sb_capability_detail signal_delivery)" || detail=""
    px_die "$PX_EXIT_UNSUPPORTED" \
      "this backend delivers no signal: $detail"
  fi
  pc_plan "sb_signal $scope $role $index $signal" && return 0
  pc_planned "$scope" signal "$role" "$index" "signal $signal"
  sb_call sb_signal "$scope" "$role" "$index" "$signal" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "signal $signal to $role/$index failed"
  fi
}

# Drains hosted regions, restarts the instance, waits for readiness, and rebalances; exits 5 when
# the backend has no drain-aware restart, or 6 when no such instance exists.
## @description  Drains, restarts, waits for readiness on, and rebalances a single instance.
## @return       Exits 0 if no phase fails, 1 if a phase fails, 2 on usage or no drain semantics,
##               4 if a phase times out, 5 if drain-aware restart is unsupported, or 6 if absent.
pc_restart() {
  local drain="" ready="" role index scope rows detail status=0
  pc_opts restart "--drain-timeout=drain --ready-timeout=ready" "$@"
  set -- ${PC_ARGS[@]+"${PC_ARGS[@]}"}
  [ $# -eq 2 ] || pc_sub_usage_error restart "name a role and an index"
  role=$1 index=$2
  pc_require_instance "$role" "$index"
  drain="$(pc_timeout PX_TIMEOUT_DRAIN "$drain")" || exit $?
  ready="$(pc_timeout PX_TIMEOUT_READY "$ready")" || exit $?
  scope="$(sb_scope_require "" "in PX_SCOPE_ID")" || exit $?
  if ! sb_supports sb_restart_drain; then
    detail="$(sb_capability_detail drain_restart)" || detail=""
    px_die "$PX_EXIT_UNSUPPORTED" \
      "this backend has no drain-aware restart: $detail"
  fi
  pc_plan "sb_restart_drain $scope $role $index $drain $ready" && return 0
  pc_planned "$scope" restart "$role" "$index" "drain ${drain}s"
  rows="$(sb_call sb_restart_drain "$scope" "$role" "$index" "$drain" \
    "$ready")" || status=$?
  pc_table phase <<EOF
$rows
EOF
  if [ "$status" != 0 ]; then
    px_die "$status" "restart of $role/$index did not complete"
  fi
}

# Dry-run mode emits a plan row for endpoint resolution as well as endpoint release, because a
# backend may establish a live port-forwarding tunnel to satisfy the query.
## @description  Reports the host address of a named port or releases one held by a long session.
## @return       Writes a host-and-port row; exits 0, 1 if no address is established, 2 on usage, 5
##               if the backend does not support release, or 6 on an unknown port name or instance.
pc_endpoint() {
  local role=$1 index=$2 port=$3 scope row status=0
  pc_require_instance "$role" "$index"
  pc_require_name "port name" "$port"
  scope="$(sb_scope_require)" || exit $?
  if [ "$PC_RELEASE" = 1 ]; then
    px_plan release sb_endpoint_release "$scope" "$role" "$index" "$port" && return 0
    if ! sb_supports sb_endpoint_release; then
      px_die "$PX_EXIT_UNSUPPORTED" \
        "this backend releases no endpoint: its address is part of the" \
        "deployment and needs no release"
    fi
    sb_call sb_endpoint_release "$scope" "$role" "$index" "$port" || status=$?
    exit "$status"
  fi
  px_plan endpoint sb_endpoint "$scope" "$role" "$index" "$port" && return 0
  row="$(sb_call sb_endpoint "$scope" "$role" "$index" "$port")" || status=$?
  if [ "$status" != 0 ]; then
    px_die "$status" "no address for $role/$index port $port"
  fi
  printf '%s\n' "$row"
}

## @description  Reports the substrate contract revision supported by the harness, the bound
##               backend, and the version strings reported by the backend's runtime tooling.
## @return       Writes a table to stdout and exits 0, or 1 if the backend cannot reach its tooling.
pc_version() {
  local rows row status=0
  [ $# -eq 0 ] || pc_sub_usage_error version "unexpected argument: $*"
  rows=""
  row="$(px_tsv_row harness_contract "$PX_CONTRACT_VERSION")"
  rows="$rows$row$PX_NL"
  row="$(px_tsv_row backend "$(sb_call sb_backend_id)")"
  rows="$rows$row$PX_NL"
  row="$(px_tsv_row backend_contract "$(sb_call sb_contract_version)")"
  rows="$rows$row$PX_NL"
  row="$(sb_call sb_version_info)" || status=$?
  rows="$rows$row$PX_NL"
  pc_table kv <<EOF
$rows
EOF
  exit "$status"
}

## @description  Applies fallback configuration defaults after the loader runs and rejects any
##               cluster name that backend scopes, runtime labels, or state record files cannot use.
## @return       Exits with 0, or exits with 2 on an invalid cluster name.
pc_config_init() {
  if [ -z "${PX_CLUSTER_ID:-}" ]; then
    px_config_set PX_CLUSTER_ID default derived
  fi
  if ! [[ ${PX_CLUSTER_ID} =~ $SB_CLUSTER_RE ]]; then
    px_die "$PX_EXIT_USAGE" \
      "invalid cluster name '$PX_CLUSTER_ID': lower case letters, digits," \
      "underscore and hyphen, starting with a letter or a digit"
  fi
  if [ -z "${PX_BACKEND:-}" ]; then
    px_config_set PX_BACKEND compose derived
  fi
}

# Keeps the current matrix version set flagged as active until its teardown completes so that the
# exit hook retries any teardown interrupted by a signal or an earlier failure.
## @description  Tears down the cluster belonging to the currently active matrix version set.
## @return       Returns the px-cluster down exit status: 0, or 1 when leftover resources remain.
pc_matrix_down() {
  px_config_child "$SELF/px-cluster" ${PC_MATRIX_FILES[@]+"${PC_MATRIX_FILES[@]}"} down >&2 ||
    return $?
  PC_MATRIX_UP=0
}

## @description  Tears down the cluster of the active matrix version set when matrix execution
##               terminates early due to a failure or a signal.
## @return       Exits with 0, emitting a warning if teardown fails.
pc_matrix_abandon() {
  [ "$PC_MATRIX_UP" = 1 ] || return 0
  px_warn "the matrix ends with the cluster of a set up, so it comes down"
  pc_matrix_down || px_warn "the down of the set failed: run px-cluster down"
}

# Each version set takes the recorded session severity when its suite executed, defaults to ERROR if
# execution halted during the build or cluster bring-up, and is promoted to at least FAIL if cluster
# teardown failed. The trailing summary row reports the worst severity across all version sets.
## @description  Executes a suite (suite, file...) across each version set: build, up, run, down.
## @return       Writes one row per set and a result row; exits 0, or with the exit code of the
##               first failed set, 2 on usage, or 6 if a version set file is missing.
pc_matrix() {
  local suite=${1:-} file line dir record n=0 first=0 status down step session dump rows
  local worst=PASS severity
  local files=() class=()
  shift
  for file in "$@"; do
    [ -f "$file" ] || px_die "$PX_EXIT_NO_OBJECT" "no such version set file: $file"
  done
  if [ -n "${PX_RUN_CLASS:-}" ]; then
    class=(--class "$PX_RUN_CLASS")
  fi
  if px_is_dry_run; then
    for file in "$@"; do
      files=(--config "$file")
      for line in ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; do
        files+=(--config "$line")
      done
      px_plan build px-cluster build "${files[@]}"
      px_plan up px-cluster up "${files[@]}"
      px_plan run px-suite "${files[@]}" ${class[@]+"${class[@]}"} "$suite"
      px_plan down px-cluster down "${files[@]}"
    done
    return 0
  fi
  dir="$(px_run_dir matrix)" || exit $?
  record="$dir/matrix.tsv"
  : >"$record" || px_die "$PX_EXIT_FAIL" "cannot write $record"
  for file in "$@"; do
    n=$((n + 1))
    file="$(px_realpath "$file")"
    files=(--config "$file")
    for line in ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; do
      files+=(--config "$line")
    done
    session="${dir##*/}-$n"
    status=0
    px_info "version set $n: $file"
    severity=ERROR
    step=build
    px_config_child "$SELF/px-cluster" "${files[@]}" build >&2 || status=$?
    if [ "$status" = 0 ]; then
      step=up
      # Because this parent shell processes a signal only after the child up command exits, mark the
      # version set as active before launching bring-up; if bring-up never recorded a scope, down
      # exits cleanly with 0.
      PC_MATRIX_FILES=("${files[@]}")
      PC_MATRIX_UP=1
      px_config_child "$SELF/px-cluster" "${files[@]}" up >&2 || status=$?
      [ "$status" = 0 ] || PC_MATRIX_UP=0
    fi
    if [ "$status" = 0 ]; then
      step=run
      PX_SESSION_ID=$session px_config_child "$SELF/px-suite" "${files[@]}" \
        ${class[@]+"${class[@]}"} "$suite" >&2 || status=$?
      severity="$(px_tsv_get severity "$(cat "$(px_out_root)/sessions/$session/summary.tsv" \
        2>/dev/null)" || true)"
      severity=${severity:-ERROR}
      # Always tear the cluster down after its version set completes, even when the test suite
      # fails.
      down=0
      pc_matrix_down || down=$?
      [ "$down" = 0 ] || severity="$(sx_severity_worse "$severity" FAIL)"
      if [ "$status" = 0 ]; then
        step=down
        status=$down
      fi
    fi
    worst="$(sx_severity_worse "$worst" "$severity")"
    case "$step" in
    run | down) ;;
    *) session="" ;;
    esac
    dump="$(px_config_child "$SELF/px-cluster" "${files[@]}" config)" || dump=""
    rows="$(px_versions_rows "$dump")"
    px_tsv_row "$n" "$file" "$(px_tsv_get hbase_profile "$rows")" \
      "$(px_tsv_get hbase_version "$rows")" "$(px_tsv_get hadoop_version "$rows")" \
      "$(px_tsv_get jdks "$rows")" "$session" "$step" "$status" | tee -a "$record"
    [ "$first" != 0 ] || first=$status
  done
  px_info "matrix record $record"
  exit "$first"
}

## @description  Parses global command-line options, loads the layered configuration, and dispatches
##               the requested subcommand.
## @return       Exits with the status of the subcommand, or exits with 2 on a usage error.
pc_main() {
  local sub arg strict="" files=() sets=()
  while [ $# -gt 0 ]; do
    px_cli_common "$1" || case "$1" in
    --keep) sets+=("PX_KEEP=1") ;;
    --strict)
      strict="--strict"
      sets+=("PX_STRICT_CONFIG=1")
      ;;
    --backend)
      px_cli_need_value "$@"
      sets+=("PX_BACKEND=$2")
      shift
      ;;
    --cluster)
      px_cli_need_value "$@"
      sets+=("PX_CLUSTER_ID=$2")
      shift
      ;;
    --class)
      px_cli_need_value "$@"
      sets+=("PX_RUN_CLASS=$2")
      shift
      ;;
    --config)
      px_cli_need_value "$@"
      files+=("$2")
      PC_FILES+=("$2")
      shift
      ;;
    -e | --set)
      px_cli_need_value "$@"
      sets+=("$2")
      shift
      ;;
    --) shift; break ;;
    -*) px_usage_error "unknown global option $1" ;;
    *) break ;;
    esac
    shift
  done
  if [ $# -eq 0 ]; then
    px_error "name a subcommand"
    usage >&2
    exit "$PX_EXIT_USAGE"
  fi
  sub=$1
  shift
  if ! pc_is_subcommand "$sub"; then
    px_error "unknown subcommand '$sub'"
    usage >&2
    exit "$PX_EXIT_USAGE"
  fi
  # Handle subcommand --help requests before invoking the configuration loader. Stop scanning at
  # the first -- delimiter so a --help flag passed to an exec payload is forwarded to the remote
  # command rather than intercepted as a request for subcommand usage text.
  for arg in "$@"; do
    case "$arg" in
    --) break ;;
    -h | --help)
      pc_sub_usage "$sub"
      return 0
      ;;
    esac
  done
  # Command-line overrides hold the highest precedence stage and are applied before the file loader
  # runs. Under strict mode, undeclared variable names are rejected here as well because the loader
  # does not inspect variables that were already set before its execution.
  px_config_set_cli ${strict:+"$strict"} -- ${sets[@]+"${sets[@]}"}
  px_config_load ${strict:+"$strict"} ${files[@]+"${files[@]}"}
  pc_config_init
  # Every subcommand that operates on a live cluster binds the substrate backend here. The render,
  # config, and validate subcommands bind no backend, as verified by an empty runtime invocation
  # log, and matrix binds none either because each of its steps runs as a child process that binds
  # its own backend.
  case "$sub" in
  render | config | validate | matrix) ;;
  *) sb_load ;;
  esac
  case "$sub" in
  render)
    pc_render_guard "$@"
    pc_render "$@" || exit $?
    ;;
  up) pc_up "$@" ;;
  down) pc_down "$@" ;;
  status) pc_status "$@" ;;
  ready) pc_ready "$@" ;;
  config) pc_config "$@" ;;
  validate) pc_validate "$@" ;;
  logs) pc_logs "$@" ;;
  exec) pc_exec "$@" ;;
  cp-in) pc_cp in "$@" ;;
  cp-out) pc_cp out "$@" ;;
  scale) pc_scale "$@" ;;
  group) pc_group "$@" ;;
  kill) pc_kill "$@" ;;
  signal) pc_signal "$@" ;;
  restart) pc_restart "$@" ;;
  endpoint) pc_endpoint "$@" ;;
  version) pc_version "$@" ;;
  matrix) pc_matrix "$@" ;;
  esac
}

# Subcommands terminate the process directly whenever they report an expected domain exit status,
# such as exit code 4 on an expired readiness wait. Keeping set -e and failure handling active
# across the entire execution ensures that any non-zero status reaching this top-level call
# represents an unhandled fault whose origin will be reported by the failure trap. Interrupt and
# termination signals are converted into normal process exits so that the registered exit hooks
# can tear down an in-progress cluster bring-up or the cluster of an active matrix version set and
# remove the temporary scratch render produced by a dry run.
px_on_exit pc_up_abandon
px_on_exit pc_matrix_abandon
px_on_exit pc_plan_clean
trap 'exit 130' INT
trap 'exit 143' TERM
pc_main "$@"

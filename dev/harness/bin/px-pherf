# Operator-facing front end for the Distributed Pherf tier, comprising a single controller and its
# load-generation agents. It starts, stops, and inspects the tier, and executes test suites against
# it.
#
# Three architectural rules govern this script:
#   1. Every cluster state change executes as a px-cluster child process inheriting this command's
#      global options, ensuring that the memory check, planned-action record, and readiness barrier
#      of px-cluster apply uniformly. This command reads only the cluster scope, the role group
#      state, and the controller's REST API.
#   2. Every controller REST API call made by this script is routed through lib/fleet.sh: on
#      Compose it executes inside pherf-controller 0, whereas on Kubernetes it connects through the
#      loopback tunnel that sb_endpoint opens to the controller pod. During a run, the driver
#      invokes the controller from inside that pod across both backends. No code in this script
#      ever reads a host-published deployment port.
#   3. Each command tears down only the resources that it provisioned. A failed start stops
#      whatever resources it initiated, whereas a successful start that provisions a cluster leaves
#      that cluster running until px-cluster down is invoked. The run subcommand validates the
#      suite execution plan before provisioning any resources; when the suite concludes—whether by
#      passing, failing, or receiving a signal—it tears down only what it started: the entire
#      cluster, or the tier alone if the cluster was already running. Passing --keep preserves both.
#
# The tier supports two targets, selected by PX_PHERF_TARGET during deployment rendering:
#   harness   The tier is rendered with PX_PHERF=1 as the on-demand pherf role group of the harness
#             deployment. The start subcommand starts the group, stop stops it, and cluster teardown
#             removes it.
#   external  The deployment contains the tier alone, targeting the ZooKeeper quorum defined in
#             PX_PHERF_ZOOKEEPER. The start subcommand provisions the deployment when no cluster is
#             recorded, and stop tears it down.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/backend/contract.sh
. "$SELF/../lib/backend/contract.sh"
# shellcheck source=SCRIPTDIR/../lib/fleet.sh
. "$SELF/../lib/fleet.sh"

set -euo pipefail

# Accumulates the options forwarded to px-suite by the run subcommand, consisting of this command's
# shared options (excluding the -n dry-run flag) along with --keep.
PP_SUITE=()
# Tracks the resources provisioned by this process: "up" when it provisioned the cluster, or "tier"
# when it started the tier on an already running cluster. Both a failed start and run completion
# tear down only the recorded resource tier.
PP_STARTED=""
# Test selection options for the run subcommand, which are forwarded to px-suite.
PP_ONLY=""
PP_SKIP=""
PP_FROM=""
PP_TO=""
PP_CONTINUE=0

px_cli_spec <<'EOF'
about Starts, stops and reports the Distributed Pherf tier, one controller and its
+ agents, and runs a suite against it.
about Each change of the cluster runs as a px-cluster child with the shared options of
+ this command.
about On --backend k8s an agent id is the name of its pod. Each call that px-pherf
+ itself makes to the controller goes through a port-forward tunnel bound to
+ 127.0.0.1; the driver of a run calls the controller from inside its pod.
shared --cluster --class --backend
opt --keep - PX_KEEP=1 | keep the tier and the cluster after a failure or a
+ run
sub start
about start the tier and wait until each agent is IDLE
about With no cluster recorded, start brings the cluster up with the tier
+ (PX_PHERF=1) and leaves it up; px-cluster down removes it. The external target
+ brings its deployment up in the same way.
sub stop
about stop the group pherf, or take an external deployment
+ down
sub status
about report the group row and the agents: id, state and
+ incarnation
sub scale COUNT
about set the agent count to COUNT (1 to 9) with
+ px-cluster scale, then wait until each agent is IDLE
sub run SUITE
about check the plan, bring the cluster up with the tier,
+ start the tier, and run the suite
about run checks the plan with px-suite --dry-run, brings the cluster up with
+ PX_PHERF=1 when no cluster is recorded, starts the tier, then runs px-suite
+ SUITE with the selection options. run tears down what it brought up: the
+ cluster, or the tier when the cluster was up already, unless --keep.
opt --only IDS PP_ONLY | run exactly these tests, comma separated
opt --skip IDS PP_SKIP | do not run these tests, comma separated
opt --from ID PP_FROM | the first test of the ordered plan, inclusive
opt --to ID PP_TO | the last test of the ordered plan, inclusive
opt --continue-on-failure - PP_CONTINUE=1 | record a failure and continue, then report the
+ worst severity of the session
output the agent rows of start, scale and status, or the result rows of
+ px-suite.
exits 3 also means that the tier does not run or an instance terminated, 6 no
+ such cluster or a cluster without the tier. run exits with the status of
+ px-suite.
example px-pherf run smoke --class validation --only r1
EOF

## @description  Executes px-cluster with this command's shared options (argument...), redirecting
##               stdout to stderr.
## @return       Exits with 0, or returns the px-cluster exit code (1, 2, 3, 4, 5, or 6).
pp_cluster() {
  px_config_child "$PX_HOME/bin/px-cluster" "$@" ${PX_CLI_SHARED[@]+"${PX_CLI_SHARED[@]}"} >&2
}

## @description  Resolves and prints the recorded scope identifier of the active cluster.
## @return       Writes the scope ID to stdout and exits 0, 6 when none is recorded, or 2 or 1.
pp_scope() { sb_scope_resolve 2>/dev/null; }

## @description  Emits the recorded scope identifier for the active cluster, or aborts if absent.
## @return       Writes the scope ID to stdout and exits 0, or exits 6 if no scope is recorded.
pp_scope_or_die() {
  pp_scope || px_die "$PX_EXIT_NO_OBJECT" "no cluster ${PX_CLUSTER_ID:-default} is recorded:" \
    "$PX_HINT_NO_CLUSTER"
}

## @description  Verifies that the active cluster's recorded deployment includes the Pherf tier.
## @return       Exits with 0 when the tier is present, or 6 when the deployment lacks the tier.
pp_tier_require() {
  if [ "$(pp_topology PX_PHERF)" != 1 ]; then
    px_die "$PX_EXIT_NO_OBJECT" "cluster ${PX_CLUSTER_ID:-default} was rendered without the" \
      "tier: run px-cluster down, then px-pherf start"
  fi
}

## @description  Reads a single configuration value (name) from the recorded deployment's topology
##               record.
## @return       Writes the value to stdout (or an empty string when absent) and exits with 0.
pp_topology() {
  local file dir=""
  file="$(sb_deployment_record)" || return 0
  [ ! -f "$file" ] || IFS= read -r dir <"$file" || true
  pb_env_value "$1" "$dir/topology.env"
}

# On Kubernetes, client commands access the controller REST API exclusively through a loopback
# tunnel to the controller pod opened on 127.0.0.1 by the backend endpoint call; the Compose
# backend requires no tunnel.
## @description  Resolves the local REST tunnel port for a scope (scope) into PF_API_PORT.
## @return       Exits 0, or exits 3 if no loopback tunnel opens to pherf-controller 0's REST port.
pp_api() {
  local row
  [ "$(sb_backend_id)" = k8s ] || return 0
  if ! row="$(sb_endpoint "$1" pherf-controller 0 rest </dev/null)"; then
    px_error "no loopback tunnel reaches the REST port of pherf-controller 0"
    return "$PX_EXIT_ANOMALY"
  fi
  IFS="$PX_TAB" read -r _ PF_API_PORT _ <<<"$row"
}

# Invoked both directly and via the process exit hook so that any failure, early exit, or INT or
# TERM signal releases the resources provisioned by start or run: the entire cluster, or the tier
# alone if the cluster was already running. Stopping the role group also closes the REST tunnel.
## @description  Tears down the cluster or tier provisioned by this process unless --keep is set.
## @return       Exits with 0, or returns the px-cluster exit status if the release fails.
pp_release() {
  local started=$PP_STARTED scope status=0
  PP_STARTED=""
  [ -n "$started" ] || return 0
  if px_is_keep; then
    px_info "what $PX_CLI_SUB brought up stays for a diagnosis: run px-pherf stop or" \
      "px-cluster down"
    return 0
  fi
  if [ "$started" = up ]; then
    px_info "$PX_CLI_SUB ends, so the cluster that it brought up comes down"
    pp_cluster down || status=$?
    [ "$status" = 0 ] || px_warn "the teardown failed: run px-cluster down"
    return "$status"
  fi
  px_info "$PX_CLI_SUB ends, so the tier that it started stops"
  pp_cluster group stop pherf || status=$?
  [ "$status" = 0 ] || px_warn "the group pherf did not stop: run px-pherf stop"
  if scope="$(pp_scope)"; then
    sb_endpoint_release "$scope" pherf-controller 0 rest || px_warn "the REST tunnel stays"
  fi
  return "$status"
}

# Provisions the cluster with the tier enabled when no cluster is currently recorded, starts the
# pherf role group, and waits until every rendered agent reports the IDLE state. PP_STARTED records
# the provisioned resource tier prior to each child invocation because signals are delivered to
# this shell only after the child exits and px-cluster down exits 0 when nothing is recorded. If
# startup fails, the exit hook releases whatever resources were started.
## @description  Provisions or starts the tier and waits for all rendered agents to reach IDLE.
## @return       Writes the agent rows to stdout and exits 0, 6 if the tier is absent, or 1, 3, or
##               4 on failure, anomaly, or timeout.
pp_tier_up() {
  local scope count ready rows status=0
  ready="$(px_int_setting PX_TIMEOUT_READY 600 1)"
  if px_is_dry_run; then
    pp_scope >/dev/null || px_plan up px-cluster up -e PX_PHERF=1
    px_plan start px-cluster group start pherf
    px_plan wait GET /v1/agents
    return 0
  fi
  if ! scope="$(pp_scope)"; then
    PP_STARTED=up
    pp_cluster -e PX_PHERF=1 up || px_die "$?" "the cluster did not come up with the tier"
    scope="$(pp_scope)" || px_die "$PX_EXIT_FAIL" "the bring-up recorded no scope"
  elif pp_tier_down "$scope"; then
    PP_STARTED=tier
  fi
  pp_tier_require
  count="$(pp_topology PX_PHERF_AGENT_COUNT)"
  pp_cluster group start pherf || status=$?
  [ "$status" != 0 ] || pp_api "$scope" || status=$?
  if [ "$status" = 0 ]; then
    rows="$(pf_agents_wait "$scope" "$count" "$ready")" || status=$?
  fi
  [ "$status" = 0 ] || px_die "$status" "the tier did not start"
  px_info "the tier runs: one controller and $count IDLE agents"
  printf '%s\n' "$rows"
}

# Clears PP_STARTED upon completion so that any cluster or tier provisioned by start remains
# running after a successful startup.
## @description  Starts the Distributed Pherf tier and waits for all rendered agents to reach IDLE.
## @return       Writes the agent rows to stdout and exits 0, 6 if the tier is absent, or 1, 3, or
##               4 on failure, anomaly, or timeout.
pp_start() {
  pp_tier_up
  PP_STARTED=""
}

# Stopping the role group also releases the REST API loopback tunnel (which the Compose backend
# never opens), whereas tearing down an external deployment releases all tunnels for the scope.
## @description  Stops the Distributed Pherf tier by stopping the pherf role group or tearing down
##               an external deployment as a whole.
## @return       Exits 0, 6 when no scope is recorded, or with the px-cluster code (1, 2, 3, 4, 5).
pp_stop() {
  local scope status=0
  scope="$(pp_scope_or_die)" || exit "$?"
  if [ "$(pp_topology PX_PHERF_TARGET)" = external ]; then
    px_plan stop px-cluster down && return 0
    pp_cluster down
    return
  fi
  px_plan stop px-cluster group stop pherf && return 0
  pp_cluster group stop pherf || status=$?
  sb_endpoint_release "$scope" pherf-controller 0 rest || px_warn "the REST tunnel stays"
  return "$status"
}

# Scaling re-renders the deployment via px-cluster scale—which executes the memory check and
# records the planned action—before waiting until the new target count of agents reaches IDLE.
# Re-rendering draws its configuration from the stored cluster record, which preserves PX_PHERF and
# the run class established during cluster bring-up.
## @description  Scales the tier to the requested agent count (count, 1 to 9) and waits for them.
## @return       Writes agent rows to stdout and exits 0, 2 on usage, 6 if no scope is recorded or
##               the cluster lacks the tier, or 1, 3, or 4 on failure, anomaly, or timeout.
pp_scale() {
  local count=${1:-} scope ready rows status=0
  [[ $count =~ ^[1-9]$ ]] ||
    px_die "$PX_EXIT_USAGE" "scale needs an agent count of 1 to 9, got '$count'"
  scope="$(pp_scope_or_die)" || exit "$?"
  pp_tier_require
  ready="$(px_int_setting PX_TIMEOUT_READY 600 1)"
  if px_is_dry_run; then
    px_plan scale px-cluster scale pherf-agent "$count"
    px_plan wait GET /v1/agents
    return 0
  fi
  pp_cluster scale pherf-agent "$count" || px_die "$?" \
    "the scale of the agents to $count failed"
  pp_api "$scope" || px_die "$?" "the tier gives no REST path after the scale"
  rows="$(pf_agents_wait "$scope" "$count" "$ready")" || status=$?
  [ "$status" = 0 ] || px_die "$status" "the $count agents are not IDLE after the scale"
  px_info "the tier runs: one controller and $count IDLE agents"
  printf '%s\n' "$rows"
}

## @description  Reports the state row of the pherf role group followed by the active agent rows.
## @return       Writes the rows to stdout and exits 0, 6 if no scope is recorded, 1 or 2 if group
##               state is unavailable, 3 if the controller does not respond, or 4 on timeout.
pp_status() {
  local scope row
  scope="$(pp_scope_or_die)" || exit "$?"
  row="$(sb_group_status "$scope" pherf)" || px_die "$?" "the group pherf has no state"
  printf '%s\n' "$row"
  case "$row" in
  *"${PX_TAB}down") return 0 ;;
  esac
  pp_api "$scope" || px_die "$?" "the tier gives no REST path"
  pf_agents_wait "$scope" 0 0
}

## @description  Checks whether the pherf role group in the given scope (scope) is currently down.
## @return       Exits 0 when the role group is down, or returns 1 otherwise.
pp_tier_down() {
  local row
  row="$(sb_group_status "$1" pherf 2>/dev/null)" || return 1
  case "$row" in
  *"${PX_TAB}down") return 0 ;;
  esac
  return 1
}

# Because a px-suite dry run makes no backend calls, validating the plan first ensures that any
# invalid suite file or command-line option aborts execution before any resources are provisioned.
## @description  Executes a test suite (suite) against the tier and tears down what it provisioned.
## @return       Exits 0, or returns the px-suite status (1, 2, 3, or 6), a failed startup step
##               status, or the teardown status if releasing resources fails after a passing suite.
pp_run() {
  local suite=$1 scope status=0 release=0
  local -a words=()
  [ -z "$PP_ONLY" ] || words+=(--only "$PP_ONLY")
  [ -z "$PP_SKIP" ] || words+=(--skip "$PP_SKIP")
  [ -z "$PP_FROM" ] || words+=(--from "$PP_FROM")
  [ -z "$PP_TO" ] || words+=(--to "$PP_TO")
  [ "$PP_CONTINUE" = 0 ] || words+=(--continue-on-failure)
  if px_is_dry_run; then
    px_plan check px-suite ${PP_SUITE[@]+"${PP_SUITE[@]}"} --dry-run ${words[@]+"${words[@]}"} \
      "$suite"
    pp_tier_up
    px_plan suite px-suite ${PP_SUITE[@]+"${PP_SUITE[@]}"} ${words[@]+"${words[@]}"} "$suite"
    if px_is_keep; then
      :
    elif ! scope="$(pp_scope)"; then
      px_plan down px-cluster down
    elif pp_tier_down "$scope"; then
      px_plan stop px-cluster group stop pherf
    fi
    return 0
  fi
  px_config_child "$PX_HOME/bin/px-suite" ${PP_SUITE[@]+"${PP_SUITE[@]}"} --dry-run \
    ${words[@]+"${words[@]}"} "$suite" >/dev/null ||
    px_die "$?" "px-suite refuses the suite $suite, so no cluster starts"
  pp_tier_up >/dev/null
  px_config_child "$PX_HOME/bin/px-suite" ${PP_SUITE[@]+"${PP_SUITE[@]}"} \
    ${words[@]+"${words[@]}"} "$suite" || status=$?
  pp_release || release=$?
  [ "$status" != 0 ] || status=$release
  return "$status"
}

px_cli_parse "$@"
# Exclude -n from PP_SUITE so that the suite plan row emitted during a dry run reflects the exact
# argument vector of a live execution.
for word in ${PX_CLI_SHARED[@]+"${PX_CLI_SHARED[@]}"}; do
  case "$word" in
  -n | --dry-run) ;;
  *) PP_SUITE+=("$word") ;;
  esac
done
! px_is_keep || PP_SUITE+=(--keep)
px_config_load -- ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}
sb_load
# Convert INT and TERM signals into normal process exits so that the registered exit hook tears
# down any resources provisioned by start or run.
px_on_exit pp_release
trap 'exit 130' INT
trap 'exit 143' TERM
"pp_$PX_CLI_SUB" ${PX_CLI_ARGS[@]+"${PX_CLI_ARGS[@]}"}

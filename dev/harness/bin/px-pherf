# Front end for deploying the Pherf controller and its load-generation agents across either
# substrate backend. Because round H3 implements the runtime behavior and its command-line options,
# this entry point responds to --help and rejects every other invocation with the unsupported exit
# code.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail

## @description  Prints the command-line usage summary and supported options.
## @return       Writes the help text to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-pherf [-h|--help]

Brings up the Pherf controller and its agents on either backend.
Round H3 implements it.

Exit codes: 0 help, 2 usage, 5 unsupported until round H3.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
-*) px_usage_error "unknown option: $1" ;;
esac
px_die "$PX_EXIT_UNSUPPORTED" "px-pherf arrives with round H3"

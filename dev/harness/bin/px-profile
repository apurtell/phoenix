# This script provides the front end for the sampling profiler. The shared telemetry library in
# lib/telemetry.sh defines the command surface, target resolution logic, and artifact naming
# conventions, while round A6 attaches the profiler to the target roles and stages the captured
# recordings alongside the run artifacts.
#
# The front end intentionally omits a sampling-interval option. The system design fixes the
# execution timer at a cadence of 7,919 microseconds with no skipped samples, and round A6
# configures both parameters. Exposing an interval option here would allow a run to produce
# measurements that cannot be compared against any other run.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/telemetry.sh
. "$SELF/../lib/telemetry.sh"

set -euo pipefail
px_trap_enable

TM_KIND=profiles TM_INDEX_TOOL=profile TM_TOOL=asprof
TM_STAGED=async-profiler/bin/asprof TM_TEST=-x TM_PATH_FALLBACK=1
TM_LIST_CMD=events TM_OPT=--event TM_LIST="cpu alloc lock wall itimer" TM_DEFAULT=itimer
TM_FORMATS="html collapsed jfr" TM_EXT=html
TM_ENV_TARGETS=PX_PROFILE_TARGETS TM_ENV_DURATION=PX_PROFILE_DURATION_S
TM_SKIP="asprof is not staged under PX_TOOLKIT_DIR and not on PATH"
TM_WARN="asprof is absent, every profiling target is skipped"
TM_A6="round A6 attaches the profiler. px-profile plan reports the targets"

## @description  Assigns TM_EXT to the file extension corresponding to a given output format.
## @return       Sets TM_EXT and exits 0.
tm_extension() {
  case "$1" in
  collapsed) TM_EXT=txt ;;
  *) TM_EXT=$1 ;;
  esac
}

## @description  Prints the command-line usage and supported options for the profiler front end.
## @return       Writes the usage text to stdout and exits 0.
usage() {
  cat <<'EOF'
Usage: px-profile [plan|record|events] [option...]

Subcommands:
  plan       report what record would do, write nothing. The default
  record     take the recordings [A6 attaches the profiler]
  events     print the events this front end accepts

Options:
  --target ROLE[/INDEX]  a profiling target, repeatable, default
                         PX_PROFILE_TARGETS. An index defaults to 0
  --event NAME           cpu, alloc, lock, wall or itimer, default itimer
  --format NAME          html, collapsed or jfr, default html
  --duration S           seconds to record, default PX_PROFILE_DURATION_S
  --out DIR              the output directory, default the run directory
  --config FILE          an extra configuration file, repeatable
  -v, --verbose          report detail
  -h, --help             show this text

Exit codes: 0 ok or skipped, 1 failure, 2 usage, 5 a behaviour a later round
owns, 6 no such object.
EOF
}

tm_main "$@"

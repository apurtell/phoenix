# Front end for orchestrating async-profiler sampling sessions against selected cluster roles and
# staging the captured outputs alongside the run artifacts. Because round A6 implements the
# profiling workflow and its command-line options, this entry point responds to --help and rejects
# every other invocation with the unsupported exit code.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail

## @description  Prints the command-line usage and supported options for the profiler front end.
## @return       Writes the usage text to stdout and exits 0.
usage() {
  cat <<'EOF'
Usage: px-profile [-h|--help]

Takes sampling profiler sessions against selected roles.
Round A6 implements it.

Exit codes: 0 help, 2 usage, 5 unsupported until round A6.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
-*) px_usage_error "unknown option: $1" ;;
esac
px_die "$PX_EXIT_UNSUPPORTED" "px-profile arrives with round A6"

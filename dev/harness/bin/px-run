# px-run executes a single test run. It owns a single bundle directory at $PX_OUT/runs/<run-id>
# and writes its own files exclusively within that bundle, while backend state and the
# planned-action record are stored in the state directory under PX_OUT.
#
# docs/driver-contract.md specifies the six driver verbs that px-run invokes, and
# docs/bundle-format.md specifies the diagnostic bundle that the run populates. Execution proceeds
# in the following order:
#   1. Invoke describe. A refused document stops the run with exit code 2, and each check that the
#      document declares unsupported receives a SKIP row.
#   2. Run validate, capture the pre-run snapshot, run the quiet-host check, perform the sizing
#      check for a measurement run, and run the fetch-data plug-in hook.
#   3. Run prepare, execute the pre-workload hook, start the collectors configured in
#      PX_COLLECTORS, execute run (which px-run monitors), stop the collectors, and run the
#      post-workload hook. Scheduled disruptions fire during the verbs, and px-run waits for each
#      one to recover.
#   4. Capture the post-run snapshot and compare it against the pre-run snapshot.
#   5. Run restore whenever prepare ran, run report whenever validate ran, execute the cluster
#      checks, and invoke the collect hook. After an anomaly abort, restore is never executed and
#      is recorded with a SKIP verdict.
#   6. Merge all verdict streams with px-report, and write and validate the bundle manifest with
#      px-bundle. The run leaves the cluster running because each command tears down only the
#      resources that it provisioned.
#
# A failing step blocks only the downstream steps that depend on it, so restore and report still
# execute and the bundle remains complete. px-run writes one verdict row per verb, and px-report
# computes the overall result. The exit code is the first non-zero code returned by a verb, except
# that an unplanned cluster change replaces 0 or 1 with the anomaly code 3 and a verb that exceeds
# its timeout bound yields 4. An instance is considered changed if its restart count rose, if a
# running instance exited or transitioned to unknown, or if the instance vanished. A change is
# unplanned when no planned action from this run covers the instance, showing that the failure
# originated in the cluster rather than the workload so that callers can distinguish the two.
#
# This cluster comparison also executes once per poll interval while prepare and run are executing.
# Detecting an unplanned change during execution aborts the run immediately: px-run stops the
# active verb, appends an abort row with the cause to the run record, and ends the run with exit
# code 3 regardless of the status returned by the verb, because running a workload against a broken
# cluster produces no valid measurement.
#
# Host safety: the usage text below describes the host safeguards enforced during a run, and the
# "Host safety" section of the README explains their design rationale.
#
# Because every cluster query and fault injection goes through the substrate contract, this script
# references no specific container runtime and executes unchanged across every supported backend.
#
# THE RECORD FILE. A real run writes run-record.tsv in its bundle as a single stream of TSV rows
# whose first column identifies the row type. See the "run-record.tsv" section of
# docs/bundle-format.md for the definition of every row type and its fields.
#
# A dry run neither creates a bundle nor invokes a backend. Instead, it runs describe to validate
# the driver document and writes "plan step detail" rows to stdout.

set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/backend/contract.sh
. "$SELF/../lib/backend/contract.sh"
# shellcheck source=SCRIPTDIR/../lib/bundle.sh
. "$SELF/../lib/bundle.sh"
# shellcheck source=SCRIPTDIR/../lib/plugin.sh
. "$SELF/../lib/plugin.sh"

px_trap_enable

px_cli_spec <<'EOF'
about Runs one test: one driver against the cluster, one result bundle.
about px-run calls the six verbs of the driver, snapshots the cluster before and after
+ the workload, injects the declared disruptions, runs the cluster checks, merges
+ the verdicts and writes the manifest of the bundle. DRIVER is a path, or a name
+ that resolves to <drivers>/NAME/driver.sh, else to the driver of the enabled
+ plug-in NAME. A real run needs the class validation or measurement, by default
+ the class of the cluster record.
about A disruption specification is WHEN,ACTION,ROLE,INDEX[,ARGUMENT]. WHEN is
+ +SECONDS after the run verb starts, or phase:NAME. ACTION is kill, signal or
+ restart; a kill names a regionserver. ARGUMENT is the kill mode (hard, the
+ default), the signal name, or empty for restart. A phase name is a point that
+ px-run announces: setup, snapshot_pre, driver_start (the run verb starts),
+ driver_exit (the run verb ends) and snapshot_post. It can also be a stage anchor
+ <kind>@<name>, such as steady@script or verb@prepare: the disruption fires when
+ a verb writes the begin row of that anchor. A specification that never fires is
+ recorded as skipped, and one whose anchor opened and closed before px-run saw it
+ as missed. A substrate function that the backend cannot serve exits 5, and the
+ disruption is then recorded as a skip instead of a failure. After each injection
+ px-run waits for recovery: a killed RegionServer starts again through the
+ drain-aware restart, then the whole scope must be ready and the online regions
+ back to their count before the disruption, within PX_TIMEOUT_READY and within
+ the bound of the verb that is running. The time to recovery is the mttr_seconds
+ of the disruption in the manifest. A signal STOP or TSTP pauses the daemon JVM,
+ and its recovery waits for the next signal CONT to that instance. When the run
+ verb ends with the instance still paused, px-run sends the CONT itself.
about Time verdicts are ADVISORY unless the run is of the measurement class on a quiet
+ host with the measurement sizing: a host that is busy or not checked, and a
+ sizing that is not the measurement table, tag the run contaminated.
about The collectors are profile, jfr, hiccup, host, container and trace, and
+ px-collect starts and stops them. PX_COLLECTORS is none or a comma list of them;
+ the measurement class starts all six and the validation class none, and the HDR
+ histograms of a driver stay on in both. px-run calls px-collect start after the
+ pre-workload hook and right before the run verb, and px-collect stop right after
+ it, also at a failure or an interrupt. Each call has one PX_TIMEOUT_VERB for
+ each step, and each collector ends by itself one verb bound after the deadline
+ of the run verb. Their files go into the bundle; a collector that fails gives
+ ADVISORY.
about The run holds the host awake while it runs and leaves the cluster up;
+ px-cluster down removes it.
shared --cluster --class --backend
operands DRIVER
rest [-- DRIVER-ARGUMENT...]
opt --disrupt SPEC PX_DISRUPT_SPEC+; | one disruption (repeatable); several specifications
+ in one value are separated by a semicolon
opt --collect LIST PX_COLLECTORS | the collectors to start around the run verb,
+ comma separated; it replaces PX_COLLECTORS
opt --targets LIST PX_COLLECT_TARGETS | the roles that the collectors target, comma
+ separated, default all: every service role except
+ setup and the pherf group
opt --timeout SECONDS PX_TIMEOUT_RUN | the bound that prepare and run share, default
+ PX_TIMEOUT_RUN (3600); each other verb has the
+ bound PX_TIMEOUT_VERB
output a real run writes the bundle directory, printed when the bundle is
+ created; a dry run writes the plan.
exits The code is the first non-zero code of a verb; a code outside 0 to 3 counts as
+ 1. A verb that passed its bound gives 4. An unplanned restart, an unplanned
+ exit of a running instance, or an instance that vanished replaces 0 or 1 with
+ 3. A planned action of this run, or of px-cluster during this run, explains a
+ change. Such a change found while prepare or run works aborts the run at once
+ with 3. A bundle that px-bundle validate refuses turns 0 into 1. 4 also means
+ that the host stayed busy and the run requires a quiet host. 2 also means a
+ refused describe document.
verdicts When every verb gave 0, the merged verdict of px-report decides:
example px-run psql --class validation -- --prepare schema.sql query.sql
example px-run pherf --disrupt '+40,restart,regionserver,0' -- --scenario walk.xml
EOF

# ---------------------------------------------------------------------------
# Global runtime state
# ---------------------------------------------------------------------------
# Leaving RECORD_FILE empty directs all record output to stdout, allowing dry-run mode to print the
# execution plan without creating any files on disk.

RECORD_FILE=""
RUN_ID=""
RUN_DIR=""
STAGES_FILE=""
STAGE_BASE=0
SCOPE=""
DRIVER_SPEC=""
DRIVER_PATH=""
DRIVER_NAME=""
DRIVER_DIR=""
DRIVER_TIMEOUT=0
VERB_TIMEOUT=0
VERB_CWD=""
VERB_PID=""
VERB_STATUS=0
VERB_CODE=0
VERB_ELAPSED_MS=0
VERB_DEADLINE=0
VERB_TIMED_OUT=0
RUN_START_S=0
RUN_START_MS=0
FIRST_CODE=0
ANY_TIMED_OUT=0
ANOMALY=0
ABORTED=0
BLOCKED=""
CONTAMINATION=""
PLUGINS_ENABLED=""
REPORT_STATUS=0
BUNDLE_STATUS=0
MONITOR_DIR=""
PRE_RESTARTS=""
POST_RESTARTS=""
SNAP_ROWS=""
SNAP_LIST=""
PLANNED_SINCE_MS=0
DISRUPT_COUNT=0
DISRUPT_KIND=()
DISRUPT_WHEN=()
DISRUPT_ACTION=()
DISRUPT_ROLE=()
DISRUPT_INDEX=()
DISRUPT_ARG=()
DISRUPT_STATE=()
DISRUPT_INJECTED=()
DISRUPT_REGIONS=()
DISRUPT_PAUSED=()
GATE_STATE=""
GATE_RECOVERED=""
DRIVER_ARGS=()
COLLECTORS=""
COLLECT_LIVE=0
COLLECT_DUR=0

# ---------------------------------------------------------------------------
# Run record emission
# ---------------------------------------------------------------------------

# Formats individual field arguments into a tab-separated row and writes it to the active record
# file, or to stdout during a dry run. Fails if any field contains a tab or a newline character.
## @description  Formats and writes one record row from separate fields to the record or stdout.
## @return       Writes the row and exits 0, or exits 1 when a field contains a tab or a newline.
record_row() {
  local row
  row="$(px_tsv_row "$@")" || return
  record_line "$row"
}

# Rows emitted by the substrate contract already contain tab-separated fields in their defined
# field order, so callers prepend only the prefix columns before passing the row here.
## @description  Writes a pre-formatted tab-separated record row to the active output stream.
## @return       Writes to the record file, or to stdout during a dry run, and exits 0.
record_line() {
  if [ -n "$RECORD_FILE" ]; then
    printf '%s\n' "$1" >>"$RECORD_FILE"
  else
    printf '%s\n' "$1"
  fi
}

# Prepends a caller-supplied prefix to every non-empty row in a multi-line text block. Because the
# prefix already includes its own trailing tabs, rows emitted by the substrate contract retain their
# canonical field order.
## @description  Writes each non-empty row of a multi-line text block (prefix, rows) after a prefix.
## @return       Writes the prefixed rows and exits 0.
record_rows() {
  local row
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    record_line "$1$row"
  done <<EOF
$2
EOF
}

# Logs a stage transition when px-run reaches a named execution phase and triggers every pending
# disruption scheduled to wait for that phase.
## @description  Records that px-run reached a named phase and fires all disruptions waiting for it.
## @return       Exit 0.
phase_reached() {
  local name=$1 index=0
  record_row stage "$name" "$(px_epoch_ms)"
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    if [ "${DISRUPT_STATE[$index]}" = pending ] &&
      [ "${DISRUPT_KIND[$index]}" = phase ] &&
      [ "${DISRUPT_WHEN[$index]}" = "$name" ]; then
      disrupt_fire "$index"
    fi
    index=$((index + 1))
  done
}

## @description  Records the first non-zero status code (code) observed during the run so that it
##               can serve as the run's exit code.
## @return       Exits 0.
note_code() {
  [ "$FIRST_CODE" != 0 ] || FIRST_CODE=${1:-0}
}

# Preserves the first recorded failure reason so that the resulting skip row identifies the gate
# that failed first.
## @description  Marks downstream steps that depend on a prerequisite gate as blocked (reason).
## @return       Exits 0.
block() {
  [ -n "$BLOCKED" ] || BLOCKED=$1
}

# ---------------------------------------------------------------------------
# Workload driver lifecycle
# ---------------------------------------------------------------------------

# The describe verb receives a sanitized environment containing only PX_HOME, PX_DRIVER_NAME, and
# PX_VERB so that it can execute without an active run directory.
## @description  Launches a driver verb (verb, stdout file, stderr file) as a background process.
## @return       Sets VERB_PID and exits 0.
verb_start() {
  local verb=$1 out=$2 err=$3
  # Using exec replaces the background subshell with the driver executable so that the recorded
  # process identifier refers to the driver rather than a wrapper shell and signals reach the
  # workload directly. A driver that spawns child processes owns their lifecycle, and the driver
  # contract requires it to handle termination signals cleanly.
  if [ "$verb" = describe ]; then
    env -i "PATH=$PATH" "HOME=${HOME:-}" "TMPDIR=${TMPDIR:-/tmp}" "PX_HOME=$PX_HOME" \
      "PX_DRIVER_NAME=$DRIVER_NAME" PX_VERB=describe "$DRIVER_PATH" describe \
      >>"$out" 2>>"$err" &
  else
    (
      if [ -n "$VERB_CWD" ]; then
        cd "$VERB_CWD" || exit "$PX_EXIT_USAGE"
      fi
      PX_VERB=$verb
      PX_RECORD_SOURCE="driver:$DRIVER_NAME"
      export PX_VERB PX_RECORD_SOURCE
      exec "$DRIVER_PATH" "$verb" ${DRIVER_ARGS[@]+"${DRIVER_ARGS[@]}"}
    ) >>"$out" 2>>"$err" &
  fi
  VERB_PID=$!
}

# Requests graceful termination first and escalates to a forced kill after ten seconds so that a
# driver can flush its output while an unresponsive process is still terminated.
## @description  Terminates the active background verb process and closes any open stage anchors.
## @return       Exit 0.
verb_terminate() {
  local waited=0
  [ -n "$VERB_PID" ] || return 0
  if kill -0 "$VERB_PID" 2>/dev/null; then
    px_warn "stopping driver process $VERB_PID"
    # Suppress the shell's default job-termination message for signal-killed background jobs, which
    # would expose the raw internal command line after the harness has already logged a structured
    # warning.
    {
      kill -s TERM "$VERB_PID" || true
      while [ "$waited" -lt 10 ] && kill -0 "$VERB_PID"; do
        sleep 1
        waited=$((waited + 1))
      done
      if kill -0 "$VERB_PID"; then
        kill -s KILL "$VERB_PID" || true
      fi
    } 2>/dev/null
  fi
  # A forcefully stopped verb—including when px-run itself is interrupted—leaves its stage anchors
  # open, so close them here to keep the stage file well-formed.
  [ -z "$STAGES_FILE" ] || pb_stage_close_open "$STAGES_FILE" "px-run stopped the driver"
}

# Fires scheduled disruptions as they come due and, during prepare and run, terminates the verb
# immediately if an unplanned cluster change is observed.
## @description  Monitors the active verb (verb) until it completes or exceeds its deadline.
## @return       Sets VERB_TIMED_OUT on timeout or ABORTED on an unplanned change, and exits 0.
verb_watch() {
  local verb=$1 steps ticks=0 next=0 nap now
  # Each tick is one tenth of a second. Deadline and anomaly checks run immediately, at the end of
  # the first second, and once per PX_POLL_INTERVAL_S thereafter; polling the process at every tick
  # during the first second allows short-lived verbs to finish without paying a full poll interval.
  steps="$(awk -v i="${PX_POLL_INTERVAL_S:-1}" \
    'BEGIN { n = int(i * 10 + 0.5); print (n < 1 ? 1 : n) }')"
  while kill -0 "$VERB_PID" 2>/dev/null; do
    if [ "$ticks" -ge "$next" ]; then
      now="$(px_epoch_s)"
      if [ "$now" -ge "$VERB_DEADLINE" ]; then
        VERB_TIMED_OUT=1
        px_error "the $verb verb passed its bound"
        verb_terminate
        return 0
      fi
      [ "$verb" != run ] || disrupt_due "$now"
      case "$verb" in
      prepare | run)
        if ! anomaly_watch; then
          ABORTED=1
          verb_terminate
          return 0
        fi
        ;;
      esac
      next=$((ticks < 10 ? 10 : ticks + steps))
    fi
    # When a disruption is waiting on a stage anchor, inspect the stage file on every tick so that
    # the injection fires within a sub-interval window.
    nap=1
    if disrupt_anchor_pending; then
      disrupt_anchors fire
    elif [ "$ticks" -ge 10 ]; then
      nap=$((next - ticks))
    fi
    [ "$nap" -ge 1 ] || nap=1
    sleep "$((nap / 10)).$((nap % 10))"
    ticks=$((ticks + nap))
  done
  # Any anchor that opened and closed after the final tick is recorded as missed because a verb
  # that has already exited can no longer be disrupted.
  disrupt_anchors mark
}

## @description  Launches a driver verb (verb, stdout file, stderr file, deadline in epoch seconds)
##               in the background and monitors it until completion.
## @return       Sets VERB_STATUS, VERB_ELAPSED_MS, and VERB_TIMED_OUT, then exits 0.
verb_exec() {
  local verb=$1 started
  VERB_DEADLINE=$4
  VERB_TIMED_OUT=0
  VERB_STATUS=0
  started="$(px_epoch_ms)"
  verb_start "$verb" "$2" "$3"
  if [ "$verb" = run ]; then
    RUN_START_S="$(px_epoch_s)"
    phase_reached driver_start
  fi
  verb_watch "$verb"
  { wait "$VERB_PID"; } 2>/dev/null || VERB_STATUS=$?
  VERB_PID=""
  VERB_ELAPSED_MS=$(($(px_epoch_ms) - started))
}

## @description  Executes a driver verb within the bundle (verb, deadline in epoch seconds),
##               recording its stage rows, log output, verb row, and (except for describe) verdict.
## @return       Sets VERB_CODE (0 to 4) and exits 0.
verb_run() {
  local verb=$1 out err aborted=$ABORTED detail
  out="$RUN_DIR/logs/$verb.log"
  err=$out
  if [ "$verb" = describe ]; then
    out="$DRIVER_DIR/describe.json"
    err="$RUN_DIR/logs/describe.log"
  fi
  pb_stage begin "verb@$verb"
  verb_exec "$verb" "$out" "$err" "$2"
  # verb_terminate already closed the open stage anchors when px-run stopped the verb.
  if [ "$VERB_TIMED_OUT" = 0 ] && [ "$ABORTED" = "$aborted" ]; then
    pb_stage end "verb@$verb"
  fi
  if [ "$ABORTED" != "$aborted" ]; then
    VERB_CODE=$PX_EXIT_ANOMALY
    detail="stopped at an unplanned change of the cluster"
  elif [ "$VERB_TIMED_OUT" = 1 ]; then
    VERB_CODE=$PX_EXIT_TIMEOUT
    ANY_TIMED_OUT=1
    detail="stopped at its bound"
  else
    # Map any exit status outside the verb vocabulary (such as 143 from a signal) to a standard
    # failure code while preserving the raw status in the verb record row.
    case "$VERB_STATUS" in
    0 | 1 | 2 | 3) VERB_CODE=$VERB_STATUS ;;
    *) VERB_CODE=$PX_EXIT_FAIL ;;
    esac
    detail="exit $VERB_STATUS"
  fi
  record_row verb "$verb" "$VERB_STATUS" "$VERB_ELAPSED_MS" "$VERB_TIMED_OUT"
  [ "$verb" != run ] || phase_reached driver_exit
  px_info "verb $verb ended with exit $VERB_STATUS, code $VERB_CODE"
  [ "$verb" != describe ] || return 0
  sx_verdict "driver.$verb" "$(sx_severity_of_code "$VERB_CODE")" \
    "$detail, output in logs/$verb.log"
  note_code "$VERB_CODE"
}

## @description  Computes the execution deadline for a short verb as the current time plus
##               PX_TIMEOUT_VERB.
## @return       Writes the deadline in epoch seconds to stdout and exits 0.
verb_deadline() { printf '%s\n' "$(($(px_epoch_s) + VERB_TIMEOUT))"; }

## @description  Executes the describe verb during a dry run using a temporary directory and
##               validates the resulting document.
## @return       Exits 0 when the document is accepted, or exits 2 otherwise.
describe_dry() {
  local dir
  dir="$(px_mktemp_dir px-describe)" || exit "$?"
  verb_exec describe "$dir/describe.json" "$dir/describe.log" "$(verb_deadline)"
  if [ "$VERB_TIMED_OUT" = 1 ] || [ "$VERB_STATUS" != 0 ]; then
    cat "$dir/describe.log" >&2 || true
    px_die "$PX_EXIT_USAGE" "describe of driver $DRIVER_NAME ended with exit $VERB_STATUS"
  fi
  pb_describe_load "$dir/describe.json" ||
    px_die "$PX_EXIT_USAGE" "the describe document of driver $DRIVER_NAME is refused"
}

# Emits a SKIP verdict row for every check that the describe document declares unsupported so that
# downstream gates querying that key observe an explained skip.
## @description  Executes the describe verb in the bundle and validates the resulting document.
## @return       Exits 0 when accepted, 1 to 4 if describe fails, or 2 if the document is refused.
describe_run() {
  local key reason
  verb_run describe "$(verb_deadline)"
  if [ "$VERB_CODE" != 0 ]; then
    sx_verdict driver.describe "$(sx_severity_of_code "$VERB_CODE")" \
      "describe ended with code $VERB_CODE, output in logs/describe.log"
    return "$VERB_CODE"
  fi
  if ! pb_describe_load "$DRIVER_DIR/describe.json"; then
    sx_verdict driver.describe ERROR "the describe document is refused, see the messages of px-run"
    return "$PX_EXIT_USAGE"
  fi
  sx_verdict driver.describe PASS "drivers/$DRIVER_NAME/describe.json is accepted"
  while IFS="$PB_US" read -r key reason; do
    [ -n "$key" ] || continue
    sx_verdict "$key" SKIP "unavailable: $reason"
  done <<EOF
$(pb_describe_rows checks | tr '\t' "$PB_US")
EOF
}

# ---------------------------------------------------------------------------
# Planned fault accounting
# ---------------------------------------------------------------------------
# Instance state changes or restarts caused by a fault injected by px-run or an administrative
# action performed by px-cluster during the run are considered expected. The post-run comparison
# relies on this distinction because only unexplained changes constitute a cluster anomaly. Both
# tools append to the substrate contract's shared planned-action record, and the comparison logic
# consults only entries recorded during the current run.

# The inspection window begins before the pre-run snapshot so that records from earlier runs cannot
# excuse instance changes observed during the current run.
## @description  Checks whether a planned action recorded during this run covers a target instance.
## @return       Exits 0 when a planned action covers the instance, or exits 1 otherwise.
planned_covers() {
  local status=0
  sb_planned_contains "$SCOPE" "$1" "$2" "$PLANNED_SINCE_MS" || status=$?
  case "$status" in
  0) return 0 ;;
  1) return 1 ;;
  esac
  px_warn "cannot read the planned-action record, exit $status:" \
    "a change of $1/$2 counts as unplanned"
  return 1
}

# ---------------------------------------------------------------------------
# Cluster metadata capture in the bundle
# ---------------------------------------------------------------------------

## @description  Copies the deployment artifacts for the active scope (topology.env, services.tsv,
##               and plug-in records) into the bundle.
## @return       Records a skip row if the deployment record is absent and exits 0.
cluster_copy() {
  local file recorded="" dir="" name
  # Because a deployment record is keyed to a cluster rather than a scope, use it only when the
  # cluster's scope record matches the active scope.
  file="$(sb_scope_record || true)"
  if [ -n "$file" ] && [ -f "$file" ]; then
    IFS= read -r recorded <"$file" || true
  fi
  if [ "$recorded" = "$SCOPE" ]; then
    file="$(sb_deployment_record || true)"
    if [ -n "$file" ] && [ -f "$file" ]; then
      IFS= read -r dir <"$file" || true
    fi
  fi
  if [ -z "$dir" ] || [ ! -d "$dir" ]; then
    record_row skip pre deployment "no deployment record of scope $SCOPE"
    return 0
  fi
  for name in topology.env services.tsv; do
    if [ -f "$dir/$name" ]; then
      cp "$dir/$name" "$RUN_DIR/cluster/$name" || px_warn "cannot copy $dir/$name"
    fi
  done
  if [ -d "$dir/plugins" ]; then
    cp -R "$dir/plugins" "$RUN_DIR/cluster/" || px_warn "cannot copy $dir/plugins"
  fi
}

## @description  Writes cluster/images.tsv with the image reference and image ID of every instance
##               captured in the pre-run snapshot.
## @return       Exits 0.
images_record() {
  local row role index ref image role_col index_col ref_col id_col
  role_col="$(sb_schema_index instance role)"
  index_col="$(sb_schema_index instance index)"
  ref_col="$(sb_schema_index instance image_ref)"
  id_col="$(sb_schema_index image image_id)"
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    role="$(px_tsv_field "$role_col" "$row" || true)"
    index="$(px_tsv_field "$index_col" "$row" || true)"
    ref="$(px_tsv_field "$ref_col" "$row" || true)"
    image="$(sb_image_ref "$SCOPE" "$role" "$index" || true)"
    image="$(px_tsv_field "$id_col" "$image" || true)"
    px_tsv_row "$role" "$index" "$ref" "$image" >>"$RUN_DIR/cluster/images.tsv" || true
  done <<EOF
$SNAP_ROWS
EOF
}

# ---------------------------------------------------------------------------
# Cluster snapshots and anomaly detection
# ---------------------------------------------------------------------------

## @description  Looks up the recorded state and restart count for a single cluster instance.
## @return       Writes the state, a tab, and the restart count to stdout and exits 0, or exits 6
##               when the snapshot contains no such instance.
snapshot_lookup() {
  local list=$1 role=$2 index=$3 line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
    "$role$PX_TAB$index$PX_TAB"*)
      printf '%s\n' "${line#"$role$PX_TAB$index$PX_TAB"}"
      return 0
      ;;
    esac
  done <<EOF
$list
EOF
  return "$PX_EXIT_NO_OBJECT"
}

# Diagnostic bundle manifests include the substrate tooling versions so that every test result
# remains attributable to the exact software versions that produced it.
## @description  Queries and records the versions of the underlying substrate tooling.
## @return       Exit 0.
snapshot_versions() {
  local phase=$1 rows status=0
  rows="$(sb_version_info || exit "$?")" || status=$?
  if [ "$status" != 0 ]; then
    record_row skip "$phase" version_info "exit $status"
    return 0
  fi
  record_rows "version$PX_TAB$phase$PX_TAB" "$rows"
}

## @description  Captures and records a single resource utilization sample for every instance.
## @return       Exit 0.
snapshot_samples() {
  local phase=$1 rows status=0
  rows="$(sb_sample_resources "$SCOPE" || exit "$?")" || status=$?
  if [ "$status" != 0 ]; then
    record_row skip "$phase" sample_resources "exit $status"
    return 0
  fi
  record_rows "sample$PX_TAB$phase$PX_TAB" "$rows"
}

# Queries the cluster inventory into SNAP_ROWS and assembles the role, index, state, and restart
# count of every instance into SNAP_LIST without writing any rows to the run record.
## @description  Reads the live cluster inventory and instance restart counts into memory.
## @return       Exits 0 on success, or returns the sb_list exit status if the inventory read fails.
snapshot_read() {
  local row role index state count restarts status=0
  local role_col index_col state_col
  role_col="$(sb_schema_index instance role)"
  index_col="$(sb_schema_index instance index)"
  state_col="$(sb_schema_index instance state)"
  SNAP_LIST=""
  SNAP_ROWS="$(sb_list "$SCOPE" || exit "$?")" || status=$?
  [ "$status" = 0 ] || return "$status"
  status=0
  restarts="$(sb_restart_count "$SCOPE" || exit "$?")" || status=$?
  if [ "$status" != 0 ]; then
    px_warn "no restart counts in scope $SCOPE, exit $status"
    restarts=""
  fi
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    role="$(px_tsv_field "$role_col" "$row")" || continue
    index="$(px_tsv_field "$index_col" "$row")" || continue
    state="$(px_tsv_field "$state_col" "$row")" || state=unknown
    # Because tab-delimited read splitting collapses consecutive tabs, every field must be
    # non-empty to preserve column alignment across the line.
    [ -n "$state" ] || state=unknown
    count="$(snapshot_lookup "$restarts" "$role" "$index")" || count=""
    SNAP_LIST="$SNAP_LIST$role$PX_TAB$index$PX_TAB$state$PX_TAB$count$PX_NL"
  done <<EOF
$SNAP_ROWS
EOF
  return 0
}

# Captures a cluster snapshot containing the instance inventory, the state and restart count of each
# instance, the substrate tooling versions, and a resource sample; the pre-run snapshot also writes
# images.tsv.
## @description  Captures and records a complete cluster snapshot for the specified phase.
## @return       Exits 0 on success, or exits 1 when the cluster inventory cannot be read.
snapshot_take() {
  local phase=$1 role index count status=0
  snapshot_read || status=$?
  if [ "$status" != 0 ]; then
    px_error "the $phase snapshot cannot read the inventory of scope $SCOPE"
    record_row skip "$phase" inventory "exit $status"
    return "$PX_EXIT_FAIL"
  fi
  record_rows "instance$PX_TAB$phase$PX_TAB" "$SNAP_ROWS"
  while IFS="$PX_TAB" read -r role index _ count; do
    [ -n "$role" ] || continue
    record_row restart "$phase" "$role" "$index" "$count"
  done <<EOF
$SNAP_LIST
EOF
  if [ "$phase" = pre ]; then
    PRE_RESTARTS=$SNAP_LIST
    images_record
  else
    POST_RESTARTS=$SNAP_LIST
  fi
  snapshot_versions "$phase"
  snapshot_samples "$phase"
  return 0
}

# Compares two observations of an instance (state before, count before, state after, count after) to
# detect whether its restart count increased or a previously running instance stopped running.
## @description  Describes how an instance changed between two snapshots (pre-state, pre-count,
##               post-state, post-count).
## @return       Writes a description of the change to stdout (or an empty line if none), exits 0.
change_of() {
  local pre_state=$1 before=$2 post_state=$3 after=$4 changed=""
  # Skip numerical comparison when either restart count is empty or is not a valid decimal integer.
  case "$before:$after" in
  *[!0-9:]* | :* | *:) ;;
  *) [ "$after" -le "$before" ] || changed="restarted $before to $after" ;;
  esac
  if [ "$pre_state" = running ]; then
    case "$post_state" in
    exited | dead | unknown)
      changed="${changed:+$changed and }went from running to $post_state"
      ;;
    esac
  fi
  printf '%s\n' "$changed"
}

# Compares the live cluster state against the pre-run snapshot while a verb is running. An
# unreadable inventory is treated as inconclusive rather than evidence of a change, whereas the
# first unplanned change sets ANOMALY and writes an abort row.
## @description  Polls the live cluster against the pre-run snapshot to detect unplanned changes.
## @return       Exits 0 when no unplanned change is observed, or exits 3 on the first anomaly.
anomaly_watch() {
  local rest role index pre_state before changed status
  [ -n "$SCOPE" ] && [ -n "$PRE_RESTARTS" ] || return 0
  snapshot_read 2>/dev/null || return 0
  while IFS="$PX_TAB" read -r role index pre_state before; do
    [ -n "$role" ] || continue
    status=0
    rest="$(snapshot_lookup "$SNAP_LIST" "$role" "$index")" || status=$?
    if [ "$status" != 0 ]; then
      changed=vanished
    else
      changed="$(change_of "$pre_state" "$before" "${rest%%"$PX_TAB"*}" "${rest#*"$PX_TAB"}")"
    fi
    [ -n "$changed" ] || continue
    ! planned_covers "$role" "$index" || continue
    ANOMALY=1
    # Because the health monitor writes breach.tsv before tearing down the cluster, the presence of
    # that file distinguishes a protective monitor shutdown from an intrinsic cluster fault.
    if [ -n "$MONITOR_DIR" ] && [ -f "$MONITOR_DIR/breach.tsv" ]; then
      changed="$changed; the health monitor removed the cluster, see breach.tsv"
    fi
    px_error "instance $role/$index $changed with no planned action while the driver" \
      "runs: the run aborts with $PX_EXIT_ANOMALY"
    record_row abort "$(px_epoch_ms)" "$role" "$index" "$changed"
    return "$PX_EXIT_ANOMALY"
  done <<EOF
$PRE_RESTARTS
EOF
  return 0
}

## @description  Records failure diagnostic evidence for an anomalous instance by capturing both its
##               termination reason and its out-of-memory kill status.
## @return       Exit 0.
evidence_record() {
  local role=$1 index=$2 term="" oom="" reason="" kill="" status=0 column
  term="$(sb_termination_reason "$SCOPE" "$role" "$index" current || exit "$?")" ||
    status=$?
  if [ "$status" = 0 ] && [ -n "$term" ]; then
    record_line "term$PX_TAB$role$PX_TAB$index$PX_TAB$term"
    column="$(sb_schema_index term reason)" || column=1
    reason="$(px_tsv_field "$column" "$term")" || reason=""
  else
    record_row skip post "termination reason of $role/$index" "exit $status"
  fi
  status=0
  oom="$(sb_oom_killed "$SCOPE" "$role" "$index" || exit "$?")" || status=$?
  if [ "$status" = 0 ] && [ -n "$oom" ]; then
    record_line "oom$PX_TAB$role$PX_TAB$index$PX_TAB$oom"
    column="$(sb_schema_index oom oom)" || column=1
    kill="$(px_tsv_field "$column" "$oom")" || kill=""
  else
    record_row skip post "out-of-memory evidence of $role/$index" "exit $status"
  fi
  px_error "instance $role/$index: termination reason ${reason:-not known}," \
    "out-of-memory kill ${kill:-not known}"
}

## @description  Compares the state and restart count of every instance across the two snapshots.
## @return       Sets ANOMALY when an unexplained change is detected and exits 0.
restart_diff() {
  local line rest role index before after pre_state post_state verdict status
  local changed comparable
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    role=${line%%"$PX_TAB"*}
    rest=${line#*"$PX_TAB"}
    index=${rest%%"$PX_TAB"*}
    rest=${rest#*"$PX_TAB"}
    pre_state=${rest%%"$PX_TAB"*}
    before=${rest#*"$PX_TAB"}
    status=0
    rest="$(snapshot_lookup "$POST_RESTARTS" "$role" "$index")" || status=$?
    if [ "$status" != 0 ]; then
      if planned_covers "$role" "$index"; then
        record_row diff "$role" "$index" "$before" "" planned "$pre_state" ""
      else
        ANOMALY=1
        px_error "instance $role/$index vanished with no planned action"
        record_row diff "$role" "$index" "$before" "" vanished "$pre_state" ""
        evidence_record "$role" "$index"
      fi
      continue
    fi
    post_state=${rest%%"$PX_TAB"*}
    after=${rest#*"$PX_TAB"}
    # Restart counts that are empty or non-decimal cannot be compared numerically; the raw values
    # are preserved in the diff record so that the reporting fault remains visible.
    comparable=1
    case "$before" in '' | *[!0-9]*) comparable=0 ;; esac
    case "$after" in '' | *[!0-9]*) comparable=0 ;; esac
    changed="$(change_of "$pre_state" "$before" "$post_state" "$after")"
    if [ -n "$changed" ]; then
      if planned_covers "$role" "$index"; then
        verdict=planned
      else
        verdict=unplanned
        ANOMALY=1
        px_error "instance $role/$index $changed with no planned action"
      fi
    elif [ "$comparable" = 0 ]; then
      verdict=unknown
    else
      verdict=unchanged
    fi
    record_row diff "$role" "$index" "$before" "$after" "$verdict" "$pre_state" \
      "$post_state"
    if [ "$verdict" = unplanned ]; then
      evidence_record "$role" "$index"
    fi
  done <<EOF
$PRE_RESTARTS
EOF
}

# ---------------------------------------------------------------------------
# Disruption scheduling and injection
# ---------------------------------------------------------------------------
# Because Bash 3.2 lacks associative arrays, the disruption schedule is stored in parallel indexed
# arrays where each scheduled disruption occupies a single index across all eight arrays.

## @description  Parses and validates a single disruption specification and appends it to the
##               schedule.
## @return       Exits 0 on success, or exits 2 when the specification is rejected.
disrupt_add() {
  local spec=$1 when action role index argument extra kind value field
  IFS=, read -r when action role index argument extra <<EOF
$spec
EOF
  # Operators often format comma-separated lists with spaces after each comma, so surrounding
  # whitespace is stripped from every field before any validation check inspects it.
  for field in when action role index argument; do
    px_trim_var "$field"
  done
  if [ -n "${extra:-}" ]; then
    px_die "$PX_EXIT_USAGE" "disruption '$spec' holds more than five fields"
  fi
  case "${when:-}" in
  +*)
    kind=offset
    value=${when#+}
    [[ $value =~ $PX_RE_INT ]] ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' needs whole seconds after the plus sign"
    ;;
  phase:*)
    kind=phase
    value=${when#phase:}
    # A phase target may name either a px-run execution milestone or a <kind>@<name> stage anchor.
    if ! [[ $value =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] && ! [[ $value =~ $PB_ANCHOR_RE ]]; then
      px_die "$PX_EXIT_USAGE" "disruption '$spec' names an invalid phase '$value'"
    fi
    ;;
  *)
    px_die "$PX_EXIT_USAGE" "disruption '$spec' needs +SECONDS or phase:NAME"
    ;;
  esac
  case "${action:-}" in
  kill | signal | restart) ;;
  *) px_die "$PX_EXIT_USAGE" "disruption '$spec' needs the action kill, signal or restart" ;;
  esac
  [[ ${role:-} =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] ||
    px_die "$PX_EXIT_USAGE" "disruption '$spec' names an invalid role '${role:-}'"
  [[ ${index:-} =~ $PX_RE_INT ]] ||
    px_die "$PX_EXIT_USAGE" "disruption '$spec' needs a whole instance index"
  argument=${argument:-}
  case "$action" in
  kill)
    [ -n "$argument" ] || argument=hard
    sb_valid_value kill_mode "$argument" ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' names an unknown kill mode '$argument'"
    # Recovery restarts a killed instance using the drain-aware restart path, which is supported
    # only for RegionServers, and a deleted instance cannot be restarted at all.
    [ "$role" = regionserver ] ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' kills a $role: only a RegionServer kill has a" \
        "recovery path, the drain-aware restart"
    [ "$argument" != delete ] ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' kills with mode delete: a deleted instance" \
        "cannot start again, so it has no recovery"
    ;;
  signal)
    [[ $argument =~ ^(SIG)?[A-Z][A-Z0-9]+$ ]] ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' needs a signal name, for example QUIT"
    ;;
  restart)
    [ -z "$argument" ] ||
      px_die "$PX_EXIT_USAGE" "disruption '$spec' takes no argument after the index"
    ;;
  esac
  DISRUPT_KIND[DISRUPT_COUNT]=$kind
  DISRUPT_WHEN[DISRUPT_COUNT]=$value
  DISRUPT_ACTION[DISRUPT_COUNT]=$action
  DISRUPT_ROLE[DISRUPT_COUNT]=$role
  DISRUPT_INDEX[DISRUPT_COUNT]=$index
  DISRUPT_ARG[DISRUPT_COUNT]=$argument
  DISRUPT_STATE[DISRUPT_COUNT]=pending
  DISRUPT_INJECTED[DISRUPT_COUNT]=""
  DISRUPT_REGIONS[DISRUPT_COUNT]=""
  DISRUPT_PAUSED[DISRUPT_COUNT]=""
  DISRUPT_COUNT=$((DISRUPT_COUNT + 1))
}

# Semicolons separate individual disruption specifications so that a single environment variable can
# carry a complete disruption schedule.
## @description  Parses a complete semicolon-delimited disruption schedule.
## @return       Exits 0 on success, or exits 2 when any specification is rejected.
disrupt_parse() {
  local rest=${1:-} spec
  while [ -n "$rest" ]; do
    case "$rest" in
    *';'*)
      spec=${rest%%;*}
      rest=${rest#*;}
      ;;
    *)
      spec=$rest
      rest=""
      ;;
    esac
    px_trim_var spec
    [ -n "$spec" ] || continue
    disrupt_add "$spec"
  done
}

# A dry-run plan lists every scheduled entry in the pending state, whereas a completed run records
# the final outcome of each entry and downstream readers use the last row written for each ordinal.
## @description  Writes the disruption schedule and the state of every entry to the run record.
## @return       Exit 0.
disrupt_rows() {
  local index=0
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    record_row disrupt "$((index + 1))" "${DISRUPT_KIND[$index]}" \
      "${DISRUPT_WHEN[$index]}" "${DISRUPT_ACTION[$index]}" \
      "${DISRUPT_ROLE[$index]}" "${DISRUPT_INDEX[$index]}" \
      "${DISRUPT_ARG[$index]}" "${DISRUPT_STATE[$index]}"
    index=$((index + 1))
  done
}

# When the active backend does not support an optional substrate operation (exit code 5), the
# disruption is recorded as a skip rather than a failure. While an instance is paused, only its
# resuming CONT signal is allowed to fire.
## @description  Injects a scheduled disruption through the substrate contract, records the action,
##               and waits for cluster recovery.
## @return       Exit 0.
disrupt_fire() {
  local index=$1 action role instance argument out="" status=0 state paused="" held sent=""
  action=${DISRUPT_ACTION[$index]}
  role=${DISRUPT_ROLE[$index]}
  instance=${DISRUPT_INDEX[$index]}
  argument=${DISRUPT_ARG[$index]}
  # Mark the entry as no longer pending immediately so that a failed attempt cannot be re-fired.
  DISRUPT_STATE[index]=fail
  px_info "disruption $((index + 1)): $action $role/$instance ${argument:-(no argument)}"
  # The recovery gate waits for the online region count to return to this baseline, so abort the
  # injection if the count cannot be read. Because a paused server cannot respond, its resume
  # reuses the baseline count captured before the pause. While an instance is paused, only its CONT
  # signal is allowed to fire; the baseline read and recovery gate of any other entry would wait on
  # the paused server and delay the CONT signal for too long.
  held="$(disrupt_paused)"
  if [ -n "$held" ] && [ "$action:${argument#SIG}" = signal:CONT ]; then
    paused="$(disrupt_paused "$role" "$instance")"
  fi
  if [ -n "$held" ] && [ -z "$paused" ]; then
    px_error "disruption $((index + 1)) not injected:" \
      "${DISRUPT_ROLE[$held]}/${DISRUPT_INDEX[$held]} is paused until its CONT"
    return 0
  fi
  if [ -n "$paused" ]; then
    DISRUPT_REGIONS[index]=${DISRUPT_REGIONS[$paused]}
  else
    DISRUPT_REGIONS[index]="$(region_count_wait || exit "$?")" || status=$?
  fi
  if [ "$status" != 0 ]; then
    px_error "disruption $((index + 1)) not injected: the online regions cannot be" \
      "read before it, exit $status"
  fi
  if [ "$status" = 0 ]; then
    sb_planned_record "$SCOPE" "$action" "$role" "$instance" \
      "run $RUN_ID${argument:+ $argument}" || status=$?
    if [ "$status" != 0 ]; then
      px_error "disruption $((index + 1)) not injected: its planned action" \
        "cannot be recorded, exit $status"
    else
      # Measure time to recovery starting immediately before the substrate injection call.
      DISRUPT_INJECTED[index]="$(px_epoch_ms)"
      case "$action" in
      kill)
        out="$(sb_kill "$SCOPE" "$role" "$instance" "$argument" || exit "$?")" ||
          status=$?
        ;;
      signal)
        sent=1
        out="$(sb_signal "$SCOPE" "$role" "$instance" "$argument" || exit "$?")" ||
          status=$?
        ;;
      restart)
        out="$(sb_restart_drain "$SCOPE" "$role" "$instance" \
          "${PX_TIMEOUT_DRAIN:-600}" "${PX_TIMEOUT_READY:-600}" || exit "$?")" || status=$?
        ;;
      esac
    fi
  fi
  case "$status" in
  0) state=ok ;;
  "$PX_EXIT_UNSUPPORTED") state=skip ;;
  *) state=fail ;;
  esac
  if [ "$state" = skip ]; then
    px_warn "disruption $((index + 1)) skipped: the backend cannot $action"
  fi
  DISRUPT_STATE[index]=$state
  record_row action "$(px_epoch_ms)" "$action" "$role" "$instance" "$argument" \
    "$state" "$status"
  record_rows "phase$PX_TAB$role$PX_TAB$instance$PX_TAB" "$out"
  # A pause whose post-signal state check failed after the kill call may still leave the JVM
  # stopped. It runs no recovery gate, but it is still owed a CONT signal, and delivering CONT to a
  # running JVM has no effect.
  case "$sent:$action:${argument#SIG}:$status" in
  1:signal:STOP:[0256] | 1:signal:TSTP:[0256]) ;;
  1:signal:STOP:* | 1:signal:TSTP:*) DISRUPT_PAUSED[index]=fail ;;
  esac
  [ "$state" = ok ] || return 0
  # A paused JVM can recover only after it resumes running, so its recovery gate is deferred until
  # the resume. Running the gate now would block the scheduled CONT signal.
  case "$action:${argument#SIG}" in
  signal:STOP | signal:TSTP)
    DISRUPT_PAUSED[index]=1
    px_info "disruption $((index + 1)): $role/$instance is paused; its recovery waits" \
      "for a CONT"
    ;;
  *)
    recover_gate "$index"
    [ "$action:${argument#SIG}" != signal:CONT ] || disrupt_resumed "$role" "$instance"
    ;;
  esac
}

## @description  Finds the first paused disruption awaiting resume for an instance (role, index),
##               or across all instances when no role is given.
## @return       Writes the entry index to stdout (or nothing if none is waiting) and exits 0.
disrupt_paused() {
  local index=0
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    if [ -n "${DISRUPT_PAUSED[$index]}" ] && { [ -z "${1:-}" ] || {
      [ "${DISRUPT_ROLE[$index]}" = "$1" ] && [ "${DISRUPT_INDEX[$index]}" = "$2" ]; }; }; then
      printf '%s\n' "$index"
      return 0
    fi
    index=$((index + 1))
  done
}

# Failed pause entries are cleared without emitting a recover row.
## @description  Records the last recovery gate result as a recover row for each pause of the
##               resumed instance (role, index) from its own injection timestamp.
## @return       Exits 0.
disrupt_resumed() {
  local index
  while index="$(disrupt_paused "$1" "$2")" && [ -n "$index" ]; do
    [ "${DISRUPT_PAUSED[$index]}" = fail ] ||
      record_row recover "$((index + 1))" "${DISRUPT_INJECTED[$index]}" "$GATE_RECOVERED" \
        "$GATE_STATE"
    DISRUPT_PAUSED[index]=""
  done
}

# Sends a planned CONT signal and runs the recovery gate unless the pause failed. When quiet is set
# during exit cleanup, it resumes the instance without running the recovery gate or writing rows.
## @description  Resumes every instance left paused by the disruption schedule (quiet).
## @return       Exits 0.
disrupt_resume() {
  local quiet=${1:-} index role instance status state
  while index="$(disrupt_paused)" && [ -n "$index" ]; do
    role=${DISRUPT_ROLE[$index]}
    instance=${DISRUPT_INDEX[$index]}
    px_warn "disruption $((index + 1)): $role/$instance is still paused, px-run resumes it" \
      "with CONT"
    sb_planned_record "$SCOPE" signal "$role" "$instance" "run $RUN_ID CONT" ||
      px_warn "the resume of $role/$instance cannot be recorded as a planned action"
    status=0
    sb_signal "$SCOPE" "$role" "$instance" CONT || status=$?
    GATE_STATE=fail
    GATE_RECOVERED=""
    if [ -n "$quiet" ]; then
      while index="$(disrupt_paused "$role" "$instance")" && [ -n "$index" ]; do
        DISRUPT_PAUSED[index]=""
      done
      continue
    fi
    state=ok
    [ "$status" = 0 ] || state=fail
    record_row action "$(px_epoch_ms)" signal "$role" "$instance" CONT "$state" "$status"
    if [ "$status" = 0 ] && [ "${DISRUPT_PAUSED[$index]}" = fail ]; then
      DISRUPT_PAUSED[index]=""
    elif [ "$status" = 0 ]; then
      DISRUPT_PAUSED[index]=""
      recover_gate "$index"
    else
      px_error "disruption $((index + 1)): the CONT of $role/$instance failed, exit $status"
    fi
    # Propagate the recovery gate outcome to any other entries that paused the same instance.
    disrupt_resumed "$role" "$instance"
  done
}

## @description  Queries the total number of online regions across the cluster by running
##               px-region-count in client 0 to sum regionCount across every RegionServer.
## @return       Writes the count to stdout and exits 0, or returns the exec status (1 if no count).
region_count() {
  local out
  out="$(sb_exec "$SCOPE" client 0 30 -- px-region-count </dev/null || exit "$?")" || return
  out="$(printf '%s\n' "$out" | sed -n '$p')"
  [[ $out =~ $PX_RE_INT ]] || return "$PX_EXIT_FAIL"
  printf '%s\n' "$out"
}

## @description  Reads the online region count before an injection, retrying while unready within
##               the readiness bound and any active verb deadline.
## @return       Writes the count to stdout and exits 0, or returns the status of the final read.
region_count_wait() {
  local ready deadline status shared=0
  ready="$(px_int_setting PX_TIMEOUT_READY 600 1 || exit "$?")" || return
  [ -z "$VERB_PID" ] || shared=$VERB_DEADLINE
  deadline=$(($(px_epoch_s) + $(gate_bound "$ready" "$shared")))
  while [ "$(px_epoch_s)" -lt "$deadline" ]; do
    status=0
    region_count 2>/dev/null || status=$?
    # Immediately after a restart or a rebalance, a RegionServer may respond before publishing
    # regionCount, causing px-region-count to exit with 1 while not yet ready. Any other non-zero
    # code indicates an execution fault that retrying cannot resolve.
    [ "$status" = "$PX_EXIT_FAIL" ] || return "$status"
    sleep "${PX_POLL_INTERVAL_S:-1}"
  done
  # Perform a final unguarded read so its diagnostic reason is emitted on stderr.
  region_count
}

## @description  Clamps a recovery gate timeout (seconds, shared deadline in epoch seconds or 0) to
##               the time remaining before the shared deadline, with a minimum of 1 second.
## @return       Writes the bounded timeout in seconds to stdout and exits 0.
gate_bound() {
  local bound=$1 left
  if [ "$2" -gt 0 ]; then
    left=$(($2 - $(px_epoch_s)))
    [ "$left" -ge "$bound" ] || bound=$left
  fi
  [ "$bound" -ge 1 ] || bound=1
  printf '%s\n' "$bound"
}

# An instance that has exited (with any exit status, including 0 which satisfies the readiness
# check) or vanished from the scope cannot bring any hosted regions back online.
## @description  Checks whether the target instance of a disruption (index) has exited or is absent.
## @return       Logs the instance and its state and exits 0 when exited or absent, or exits 1.
gate_exited() {
  local role=${DISRUPT_ROLE[$1]} instance=${DISRUPT_INDEX[$1]} row status=0
  row="$(sb_list "$SCOPE" "$role" "$instance" 2>/dev/null)" || status=$?
  if [ "$status" = "$PX_EXIT_NO_OBJECT" ]; then
    px_error "disruption $(($1 + 1)): $role/$instance is absent, so it cannot recover"
    return 0
  fi
  if [ "$status" = 0 ] && [ "$(px_tsv_field 4 "$row")" = exited ]; then
    px_error "disruption $(($1 + 1)): the backend reports $role/$instance as exited, so it" \
      "cannot recover"
    return 0
  fi
  return 1
}

# Restarts a killed RegionServer, waits for the scope to become ready, and waits for the online
# region count to return to its pre-disruption baseline (aborting immediately if the target instance
# has exited or vanished), then writes a recover row whose timestamps determine mttr_seconds.
## @description  Waits for full cluster recovery after an injected disruption (index).
## @return       Writes the recover row (whose timestamps determine mttr_seconds) and exits 0.
recover_gate() {
  local index=$1 role instance status=0 out="" state recovered="" ready drain deadline regions
  local shared=0
  role=${DISRUPT_ROLE[$index]}
  instance=${DISRUPT_INDEX[$index]}
  ready="$(px_int_setting PX_TIMEOUT_READY 600 1 || exit "$?")" || status=$?
  drain="$(px_int_setting PX_TIMEOUT_DRAIN 600 1 || exit "$?")" || status=$?
  # A disruption triggered while a verb is running is bounded by that verb's deadline—the shared
  # timeout governing prepare and run—so recovery waiting never extends the overall test time limit
  # before the verb watcher terminates the verb at the bound.
  [ -z "$VERB_PID" ] || shared=$VERB_DEADLINE
  if [ "$status" = 0 ] && [ "${DISRUPT_ACTION[$index]}" = kill ]; then
    out="$(sb_restart_drain "$SCOPE" "$role" "$instance" "$(gate_bound "$drain" "$shared")" \
      "$(gate_bound "$ready" "$shared")" || exit "$?")" || status=$?
    record_rows "phase$PX_TAB$role$PX_TAB$instance$PX_TAB" "$out"
  fi
  if [ "$status" = 0 ]; then
    ready="$(gate_bound "$ready" "$shared")"
    deadline=$(($(px_epoch_s) + ready))
    sb_wait_ready "$SCOPE" "$ready" >/dev/null || status=$?
  fi
  # A server reports ready before its regions finish coming back online. Waiting for the regions
  # reuses the remainder of the same readiness bound so that a single disruption consumes at most
  # the drain bound and two readiness bounds, and it never queries regions-in-transition metrics
  # because they lag behind actual availability.
  # Failing to restore the region count is a failed recovery rather than a slow recovery, whereas
  # being cut short by the verb's shared timeout bound is a timeout. Because an exited instance
  # cannot bring any regions back online even when the aggregate count has already recovered, each
  # poll checks the instance state before reading the count. Because a read can start while the
  # instance is running and complete after it exits, observing a full count rechecks the instance
  # state as well. The recovery gate therefore monitors the instance until recovery completes, and
  # any exit after that point is handled by the anomaly watcher.
  if [ "$status" = 0 ]; then
    while :; do
      if gate_exited "$index"; then
        status=$PX_EXIT_FAIL
        break
      fi
      regions="$(region_count 2>/dev/null || true)"
      if [ -n "$regions" ] && [ "$regions" -ge "${DISRUPT_REGIONS[$index]}" ]; then
        if gate_exited "$index"; then
          status=$PX_EXIT_FAIL
        fi
        break
      fi
      if [ "$shared" -gt 0 ] && [ "$(px_epoch_s)" -ge "$shared" ]; then
        status=$PX_EXIT_TIMEOUT
        px_error "disruption $((index + 1)): the online regions are ${regions:-unread}, below" \
          "the ${DISRUPT_REGIONS[$index]} before the disruption, at the bound of the verb"
        break
      fi
      if [ "$(px_epoch_s)" -ge "$deadline" ]; then
        status=$PX_EXIT_FAIL
        px_error "disruption $((index + 1)): the online regions are ${regions:-unread}, below" \
          "the ${DISRUPT_REGIONS[$index]} before the disruption, at the end of PX_TIMEOUT_READY"
        break
      fi
      sleep "${PX_POLL_INTERVAL_S:-1}"
    done
  fi
  case "$status" in
  0)
    state=ok
    recovered="$(px_epoch_ms)"
    ;;
  "$PX_EXIT_TIMEOUT") state=timeout ;;
  *) state=fail ;;
  esac
  [ "$state" = ok ] || px_error "disruption $((index + 1)): no recovery, $state, exit $status"
  record_row recover "$((index + 1))" "${DISRUPT_INJECTED[$index]}" "$recovered" "$state"
  GATE_STATE=$state
  GATE_RECOVERED=$recovered
  # If the verb's shared deadline cuts recovery short, mark the verb as timed out and terminate it
  # just as the verb watcher would, even if the driver process itself has already exited.
  if [ "$state" != ok ] && [ "$shared" -gt 0 ] && [ "$(px_epoch_s)" -ge "$shared" ]; then
    VERB_TIMED_OUT=1
    px_error "the verb passed its bound during the recovery of disruption $((index + 1))"
    verb_terminate
  fi
}

## @description  Triggers every pending time-offset disruption whose scheduled offset after the
##               start of the run verb has arrived (now in epoch seconds).
## @return       Exit 0.
disrupt_due() {
  local now=$1 index=0
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    if [ "${DISRUPT_STATE[$index]}" = pending ] &&
      [ "${DISRUPT_KIND[$index]}" = offset ] &&
      [ "$now" -ge $((RUN_START_S + DISRUPT_WHEN[index])) ]; then
      disrupt_fire "$index"
    fi
    index=$((index + 1))
  done
}

## @description  Checks whether any pending disruption is waiting for a stage anchor.
## @return       Exits 0 when at least one anchor disruption is pending, or exits 1 otherwise.
disrupt_anchor_pending() {
  local index=0
  [ -n "$RUN_DIR" ] || return 1
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    case "${DISRUPT_STATE[$index]}:${DISRUPT_WHEN[$index]}" in
    pending:*@*) return 0 ;;
    esac
    index=$((index + 1))
  done
  return 1
}

# Ignores pre-existing stage rows copied into the bundle before the run started.
## @description  Reports every stage anchor opened by a verb in this run along with its current
##               state (open or closed) and the ts_ms timestamp of its most recent begin row.
## @return       Writes "anchor<TAB>state<TAB>ts_ms" rows to stdout and exits 0.
disrupt_anchor_states() {
  awk -F '\t' -v base="$STAGE_BASE" 'NR > base && $2 == "begin" { s[$3] = "open"; t[$3] = $1 }
    NR > base && $2 == "end" && s[$3] == "open" { s[$3] = "closed" }
    END { for (a in s) print a "\t" s[a] "\t" t[a] }' "$STAGES_FILE"
}

# In fire mode, open anchors trigger injection; in all modes (fire, mark, or sweep), closed anchors
# are marked as missed; and in sweep mode, still-open anchors are also marked as missed.
## @description  Evaluates pending anchor-triggered disruptions according to the requested mode
##               (fire, mark, or sweep).
## @return       Exits 0.
disrupt_anchors() {
  local mode=${1:-fire} index=0 states entry
  disrupt_anchor_pending || return 0
  states="$(disrupt_anchor_states)"
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    if [ "${DISRUPT_STATE[$index]}" = pending ] && [ "${DISRUPT_KIND[$index]}" = phase ]; then
      entry="$(px_tsv_get "${DISRUPT_WHEN[$index]}" "$states" || true)"
      case "$mode:${entry%%"$PX_TAB"*}" in
      fire:open) disrupt_fire "$index" ;;
      *:closed | sweep:open) disrupt_missed "$index" "${entry#*"$PX_TAB"}" ;;
      esac
    fi
    index=$((index + 1))
  done
}

# A missed anchor indicates that the target stage began without triggering the disruption, which
# the cluster check treats as a failure.
## @description  Marks a scheduled disruption (index, ts_ms of the begin row) as missed.
## @return       Exits 0.
disrupt_missed() {
  local index=$1 reason
  reason="anchor ${DISRUPT_WHEN[$index]} began at $2, the disruption did not fire"
  px_warn "disruption $((index + 1)) missed its anchor: $reason"
  record_row skip run "disruption $((index + 1))" "$reason"
  DISRUPT_STATE[index]=missed
}

## @description  Finalizes the disruption schedule by resuming any paused instance, marking unfired
##               entries whose anchor began as missed, and marking all other pending entries skip.
## @return       Exit 0.
disrupt_sweep() {
  local index=0 reason
  disrupt_resume
  disrupt_anchors sweep
  while [ "$index" -lt "$DISRUPT_COUNT" ]; do
    if [ "${DISRUPT_STATE[$index]}" = pending ]; then
      if [ "${DISRUPT_KIND[$index]}" = offset ]; then
        reason="the run verb ended before offset ${DISRUPT_WHEN[$index]}s"
      else
        reason="phase ${DISRUPT_WHEN[$index]} was not reached"
      fi
      px_warn "disruption $((index + 1)) did not fire: $reason"
      record_row skip run "disruption $((index + 1))" "$reason"
      DISRUPT_STATE[index]=skip
    fi
    index=$((index + 1))
  done
}

# ---------------------------------------------------------------------------
# Host safety and lifecycle guards
# ---------------------------------------------------------------------------

# Any non-quiet result that still permits the workload to proceed—including when the check is turned
# off—sets CONTAMINATION and records a contamination row.
## @description  Runs the px-tool quiet-host check before starting the workload.
## @return       Exits 0 to proceed, or returns the px-tool status (2 usage, 4 busy, 5 unmeasured).
quiet_check() {
  local rows status=0 state detail
  rows="$("$PX_HOME/bin/px-tool" quiet-host || exit "$?")" || status=$?
  record_rows "quiet$PX_TAB" "$(printf '%s\n' "$rows" | grep -v "^result$PX_TAB" || true)"
  state="$(px_tsv_get quiet_host "$rows")" || state=""
  state=${state%%"$PX_TAB"*}
  [ "$status" = 0 ] || return "$status"
  case "$state" in
  quiet) return 0 ;;
  off) detail="the quiet-host check is off" ;;
  *) detail="the host was ${state:-not measured}" ;;
  esac
  contaminate quiet-host "$detail"
}

## @description  Appends a contamination cause (cause, detail...) to the comma-separated
##               CONTAMINATION list carried by every metric record and writes a contamination row.
## @return       Exits 0.
contaminate() {
  CONTAMINATION="${CONTAMINATION:+$CONTAMINATION,}$1"
  record_row contamination "$1" "${*:2}, so a failed time verdict is ADVISORY"
}

## @description  Marks a measurement run as contaminated if its cluster sizing diverges from the
##               measurement table via a run configuration override or the deployment record.
## @return       Exits 0.
sizing_check() {
  local names topo="$RUN_DIR/cluster/topology.env" class name
  [ "$PX_RUN_CLASS" = measurement ] || return 0
  names="$(px_sizing_overrides)"
  # The deployment generator records the rendered run class along with any sizing variables that
  # diverge from that class; a deployment record without those entries reports no overrides.
  if [ -f "$topo" ]; then
    class="$(pb_env_value PX_RUN_CLASS "$topo")"
    if [ -n "$class" ] && [ "$class" != measurement ]; then
      contaminate sizing "the cluster has the sizing of the class $class"
      return 0
    fi
    for name in $(pb_env_value PX_SIZING_OVERRIDES "$topo"); do
      case " $names " in
      *" $name "*) ;;
      *) names="${names:+$names }$name" ;;
      esac
    done
  fi
  [ -n "$names" ] || return 0
  contaminate sizing "the sizing is not the measurement table, overridden: $names"
}

## @description  Copies health-monitor instance samples taken during this run into the run record
##               as monitor-phase sample rows so that peak memory calculations cover the full run.
## @return       Exits 0.
monitor_samples() {
  [ -n "$MONITOR_DIR" ] && [ -f "$MONITOR_DIR/samples.tsv" ] || return 0
  # Each monitor sample row begins with the literal "instance" followed by the standard sample
  # schema, whose first field is ts_ms.
  record_rows "sample${PX_TAB}monitor$PX_TAB" "$(awk -F '\t' -v t="$RUN_START_MS" \
    '$1 == "instance" && $2 + 0 >= t + 0 { print substr($0, 10) }' "$MONITOR_DIR/samples.tsv")"
}

# Looks up the run directory of the active health monitor for the current scope, stores it in
# MONITOR_DIR, and records a monitor row; if the monitor triggers a protective shutdown, it leaves
# its breach.tsv artifact in that directory.
## @description  Locates and records the health monitor run directory for the active cluster scope.
## @return       Exits 0.
monitor_find() {
  local record line=""
  record="$(px_guard_path monitor "$SCOPE" 2>/dev/null)" || return 0
  [ -f "$record" ] || return 0
  IFS= read -r line <"$record" || true
  MONITOR_DIR="$(px_tsv_field 3 "$line")" || MONITOR_DIR=""
  [ -z "$MONITOR_DIR" ] || record_row monitor pre "$MONITOR_DIR"
}

# ---------------------------------------------------------------------------
# Plug-in hooks and cluster checks
# ---------------------------------------------------------------------------

## @description  Invokes a run-level plug-in hook (hook, argument...) and records a FAIL verdict
##               row (or ADVISORY for collect) for each plug-in whose call failed.
## @return       Exits 0 when every plug-in call succeeds, or exits 1 otherwise.
hook_run() {
  local hook=$1 status=0 severity=FAIL id row failed=0
  shift
  [ -n "$PLUGINS_ENABLED" ] || return 0
  [ "$hook" != collect ] || severity=ADVISORY
  pl_hook_run "$hook" "$RUN_DIR" "$@" >>"$RUN_DIR/logs/hook-$hook.log" 2>&1 || status=$?
  [ "$status" != 0 ] || return 0
  # Because the plug-in loader appends a ts_ms, hook, status, and elapsed_ms row to each
  # plug-in's hooks.tsv file on every invocation, inspecting those rows identifies which
  # individual plug-in failed.
  while read -r id _; do
    [ -n "$id" ] || continue
    row="$(awk -F '\t' -v h="$hook" '$2 == h { s = $3 } END { print s }' \
      "$RUN_DIR/plugins/$id/hooks.tsv" 2>/dev/null || true)"
    case "$row" in '' | 0 | ok) continue ;; esac
    sx_verdict "plugin.$id.$hook" "$severity" "the $hook hook ended with exit $row," \
      "output in logs/hook-$hook.log"
    failed=1
  done <<EOF
$PLUGINS_ENABLED
EOF
  if [ "$failed" = 0 ]; then
    sx_verdict "plugin.$hook" "$severity" "the plug-in loader ended the $hook hook with" \
      "exit $status, output in logs/hook-$hook.log"
  fi
  return "$PX_EXIT_FAIL"
}

## @description  Executes suites/check-cluster.sh to write the verdict rows for the cluster and
##               plug-in checks, recording an ERROR row if a check script cannot run.
## @return       Exits 0.
checks_run() {
  local status=0 line names="" file
  local -a files=()
  # Any variable exported in the environment is treated by a child process as an operator-supplied
  # environment override, which takes precedence over plug-in thresholds. Unset thresholds loaded
  # from a run-class file or a configuration file before spawning the child so that it reloads
  # those files directly and preserves each setting's true origin.
  while IFS= read -r line; do
    case "$line" in
    PX_THRESHOLD_*"$PX_TAB"environment | PX_THRESHOLD_*"$PX_TAB"cli) ;;
    PX_THRESHOLD_*) names="$names ${line%%"$PX_TAB"*}" ;;
    esac
  done <<EOF
$PX_CONFIG_ORIGINS
EOF
  for file in ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; do
    files+=(--config "$file")
  done
  # Apply a single timeout equal to twice the verb timeout bound to cover the thresholds hooks,
  # the built-in check subjects, the steady-state checks, and the plug-in checks combined.
  (
    for line in $names; do
      unset "$line"
    done
    px_timeout "$((VERB_TIMEOUT * 2))" "$PX_HOME/suites/check-cluster.sh" \
      ${files[@]+"${files[@]}"}
  ) >>"$RUN_DIR/logs/check-cluster.log" 2>&1 || status=$?
  case "$status" in
  0 | 1) ;;
  *)
    sx_verdict cluster.checks ERROR "suites/check-cluster.sh ended with exit $status," \
      "output in logs/check-cluster.log"
    ;;
  esac
}

# ---------------------------------------------------------------------------
# Diagnostic collectors
# ---------------------------------------------------------------------------
# px-collect serves as the unified entry point for all telemetry collectors. px-run invokes
# px-collect once on its bundle immediately before the run verb to start collection and once
# immediately afterward to stop it; px-collect starts collectors in PB_COLLECTORS order—launching
# trace last so that its counters span the workload—and stops them in reverse order. Each call is
# allotted one verb timeout bound per synchronous px-collect step (pb_collect_steps), matching the
# time budget that px-suite reserves for a test's collectors.

# Any px-collect exit status other than 0 or 1 is recorded as an ADVISORY verdict for each active
# collector of the run, ensuring that telemetry loss never causes a test run to fail.
## @description  Invokes px-collect (action, option...) on the run bundle within its timeout bound.
## @return       Exits 0.
collect_call() {
  local action=$1 status=0 name
  shift
  px_timeout "$((VERB_TIMEOUT * $(pb_collect_steps "$COLLECTORS")))" "$PX_HOME/bin/px-collect" \
    "$action" "$RUN_DIR" "$@" </dev/null >/dev/null 2>>"$RUN_DIR/logs/px-collect.log" ||
    status=$?
  case "$status" in
  0 | 1) ;;
  *)
    for name in $COLLECTORS; do
      sx_verdict "collector.$name" ADVISORY "px-collect $action ended with exit $status," \
        "output in logs/px-collect.log"
    done
    ;;
  esac
}

# Each remote collection session is configured to self-terminate one verb timeout bound after the
# run verb's execution deadline. Setting COLLECT_LIVE prior to the invocation ensures that if a
# signal arrives while startup is in progress, the exit hook still executes the corresponding stop.
## @description  Starts all enabled telemetry collectors for the run via px-collect start.
## @return       Exits 0.
collectors_start() {
  local name
  [ -n "$COLLECTORS" ] || return 0
  if [ -z "$SCOPE" ]; then
    record_row skip run collectors "no scope id"
    for name in $COLLECTORS; do
      sx_verdict "collector.$name" SKIP "the run has no cluster"
    done
    return 0
  fi
  COLLECT_DUR=$((SHARED_DEADLINE - $(px_epoch_s) + VERB_TIMEOUT))
  [ "$COLLECT_DUR" -ge 1 ] || COLLECT_DUR=1
  COLLECT_LIVE=1
  collect_call start --collect "${COLLECTORS// /,}" --targets "${PX_COLLECT_TARGETS:-all}" \
    --duration "$COLLECT_DUR"
}

# This function also serves as the process exit hook. Invoking stop a second time against the same
# bundle writes nothing because px-collect stops only collectors whose collection window remains
# open.
## @description  Stops all active telemetry collectors for the run via px-collect stop.
## @return       Exits 0.
collectors_stop() {
  [ "$COLLECT_LIVE" = 1 ] || return 0
  collect_call stop
  COLLECT_LIVE=0
}

# ---------------------------------------------------------------------------
# Bundle finalization and run completion
# ---------------------------------------------------------------------------

## @description  Finalizes the run bundle by copying any health-monitor breach record, generating
##               the merged report, and writing and validating the bundle manifest.
## @return       Sets REPORT_STATUS and BUNDLE_STATUS, and exits 0.
bundle_finalize() {
  local log="$RUN_DIR/logs/px-bundle.log" check detail
  # Because the health monitor writes breach.tsv into its own run directory, copying the file into
  # the bundle preserves the triggering resource sample alongside the run that the breach ended.
  if [ -n "$MONITOR_DIR" ] && [ -f "$MONITOR_DIR/breach.tsv" ]; then
    if cp "$MONITOR_DIR/breach.tsv" "$RUN_DIR/breach.tsv"; then
      record_row breach "$RUN_DIR/breach.tsv"
    else
      px_warn "cannot copy $MONITOR_DIR/breach.tsv into $RUN_DIR"
    fi
  fi
  # Both tools operate exclusively on the bundle directory, so invoke them with only the
  # operator's initial configuration rather than the runtime settings loaded by this process.
  px_config_child "$PX_HOME/bin/px-report" "$RUN_DIR" >"$RUN_DIR/logs/px-report.log" \
    2>&1 || REPORT_STATUS=$?
  px_config_child "$PX_HOME/bin/px-bundle" write "$RUN_DIR" >"$log" 2>&1 ||
    BUNDLE_STATUS=$?
  if [ "$BUNDLE_STATUS" = 0 ]; then
    px_config_child "$PX_HOME/bin/px-bundle" validate "$RUN_DIR" >>"$log" 2>&1 ||
      BUNDLE_STATUS=$?
  fi
  [ "$BUNDLE_STATUS" != 0 ] || return 0
  px_warn "the bundle does not validate, exit $BUNDLE_STATUS, rows in logs/px-bundle.log"
  while IFS="$PX_TAB" read -r check _ detail; do
    px_warn "bundle check $check: $detail"
  done <<EOF
$(awk -F '\t' '$2 == "fail"' "$log")
EOF
}

## @description  Computes the final exit code for the run from the driver verb codes, any cluster
##               anomaly, the merged report verdict, and the bundle validation result.
## @return       Writes the computed exit code to stdout and exits 0.
run_code() {
  local code=$FIRST_CODE
  if [ "$ABORTED" = 1 ]; then
    code=$PX_EXIT_ANOMALY
  elif [ "$ANY_TIMED_OUT" = 1 ]; then
    code=$PX_EXIT_TIMEOUT
  fi
  if [ "$ANOMALY" = 1 ] && { [ "$code" = 0 ] || [ "$code" = 1 ]; }; then
    code=$PX_EXIT_ANOMALY
  fi
  if [ "$code" = 0 ]; then
    case "$REPORT_STATUS" in
    0 | 1 | 2 | 3) code=$REPORT_STATUS ;;
    *) code=$PX_EXIT_FAIL ;;
    esac
  fi
  if [ "$code" = 0 ] && [ "$BUNDLE_STATUS" != 0 ]; then
    code=$PX_EXIT_FAIL
  fi
  printf '%s\n' "$code"
}

## @description  Finalizes the diagnostic bundle, records the result row, and terminates the run
##               with either the caller-supplied status or the exit code computed by run_code.
## @return       Exits with the resolved exit code.
run_finish() {
  local code=${1:-} seen=no result
  bundle_finalize
  [ -n "$code" ] || code="$(run_code)"
  [ "$ANOMALY" = 0 ] || seen=yes
  record_row result "$code" "$(px_exit_name "$code")" "$seen"
  result="$(awk -F '\t' '$1 == "result" { r = $2 } END { print r }' \
    "$RUN_DIR/logs/px-report.log" 2>/dev/null || true)"
  px_exit_noted "$code" "run $RUN_ID ends at ${result:-no result} (exit $code," \
    "$(px_exit_name "$code"))"
  exit "$code"
}

# ---------------------------------------------------------------------------
# Dry-run execution plan
# ---------------------------------------------------------------------------

## @description  Emits the dry-run execution plan describing the actions a live run would perform.
## @return       Writes plan rows to stdout. Exit 0.
plan_print() {
  local root
  # Because px_out_root terminates inside a command substitution when the output root is invalid,
  # propagate its non-zero exit status directly to terminate px-run.
  root="$(px_out_root)" || exit "$?"
  record_row plan run_id "$RUN_ID"
  record_row plan run_dir "$root/runs/$RUN_ID"
  record_row plan run_class "${PX_RUN_CLASS:-}"
  record_row plan backend "${PX_BACKEND:-the default of the contract}"
  record_row plan scope "${SCOPE:-none, snapshots skipped}"
  record_row plan driver "$DRIVER_PATH"
  record_row plan driver_name "$DRIVER_NAME"
  record_row plan describe "accepted, $(pb_describe_rows phases | awk 'END { print NR }') phases"
  record_row plan verbs "$PB_VERBS"
  record_row plan driver_arguments "${#DRIVER_ARGS[@]}"
  record_row plan driver_timeout_s "$DRIVER_TIMEOUT"
  record_row plan verb_timeout_s "$VERB_TIMEOUT"
  record_row plan plugins "${PX_PLUGINS:-none}"
  record_row plan collectors "${COLLECTORS:-none}"
  if [ -n "$COLLECTORS" ]; then
    record_row plan collect_targets "${PX_COLLECT_TARGETS:-all}"
    record_row plan collect_bound_s "$((DRIVER_TIMEOUT + VERB_TIMEOUT))"
  fi
  record_row plan snapshot_pre \
    "sb_list sb_restart_count sb_image_ref sb_version_info sb_sample_resources"
  record_row plan quiet_host_wait_s "${PX_QUIET_HOST_WAIT_S:-0}"
  record_row plan disruptions "$DISRUPT_COUNT"
  disrupt_rows
  record_row plan snapshot_post "sb_list sb_restart_count sb_version_info sb_sample_resources"
  record_row plan diff "an unplanned restart, exit or loss gives exit $PX_EXIT_ANOMALY"
  record_row plan bundle "px-report BUNDLE, px-bundle write BUNDLE, px-bundle validate BUNDLE"
  if [ -z "$SCOPE" ]; then
    record_row plan checks "none, no cluster"
  else
    record_row plan checks suites/check-cluster.sh
  fi
}

# ---------------------------------------------------------------------------
# Command-line argument parsing and configuration
# ---------------------------------------------------------------------------

px_cli_parse "$@"
DRIVER_SPEC=${PX_CLI_ARGS[0]}
DRIVER_ARGS=(${PX_CLI_REST[@]+"${PX_CLI_REST[@]}"})
px_config_load -- ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}

# Resolve the target scope from PX_SCOPE_ID or from the scope recorded by px-cluster for the active
# cluster. Running without a provisioned cluster is a supported mode that skips cluster snapshots;
# catching the exit status inside the command substitution prevents the error trap from firing when
# no cluster object exists.
SCOPE_STATUS=0
SCOPE="$(sb_scope_resolve || exit "$?")" || SCOPE_STATUS=$?
case "$SCOPE_STATUS" in
0) ;;
"$PX_EXIT_NO_OBJECT") SCOPE="" ;;
*) px_die "$SCOPE_STATUS" "cannot resolve the scope of cluster ${PX_CLUSTER_ID:-default}" ;;
esac
DRIVER_TIMEOUT="$(px_int_setting PX_TIMEOUT_RUN 3600 1)" || exit "$?"
VERB_TIMEOUT="$(px_int_setting PX_TIMEOUT_VERB 300 1)" || exit "$?"
# Fail immediately before performing any other work—even during a dry run—if any configured
# plug-in cannot be loaded.
PLUGINS_ENABLED="$(pl_enabled || exit "$?")" || exit "$?"
DRIVER_PATH="$(pl_driver_resolve "$DRIVER_SPEC")" || exit "$?"
DRIVER_NAME="$(pl_driver_name "$DRIVER_SPEC" "$DRIVER_PATH")" || exit "$?"
disrupt_parse "${PX_DISRUPT_SPEC:-}"
COLLECTORS="$(pb_collectors_parse "${PX_COLLECTORS:-none}")" || exit "$?"
if [ "$DISRUPT_COUNT" -gt 0 ] && [ -z "$SCOPE" ]; then
  px_die "$PX_EXIT_USAGE" "a disruption needs a cluster, and no cluster" \
    "${PX_CLUSTER_ID:-default} is recorded: $PX_HINT_NO_CLUSTER"
fi
# Start each driver verb in the directory containing the suite file so that relative paths in test
# arguments resolve against the suite file's location.
if [ -n "${PX_SUITE_FILE:-}" ] && [ -d "$(dirname "$PX_SUITE_FILE")" ]; then
  VERB_CWD="$(dirname "$PX_SUITE_FILE")"
fi

# ---------------------------------------------------------------------------
# Dry-run termination: validate the driver's describe document, print the execution plan, and exit
# without invoking a backend or writing anything beyond the validated output root and state
# directory.
# ---------------------------------------------------------------------------

if px_is_dry_run; then
  RUN_ID="$(px_run_id)"
  describe_dry
  plan_print
  exit "$PX_EXIT_OK"
fi

# Require an explicit run class because every emitted metric record carries it, and records
# written without a class cannot be classified by downstream readers.
px_run_class_require

# ---------------------------------------------------------------------------
# Test run execution
# ---------------------------------------------------------------------------

sb_load
if [ -n "$SCOPE" ]; then
  SCOPE_STATUS=0
  sb_scope_exists "$SCOPE" || SCOPE_STATUS=$?
  if [ "$SCOPE_STATUS" != 0 ]; then
    px_die "$SCOPE_STATUS" "the scope $SCOPE is not usable"
  fi
fi

# Resolve the output root in the current shell so that PX_OUT is exported to every driver verb as
# a canonical physical path.
px_out_root >/dev/null
RUN_DIR="$(pb_bundle_create || exit "$?")" || exit "$?"
RUN_ID=${RUN_DIR##*/}
RECORD_FILE="$RUN_DIR/run-record.tsv"
STAGES_FILE="$RUN_DIR/stages.tsv"
DRIVER_DIR="$RUN_DIR/drivers/$DRIVER_NAME"
mkdir -p "$DRIVER_DIR" || px_die "$PX_EXIT_FAIL" "cannot create $DRIVER_DIR"
# Because px-run mints these per-run identifiers and paths itself, it exports them directly. The
# configuration loader preserves the first value assigned to a variable, which is appropriate for
# operator-supplied inputs but not for values generated by this command.
PX_RUN_ID=$RUN_ID
PX_RUN_DIR=$RUN_DIR
PX_DRIVER_NAME=$DRIVER_NAME
PX_DRIVER_DIR=$DRIVER_DIR
PX_SCOPE_ID=$SCOPE
PX_BACKEND="$(sb_bound_backend)"
PX_CONTAMINATION=""
PX_SUITE_NAME=${PX_SUITE_NAME:-}
PX_SUITE_FILE=${PX_SUITE_FILE:-}
PX_TEST_ID=${PX_TEST_ID:-}
export PX_HOME PX_OUT PX_RUN_ID PX_RUN_DIR PX_RUN_CLASS PX_CONTAMINATION PX_BACKEND PX_SCOPE_ID
export PX_DRIVER_NAME PX_DRIVER_DIR PX_SUITE_NAME PX_SUITE_FILE PX_TEST_ID
# Attribute records emitted by the harness itself to px-run, whereas driver verbs, plug-in hooks,
# and cluster checks each set their own record source.
PX_RECORD_SOURCE=px-run
printf '%s\n' "$RUN_DIR"
px_info "run $RUN_ID in $RUN_DIR"

# Exit hooks run in reverse registration order on every exit: the active verb is terminated and
# any open stage anchors are closed first, active telemetry collectors are stopped next, and the
# host sleep inhibitor is released last, while the cluster itself remains running. Converting INT
# and TERM signals into normal process exits guarantees that interrupted runs execute the complete
# cleanup sequence.
px_inhibit_start "run-$RUN_ID" "$$"
px_on_exit px_guard_release inhibit "run-$RUN_ID"
px_on_exit collectors_stop
px_on_exit verb_terminate
# Resume any paused instance on exit so that no daemon JVM remains paused after px-run terminates.
px_on_exit disrupt_resume quiet
trap 'exit 130' INT
trap 'exit 143' TERM

RUN_START_MS="$(px_epoch_ms)"
record_row run "$RUN_ID" "$PX_RUN_CLASS" "$PX_BACKEND" "$SCOPE" "$DRIVER_PATH"
record_row context driver "$DRIVER_NAME"
record_row context suite "$PX_SUITE_NAME"
record_row context test "$PX_TEST_ID"
record_row context session "${PX_SESSION_ID:-}"
record_row context plugins "$(printf '%s\n' "$PLUGINS_ENABLED" |
  awk -F '\t' 'NF { printf "%s%s", s, $1; s = " " }')"
# Open the planned-action timestamp window before reaching the first phase that can trigger a
# disruption so that every planned action recorded during this run falls within the window.
PLANNED_SINCE_MS="$(px_epoch_ms)"
phase_reached setup
[ -z "$SCOPE" ] || cluster_copy
STAGE_BASE="$(awk 'END { print NR }' "$STAGES_FILE")"
disrupt_rows

# Run the describe verb first. If the verb fails or its output document is rejected, terminate the
# run immediately with that exit code before executing any subsequent steps.
DESCRIBE_STATUS=0
describe_run || DESCRIBE_STATUS=$?
if [ "$DESCRIBE_STATUS" != 0 ]; then
  run_finish "$DESCRIBE_STATUS"
fi

# Execute the validate verb followed by the pre-run readiness gates required before prepare.
verb_run validate "$(verb_deadline)"
[ "$VERB_CODE" = 0 ] || block "validate failed"
if [ -n "$SCOPE" ]; then
  if ! snapshot_take pre; then
    sx_verdict cluster.snapshot FAIL "the pre-run snapshot cannot read the inventory"
    block "no pre-run snapshot"
  fi
  monitor_find
else
  px_warn "no scope id and no recorded cluster: px-run takes no snapshot and" \
    "checks no instance"
  record_row skip pre scope "no scope id"
fi
phase_reached snapshot_pre

QUIET_STATUS=0
quiet_check || QUIET_STATUS=$?
if [ "$QUIET_STATUS" != 0 ]; then
  sx_verdict host.quiet "$(sx_severity_of_code "$QUIET_STATUS")" \
    "the host is not proven quiet, px-tool quiet-host exit $QUIET_STATUS"
  note_code "$QUIET_STATUS"
  block "the host is not proven quiet"
fi
sizing_check
# Export the run's contamination status so that every emitted metric record carries it.
PX_CONTAMINATION=$CONTAMINATION
export PX_CONTAMINATION

if [ -z "$BLOCKED" ]; then
  hook_run fetch-data || block "the fetch-data hook failed"
fi

# The prepare and run verbs share a single overall execution deadline for the test.
PREPARE_RAN=0
if [ -z "$BLOCKED" ]; then
  SHARED_DEADLINE=$(($(px_epoch_s) + DRIVER_TIMEOUT))
  PREPARE_RAN=1
  verb_run prepare "$SHARED_DEADLINE"
  [ "$VERB_CODE" = 0 ] || block "prepare failed"
  if [ -z "$BLOCKED" ]; then
    hook_run pre-workload || block "the pre-workload hook failed"
  fi
  if [ -z "$BLOCKED" ]; then
    collectors_start
    verb_run run "$SHARED_DEADLINE"
    # Stopping a collector requires communicating with the target JVM, so resume any paused JVM
    # before stopping collectors.
    disrupt_resume
    collectors_stop
    hook_run post-workload || true
  fi
fi
if [ -n "$BLOCKED" ]; then
  px_warn "the workload did not run to its end: $BLOCKED"
  record_row skip run workload "$BLOCKED"
fi

if [ -n "$SCOPE" ]; then
  monitor_samples
  # An inability to read the post-run cluster inventory is not evidence that instances vanished,
  # so compare instance states and restart counts only when the post-run snapshot succeeds.
  if snapshot_take post; then
    restart_diff
  else
    sx_verdict cluster.snapshot FAIL "the post-run snapshot cannot read the inventory"
    record_row skip post diff "the post-run inventory cannot be read"
  fi
else
  record_row skip post scope "no scope id"
fi
phase_reached snapshot_post
disrupt_sweep
disrupt_rows

# Run restore whenever prepare ran, run report whenever validate ran, and then execute the cluster
# checks while the cluster remains active. Following an anomaly abort, restore is never executed
# because the cluster state cannot be trusted and invoking restore would block for its full timeout
# bound against an unresponsive instance.
if [ "$PREPARE_RAN" = 1 ]; then
  if [ "$ABORTED" = 1 ]; then
    sx_verdict driver.restore SKIP "anomaly abort: the cluster cannot be trusted, so restore" \
      "does not run"
  else
    verb_run restore "$(verb_deadline)"
  fi
fi
verb_run report "$(verb_deadline)"
[ -z "$SCOPE" ] || checks_run
hook_run collect || true

run_finish

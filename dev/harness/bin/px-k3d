# Front end for provisioning and tearing down the small, version-pinned k3s cluster through k3d to
# verify the Kubernetes backend. Because round K2 implements the cluster lifecycle behavior and its
# command-line options, this entry point responds to --help and rejects every other invocation with
# the unsupported exit code.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail

## @description  Prints the command-line usage summary and supported options.
## @return       Writes the help text to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-k3d [-h|--help]

Creates and removes the local cluster that proofs the Kubernetes backend.
Round K2 implements it.

Exit codes: 0 help, 2 usage, 5 unsupported until round K2.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
-*) px_usage_error "unknown option: $1" ;;
esac
px_die "$PX_EXIT_UNSUPPORTED" "px-k3d arrives with round K2"

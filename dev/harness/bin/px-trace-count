# This script serves as the trace counter front end, archiving Phoenix request trace outputs from
# selected roles into the result bundle. Because round A6 owns this behavior and its command-line
# options, this entry point responds to --help and rejects every other invocation with the
# unsupported exit code.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail

## @description  Prints the command-line usage and supported options for the trace-count front end.
## @return       Writes the usage text to stdout and exits 0.
usage() {
  cat <<'EOF'
Usage: px-trace-count [-h|--help]

Archives the trace counter outputs of selected roles into the bundle.
Round A6 implements it.

Exit codes: 0 help, 2 usage, 5 unsupported until round A6.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
-*) px_usage_error "unknown option: $1" ;;
esac
px_die "$PX_EXIT_UNSUPPORTED" "px-trace-count arrives with round A6"

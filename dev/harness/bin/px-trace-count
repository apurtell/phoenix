# Implements the Phoenix trace counter collector. The start and stop actions each capture a single
# snapshot of the counters across every RegionServer by invoking the px-trace-counters image reader
# inside client 0, and the stop action joins the two snapshots into traces/counters.tsv to record
# the change in each counter over the course of the run.
#
# When the client instance does not contain the reader binary, the collector skips itself and
# writes a SKIP row to the collector index; the run continues. Along with px-jfr, this collector is
# one of the two collectors that report SKIP when an underlying tool is absent. The shared
# lifecycle rules that govern every collector reside in lib/collect.sh.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/collect.sh
. "$SELF/../lib/collect.sh"

set -euo pipefail
px_trap_enable

## @description  Captures a counter snapshot (which: start or stop) into traces/<which>.tsv and
##               writes its index row, or writes a cluster skip row when the client has no reader.
## @return       Returns 0 on success or skip, or 1 when the snapshot fails.
trace_snapshot() {
  local which=$1 file="traces/$1.tsv" status=0
  mkdir -p "$PX_RUN_DIR/traces" || return "$PX_EXIT_FAIL"
  printf 'role\tindex\tbean\tcounter\tvalue\n' >"$PX_RUN_DIR/$file.tmp"
  sb_exec "$CK_SCOPE" client 0 "" -- px-trace-counters >>"$PX_RUN_DIR/$file.tmp" || status=$?
  if [ "$status" = 0 ]; then
    mv -f "$PX_RUN_DIR/$file.tmp" "$PX_RUN_DIR/$file"
    pb_collector trace "$which" ok "$file" "$(($(wc -l <"$PX_RUN_DIR/$file") - 1)) counters"
    return 0
  fi
  rm -f "$PX_RUN_DIR/$file.tmp"
  case "$status" in
  127)
    pb_collector trace cluster skip "" "client 0 has no px-trace-counters"
    return 0
    ;;
  6 | 125)
    pb_collector trace cluster skip "" "client 0 is absent or not running, exit $status"
    return 0
    ;;
  esac
  pb_collector trace "$which" fail "$file" "px-trace-counters in client 0 ended with exit $status"
  return "$PX_EXIT_FAIL"
}

## @description  Captures the initial counter snapshot and records the stage begin anchor.
## @return       Returns 0 on success, or 1 when the snapshot fails.
trace_start() {
  local status=0
  trace_snapshot start || status=$?
  pb_stage begin collector@trace "Phoenix counters of every RegionServer"
  return "$status"
}

## @description  Captures the final snapshot, joins both snapshots into traces/counters.tsv, and
##               records the stage end anchor and collector verdict.
## @return       Returns 0 on success, or 1 when a snapshot fails.
trace_stop() {
  local status=0 file=traces/counters.tsv
  # Avoid writing duplicate rows when the px-run exit hook invokes the stop action a second time.
  if ! ck_done trace cluster && ! ck_done trace stop &&
    [ -f "$PX_RUN_DIR/traces/start.tsv" ]; then
    trace_snapshot stop || status=$?
  fi
  if [ "$status" = 0 ] && ! ck_done trace counters && [ -f "$PX_RUN_DIR/traces/stop.tsv" ]; then
    awk -F '\t' -v OFS='\t' 'FNR == 1 { next }
      NR == FNR { first[$1 OFS $2 OFS $3 OFS $4] = $5; next }
      { k = $1 OFS $2 OFS $3 OFS $4
        if (k in first) print k, first[k], $5, $5 - first[k]; else print k, "", $5, "" }' \
      "$PX_RUN_DIR/traces/start.tsv" "$PX_RUN_DIR/traces/stop.tsv" >"$PX_RUN_DIR/$file.tmp"
    { printf 'role\tindex\tbean\tcounter\tstart\tstop\tdelta\n'; cat "$PX_RUN_DIR/$file.tmp"; } \
      >"$PX_RUN_DIR/$file"
    rm -f "$PX_RUN_DIR/$file.tmp"
    pb_collector trace counters ok "$file" "the change of each counter over the run"
  fi
  pb_stage end collector@trace
  ck_verdict trace
}

px_cli_spec <<'EOF'
about Reads the Phoenix counters of every RegionServer: each integer *Count and
+ *_num_ops attribute of the beans Server, PhoenixIndexer, GlobalIndexChecker,
+ PhoenixMetadata and MetadataCaching, through px-trace-counters in client 0.
about start writes traces/start.tsv; stop writes traces/stop.tsv and joins both into
+ traces/counters.tsv: role index bean counter start stop delta. The rows go to
+ metrics/index.tsv, and the verdict is collector.trace.
shared --cluster
opt --run DIR CK_RUN | the bundle, default PX_RUN_DIR
sub start
about take the first snapshot of the counters
sub stop
about take the last snapshot and join both into
+ traces/counters.tsv
exits 0 also means skipped, 1 a snapshot failed, 6 also no bundle or no scope.
example px-trace-count start --run "$PX_RUN_DIR"
EOF

px_cli_parse "$@"
ck_main trace
TRACE_STATUS=0
if [ "$CK_ACTION" = start ]; then
  trace_start || TRACE_STATUS=$?
else
  trace_stop || TRACE_STATUS=$?
fi
exit "$TRACE_STATUS"

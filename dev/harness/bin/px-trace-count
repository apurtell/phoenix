# This script provides the invocation-count front end, collecting the deterministic evidence that
# the design favors over wall-clock timing: exact invocation counts, database query counters, and
# allocated heap volume. Because counts do not shift under host load, regressions evaluated from
# counts remain reliable on shared development machines where elapsed durations do not.
#
# The shared telemetry library in lib/telemetry.sh defines the command surface, target resolution
# logic, and artifact naming conventions, while round A6 attaches the counting agent to the target
# roles and reads the collected counters back. Because trace counts are comparable only between runs
# instrumented with the exact same agent binary, resolution accepts only the staged agent.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/telemetry.sh
. "$SELF/../lib/telemetry.sh"

set -euo pipefail
px_trap_enable

# Supported counter families, each of which records a deterministic count and never a duration:
#   invocations  Tracks how many times each traced method executed.
#   phoenix      Captures the query counters reported by the database client.
#   allocations  Measures the total volume of heap memory allocated during the run.
TM_KIND=traces TM_INDEX_TOOL=trace TM_TOOL=px-trace-agent.jar
TM_STAGED=trace/px-trace-agent.jar TM_TEST=-f TM_PATH_FALLBACK=0
TM_LIST_CMD=counters TM_OPT=--counter TM_LIST="invocations phoenix allocations"
TM_DEFAULT=invocations TM_EXT=tsv
TM_ENV_TARGETS=PX_TRACE_TARGETS TM_ENV_DURATION=PX_TRACE_DURATION_S
TM_SKIP="px-trace-agent.jar is not staged under PX_TOOLKIT_DIR"
TM_WARN="px-trace-agent.jar is not staged, every counting target is skipped"
TM_A6="round A6 attaches the counting agent. px-trace-count plan reports the targets"

## @description  Prints the command-line usage and supported options for the trace-count front end.
## @return       Writes the usage text to stdout and exits 0.
usage() {
  cat <<'EOF'
Usage: px-trace-count [plan|record|counters] [option...]

Subcommands:
  plan       report what record would do, write nothing. The default
  record     collect the counts [A6 attaches the counting agent]
  counters   print the counter families this front end accepts

Options:
  --target ROLE[/INDEX]  a counting target, repeatable, default
                         PX_TRACE_TARGETS. An index defaults to 0
  --counter NAME         invocations, phoenix or allocations, default
                         invocations
  --duration S           seconds to count, default PX_TRACE_DURATION_S
  --out DIR              the output directory, default the run directory
  --config FILE          an extra configuration file, repeatable
  -v, --verbose          report detail
  -h, --help             show this text

Exit codes: 0 ok or skipped, 1 failure, 2 usage, 5 a behaviour a later round
owns, 6 no such object.
EOF
}

tm_main "$@"

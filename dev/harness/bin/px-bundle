# The result-bundle tool writes the bundle for a completed run and verifies any bundle supplied to
# it.
#
# Round A5 owns the underlying behavior: A5 defines the required artifact paths in
# docs/bundle-format.md, writes the manifest with its steady-state anchors, and verifies a bundle
# without requiring a driver to be present. The current round delivers the command name, the
# complete option surface, and the argument validation checks so that a suite, a run wrapper, and an
# operator can all be written against the final interface before the format exists. Every execution
# path that requires the format reports the unsupported status code and identifies round A5.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail
px_trap_enable

BUNDLE_ACTION=""
BUNDLE_RUN=""
BUNDLE_PATH=""
BUNDLE_OUT=""
BUNDLE_CONFIG_FILES=()

## @description  Outputs the command-line interface syntax, options, and exit code reference.
## @return       Writes usage documentation to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-bundle <write|verify> [option...]

Subcommands:
  write      collect the artifacts of one run into a bundle [A5]
  verify     check a bundle against the required artifact paths [A5]

Options:
  --run DIR       the run directory to bundle, default PX_RUN_DIR
  --bundle PATH   the bundle to verify, or the bundle write produces
  --out DIR       where write puts the bundle, default the run directory
  --config FILE   an extra configuration file, repeatable
  -v, --verbose   report detail
  -h, --help      show this text

Exit codes: 0 ok, 1 the bundle is not valid, 2 usage, 5 a behaviour round A5
owns, 6 no such run or bundle.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -v | --verbose) px_config_set PX_VERBOSE 1 cli ;;
  --run) px_cli_need_value "$@" && BUNDLE_RUN="$2" && shift ;;
  --bundle) px_cli_need_value "$@" && BUNDLE_PATH="$2" && shift ;;
  --out) px_cli_need_value "$@" && BUNDLE_OUT="$2" && shift ;;
  --config) px_cli_need_value "$@" && BUNDLE_CONFIG_FILES+=("$2") && shift ;;
  -*) px_usage_error "unknown option: $1" ;;
  *)
    [ -z "$BUNDLE_ACTION" ] || px_usage_error "unexpected argument: $1"
    BUNDLE_ACTION=$1
    ;;
  esac
  shift
done

if [ -z "$BUNDLE_ACTION" ]; then
  px_usage_error "name a subcommand: write or verify"
fi
case "$BUNDLE_ACTION" in
write | verify) ;;
*) px_usage_error "unknown subcommand: $BUNDLE_ACTION" ;;
esac

px_config_load ${BUNDLE_CONFIG_FILES[@]+"${BUNDLE_CONFIG_FILES[@]}"}

# Argument validation runs in the current round because these checks do not depend on the bundle
# format. Validating paths upfront ensures that an operator discovers an invalid path immediately
# rather than after round A5 lands.
if [ "$BUNDLE_ACTION" = write ]; then
  if [ -z "$BUNDLE_RUN" ]; then
    BUNDLE_RUN="${PX_RUN_DIR:-}"
  fi
  if [ -z "$BUNDLE_RUN" ]; then
    px_usage_error "name the run with --run, or export PX_RUN_DIR"
  fi
  if [ ! -d "$BUNDLE_RUN" ]; then
    px_die "$PX_EXIT_NO_OBJECT" "no such run directory: $BUNDLE_RUN"
  fi
  # Because a result bundle is a run artifact, it must reside under the configured output root like
  # every other artifact. This boundary check executes here at the top level rather than in round A5
  # so that a rejected path terminates the main process immediately instead of exiting a subshell.
  if [ -n "$BUNDLE_OUT" ]; then
    BUNDLE_DEST="$(px_out_resolve "$BUNDLE_OUT")" || exit $?
    px_debug "the bundle would go to $BUNDLE_DEST"
  fi
else
  if [ -z "$BUNDLE_PATH" ]; then
    px_usage_error "name the bundle with --bundle"
  fi
  if [ ! -e "$BUNDLE_PATH" ]; then
    px_die "$PX_EXIT_NO_OBJECT" "no such bundle: $BUNDLE_PATH"
  fi
fi

px_die "$PX_EXIT_UNSUPPORTED" \
  "px-bundle $BUNDLE_ACTION arrives with round A5, which also writes docs/bundle-format.md"

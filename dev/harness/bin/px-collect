# Coordinates metric collection for an execution run. This initial implementation round defines
# three core components: the collector registry, the metric output contract, and the periodic
# sampling loop that drives the resource collector through the substrate contract. Round A6 later
# attaches the host samplers, the jHiccup idle control collector, and the garbage-collection log
# collectors to the topology, while preserving the registry entries and the output contract
# established here.
#
# OUTPUT CONTRACT
#   <out>/metrics/<collector>.csv   Produces one file per collector whose first line contains the
#                                   column header. For the resource collector, this header is
#                                   derived directly from the sample schema in the substrate
#                                   contract, ensuring that one schema definition governs both the
#                                   columns emitted by a backend and the columns read by consumers.
#   <out>/metrics/index.tsv         Records one row per selected collector containing the columns
#                                   tool, target, status, artifact, and detail. The bundle reads
#                                   this index so that a skipped collector is always recorded and
#                                   never silently omitted.
# Any field containing a comma, a quote, or a space is enclosed in double quotes with internal
# quotes doubled, matching the standard format expected by spreadsheets and data frames.
#
# The sampling cadence is always a whole number of seconds. Sub-second sampling acts as a profiling
# operation rather than metric collection, so px-profile owns that faster cadence.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail
px_trap_enable

# ---------------------------------------------------------------------------
# Collector registry
# ---------------------------------------------------------------------------
# The registry is stored in parallel indexed arrays to maintain compatibility with bash 3.2, which
# lacks associative arrays. The owner column identifies the implementation round that provides the
# collector, while the tool column identifies the host dependency required to run it; "contract"
# denotes the substrate contract, and an empty value indicates that nothing outside the harness is
# needed.

COLLECT_NAMES=(container host hiccup gc)
COLLECT_OWNERS=(A1 A6 A6 A6)
COLLECT_TOOLS=(contract "" jhiccup "")
COLLECT_SUMMARIES=(
  "per-instance processor, memory, network and block samples"
  "host processor, memory and load samples"
  "JVM pause measurement against an idle control runtime"
  "garbage-collection logs staged from the target roles"
)

COLLECT_SELECTED=()
COLLECT_LIST=0
COLLECT_OUT=""
COLLECT_INTERVAL=""
COLLECT_DURATION=""
COLLECT_TARGETS=""
COLLECT_STOP=0
COLLECT_BOUND=0
COLLECT_AT=""

## @description  Prints the command-line usage reference and collector registry documentation.
## @return       Writes usage text to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-collect [option...]

Options:
  --list              print the collector registry and stop
  --collector NAME    collect this metric source, repeatable, default container
  --interval S        seconds between two samples, default PX_COLLECT_INTERVAL_S
  --duration S        seconds to sample, 0 runs until a signal arrives
  --targets LIST      the roles to sample, comma separated, default all
  --scope ID          the scope to sample, default PX_SCOPE_ID, else the scope
                      that px-cluster up recorded for PX_CLUSTER_ID
  --out DIR           the output directory, default the run directory
  --config FILE       an extra configuration file, repeatable
  -v, --verbose       report detail
  -h, --help          show this text

Exit codes: 0 ok or skipped, 1 failure, 2 usage, 4 timeout, 5 a collector a
later round owns, 6 no such collector or scope.
EOF
}

# Stores the resolved index in COLLECT_AT rather than writing to stdout so that callers do not run
# the lookup inside a command-substitution subshell, where the failure trap would report an expected
# negative lookup as an error.
## @description  Looks up the array index of a named collector in the collector registry.
## @param        collector name
## @return       Sets COLLECT_AT. Exits with 0 on match, or 6 when the name is not a collector.
collect_find_position() {
  local i=0
  COLLECT_AT=""
  while [ "$i" -lt "${#COLLECT_NAMES[@]}" ]; do
    if [ "${COLLECT_NAMES[$i]}" = "${1:-}" ]; then
      COLLECT_AT="$i"
      return 0
    fi
    i=$((i + 1))
  done
  return "$PX_EXIT_NO_OBJECT"
}

# Evaluates collector readiness at the given registry index: reports "ready" when implemented in
# this round (A1) and its required host tool is available, "absent" when the host tool is missing,
# and "deferred" when implementation belongs to a later round.
## @description  Determines the availability state of the collector at a given registry position.
## @param        registry position
## @return       Writes the state label to stdout and exits with status 0.
collect_state() {
  local tool="${COLLECT_TOOLS[$1]}"
  if [ "${COLLECT_OWNERS[$1]}" != A1 ]; then
    printf 'deferred\n'
  elif [ -z "$tool" ] || [ "$tool" = contract ]; then
    printf 'ready\n'
  elif command -v "$tool" >/dev/null 2>&1; then
    printf 'ready\n'
  else
    printf 'absent\n'
  fi
}

# Emits one tab-separated row per collector containing the collector name, owning implementation
# round, required tool, current availability state, and summary description.
## @description  Outputs the full collector registry table.
## @return       Writes TSV rows to stdout and exits with status 0.
collect_list() {
  local i=0
  while [ "$i" -lt "${#COLLECT_NAMES[@]}" ]; do
    px_tsv_row "${COLLECT_NAMES[$i]}" "${COLLECT_OWNERS[$i]}" \
      "${COLLECT_TOOLS[$i]:--}" "$(collect_state "$i")" "${COLLECT_SUMMARIES[$i]}"
    i=$((i + 1))
  done
}

# Defers sourcing the substrate contract until a collector actually requires backend access, so that
# listing the registry or reporting command-line usage errors succeeds even when no cluster or
# backend is present.
## @description  Lazily loads and binds the substrate backend contract on first use.
## @return       Exits with status 0.
collect_backend() {
  if [ "$COLLECT_BOUND" = 0 ]; then
    # shellcheck source=SCRIPTDIR/../lib/backend/contract.sh
    . "$SELF/../lib/backend/contract.sh"
    COLLECT_BOUND=1
  fi
  sb_load
}

# Must be called after collect_backend because sb_scope_resolve is defined by the substrate
# contract. Exits with status 6 when no scope is specified or recorded, status 2 on an invalid
# cluster name or a refused state directory, and status 1 when the state directory cannot be
# created.
## @description  Resolves the active sampling scope when --scope was not explicitly provided.
## @return       Sets COLLECT_SCOPE and exits with 0, or exits with 6, 2, or 1 on resolution error.
collect_scope() {
  local status=0
  if [ -n "$COLLECT_SCOPE" ]; then
    return 0
  fi
  COLLECT_SCOPE="$(sb_scope_resolve || exit "$?")" || status=$?
  if [ "$status" = "$PX_EXIT_NO_OBJECT" ]; then
    px_die "$PX_EXIT_NO_OBJECT" \
      "no scope recorded for cluster ${PX_CLUSTER_ID:-default}." \
      "Run px-cluster up, or name the scope with --scope or PX_SCOPE_ID."
  fi
  if [ "$status" != 0 ]; then
    exit "$status"
  fi
}

# Because the raw schema declaration includes multiline line breaks and indentation, consecutive
# whitespace runs are collapsed into single spaces before converting the field list into a
# comma-separated header line.
## @description  Formats the field names of a substrate schema as a single CSV header line.
## @param        schema name
## @return       Writes the CSV header to stdout and exits with 0, or returns 6 on unknown schema.
collect_csv_header() {
  local fields
  fields="$(sb_schema_fields "$1")" || return "$PX_EXIT_NO_OBJECT"
  while [ "$fields" != "${fields//  / }" ]; do
    fields=${fields//  / }
  done
  fields=${fields# }
  fields=${fields% }
  printf '%s\n' "${fields// /,}"
}

# Extracts fields explicitly by column index rather than splitting through IFS so that empty columns
# preserve their positional alignment whenever a metrics source omits a sample schema field that has
# no local equivalent.
## @description  Converts a tab-separated sample row into a properly quoted CSV row.
## @param        row, column count
## @return       Writes the formatted CSV row to stdout and exits with status 0.
collect_csv_row() {
  local row=$1 count=$2 i=1 field out=""
  while [ "$i" -le "$count" ]; do
    field="$(px_tsv_field "$i" "$row")" || field=""
    case "$field" in
    *,* | *'"'* | *' '*)
      field=${field//\"/\"\"}
      field=\"$field\"
      ;;
    esac
    if [ "$i" = 1 ]; then
      out=$field
    else
      out="$out,$field"
    fi
    i=$((i + 1))
  done
  printf '%s\n' "$out"
}

# Records the outcome of a collector execution in the index file consumed by the bundle so that
# downstream packaging knows whether each selected collector ran, was skipped, or failed.
## @description  Appends a status entry for a collector to the metrics index file.
## @param        collector, target, status, artifact, detail
## @return       Exits with status 0.
collect_record() {
  px_tsv_row "$1" "$2" "$3" "$4" "$(px_tsv_clean "$5")" >>"$COLLECT_INDEX"
}

## @description  Checks whether a given cluster role is included in the active target filter list.
## @param        role
## @return       Returns 0 when the role is selected for collection, or 1 otherwise.
collect_wanted() {
  local want
  case "$COLLECT_TARGETS" in
  "" | all) return 0 ;;
  esac
  for want in ${COLLECT_TARGETS//,/ }; do
    if [ "$want" = "$1" ]; then
      return 0
    fi
  done
  return 1
}

# Formats the delay as fractional seconds, which both supported host platforms accept, so the
# sampling loop remains anchored to an absolute wall-clock schedule rather than drifting by adding
# the sample execution time to every interval.
## @description  Sleeps for the requested duration in milliseconds.
## @param        milliseconds
## @return       Exits with status 0, setting COLLECT_STOP when a signal interrupts the sleep.
collect_sleep_ms() {
  local ms=$1
  if [ "$ms" -le 0 ]; then
    return 0
  fi
  sleep "$((ms / 1000)).$(printf '%03d' "$((ms % 1000))")" || COLLECT_STOP=1
}

# Because the backend returns one row per instance in a single call, each sampling pass costs only
# one substrate invocation regardless of how many instances are running. Returns 0 when collection
# completes or is skipped, returns 1 on a sampling failure, exits with 6 when the target scope is
# absent, and exits with 1 when the runtime fails to respond.
## @description  Periodically samples resource metrics for all instances in the scope into a CSV.
## @param        csv path
## @return       Exits with 0 when run or skipped, 1 on sampling or runtime failure, or 6 if absent.
collect_container() {
  local csv=$1 columns role_col header rows row role tick=0 samples=0
  local start_ms due_ms now_ms status=0
  collect_backend
  if ! sb_supports sb_sample_resources ||
    ! sb_capability resource_sampling >/dev/null; then
    collect_record container "$COLLECT_TARGETS" skip "" \
      "the backend declares no resource sampling"
    px_warn "container: the backend has no metrics source, skipped"
    return 0
  fi
  sb_scope_exists "$COLLECT_SCOPE" || status=$?
  if [ "$status" = "$PX_EXIT_NO_OBJECT" ]; then
    px_die "$PX_EXIT_NO_OBJECT" "no such scope: $COLLECT_SCOPE"
  fi
  if [ "$status" != 0 ]; then
    px_die "$status" "cannot tell whether the scope $COLLECT_SCOPE exists"
  fi
  header="$(collect_csv_header sample)"
  columns="$(sb_schema_count sample)"
  # Resolve the role column index once before entering the sampling loop so that filtering rows by
  # target role does not spawn a subprocess for every sample.
  role_col="$(sb_schema_index sample role)"
  printf '%s\n' "$header" >"$csv"
  px_info "container: every $COLLECT_INTERVAL s into $csv"
  start_ms="$(px_epoch_ms)"
  while [ "$COLLECT_STOP" = 0 ]; do
    status=0
    rows="$(sb_call sb_sample_resources "$COLLECT_SCOPE")" || status=$?
    if [ "$status" = "$PX_EXIT_UNSUPPORTED" ]; then
      collect_record container "$COLLECT_TARGETS" skip "$csv" \
        "the backend stopped reporting resource metrics"
      return 0
    fi
    if [ "$status" != 0 ]; then
      collect_record container "$COLLECT_TARGETS" fail "$csv" \
        "a sampling pass failed with status $status"
      px_error "container: a sampling pass failed with status $status"
      return "$PX_EXIT_FAIL"
    fi
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      role="$(px_tsv_field "$role_col" "$row")" || role=""
      if collect_wanted "$role"; then
        collect_csv_row "$row" "$columns" >>"$csv"
        samples=$((samples + 1))
      fi
    done <<EOF
$rows
EOF
    tick=$((tick + 1))
    if [ "$COLLECT_DURATION" != 0 ] &&
      [ "$((tick * COLLECT_INTERVAL))" -ge "$COLLECT_DURATION" ]; then
      break
    fi
    now_ms="$(px_epoch_ms)"
    due_ms=$((start_ms + tick * COLLECT_INTERVAL * 1000))
    collect_sleep_ms "$((due_ms - now_ms))"
  done
  collect_record container "$COLLECT_TARGETS" ok "$csv" \
    "$samples sample rows in $tick passes"
  px_info "container: $samples sample rows in $tick passes"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -v | --verbose)
    PX_VERBOSE=1
    export PX_VERBOSE
    ;;
  --list) COLLECT_LIST=1 ;;
  --collector) px_cli_need_value "$@" && COLLECT_SELECTED+=("$2") && shift ;;
  --interval) px_cli_need_value "$@" && COLLECT_INTERVAL="$2" && shift ;;
  --duration) px_cli_need_value "$@" && COLLECT_DURATION="$2" && shift ;;
  --targets) px_cli_need_value "$@" && COLLECT_TARGETS="$2" && shift ;;
  --scope) px_cli_need_value "$@" && COLLECT_SCOPE="$2" && shift ;;
  --out) px_cli_need_value "$@" && COLLECT_OUT="$2" && shift ;;
  --config) px_cli_need_value "$@" && COLLECT_CONFIG_FILES+=("$2") && shift ;;
  -*) px_usage_error "unknown option: $1" ;;
  *) px_usage_error "unexpected argument: $1" ;;
  esac
  shift
done

if [ "$COLLECT_LIST" = 1 ]; then
  collect_list
  exit 0
fi

if [ "${#COLLECT_CONFIG_FILES[@]}" -gt 0 ]; then
  px_config_load "${COLLECT_CONFIG_FILES[@]}"
else
  px_config_load
fi

if [ "${#COLLECT_SELECTED[@]}" = 0 ]; then
  COLLECT_SELECTED=(container)
fi
if [ -z "$COLLECT_INTERVAL" ]; then
  COLLECT_INTERVAL="${PX_COLLECT_INTERVAL_S:-5}"
fi
if [ -z "$COLLECT_DURATION" ]; then
  COLLECT_DURATION="${PX_COLLECT_DURATION_S:-0}"
fi
if [ -z "$COLLECT_TARGETS" ]; then
  COLLECT_TARGETS="${PX_COLLECT_TARGETS:-all}"
fi
if ! [[ $COLLECT_INTERVAL =~ $PX_RE_INT ]] || [ "$COLLECT_INTERVAL" -lt 1 ]; then
  px_usage_error "--interval needs a whole number of seconds, got '$COLLECT_INTERVAL'"
fi
if ! [[ $COLLECT_DURATION =~ $PX_RE_INT ]]; then
  px_usage_error "--duration needs a whole number of seconds, got '$COLLECT_DURATION'"
fi

# Validate every selected collector before starting any sampling run so that an operator learns
# about an unknown or deferred collector immediately rather than after a long collection period.
COLLECT_POSITIONS=()
for COLLECT_NAME in "${COLLECT_SELECTED[@]}"; do
  if ! collect_find_position "$COLLECT_NAME"; then
    px_die "$PX_EXIT_NO_OBJECT" "no such collector: $COLLECT_NAME"
  fi
  if [ "${COLLECT_OWNERS[$COLLECT_AT]}" != A1 ]; then
    px_die "$PX_EXIT_UNSUPPORTED" \
      "the $COLLECT_NAME collector arrives with round ${COLLECT_OWNERS[$COLLECT_AT]}"
  fi
  COLLECT_POSITIONS+=("$COLLECT_AT")
done

# Resolve the target scope before creating any output directories or files so that a missing cluster
# never leaves an empty metrics index behind.
collect_backend
collect_scope

# Execute each step of the output directory policy at the top level of the script so that any path
# refusal terminates the main process directly rather than exiting only a subshell.
if [ -n "$COLLECT_OUT" ]; then
  COLLECT_DIR="$(px_out_subdir "$COLLECT_OUT/metrics")" || exit $?
elif [ -n "${PX_RUN_DIR:-}" ]; then
  COLLECT_DIR="$(px_out_subdir "$PX_RUN_DIR/metrics")" || exit $?
else
  COLLECT_DIR="$(px_run_dir)" || exit $?
  COLLECT_DIR="$(px_out_subdir "$COLLECT_DIR/metrics")" || exit $?
fi
COLLECT_INDEX="$COLLECT_DIR/index.tsv"
: >>"$COLLECT_INDEX"

# Catch termination signals to stop the sampling loop gracefully while preserving the collected
# files, because a partially completed collection still provides diagnostic evidence. Because the
# shared library owns the EXIT trap, this command registers handlers only for INT and TERM.
trap 'COLLECT_STOP=1' INT TERM

COLLECT_STATUS=0
for COLLECT_AT in "${COLLECT_POSITIONS[@]}"; do
  case "${COLLECT_NAMES[$COLLECT_AT]}" in
  container) collect_container "$COLLECT_DIR/container.csv" || COLLECT_STATUS=$? ;;
  esac
done
exit "$COLLECT_STATUS"

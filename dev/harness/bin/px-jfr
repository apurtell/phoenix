# This script provides the flight-recorder front end while delegating the command surface, target
# resolution, and artifact naming to lib/telemetry.sh. Round A6 starts and stops recordings within
# each target role and stages the resulting files alongside the run artifacts.
#
# Because the recorder itself is built into the role runtime, this front end does not stage any
# components into a role. On the host, it requires only the recording reader that converts a
# captured recording into the summary included in the result bundle.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/telemetry.sh
. "$SELF/../lib/telemetry.sh"

set -euo pipefail
px_trap_enable

# Define the two stock settings profiles supported by the recorder. The "default" profile imposes
# low overhead so a measurement run can keep it active for its entire duration, whereas the
# "profile" configuration enables the broader event set required for diagnostic analysis.
TM_KIND=jfr TM_INDEX_TOOL=jfr TM_TOOL=jfr
TM_STAGED=jdk/bin/jfr TM_TEST=-x TM_PATH_FALLBACK=1
TM_LIST_CMD=settings TM_OPT=--settings TM_LIST="default profile" TM_DEFAULT=default
TM_EXT=jfr
TM_ENV_TARGETS=PX_JFR_TARGETS TM_ENV_DURATION=PX_JFR_DURATION_S
TM_SKIP="the jfr reader is not staged under PX_TOOLKIT_DIR and not on PATH"
TM_WARN="the jfr reader is absent, every recording target is skipped"
TM_A6="round A6 drives the recorder. px-jfr plan reports the targets"

## @description  Outputs the command-line usage documentation.
## @return       Writes usage information to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-jfr [plan|record|settings] [option...]

Subcommands:
  plan       report what record would do, write nothing. The default
  record     take the recordings [A6 drives the recorder]
  settings   print the settings profiles this front end accepts

Options:
  --target ROLE[/INDEX]  a recording target, repeatable, default
                         PX_JFR_TARGETS. An index defaults to 0
  --settings NAME        default or profile, default default
  --duration S           seconds to record, default PX_JFR_DURATION_S
  --out DIR              the output directory, default the run directory
  --config FILE          an extra configuration file, repeatable
  -v, --verbose          report detail
  -h, --help             show this text

Exit codes: 0 ok or skipped, 1 failure, 2 usage, 5 a behaviour a later round
owns, 6 no such object.
EOF
}

tm_main "$@"

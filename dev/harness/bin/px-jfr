# Front end for capturing Java Flight Recorder sessions against selected cluster roles and staging
# the resulting recordings alongside the run artifacts. Because round A6 implements the recording
# workflow and its command-line options, this entry point responds to --help and rejects every
# other invocation with the unsupported exit code.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail

## @description  Outputs the command-line usage documentation.
## @return       Writes usage information to stdout and exits with status 0.
usage() {
  cat <<'EOF'
Usage: px-jfr [-h|--help]

Takes Java Flight Recorder sessions against selected roles.
Round A6 implements it.

Exit codes: 0 help, 2 usage, 5 unsupported until round A6.
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
-*) px_usage_error "unknown option: $1" ;;
esac
px_die "$PX_EXIT_UNSUPPORTED" "px-jfr arrives with round A6"

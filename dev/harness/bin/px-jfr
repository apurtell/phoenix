# This script provides the flight-recorder front end. The current round establishes the command
# surface, target resolution, and artifact naming, whereas round A6 starts and stops recordings
# within each target role and stages the resulting files alongside the run artifacts.
#
# Because the recorder itself is built into the role runtime, this front end does not stage any
# components into a role. On the host, it requires only the recording reader that converts a raw
# recording into the summary included in the result bundle. If a host lacks that reader, the tool
# records a skip rather than a failure, because telemetry serves as diagnostic evidence and never
# acts as an execution gate.
#
# ARTIFACT NAMING
#   <out>/jfr/index.tsv                 Lists the tool, target, status, artifact, and detail
#                                       columns, with one row per target.
#   <out>/jfr/<role>-<index>/<settings>-<session>.jfr
#                                       Stores one recording. The session tag is the run id, so all
#                                       artifacts from a run sort together and separate runs cannot
#                                       overwrite each other.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"

set -euo pipefail
px_trap_enable

# Define the two stock settings profiles supported by the recorder. The "default" profile imposes
# low overhead so a measurement run can keep it active for its entire duration, whereas the
# "profile" configuration enables the broader event set required for diagnostic analysis.
JFR_SETTINGS_LIST="default profile"
JFR_TOOL="jfr"

JFR_ACTION=""
JFR_SPEC=""
JFR_SETTINGS=""
JFR_DURATION=""
JFR_OUT=""
JFR_CONFIG_FILES=()
JFR_ROWS=""
JFR_TOOL_PATH=""

## @description  Outputs the command surface documentation.
## @return       Writes usage information to stdout and returns exit code 0.
usage() {
  cat <<'EOF'
Usage: px-jfr [plan|record|settings] [option...]

Subcommands:
  plan       report what record would do, write nothing. The default
  record     take the recordings [A6 drives the recorder]
  settings   print the settings profiles this front end accepts

Options:
  --target ROLE[/INDEX]  a recording target, repeatable, default
                         PX_JFR_TARGETS. An index defaults to 0
  --settings NAME        default or profile, default default
  --duration S           seconds to record, default PX_JFR_DURATION_S
  --out DIR              the output directory, default the run directory
  --config FILE          an extra configuration file, repeatable
  -v, --verbose          report detail
  -h, --help             show this text

Exit codes: 0 ok or skipped, 1 failure, 2 usage, 5 a behaviour a later round
owns, 6 no such object.
EOF
}

# The target specification accepts either commas or spaces as separators because configuration files
# and shell command lines naturally favor different delimiters. Results are stored in the JFR_ROWS
# global variable rather than written to stdout so that a malformed target terminates the main
# process immediately with the usage exit code instead of failing inside a subshell.
## @description  Converts the target specification into tab-separated role and index rows.
## @param        specification  The target specification string to parse.
## @return       Sets JFR_ROWS to TSV rows of role and index, or exits 2 on a malformed target.
jfr_parse_targets() {
  local item role index
  JFR_ROWS=""
  for item in ${1//,/ }; do
    role=${item%%/*}
    index=${item#*/}
    if [ "$index" = "$item" ]; then
      index=0
    fi
    if [ -z "$role" ] || ! [[ $index =~ $PX_RE_INT ]]; then
      px_usage_error "a target is ROLE or ROLE/INDEX, got '$item'"
    fi
    JFR_ROWS="$JFR_ROWS$role$PX_TAB$index$PX_NL"
  done
  if [ -z "$JFR_ROWS" ]; then
    px_usage_error "name a target with --target, or set PX_JFR_TARGETS"
  fi
}

# Resolution prefers the reader binary staged under the toolkit directory so that a run inspects its
# recordings with the same version used to capture them. The resolved location is stored in a global
# variable rather than written to stdout because probing inside a command substitution executes in a
# subshell, which would cause the failure trap to report an absent tool as an error when its absence
# is an expected outcome.
## @description  Locates the recording reader executable for inspecting captured recordings.
## @return       Sets JFR_TOOL_PATH and returns exit code 0, or exit code 6 if the tool is absent.
jfr_find_tool() {
  local staged="${PX_TOOLKIT_DIR:-}/jdk/bin/$JFR_TOOL"
  JFR_TOOL_PATH=""
  if [ -n "${PX_TOOLKIT_DIR:-}" ] && [ -x "$staged" ]; then
    JFR_TOOL_PATH="$staged"
    return 0
  fi
  if command -v "$JFR_TOOL" >/dev/null 2>&1; then
    JFR_TOOL_PATH="$JFR_TOOL"
    return 0
  fi
  return "$PX_EXIT_NO_OBJECT"
}

# Planning writes no files to disk and requires no running cluster, allowing an operator to verify
# target resolution and artifact naming before starting a run.
## @description  Reports the recording plan by emitting one row per target with its output path.
## @param        base directory  The base output directory under which recording paths are formed.
## @return       Writes TSV rows to stdout and returns exit code 0.
jfr_plan() {
  local base=$1 row role index
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    role="$(px_tsv_field 1 "$row")"
    index="$(px_tsv_field 2 "$row")"
    px_tsv_row "$role" "$index" "$JFR_SETTINGS" "$JFR_DURATION" \
      "$base/$role-$index/$JFR_SETTINGS-$JFR_SESSION.jfr"
  done <<EOF
$JFR_ROWS
EOF
}

# The reader availability check runs before any recording attempt so that a host unable to read a
# recording logs a skip for every target and completes successfully.
## @description  Captures flight recordings for all resolved targets.
## @param        base directory  The base output directory where index and recording files reside.
## @return       Exits 0 when every target is skipped, or exits 5 while round A6 owns the recorder.
jfr_record() {
  local base=$1 row role index
  if ! jfr_find_tool; then
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      role="$(px_tsv_field 1 "$row")"
      index="$(px_tsv_field 2 "$row")"
      px_tsv_row jfr "$role/$index" skip "" \
        "the $JFR_TOOL reader is not staged under PX_TOOLKIT_DIR and not on PATH" \
        >>"$base/index.tsv"
    done <<EOF
$JFR_ROWS
EOF
    px_warn "the $JFR_TOOL reader is absent, every recording target is skipped"
    return 0
  fi
  px_debug "the recording reader is $JFR_TOOL_PATH"
  px_die "$PX_EXIT_UNSUPPORTED" \
    "round A6 drives the recorder. px-jfr plan reports the targets"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  -v | --verbose)
    PX_VERBOSE=1
    export PX_VERBOSE
    ;;
  --target)
    px_cli_need_value "$@"
    JFR_SPEC="$JFR_SPEC $2"
    shift
    ;;
  --settings) px_cli_need_value "$@" && JFR_SETTINGS="$2" && shift ;;
  --duration) px_cli_need_value "$@" && JFR_DURATION="$2" && shift ;;
  --out) px_cli_need_value "$@" && JFR_OUT="$2" && shift ;;
  --config) px_cli_need_value "$@" && JFR_CONFIG_FILES+=("$2") && shift ;;
  -*) px_usage_error "unknown option: $1" ;;
  *)
    if [ -n "$JFR_ACTION" ]; then
      px_usage_error "unexpected argument: $1"
    fi
    JFR_ACTION="$1"
    ;;
  esac
  shift
done

if [ -z "$JFR_ACTION" ]; then
  JFR_ACTION=plan
fi
case "$JFR_ACTION" in
plan | record) ;;
settings)
  for JFR_NAME in $JFR_SETTINGS_LIST; do
    printf '%s\n' "$JFR_NAME"
  done
  exit 0
  ;;
*) px_usage_error "unknown subcommand: $JFR_ACTION" ;;
esac

if [ "${#JFR_CONFIG_FILES[@]}" -gt 0 ]; then
  px_config_load "${JFR_CONFIG_FILES[@]}"
else
  px_config_load
fi

if [ -z "$JFR_SETTINGS" ]; then
  JFR_SETTINGS=default
fi
if [ -z "$JFR_DURATION" ]; then
  JFR_DURATION="${PX_JFR_DURATION_S:-60}"
fi
if [ -z "$JFR_SPEC" ]; then
  JFR_SPEC="${PX_JFR_TARGETS:-}"
fi
case " $JFR_SETTINGS_LIST " in
*" $JFR_SETTINGS "*) ;;
*) px_usage_error "--settings accepts $JFR_SETTINGS_LIST, got '$JFR_SETTINGS'" ;;
esac
if ! [[ $JFR_DURATION =~ $PX_RE_INT ]] || [ "$JFR_DURATION" -lt 1 ]; then
  px_usage_error "--duration needs a whole number of seconds, got '$JFR_DURATION'"
fi
jfr_parse_targets "$JFR_SPEC"

# The session tag links every artifact from a single invocation together. When an active run
# already provides an identifier, this invocation reuses it so that each recording and its manifest
# remain consistent.
JFR_SESSION="${PX_RUN_ID:-$(px_run_id)}"

if [ -n "$JFR_OUT" ]; then
  JFR_BASE="$JFR_OUT/jfr"
elif [ -n "${PX_RUN_DIR:-}" ]; then
  JFR_BASE="$PX_RUN_DIR/jfr"
elif [ "$JFR_ACTION" = record ]; then
  JFR_BASE="$(px_run_dir)/jfr"
else
  JFR_BASE="$(px_out_root)/jfr"
fi

# Evaluate the output directory policy at the top level rather than inline within a command
# argument so that a policy refusal terminates the main process instead of exiting only a subshell.
if [ "$JFR_ACTION" = plan ]; then
  JFR_DIR="$(px_out_resolve "$JFR_BASE")" || exit $?
  jfr_plan "$JFR_DIR"
  exit 0
fi
JFR_DIR="$(px_out_subdir "$JFR_BASE")" || exit $?
jfr_record "$JFR_DIR"

# px-suite executes a declarative test suite definition. It orders tests according to their
# declared dependencies, narrows that schedule using positional execution boundaries and explicit
# selection filters, executes each test within a bounded timeout, and aggregates the outcomes into a
# single overall session severity.
#
# The specification below defines the normative suite grammar. Because both built-in suites and
# external plug-in suites target this specification, any modification to the grammar alters a
# published interface contract.
#
# ---------------------------------------------------------------------------
# THE SUITE GRAMMAR
# ---------------------------------------------------------------------------
# A suite definition consists of a line-oriented text file where every line is either blank, a
# full-line comment, or a single directive written in "key: value" form. During parsing, leading and
# trailing whitespace is stripped independently from both the key and the value. Because comments
# must occupy an entire line beginning with a hash character (#), directive values may freely
# contain literal hash characters without escaping.
#
# The parser strictly rejects any unrecognized directive key and reports the offending line number.
# Failing fast on unknown directives prevents typos or unsupported options from silently disabling
# or misconfiguring a test, providing immediate diagnostic feedback to the suite author.
#
# Structurally, a suite file is divided into two regions: a header section followed by one or more
# test blocks. All directives appearing prior to the first "test" directive establish suite-wide
# metadata and default attributes in the suite header. Each "test" directive opens a new test
# definition block, and all subsequent directives apply to that test until the next "test"
# directive or the end of the file.
#
# HEADER DIRECTIVES
#   suite: <name>           Declares the logical name of the suite, defaulting to the suite file
#                           name without its extension.
#   description: <text>     Provides a one-line summary of the suite for an operator.
#   class: <name>           Sets the default run class for each test that declares none. The
#                           --class command-line option—or otherwise the class recorded in the
#                           cluster record—overrides both suite-level and test-level class values.
#   requires: <name>...     Sets the default role-group requirements for each test that declares
#                           none.
#   timeout: <seconds>      Sets the default execution time limit for each test that declares none.
#
# TEST DIRECTIVES
#   test: <id>              Begins a new test block identified by <id>, which must be unique within
#                           the file and match the regular expression ^[A-Za-z0-9][A-Za-z0-9_-]*$.
#                           All harness components reference the test using this identifier.
#   name: <text>            Assigns a human-readable display name to the test, defaulting to the
#                           test id when omitted.
#   driver: <name>          Names the required execution driver that px-run invokes for this test.
#                           Each test consists of a single driver run.
#   disrupt: <spec>         Declares a fault disruption for a driver test, forwarded to px-run as
#                           --disrupt <spec>. This directive is repeatable.
#   args: <text>            Appends whitespace-delimited arguments for the driver without performing
#                           globbing or shell expansion, ensuring patterns such as *.sql reach the
#                           driver verbatim. This directive is repeatable, and each occurrence
#                           appends to the argument list.
#   arg: <text>             Appends a single literal argument to the driver invocation so that an
#                           argument may contain spaces or be empty. This directive is repeatable.
#   needs: <id>...          Declares prerequisite test ids, separated by spaces or commas, that must
#                           complete before this test runs. This directive is repeatable.
#   class: <name>           Sets the execution run class for this individual test.
#   requires: <name>...     Declares the cluster role groups required by this test; "yarn" is the
#                           only requirement recognized in this round. Before running the test, the
#                           harness validates host memory capacity and starts each required group,
#                           then stops the group afterward even if the test fails. The target
#                           cluster scope is taken from PX_SCOPE_ID when set, or otherwise from the
#                           scope recorded by px-cluster for PX_CLUSTER_ID.
#   timeout: <seconds>      Sets the execution time limit for this test as a whole number of seconds
#                           greater than zero.
#
# Declaring any single-valued directive more than once within the same test block is rejected as an
# error so that a later line cannot silently overwrite an earlier value.
#
# AN EXAMPLE
#   suite: smoke
#   class: validation
#   timeout: 600
#
#   test: create
#     name: Create the schema
#     driver: psql
#     args: sql/create.sql
#
#   test: count
#     name: Count the rows
#     needs: create
#     requires: yarn
#     driver: psql
#     args: sql/count.sql
#
#   Every driver invocation receives PX_SUITE_NAME, PX_SUITE_FILE, and PX_TEST_ID in its
#   environment.
#
# WHAT px-suite WRITES
#   Standard output is reserved exclusively for machine-readable TSV records: a dry run emits one
#   plan row per selected test, whereas a live run streams one result row as each test completes
#   and concludes with a single session row. An interrupted session emits no session row.
#     plan row     position id name mode target class requires timeout_s
#     result row   position id severity exit_code elapsed_ms reason bundle
#     session row  result result exit_code session_dir
#   The bundle column records the run directory path reported by px-run, or remains empty when a
#   test did not execute.
#   The session directory contains plan.tsv, results.tsv, summary.tsv, groups.tsv, and one
#   subdirectory per test. In addition to session counts, summary.tsv records the active version
#   set: the HBase profile, the HBase and Hadoop releases, and every configured JDK. Each test
#   directory holds stdout.txt for the test's structured data channel and stderr.log for its
#   diagnostic messages. A dry run writes nothing at all to disk: it resolves each driver and
#   validates its describe document, and it invokes the suites hook with a temporary output
#   directory.
#
# WHAT A DRIVER TEST BECOMES
#   For a driver-backed test, px-suite delegates execution to px-run using the command form:
#     px-run <driver> --timeout <seconds>
#            [--class <name>] [--config <file>...] [--disrupt <spec>...] --
#            <declared arguments>
#   forwarding only the operator-supplied configuration so that px-run loads its own run class.
#   px-run owns the run directory and reports that path on its data channel, which px-suite captures
#   in the test's stdout.txt file. While px-run bounds the driver with the test's declared time
#   limit, px-suite bounds the outer px-run process with that limit plus a fixed margin, the short
#   verb and check bounds (PX_TIMEOUT_VERB), the four bounded hooks of each enabled plug-in, the
#   recovery gate of each disruption, and the quiet-host wait duration and one poll interval of the
#   test's run class; px_suite_run_limit enumerates each term. The test's severity is the worst of
#   its exit code and the effective verdicts in report/verdicts.tsv within the bundle. px-run takes
#   its snapshots, waits for a quiet host, and writes its result outside the driver time bound.
#   Because each command tears down only the resources that it provisioned, both individual tests
#   and the enclosing suite session leave the cluster running, and session cleanup stops only the
#   role groups that the session itself started.
#
# ORDER, BOUNDARIES AND FILTERS
#   1. The parser records tests in the exact order they appear in the suite file.
#   2. Topological sorting schedules each test after all of its declared prerequisites. Ties between
#      simultaneously ready tests are broken by declaration order to produce a deterministic plan,
#      and any dependency cycle aborts parsing with an error that prints the offending cycle.
#   3. The --from and --to flags slice the topologically ordered schedule inclusively at both ends.
#   4. The --only flag restricts the plan to the listed test ids, whereas --skip removes the listed
#      test ids from the slice.
#   5. If boundaries or filters exclude a prerequisite of a selected test, the harness logs a
#      warning but still runs the test because the operator explicitly requested that selection. If
#      a prerequisite was part of the plan but failed or was skipped during execution, any dependent
#      test is automatically skipped with a result row explaining the unfulfilled dependency.
#
# SEVERITY
#   The "Verdict severity" section of the README specifies how a test's process exit code and
#   recorded verdicts map onto the severity lattice defined in suites/lib/common.sh.

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/../lib/common.sh
. "$SELF/../lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/backend/contract.sh
. "$SELF/../lib/backend/contract.sh"
# shellcheck source=SCRIPTDIR/../suites/lib/common.sh
. "$SELF/../suites/lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/plugin.sh
. "$SELF/../lib/plugin.sh"

set -euo pipefail

# Role-group requirements recognized by this version of the harness. Each requirement identifies a
# cluster role group that the backend can dynamically start and stop, and the identifier is passed
# through to the backend verbatim. Future additions to the supported role groups are registered in
# this single list.
SUITE_REQUIREMENTS="yarn"

# Base grace period, in seconds, granted to px-run beyond a test's own driver time limit to cover
# the pre-run and post-run snapshots and result-row recording. Because the quiet-host wait duration
# and one poll interval of the test's run class are added on top of this margin, px-suite's outer
# timeout never terminates px-run before px-run finishes reporting its result.
SUITE_RUN_MARGIN_S=300

# Regular expression defining the valid syntax for a test identifier.
SUITE_ID_RE='^[A-Za-z0-9][A-Za-z0-9_-]*$'

# Enabled plug-ins reported once by lib/plugin.sh as "id<TAB>dir" rows.
SUITE_PLUGINS=""

# Command-line option values captured during argument parsing before the configuration loader runs.
OPT_SKIP=""
OPT_SUITE=""
OPT_CLASS=""

# In-memory representation of the parsed suite definition. Because Bash 3.2 lacks associative
# arrays, each test is represented by a shared integer index across parallel indexed arrays.
SUITE_FILE=""
SUITE_NAME=""
SUITE_DESCRIPTION=""
SUITE_CLASS=""
SUITE_REQUIRES=""
SUITE_TIMEOUT=""
SUITE_WORDS=""
# Flattened storage for the driver arguments of all tests, holding one argument per element in file
# declaration order. Because Bash 3.2 cannot nest arrays, each test records the starting index of
# its first argument and its total argument count; since all directives of a test block are adjacent
# in the suite file, its arguments occupy a contiguous slice here.
SUITE_ARGV=()
TEST_ID=()
TEST_NAME=()
TEST_DRIVER=()
TEST_DISRUPT=()
TEST_ARG_FIRST=()
TEST_ARG_COUNT=()
TEST_NEEDS=()
TEST_CLASS=()
TEST_REQUIRES=()
TEST_TIMEOUT=()
TEST_LINE=()
TEST_SEEN=()
TEST_SEVERITY=()
# Records 1 when a test verified at least one check, including a SKIP test that emitted verdicts of
# another severity, allowing dependent tests that declare it in needs to proceed.
TEST_CHECKED=()

# Topologically sorted test order, the set of already-scheduled test ids during sorting, and the
# filtered execution plan. Each list is stored as a space-delimited string of array indices or test
# ids paired with an explicit integer counter so that element counts can be queried without spawning
# a subprocess in Bash 3.2.
ORDER=""
ORDER_COUNT=0
PLACED=" "
PLAN=""
PLAN_COUNT=0

# Runtime state, artifact file paths, and per-severity outcome counters for the active execution
# session.
SESSION_DIR=""
SESSION_ID=""
SESSION_SEVERITY="PASS"
SESSION_RESULT=""
PLAN_FILE=""
RESULT_FILE=""
GROUP_FILE=""
COUNT_PASS=0
COUNT_SKIP=0
COUNT_ADVISORY=0
COUNT_FAIL=0
COUNT_ERROR=0
COUNT_RAN=0
COUNT_NOT_RUN=0

# Tracking state for cluster role groups started by this process that must be stopped on release,
# along with the resolved backend scope that owns them and the outcome of the last group operation.
GROUPS_HELD=""
GROUP_SCOPE=""
GROUP_REASON=""
GROUP_SEVERITY=""
GROUP_STATUS=0

# Execution outcome variables populated by the most recent invocation of px_suite_run_one.
RUN_SEVERITY=""
RUN_STATUS=0
RUN_REASON=""
RUN_ELAPSED=0
RUN_CONCLUSIVE=1
RUN_BUNDLE=""
COUNT_INCONCLUSIVE=0

px_cli_spec <<'EOF'
about Runs a declarative suite file as one session.
about SUITE is a path, or a name under PX_SUITE_DIR with or without the .suite
+ extension.
about When the session ends, by a pass, a failure or an interrupt, it stops the role
+ groups it started, unless --keep or PX_KEEP=1 keeps them. The cluster stays up;
+ px-cluster down removes it.
shared --cluster --class --backend
operands SUITE
opt --from ID PX_SUITE_FROM | the first test of the ordered plan, inclusive
opt --to ID PX_SUITE_TO | the last test of the ordered plan, inclusive
opt --only IDS PX_SUITE_FILTER | run exactly these tests, comma separated
opt --skip IDS OPT_SKIP | do not run these tests, comma separated
opt --continue-on-failure - PX_SUITE_CONTINUE=1 | record a failure and continue, then report the
+ worst severity of the session
opt --keep - PX_KEEP=1 | keep the role groups that the session started and
+ the temporary files
output TSV rows on stdout: a dry run writes the plan, a run writes one result
+ row per test (position, id, severity, code, elapsed ms, reason, bundle), then
+ result, the session result, the code and the session directory. The session
+ directory holds the test rows with the output of every test. --class, else the
+ class of the cluster record, sets the run class of every test, over the class
+ that the suite declares.
verdicts The worst severity of the session decides the code, and a session in which
+ every test was skipped is INCONCLUSIVE:
exits 6 also means no such suite or test.
example px-suite smoke --class validation
example px-suite functional --class validation --from second --continue-on-failure
EOF

## @description  Resolves a suite (name, hook base) from a path, PX_SUITE_DIR, or a plug-in suite.
## @return       Writes the absolute path to stdout (or nothing if none is readable) and exits 0, or
##               exits 2 on a failed hook or a hook path outside its plug-in.
px_suite_resolve() {
  local name=${1:-} base=${2:-} dir candidate listed="" id path pdir found=""
  # Execute the suites hook unconditionally on every resolution attempt so that each enabled plug-in
  # observes a consistent invocation regardless of which resolution stage locates the suite file.
  if [ -n "$SUITE_PLUGINS" ]; then
    listed="$(pl_hook_run suites "$base" || exit "$?")" ||
      px_die "$PX_EXIT_USAGE" "the suites hook of a plug-in failed"
  fi
  while IFS="$PX_TAB" read -r id path; do
    [ -n "$id" ] || continue
    case "/$path/" in
    //* | */../*)
      px_die "$PX_EXIT_USAGE" "the suites hook of plug-in $id lists '$path'," \
        "which is not a path inside the plug-in"
      ;;
    esac
    [ -z "$found" ] || continue
    pdir="$(px_tsv_get "$id" "$SUITE_PLUGINS" || true)"
    case "${path##*/}" in
    "$name" | "$name.suite") [ ! -f "$pdir/$path" ] || found="$pdir/$path" ;;
    esac
  done <<EOF
$listed
EOF
  if [ -f "$name" ]; then
    px_realpath "$name"
    return 0
  fi
  dir="${PX_SUITE_DIR:-$PX_HOME/suites}"
  case "$dir" in
  /*) ;;
  *) dir="$PX_HOME/$dir" ;;
  esac
  for candidate in "$dir/$name" "$dir/$name.suite" "$name.suite" "$found"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      px_realpath "$candidate"
      return 0
    fi
  done
}

# Validates each planned test's driver during a dry run by resolving the driver binary and invoking
# its describe verb under PX_TIMEOUT_VERB to verify that pb_describe_load accepts the output.
## @description  Verifies that every planned driver resolves and produces a valid describe document.
## @return       Exits 0 when all drivers validate, or exits 2 if a driver fails to resolve or its
##               describe document is refused.
px_suite_describe_check() {
  local index path name dir status bound=${PX_TIMEOUT_VERB:-300}
  dir="$(px_mktemp_dir px-describe)" || exit "$?"
  for index in $PLAN; do
    [ -n "${TEST_DRIVER[$index]}" ] || continue
    path="$(pl_driver_resolve "${TEST_DRIVER[$index]}")" ||
      px_die "$PX_EXIT_USAGE" "test ${TEST_ID[$index]}: the driver does not resolve"
    name="$(pl_driver_name "${TEST_DRIVER[$index]}" "$path")"
    status=0
    px_timeout "$bound" env -i "PATH=$PATH" "HOME=${HOME:-}" "TMPDIR=${TMPDIR:-/tmp}" \
      "PX_HOME=$PX_HOME" "PX_DRIVER_NAME=$name" PX_VERB=describe "$path" describe \
      >"$dir/$index.json" 2>"$dir/$index.log" || status=$?
    if [ "$status" != 0 ]; then
      cat "$dir/$index.log" >&2 || true
      px_die "$PX_EXIT_USAGE" "test ${TEST_ID[$index]}: describe of driver $name ended with" \
        "exit $status"
    fi
    pb_describe_load "$dir/$index.json" ||
      px_die "$PX_EXIT_USAGE" "test ${TEST_ID[$index]}: the describe document of driver" \
        "$name is refused"
    px_debug "test ${TEST_ID[$index]}: driver $name, describe accepted"
  done
}

## @description  Looks up the parallel-array index of a test by its identifier.
## @return       Writes the index to stdout and exits 0, or exits 6 when no such test is declared.
px_suite_index_of() {
  local id=${1:-} index=0 total=${#TEST_ID[@]}
  while [ "$index" -lt "$total" ]; do
    if [ "${TEST_ID[$index]}" = "$id" ]; then
      printf '%s\n' "$index"
      return 0
    fi
    index=$((index + 1))
  done
  return "$PX_EXIT_NO_OBJECT"
}

## @description  Validates that a timeout value is a whole number of seconds greater than zero,
##               matching the domain accepted by px_timeout.
## @return       Exits 0 when valid, or exits 2 on any other value.
px_suite_check_timeout() {
  if ! [[ ${1:-} =~ $PX_RE_INT ]] || [ "$1" -lt 1 ]; then
    px_die "$PX_EXIT_USAGE" "$2: timeout needs whole seconds above zero, got '${1:-}'"
  fi
}

# Uses the shell read builtin to tokenize the string so that words never undergo pathname
# expansion.
## @description  Splits a whitespace-delimited text string into a named array in the caller.
## @return       Populates the caller's array and exits 0.
px_suite_split() {
  IFS=$' \t\n' read -r -d '' -a "$1" <<<"${2:-}" || true
}

# Validates each requirement token against the supported vocabulary and fails closed on any unknown
# requirement name.
## @description  Validates requirement tokens (value, location, list) and appends them to
##               SUITE_WORDS.
## @return       Sets SUITE_WORDS and exits 0, or exits 2 on an unknown requirement.
px_suite_check_requires() {
  local value=${1:-} where=$2 word
  local -a words
  SUITE_WORDS=${3:-}
  px_suite_split words "${value//,/ }"
  for word in ${words[@]+"${words[@]}"}; do
    case " $SUITE_REQUIREMENTS " in
    *" $word "*) SUITE_WORDS="${SUITE_WORDS:+$SUITE_WORDS }$word" ;;
    *)
      px_die "$PX_EXIT_USAGE" "$where: unknown requirement '$word'," \
        "this harness knows: $SUITE_REQUIREMENTS"
      ;;
    esac
  done
}

## @description  Records that a test block has declared a single-valued directive and rejects
##               duplicate declarations of the same directive.
## @return       Exits 0 on the first declaration, or exits 2 on a repeated directive.
px_suite_once() {
  local index=$1 key=$2 where=$3
  case "${TEST_SEEN[$index]}" in
  *" $key "*)
    px_die "$PX_EXIT_USAGE" \
      "$where: '$key' is declared twice in test '${TEST_ID[$index]}'"
    ;;
  esac
  TEST_SEEN[index]="${TEST_SEEN[$index]}$key "
}

# Header directives define the default attributes inherited by every test in the suite, allowing a
# run class or execution time limit to be declared once per file.
## @description  Parses and applies a single suite header directive.
## @return       Exits 0 on success, or exits 2 on a test directive outside a block or unknown key.
px_suite_header() {
  local key=$1 value=$2 where=$3
  case "$key" in
  suite) SUITE_NAME=$value ;;
  description) SUITE_DESCRIPTION=$value ;;
  class) SUITE_CLASS=$value ;;
  timeout)
    px_suite_check_timeout "$value" "$where"
    SUITE_TIMEOUT=$value
    ;;
  requires)
    px_suite_check_requires "$value" "$where" "$SUITE_REQUIRES"
    SUITE_REQUIRES=$SUITE_WORDS
    ;;
  name | driver | disrupt | args | arg | needs)
    px_die "$PX_EXIT_USAGE" "$where: '$key' belongs to a test," \
      "open one with 'test: <id>'"
    ;;
  *) px_die "$PX_EXIT_USAGE" "$where: unknown directive '$key'" ;;
  esac
}

# Explicitly initializes every parallel-array slot for the new test with header defaults so that
# subsequent reads never encounter an unset array element.
## @description  Opens a new test block and initializes its attributes from the header defaults.
## @return       Exits 0 on success, or exits 2 on an invalid or duplicate test identifier.
px_suite_open() {
  local index=$1 id=$2 where=$3 lineno=$4
  [[ $id =~ $SUITE_ID_RE ]] ||
    px_die "$PX_EXIT_USAGE" "$where: '$id' is not a test id"
  if px_suite_index_of "$id" >/dev/null; then
    px_die "$PX_EXIT_USAGE" "$where: test '$id' is declared twice"
  fi
  TEST_ID[index]=$id
  TEST_NAME[index]=""
  TEST_DRIVER[index]=""
  TEST_DISRUPT[index]=""
  TEST_ARG_FIRST[index]=${#SUITE_ARGV[@]}
  TEST_ARG_COUNT[index]=0
  TEST_NEEDS[index]=""
  TEST_CLASS[index]=$SUITE_CLASS
  TEST_REQUIRES[index]=$SUITE_REQUIRES
  TEST_TIMEOUT[index]=$SUITE_TIMEOUT
  TEST_LINE[index]=$lineno
  TEST_SEEN[index]=" "
  TEST_SEVERITY[index]=""
  TEST_CHECKED[index]=0
}

## @description  Parses and applies a single directive within an open test block.
## @return       Exits 0 on success, or exits 2 on an unknown or repeated directive or a dependency
##               that is not a valid test identifier.
px_suite_directive() {
  local index=$1 key=$2 value=$3 where=$4 word
  local -a words
  case "$key" in
  name | driver | class | timeout)
    px_suite_once "$index" "$key" "$where"
    ;;
  esac
  case "$key" in
  name) TEST_NAME[index]=$value ;;
  driver) TEST_DRIVER[index]=$value ;;
  disrupt)
    [ -n "$value" ] || px_die "$PX_EXIT_USAGE" "$where: 'disrupt' needs a specification"
    TEST_DISRUPT[index]="${TEST_DISRUPT[$index]:+${TEST_DISRUPT[$index]};}$value"
    ;;
  class) TEST_CLASS[index]=$value ;;
  timeout)
    px_suite_check_timeout "$value" "$where"
    TEST_TIMEOUT[index]=$value
    ;;
  args)
    px_suite_split words "$value"
    for word in ${words[@]+"${words[@]}"}; do
      SUITE_ARGV[${#SUITE_ARGV[@]}]=$word
      TEST_ARG_COUNT[index]=$((TEST_ARG_COUNT[index] + 1))
    done
    ;;
  arg)
    SUITE_ARGV[${#SUITE_ARGV[@]}]=$value
    TEST_ARG_COUNT[index]=$((TEST_ARG_COUNT[index] + 1))
    ;;
  needs)
    # Enforcing test-id syntax on every dependency guarantees that the stored space-separated list
    # contains no shell metacharacters that could trigger glob expansion during unquoted iteration.
    px_suite_split words "${value//,/ }"
    for word in ${words[@]+"${words[@]}"}; do
      [[ $word =~ $SUITE_ID_RE ]] ||
        px_die "$PX_EXIT_USAGE" "$where: '$word' is not a test id"
      TEST_NEEDS[index]="${TEST_NEEDS[$index]:+${TEST_NEEDS[$index]} }$word"
    done
    ;;
  requires)
    px_suite_check_requires "$value" "$where" "${TEST_REQUIRES[$index]}"
    TEST_REQUIRES[index]=$SUITE_WORDS
    ;;
  suite | description)
    px_die "$PX_EXIT_USAGE" "$where: '$key' belongs to the suite header"
    ;;
  *) px_die "$PX_EXIT_USAGE" "$where: unknown directive '$key'" ;;
  esac
}

## @description  Finalizes an open test block and rejects any incomplete definition.
## @return       Exits 0 when valid, or exits 2 on an incomplete test block.
px_suite_close() {
  local index=$1 label=$2 id where
  [ "$index" -ge 0 ] || return 0
  id=${TEST_ID[$index]}
  where="$label line ${TEST_LINE[$index]}"
  [ -n "${TEST_DRIVER[$index]}" ] ||
    px_die "$PX_EXIT_USAGE" "$where: test '$id' declares no driver"
  [ -n "${TEST_NAME[$index]}" ] || TEST_NAME[index]=$id
  # A run class resolved from the command line or the cluster record overrides any class declared
  # in the suite file.
  [ -z "$OPT_CLASS" ] || TEST_CLASS[index]=$OPT_CLASS
  if [ -z "${TEST_TIMEOUT[$index]}" ]; then
    px_suite_check_timeout "${PX_TIMEOUT_DEFAULT:-600}" PX_TIMEOUT_DEFAULT
    TEST_TIMEOUT[index]=${PX_TIMEOUT_DEFAULT:-600}
  fi
}

## @description  Verifies that every declared dependency references a test defined in this file.
## @return       Exits 0 when all dependencies exist, or exits 2 on a self-dependency or unknown id.
px_suite_check_needs() {
  local label=$1 index=0 total=${#TEST_ID[@]} need
  while [ "$index" -lt "$total" ]; do
    for need in ${TEST_NEEDS[$index]}; do
      if [ "$need" = "${TEST_ID[$index]}" ]; then
        px_die "$PX_EXIT_USAGE" \
          "$label line ${TEST_LINE[$index]}: test '$need' needs itself"
      fi
      px_suite_index_of "$need" >/dev/null ||
        px_die "$PX_EXIT_USAGE" "$label line ${TEST_LINE[$index]}:" \
          "test '${TEST_ID[$index]}' needs unknown test '$need'"
    done
    index=$((index + 1))
  done
}

## @description  Parses a declarative suite file and populates the in-memory parallel arrays.
## @return       Exits 0 on valid syntax, or exits 2 naming the offending line on any grammar error.
px_suite_parse() {
  local file=$1 label line lineno=0 key value current=-1 count=0 where
  # Diagnostic messages reference the file path through this separate variable so that the input
  # file variable appears only in the loop's input redirection, allowing static analysis to verify
  # that the loop never writes to the file it is reading.
  label=$file
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line=${line%$'\r'}
    px_trim_var line
    case "$line" in
    '' | '#'*) continue ;;
    esac
    where="$label line $lineno"
    key=${line%%:*}
    if [ "$key" = "$line" ]; then
      px_die "$PX_EXIT_USAGE" "$where: expected 'key: value', got: $line"
    fi
    value=${line#*:}
    px_trim_var key
    px_trim_var value
    if [ "$key" = test ]; then
      px_suite_close "$current" "$label"
      current=$count
      count=$((count + 1))
      px_suite_open "$current" "$value" "$where" "$lineno"
      continue
    fi
    if [ "$current" -lt 0 ]; then
      px_suite_header "$key" "$value" "$where"
      continue
    fi
    px_suite_directive "$current" "$key" "$value" "$where"
  done <"$file"
  px_suite_close "$current" "$label"
  [ "$count" -gt 0 ] || px_die "$PX_EXIT_USAGE" "$label declares no test"
  px_suite_check_needs "$label"
  [ -n "$SUITE_NAME" ] || SUITE_NAME=${label##*/}
  SUITE_NAME=${SUITE_NAME%.suite}
  px_debug "suite $SUITE_NAME holds $count tests"
}

## @description  Checks whether a test identifier has already been placed by the topological sort.
## @return       Exits 0 when the identifier is already placed, or exits 1 otherwise.
px_suite_placed() {
  case "$PLACED" in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

# Walks from the first test that topological sorting could not place, following the first unplaced
# dependency at each step until a test identifier repeats.
## @description  Traces and formats a dependency cycle among unplaced tests for diagnostic output.
## @return       Writes the cycle path to stdout and exits 0.
px_suite_find_cycle() {
  local total=${#TEST_ID[@]} index=0 start=-1 id need next seen=" " path="" guard=0
  while [ "$index" -lt "$total" ]; do
    if ! px_suite_placed "${TEST_ID[$index]}"; then
      start=$index
      break
    fi
    index=$((index + 1))
  done
  [ "$start" -ge 0 ] || return 0
  index=$start
  while [ "$guard" -le "$total" ]; do
    id=${TEST_ID[$index]}
    case "$seen" in
    *" $id "*)
      printf '%s -> %s\n' "$path" "$id"
      return 0
      ;;
    esac
    seen="$seen$id "
    path="${path:+$path -> }$id"
    next=""
    for need in ${TEST_NEEDS[$index]}; do
      if ! px_suite_placed "$need"; then
        next=$need
        break
      fi
    done
    [ -n "$next" ] || break
    index="$(px_suite_index_of "$next")" || break
    guard=$((guard + 1))
  done
  printf '%s\n' "$path"
}

## @description  Topologically sorts the tests so that each test follows all of its dependencies.
## @return       Sets ORDER to the ordered indices and ORDER_COUNT to their count and exits 0, or
##               exits 2 on a dependency cycle, naming the cycle.
px_suite_order() {
  local total=${#TEST_ID[@]} index placed=0 progress need ready
  ORDER=""
  ORDER_COUNT=$total
  PLACED=" "
  while [ "$placed" -lt "$total" ]; do
    progress=0
    index=0
    while [ "$index" -lt "$total" ]; do
      if px_suite_placed "${TEST_ID[$index]}"; then
        index=$((index + 1))
        continue
      fi
      ready=1
      for need in ${TEST_NEEDS[$index]}; do
        if ! px_suite_placed "$need"; then
          ready=0
          break
        fi
      done
      if [ "$ready" = 1 ]; then
        ORDER="${ORDER:+$ORDER }$index"
        PLACED="$PLACED${TEST_ID[$index]} "
        placed=$((placed + 1))
        progress=1
      fi
      index=$((index + 1))
    done
    if [ "$progress" = 0 ]; then
      px_die "$PX_EXIT_USAGE" \
        "dependency cycle in $SUITE_FILE: $(px_suite_find_cycle)"
    fi
  done
}

## @description  Checks whether the filtered execution plan includes a given test identifier.
## @return       Exits 0 when the plan contains the identifier, or exits 1 otherwise.
px_suite_in_plan() {
  local id=${1:-} index
  for index in $PLAN; do
    if [ "${TEST_ID[$index]}" = "$id" ]; then
      return 0
    fi
  done
  return 1
}

# Always exits 0 even when the identifier is absent so callers can invoke it inside a command
# substitution without triggering the failure trap, for the same reason as px_suite_resolve.
## @description  Finds the zero-based position of a test identifier in the ordered schedule.
## @return       Writes the zero-based position to stdout (or nothing if absent) and exits 0.
px_suite_position_of() {
  local id=${1:-} index position=0
  for index in $ORDER; do
    if [ "${TEST_ID[$index]}" = "$id" ]; then
      printf '%s\n' "$position"
      return 0
    fi
    position=$((position + 1))
  done
}

## @description  Applies the positional range boundaries and selection filters to the ordered list.
## @return       Sets PLAN to the selected indices and PLAN_COUNT to their count and exits 0; exits
##               2 when the boundaries cross, or 6 on an unknown test id or an empty selection.
px_suite_select() {
  local from=${PX_SUITE_FROM:-} to=${PX_SUITE_TO:-} only=${PX_SUITE_FILTER:-}
  local skip=$OPT_SKIP index id word keep position=0 from_at=0 to_at=0
  local -a only_ids skip_ids
  px_suite_split only_ids "${only//,/ }"
  px_suite_split skip_ids "${skip//,/ }"
  for word in ${only_ids[@]+"${only_ids[@]}"} ${skip_ids[@]+"${skip_ids[@]}"}; do
    px_suite_index_of "$word" >/dev/null ||
      px_die "$PX_EXIT_NO_OBJECT" "the selection names no such test: $word"
  done
  to_at=$((ORDER_COUNT - 1))
  if [ -n "$from" ]; then
    from_at="$(px_suite_position_of "$from")"
    [ -n "$from_at" ] ||
      px_die "$PX_EXIT_NO_OBJECT" "--from names no such test: $from"
  fi
  if [ -n "$to" ]; then
    to_at="$(px_suite_position_of "$to")"
    [ -n "$to_at" ] ||
      px_die "$PX_EXIT_NO_OBJECT" "--to names no such test: $to"
  fi
  if [ "$from_at" -gt "$to_at" ]; then
    px_die "$PX_EXIT_USAGE" \
      "--from '$from' comes after --to '$to' in the resolved order"
  fi
  PLAN=""
  PLAN_COUNT=0
  position=0
  for index in $ORDER; do
    if [ "$position" -ge "$from_at" ] && [ "$position" -le "$to_at" ]; then
      id=${TEST_ID[$index]}
      keep=1
      if [ -n "$only" ]; then
        keep=0
        for word in ${only_ids[@]+"${only_ids[@]}"}; do
          [ "$word" != "$id" ] || keep=1
        done
      fi
      for word in ${skip_ids[@]+"${skip_ids[@]}"}; do
        [ "$word" != "$id" ] || keep=0
      done
      if [ "$keep" = 1 ]; then
        PLAN="${PLAN:+$PLAN }$index"
        PLAN_COUNT=$((PLAN_COUNT + 1))
      fi
    fi
    position=$((position + 1))
  done
  [ -n "$PLAN" ] || px_die "$PX_EXIT_NO_OBJECT" "the selection matched no test"
  for index in $PLAN; do
    for word in ${TEST_NEEDS[$index]}; do
      px_suite_in_plan "$word" ||
        px_warn "test '${TEST_ID[$index]}' needs '$word'," \
          "which the selection excludes"
    done
  done
}

# Preserves standard output as the live structured data channel while persisting a copy of each row
# to the session file whenever an active session exists.
## @description  Writes a TSV row to stdout and appends it to a session file when present.
## @return       Writes the row and exits 0, or exits 1 when a field cannot be formatted or written.
px_suite_row() {
  local dest=$1 row
  shift
  row="$(px_tsv_row "$@")" ||
    px_die "$PX_EXIT_FAIL" "cannot write a row of the suite report"
  printf '%s\n' "$row"
  if [ -n "$dest" ]; then
    printf '%s\n' "$row" >>"$dest" ||
      px_die "$PX_EXIT_FAIL" "cannot append to $dest"
  fi
}

## @description  Emits the execution plan as one TSV row per selected test in scheduled run order.
## @return       Writes the plan rows and exits 0.
px_suite_plan_emit() {
  local dest=$1 index position=0
  for index in $PLAN; do
    position=$((position + 1))
    px_suite_row "$dest" "$position" "${TEST_ID[$index]}" \
      "$(px_tsv_clean "${TEST_NAME[$index]}")" driver "${TEST_DRIVER[$index]}" \
      "${TEST_CLASS[$index]}" "${TEST_REQUIRES[$index]}" "${TEST_TIMEOUT[$index]}"
  done
}

## @description  Allocates the session directory exclusively and sets SESSION_DIR and SESSION_ID.
## @return       Exits 0 on success, exits 1 if no directory is free or a named session already
##               exists, or exits 2 or 1 when the output policy refuses the session log.
px_suite_session_create() {
  local root status=0
  if [ -n "${PX_SESSION_ID:-}" ]; then
    root="$(px_out_subdir sessions)" || exit $?
    SESSION_ID=$PX_SESSION_ID
    SESSION_DIR="$root/$SESSION_ID"
    mkdir "$SESSION_DIR" 2>/dev/null ||
      px_die "$PX_EXIT_FAIL" "session '$SESSION_ID' has a directory already:" \
        "$SESSION_DIR"
  else
    SESSION_DIR="$(px_run_dir sessions)" || exit $?
    SESSION_ID=${SESSION_DIR##*/}
  fi
  # Child processes inherit the active session identifier from the environment, so PX_SESSION_ID is
  # assigned and exported directly here rather than via px_config_set, whose internal origin probe
  # would otherwise trip the already-enabled ERR failure trap.
  PX_SESSION_ID=$SESSION_ID
  export PX_SESSION_ID
  mkdir -p "$SESSION_DIR/tests" ||
    px_die "$PX_EXIT_FAIL" "cannot create $SESSION_DIR/tests"
  PLAN_FILE="$SESSION_DIR/plan.tsv"
  RESULT_FILE="$SESSION_DIR/results.tsv"
  GROUP_FILE="$SESSION_DIR/groups.tsv"
  # Unless the operator has already configured an explicit PX_LOG_FILE destination, direct a copy of
  # all diagnostic log messages into the session directory, registering the path through the output
  # policy because px_log writes only to policy-admitted files.
  if [ -z "${PX_LOG_FILE:-}" ]; then
    px_log_file_set "$SESSION_DIR/suite.log" || status=$?
    if [ "$status" != 0 ]; then
      exit "$status"
    fi
  fi
  px_info "session $SESSION_ID in $SESSION_DIR"
}

## @description  Starts every role group required by a test and records each started group.
## @return       Exits 0 when all groups are running, or exits 1 with GROUP_SEVERITY, GROUP_REASON,
##               and GROUP_STATUS set to the cause status (5 if the backend cannot switch groups).
px_suite_group_acquire() {
  local index=$1 requirement timeout status=0
  GROUP_REASON=""
  GROUP_SEVERITY=""
  GROUP_STATUS=0
  [ -n "${TEST_REQUIRES[$index]}" ] || return 0
  timeout=${PX_TIMEOUT_GROUP:-${TEST_TIMEOUT[$index]}}
  # Bind the backend lazily here rather than at startup so that a dry run never reaches this path.
  # Cluster scope resolution runs after binding because scope records belong to a specific backend.
  sb_load
  # Guarding the command inside the substitution prevents a missing scope from triggering the ERR
  # trap before the caller can record the failure in the test's result row.
  GROUP_SCOPE="$(sb_scope_resolve || exit "$?")" || status=$?
  if [ "$status" != 0 ]; then
    GROUP_SEVERITY=ERROR
    GROUP_STATUS=$status
    if [ "$status" = "$SB_EXIT_NO_OBJECT" ]; then
      GROUP_REASON="requires ${TEST_REQUIRES[$index]}, but PX_SCOPE_ID is unset"
      GROUP_REASON="$GROUP_REASON and no scope is recorded for cluster"
      GROUP_REASON="$GROUP_REASON '${PX_CLUSTER_ID:-default}'"
    else
      GROUP_REASON="requires ${TEST_REQUIRES[$index]}, but the scope did not"
      GROUP_REASON="$GROUP_REASON resolve ($(sb_exit_name "$status"))"
    fi
    return 1
  fi
  for requirement in ${TEST_REQUIRES[$index]}; do
    status=0
    px_suite_untrapped px_memory_recheck || status=$?
    if [ "$status" != 0 ]; then
      GROUP_SEVERITY=ERROR
      GROUP_STATUS=$status
      GROUP_REASON="the memory check refused group $requirement"
      GROUP_REASON="$GROUP_REASON ($(px_exit_name "$status"))"
      return 1
    fi
    # Record the role group as held before invoking sb_group_start so that release cleanup will also
    # tear down a group whose startup failed partway through or exited early.
    GROUPS_HELD="${GROUPS_HELD:+$GROUPS_HELD }$requirement"
    px_suite_untrapped sb_group_start "$GROUP_SCOPE" "$requirement" "$timeout" \
      >>"$GROUP_FILE" || status=$?
    if [ "$status" != 0 ]; then
      GROUP_SEVERITY=ERROR
      [ "$status" != "$PX_EXIT_UNSUPPORTED" ] || GROUP_SEVERITY=SKIP
      GROUP_STATUS=$status
      GROUP_REASON="group $requirement did not start ($(sb_exit_name "$status"))"
      return 1
    fi
    px_info "group $requirement is up for the next test"
  done
  return 0
}

# If a role group fails to stop cleanly, the failure is logged as a warning rather than aborting
# the session; the cluster remains running, and a subsequent px-cluster down removes any leftover
# group resources.
## @description  Stops every cluster role group started by this process.
## @return       Always exits 0.
px_suite_group_release() {
  local mode=${1:-} held=$GROUPS_HELD group timeout
  GROUPS_HELD=""
  [ -n "$held" ] || return 0
  [ -n "$GROUP_SCOPE" ] || return 0
  if [ "$mode" = end ]; then
    if px_is_keep; then
      px_warn "role groups stay up in scope $GROUP_SCOPE for a triage: $held." \
        "px-cluster group stop stops each one"
      return 0
    fi
  fi
  timeout=${PX_TIMEOUT_GROUP:-${PX_TIMEOUT_DEFAULT:-600}}
  for group in $held; do
    px_suite_untrapped sb_group_stop "$GROUP_SCOPE" "$group" "$timeout" \
      >>"$GROUP_FILE" ||
      px_warn "group $group did not stop, the teardown removes it"
  done
  return 0
}

## @description  Executes a single command with the ERR failure trap disabled.
## @return       Returns the exit status of the executed command.
px_suite_untrapped() {
  local status=0
  trap - ERR
  "$@" || status=$?
  px_trap_enable
  return "$status"
}

# Launches a test command in the background with standard input detached and waits for completion so
# that a trapped INT or TERM signal interrupts the wait immediately and lets the exit hook stop the
# child process.
## @description  Executes a test child process (out, log, command...) in the background and waits.
## @return       Returns the exit status of the child process.
px_suite_child() {
  local out=$1 log=$2 status=0
  shift 2
  px_suite_untrapped "$@" </dev/null >"$out" 2>"$log" &
  SUITE_CHILD=$!
  wait "$SUITE_CHILD" || status=$?
  SUITE_CHILD=""
  return "$status"
}

# Terminates the active test child and its entire descendant process tree using the same escalation
# sequence as an expired time limit: SIGTERM, a two-second grace period, and then SIGKILL.
## @description  Stops the active test child process and all of its descendants.
## @return       Exits 0.
px_suite_child_stop() {
  [ -z "$SUITE_CHILD" ] || px_kill_tree "$SUITE_CHILD" || true
}

## @description  Extracts an integer timeout setting in whole seconds (name, dump, default) from a
##               px-cluster config dump.
## @return       Writes the parsed value or the default to stdout and exits 0.
px_suite_dump_s() {
  local value
  value="$(px_tsv_get "$1" "$2" || true)"
  value=${value%%"$PX_TAB"*}
  [[ $value =~ $PX_RE_INT ]] || value=$3
  printf '%s\n' "$((10#$value))"
}

# Computes the outer execution time limit for px-run on a driver test (index) by summing the test's
# declared timeout, the fixed suite margin, the driver verb, plug-in hook, cluster check, and
# disruption recovery bounds, and the quiet-host wait and single poll interval of the test's run
# class.
## @description  Calculates the outer px-run timeout bound in whole seconds for a driver test
##               (index).
## @return       Writes the computed timeout in whole seconds to stdout and exits 0.
px_suite_run_limit() {
  local index=$1 dump wait poll whole file verb drain ready fetch plugins count
  local -a args=()
  if [ -n "${TEST_CLASS[$index]}" ]; then
    args=(--class "${TEST_CLASS[$index]}")
  fi
  for file in ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; do
    args=(${args[@]+"${args[@]}"} --config "$file")
  done
  # Query the configuration that px-run itself will load so that the timing parameters reflect the
  # individual test's run class rather than the outer session's run class.
  dump="$(px_config_child "$PX_HOME/bin/px-cluster" ${args[@]+"${args[@]}"} config \
    2>/dev/null || exit "$?")" || dump=""
  wait="$(px_suite_dump_s PX_QUIET_HOST_WAIT_S "$dump" 0)"
  poll="$(px_tsv_get PX_POLL_INTERVAL_S "$dump" || exit "$?")" || poll=""
  poll=${poll%%"$PX_TAB"*}
  whole=${poll%%.*}
  [[ $whole =~ $PX_RE_INT ]] || whole=0
  case "$poll" in
  *.*[1-9]*) whole=$((10#$whole + 1)) ;;
  esac
  verb="$(px_suite_dump_s PX_TIMEOUT_VERB "$dump" 300)"
  drain="$(px_suite_dump_s PX_TIMEOUT_DRAIN "$dump" 600)"
  ready="$(px_suite_dump_s PX_TIMEOUT_READY "$dump" 600)"
  fetch="$(px_suite_dump_s PX_TIMEOUT_FETCH "$dump" 1800)"
  plugins="$(px_tsv_get PX_PLUGINS "$dump" || true)"
  plugins="$(printf '%s\n' "${plugins%%"$PX_TAB"*}" | awk '{ n += NF } END { print n + 0 }')"
  # Combine the disrupt: directives declared on the test with any session-wide --disrupt setting,
  # splitting on semicolons in the same manner as px-run.
  count="$(px_tsv_get PX_DISRUPT_SPEC "$dump" || true)"
  count="$(printf '%s;%s\n' "${count%%"$PX_TAB"*}" "${TEST_DISRUPT[$index]}" |
    awk -F ';' '{ for (i = 1; i <= NF; i++) if ($i ~ /[^ \t]/) n++ } END { print n + 0 }')"
  # Sum the budget terms in order: the test's declared time limit (shared by prepare and run); the
  # fixed margin for snapshots and result recording; one verb bound for each of describe, validate,
  # restore, and report, plus two for cluster checks; the four bounded hooks (fetch-data,
  # pre-workload, post-workload, and collect) for each enabled plug-in; the drain-aware restart plus
  # the readiness and region waits of the recovery gate for each disruption; the quiet-host wait;
  # and one poll interval.
  printf '%s\n' "$((TEST_TIMEOUT[index] + SUITE_RUN_MARGIN_S + 6 * verb +
    plugins * (3 * verb + fetch) + count * (drain + 2 * ready) + wait + 10#$whole))"
}

# Driver-backed tests are delegated to px-run, which owns the workload driver lifecycle.
## @description  Executes a single test within its configured time limit and populates RUN_SEVERITY,
##               RUN_STATUS, RUN_REASON, RUN_ELAPSED, and RUN_BUNDLE.
## @return       Exits 0 on completion, or exits 1 when a test record cannot be written.
px_suite_run_one() {
  local index=$1 id dir out log timeout limit status=0 started finished worst file
  local verdicts reported
  local -a argv
  id=${TEST_ID[$index]}
  timeout=${TEST_TIMEOUT[$index]}
  dir="$SESSION_DIR/tests/$id"
  # Maintain strict separation between output streams across the harness by capturing structured
  # stdout data and diagnostic stderr messages in dedicated per-test files.
  out="$dir/stdout.txt"
  log="$dir/stderr.log"
  mkdir -p "$dir" || px_die "$PX_EXIT_FAIL" "cannot create $dir"
  RUN_SEVERITY=""
  RUN_STATUS=0
  RUN_REASON=""
  RUN_ELAPSED=0
  RUN_CONCLUSIVE=0
  RUN_BUNDLE=""
  started="$(px_epoch_ms)"
  if ! px_suite_group_acquire "$index"; then
    px_suite_group_release
    # When role-group acquisition fails before the test can run, report the acquisition status code
    # in the result row: PX_EXIT_UNSUPPORTED when the backend cannot switch groups, or the exit
    # status of the specific check or startup step that failed.
    RUN_SEVERITY=$GROUP_SEVERITY
    RUN_STATUS=$GROUP_STATUS
    RUN_REASON=$GROUP_REASON
    return 0
  fi
  # Export PX_RUN_DIR so that each test writes into its own dedicated directory and any library
  # sourced by a check reads that path. Export BASH_ENV so that the driver shell and every child
  # subshell automatically load the shared library along with its container-runtime trap.
  PX_RUN_DIR="$dir"
  export PX_RUN_DIR
  BASH_ENV="$PX_HOME/lib/common.sh"
  export BASH_ENV
  # Export the suite and test identity so the driver knows which test of which suite it is running
  # and can resolve relative argument paths against the suite file location.
  PX_SUITE_NAME=$SUITE_NAME
  PX_SUITE_FILE=$SUITE_FILE
  PX_TEST_ID=$id
  export PX_SUITE_NAME PX_SUITE_FILE PX_TEST_ID
  # Run the test as a background child with standard input redirected from /dev/null so it never
  # reads from the terminal. Waiting on the background child allows a session INT or TERM signal to
  # interrupt the wait immediately so the exit hook can stop the child, while the time limit
  # terminates all descendant processes started by the test rather than only the test process.
  #
  # Delegate driver lifecycle and run-directory management to px-run, passing the driver, run
  # class, configuration files, and time limit as px-run options and forwarding all arguments after
  # the "--" separator directly to the driver.
  argv=("$PX_HOME/bin/px-run" "${TEST_DRIVER[$index]}" --timeout "$timeout")
  if [ -n "${TEST_CLASS[$index]}" ]; then
    argv=("${argv[@]}" --class "${TEST_CLASS[$index]}")
  fi
  for file in ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}; do
    argv=("${argv[@]}" --config "$file")
  done
  if [ -n "${TEST_DISRUPT[$index]}" ]; then
    argv=("${argv[@]}" --disrupt "${TEST_DISRUPT[$index]}")
  fi
  argv=("${argv[@]}" --)
  # Extract the test's contiguous argument slice from SUITE_ARGV as a double-quoted array expansion
  # so that each element is passed as a single literal word without shell expansion.
  if [ "${TEST_ARG_COUNT[$index]}" -gt 0 ]; then
    argv=("${argv[@]}"
      "${SUITE_ARGV[@]:TEST_ARG_FIRST[index]:TEST_ARG_COUNT[index]}")
  fi
  limit="$(px_suite_run_limit "$index")"
  px_debug "test $id: px-run gets a bound of ${limit}s"
  # Invoke px-run with only the operator's initial configuration environment so that px-run loads
  # its own run class without having that class masked by values loaded in this process.
  px_suite_child "$out" "$log" px_config_child px_timeout "$limit" "${argv[@]}" ||
    status=$?
  px_suite_group_release
  finished="$(px_epoch_ms)"
  RUN_ELAPSED=$((finished - started))
  # Both exit code 124 (SIGTERM timeout) and 137 (SIGKILL after the grace period) indicate that the
  # test exceeded its execution time limit.
  if [ "$status" = 124 ] || [ "$status" = 137 ]; then
    status=$PX_EXIT_TIMEOUT
    RUN_REASON="the time limit of ${limit}s expired"
  elif [ "$status" != 0 ]; then
    RUN_REASON="exit $status ($(px_exit_name "$status")), messages in $log"
  fi
  RUN_STATUS=$status
  RUN_SEVERITY="$(sx_severity_of_code "$status")"
  # Elevate the test's baseline severity when its recorded verdicts carry a worse outcome than its
  # process exit code, allowing an ADVISORY verdict to survive a test that exits 0. The driver
  # writes its verdicts inside the run directory that px-run allocated and reported on its stdout
  # data channel.
  verdicts="$dir/verdicts.tsv"
  if [ -s "$out" ]; then
    reported=""
    read -r reported <"$out" || reported=""
    [ -z "$reported" ] || [ ! -d "$reported" ] || RUN_BUNDLE=$reported
    if [ -n "$reported" ] && [ -f "$reported/report/verdicts.tsv" ]; then
      # Because the exported report table begins with a header line, strip the header and write the
      # effective verdict rows into the test directory as a headerless stream for the lattice.
      verdicts="$dir/verdicts.effective.tsv"
      tail -n +2 "$reported/report/verdicts.tsv" >"$verdicts" ||
        px_die "$PX_EXIT_FAIL" "cannot write $verdicts"
    elif [ -n "$reported" ] && [ -f "$reported/verdicts.tsv" ]; then
      verdicts="$reported/verdicts.tsv"
    fi
  fi
  worst="$(sx_verdict_worst "$verdicts")"
  if [ -n "$worst" ]; then
    RUN_SEVERITY="$(sx_severity_worse "$RUN_SEVERITY" "$worst")"
    if [ -z "$RUN_REASON" ] && [ "$worst" != PASS ]; then
      RUN_REASON="the verdicts of this test reach $worst"
    fi
  fi
  # A test whose worst overall severity is SKIP has still verified real behavior if at least one of
  # its recorded verdicts is not SKIP (for example, a passing run with unsupported checks). Only a
  # test that verified nothing at all counts toward an inconclusive session.
  if [ "$RUN_SEVERITY" != SKIP ] ||
    awk -F '\t' '$2 != "" && $2 != "SKIP" { f = 1 } END { exit !f }' "$verdicts" \
      2>/dev/null; then
    RUN_CONCLUSIVE=1
  fi
  return 0
}

## @description  Increments the counter for one test severity and updates the worst session
##               severity.
## @return       Updates the session counters and SESSION_SEVERITY, then exits 0.
px_suite_count() {
  # The per-severity counter variable names correspond directly to the severity names in the
  # lattice.
  local counter="COUNT_${1:-PASS}"
  printf -v "$counter" '%s' "$((${!counter:-0} + 1))"
  SESSION_SEVERITY="$(sx_severity_worse "$SESSION_SEVERITY" "${1:-PASS}")"
}

## @description  Determines whether a test is blocked because a prerequisite test did not pass.
## @return       Writes the blocking reason to stdout (or an empty line if runnable) and exits 0.
px_suite_blocked_by() {
  local index=$1 need at severity
  for need in ${TEST_NEEDS[$index]}; do
    px_suite_in_plan "$need" || continue
    at="$(px_suite_index_of "$need")" || continue
    severity=${TEST_SEVERITY[$at]}
    case "$severity" in
    '' | PASS | ADVISORY) ;;
    SKIP)
      # A prerequisite whose overall severity is SKIP because of unsupported checks alongside
      # passing checks still verified the behavior that dependent tests require.
      [ "${TEST_CHECKED[$at]}" != 1 ] || continue
      printf 'test %s was skipped\n' "$need"
      return 0
      ;;
    *)
      printf 'test %s reached %s\n' "$need" "$severity"
      return 0
      ;;
    esac
  done
  printf '\n'
}

# Halts at the first failing test unless fault-tolerant continuation mode is enabled, and
# automatically skips any test whose scheduled dependency did not pass.
## @description  Executes the scheduled test plan and streams a result row as each test completes.
## @return       Writes one TSV result row per decided test and exits 0.
px_suite_execute() {
  local keep_going=$1 index position=0 blocked rank stop_rank pending
  stop_rank="$(sx_severity_rank FAIL)"
  for index in $PLAN; do
    position=$((position + 1))
    blocked="$(px_suite_blocked_by "$index")"
    if [ -n "$blocked" ]; then
      TEST_SEVERITY[index]=SKIP
      COUNT_INCONCLUSIVE=$((COUNT_INCONCLUSIVE + 1))
      px_suite_count SKIP
      px_warn "skip ${TEST_ID[$index]}: $blocked"
      px_suite_row "$RESULT_FILE" "$position" "${TEST_ID[$index]}" SKIP \
        "$PX_EXIT_UNSUPPORTED" 0 "$(px_tsv_clean "$blocked")" ""
      continue
    fi
    px_info "test ${TEST_ID[$index]}: ${TEST_NAME[$index]}," \
      "run class ${TEST_CLASS[$index]:-${PX_RUN_CLASS:-none}}"
    px_suite_run_one "$index"
    TEST_SEVERITY[index]=$RUN_SEVERITY
    TEST_CHECKED[index]=$RUN_CONCLUSIVE
    if [ "$RUN_SEVERITY" = SKIP ] && [ "$RUN_CONCLUSIVE" = 0 ]; then
      COUNT_INCONCLUSIVE=$((COUNT_INCONCLUSIVE + 1))
    fi
    COUNT_RAN=$((COUNT_RAN + 1))
    px_suite_count "$RUN_SEVERITY"
    px_suite_row "$RESULT_FILE" "$position" "${TEST_ID[$index]}" "$RUN_SEVERITY" \
      "$RUN_STATUS" "$RUN_ELAPSED" "$(px_tsv_clean "$RUN_REASON")" "$RUN_BUNDLE"
    rank="$(sx_severity_rank "$RUN_SEVERITY")"
    if [ "$rank" -ge "$stop_rank" ] && [ "$keep_going" != 1 ]; then
      COUNT_NOT_RUN=0
      for pending in $PLAN; do
        [ -z "${TEST_SEVERITY[$pending]}" ] || continue
        COUNT_NOT_RUN=$((COUNT_NOT_RUN + 1))
      done
      px_error "${TEST_ID[$index]} reached $RUN_SEVERITY," \
        "$COUNT_NOT_RUN tests did not run. Pass --continue-on-failure to run them."
      return 0
    fi
  done
  return 0
}

## @description  Writes the session summary record as key-value rows capturing the session outcome
##               and the version set selected by the active configuration.
## @return       Exits 0 on success, or exits 1 when the summary record cannot be written.
px_suite_summary() {
  local code=$1 record="$SESSION_DIR/summary.tsv"
  {
    px_tsv_row suite "$(px_tsv_clean "$SUITE_NAME")"
    px_tsv_row description "$(px_tsv_clean "$SUITE_DESCRIPTION")"
    px_tsv_row suite_file "$SUITE_FILE"
    px_tsv_row session "$SESSION_ID"
    px_versions_rows "$(px_config_dump)"
    px_tsv_row ran "$COUNT_RAN"
    px_tsv_row not_run "$COUNT_NOT_RUN"
    px_tsv_row pass "$COUNT_PASS"
    px_tsv_row skip "$COUNT_SKIP"
    px_tsv_row inconclusive "$COUNT_INCONCLUSIVE"
    px_tsv_row advisory "$COUNT_ADVISORY"
    px_tsv_row fail "$COUNT_FAIL"
    px_tsv_row error "$COUNT_ERROR"
    px_tsv_row severity "$SESSION_SEVERITY"
    px_tsv_row result "$SESSION_RESULT"
    px_tsv_row exit_code "$code"
  } >"$record" || px_die "$PX_EXIT_FAIL" "cannot write $record"
}

# ---------------------------------------------------------------------------
# Command-line argument parsing
# ---------------------------------------------------------------------------
# Command-line settings are recorded with the cli origin so that boundaries and options can come
# from the command line, a target file, or the defaults while px_config_dump reports which source
# applied during configuration resolution.

px_cli_parse "$@"
OPT_SUITE=${PX_CLI_ARGS[0]}

# ---------------------------------------------------------------------------
# Session initialization and execution
# ---------------------------------------------------------------------------

# The argument-parsing loop registers command-line overrides at the highest-precedence stage before
# the configuration loader runs, because the selected run class determines which class file the
# loader reads.
px_config_load -- ${PX_CLI_FILES[@]+"${PX_CLI_FILES[@]}"}
# A run class supplied via --class or -e PX_RUN_CLASS, or otherwise the class persisted in the
# cluster record file, applies to every test and overrides any class declared by the suite; the
# suite's own class declaration takes effect only when no cluster run class is established. The
# cluster record file is inspected directly here because an exported PX_RUN_CLASS in the process
# environment loads at an earlier precedence stage.
if [ "$(px_config_origin PX_RUN_CLASS || true)" = cli ]; then
  OPT_CLASS=$PX_RUN_CLASS
elif [ -n "$PX_CONFIG_RECORD" ] && [ -f "$PX_CONFIG_RECORD" ]; then
  OPT_CLASS="$(px_config_peek "$PX_CONFIG_RECORD" PX_RUN_CLASS)"
fi

# Enable the ERR failure trap only after configuration loading completes. During loading, the
# loader probes whether each variable already has a recorded origin, and that probe returns a
# non-zero status for every newly introduced variable inside a command substitution; because Bash
# fires the ERR trap inside command substitutions even when guarded, enabling the trap earlier
# would misreport every newly loaded variable as a failure.
px_trap_enable

# Validate and load enabled plug-ins before performing any other work so that a broken plug-in
# aborts the session immediately, even during a dry run. Because no session directory exists yet and
# a dry run writes no persistent files, the suites hook initially writes into a temporary directory.
SUITE_PLUGINS="$(pl_enabled || exit "$?")" || exit "$?"
SUITE_HOOK_BASE=""
if [ -n "$SUITE_PLUGINS" ]; then
  SUITE_HOOK_BASE="$(px_mktemp_dir px-suites)" || exit "$?"
fi
SUITE_FILE="$(px_suite_resolve "$OPT_SUITE" "$SUITE_HOOK_BASE" || exit "$?")" || exit "$?"
[ -n "$SUITE_FILE" ] ||
  px_die "$PX_EXIT_NO_OBJECT" "no such suite: $OPT_SUITE"
px_suite_parse "$SUITE_FILE"
px_suite_order
px_suite_select

# A dry run validates the execution plan without modifying host state: it creates no output root,
# allocates no session directory, and loads no backend, making it safe for an operator to run on a
# host that already holds a live cluster. It still resolves every planned driver and validates its
# describe document, which requires no running cluster.
if px_is_dry_run; then
  px_suite_describe_check
  px_info "dry run of $SUITE_NAME, $PLAN_COUNT of $ORDER_COUNT tests selected"
  px_suite_plan_emit ""
  exit "$PX_EXIT_OK"
fi

# Resolve the output root in the top-level shell process so that the canonical path written back to
# PX_OUT is inherited by all child processes.
px_out_root >/dev/null
px_suite_session_create
# Copy any plug-in records produced by the suites hook from the temporary staging directory into
# the newly created session directory, which serves as the permanent output location for that hook.
if [ -n "$SUITE_HOOK_BASE" ] && [ -d "$SUITE_HOOK_BASE/plugins" ]; then
  cp -R "$SUITE_HOOK_BASE/plugins" "$SESSION_DIR/" ||
    px_warn "cannot copy the suites hook records into $SESSION_DIR"
fi
# Exit hooks run in reverse registration order on every exit: the active test child stops first
# (via SIGTERM, a two-second wait, and SIGKILL, since background jobs ignore SIGINT), followed by
# any role groups started by the session, ensuring that an interruption never leaves behind a
# running test or active role group while leaving the cluster itself running. Because an untrapped
# signal would terminate the shell without firing the EXIT trap, trapping INT and TERM converts
# both operator signals into normal exits while immediately interrupting any active wait on a test
# child process.
SUITE_CHILD=""
px_on_exit px_suite_group_release end
px_on_exit px_suite_child_stop
trap 'exit 130' INT
trap 'exit 143' TERM

px_suite_plan_emit "$PLAN_FILE" >/dev/null
if px_is_true "${PX_SUITE_CONTINUE:-0}"; then
  px_suite_execute 1
else
  px_suite_execute 0
fi

# If every test in the session verified nothing (reaching SKIP without recording any verdict of
# another severity), the overall session result is INCONCLUSIVE rather than a pass. Delegating this
# decision to the shared lattice library ensures that downstream reports derive the identical result
# from the same summary counts.
SESSION_RESULT="$(sx_result "$SESSION_SEVERITY" \
  "$((COUNT_PASS + COUNT_SKIP + COUNT_ADVISORY + COUNT_FAIL + COUNT_ERROR))" \
  "$COUNT_INCONCLUSIVE")"
EXIT_CODE="$(px_verdict_exit "$SESSION_RESULT")" || EXIT_CODE=$PX_EXIT_FAIL
px_suite_summary "$EXIT_CODE"
# Emit the closing session row on standard output only when the session runs to completion; the row
# records the overall session result from which the process exit code is derived.
px_result_row "$SESSION_RESULT" "$EXIT_CODE" "$SESSION_DIR"
px_exit_noted "$EXIT_CODE" "session $SESSION_ID ends at $SESSION_RESULT:" \
  "$COUNT_PASS pass, $COUNT_SKIP skip, $COUNT_ADVISORY advisory," \
  "$COUNT_FAIL fail, $COUNT_ERROR error (exit $EXIT_CODE, $(px_exit_name "$EXIT_CODE"))"
# A failing session exits explicitly with its non-zero status code, whereas a passing session falls
# through to the end of the script with status 0; the registered exit hooks execute on both paths.
[ "$EXIT_CODE" = 0 ] || exit "$EXIT_CODE"

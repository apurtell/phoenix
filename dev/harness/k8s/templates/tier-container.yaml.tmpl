# Defines the entrypoint arguments and readiness probe for a Distributed Pherf tier container,
# populating the probe slot of the pod template. The container image accepts the role verb as its
# argument, and the readiness probe runs the image probe using the same timings as the Compose
# tier. No liveness probe is configured because a controller restart would otherwise cause the
# kubelet to restart agents that lost their channel.

args:
  - ${PX_M_VERB}
  - start
readinessProbe:
  exec:
    command:
      - /opt/pherf/healthcheck.sh
      - ${PX_M_VERB}
  periodSeconds: 5
  timeoutSeconds: 6
  failureThreshold: 3

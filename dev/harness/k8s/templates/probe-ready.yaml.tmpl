# This template defines the readiness probe applied to every pod, mirroring the Compose healthcheck
# probe. Roles that do not run a daemon omit all other probes because their pods are configured
# never to restart, meaning a failed liveness probe would permanently terminate the pod.

readinessProbe:
  exec:
    command:
      - /opt/px/healthcheck.sh
      - ready
  periodSeconds: 5
  timeoutSeconds: 15
  failureThreshold: 3

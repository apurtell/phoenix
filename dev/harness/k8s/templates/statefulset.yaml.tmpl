# Defines the StatefulSet for a single cluster role. Because the update strategy is set to
# OnDelete, re-rendering the manifest never automatically replaces running pods. Persistent volume
# claims are retained when the StatefulSet is deleted, but are deleted when a scale-down removes
# their corresponding ordinal.

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: ${PX_M_ROLE}
  namespace: ${PX_M_NAMESPACE}
  labels:
${PX_M_LABELS}
spec:
  serviceName: ${PX_M_ROLE}
  replicas: ${PX_M_REPLICAS}
  podManagementPolicy: Parallel
  updateStrategy:
    type: OnDelete
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Delete
  selector:
    matchLabels:
${PX_M_SELECTOR}
  template:
    metadata:
      labels:
${PX_M_POD_LABELS}
    spec:
${PX_M_POD_SPEC}
  volumeClaimTemplates:
${PX_M_CLAIMS}

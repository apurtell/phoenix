# Defines the Kubernetes Deployment for a single Distributed Pherf tier role. When rolling out a
# modified pod template, the Recreate strategy ensures that all existing pods terminate before any
# new pod is started. However, this ordering guarantee does not apply when an individual pod is
# deleted or evicted: the ReplicaSet schedules a replacement immediately while the previous pod may
# still be terminating, which can cause two controller pods to briefly overlap on the run directory
# claim. To resolve this contention safely, the incoming controller waits up to a bounded duration
# to acquire the run directory lock (see backends.md).

apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PX_M_NAME}
  namespace: ${PX_M_NAMESPACE}
  labels:
${PX_M_LABELS}
spec:
  replicas: ${PX_M_REPLICAS}
  strategy:
    type: Recreate
  selector:
    matchLabels:
${PX_M_SELECTOR}
  template:
    metadata:
      labels:
${PX_M_POD_LABELS}
    spec:
${PX_M_POD_SPEC}

# Spreads the pods of a scaled role across cluster nodes so that each pod prefers a node where no
# other pod of the same role is scheduled. Because a preferred anti-affinity rule never blocks pod
# scheduling, it has no effect on a single-node cluster.

affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
${PX_M_SELECTOR}

# Defines a standalone PersistentVolumeClaim backed by the configured StorageClass. The Distributed
# Pherf controller stores its run directory on this claim, ensuring that frozen reports persist
# across controller pod replacements as well as stops of its role group.

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${PX_M_NAME}
  namespace: ${PX_M_NAMESPACE}
  labels:
${PX_M_LABELS}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: ${PX_M_STORAGE_CLASS}
  resources:
    requests:
      storage: ${PX_M_VOLUME_GIB}Gi

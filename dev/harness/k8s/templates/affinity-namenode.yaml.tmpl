# This template enforces pod affinity to schedule the setup Job onto the same cluster node as the
# NameNode, because the Job mounts the NameNode claim and that claim binds to a single node.

affinity:
  podAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - topologyKey: kubernetes.io/hostname
        labelSelector:
          matchLabels:
${PX_M_SELECTOR}

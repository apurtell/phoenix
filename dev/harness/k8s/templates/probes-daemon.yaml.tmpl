# This template configures the startup and liveness probes for a daemon workload and is followed by
# probe-ready.yaml.tmpl. Both probes execute the container image's health check script, with the
# liveness failure bound sized to exceed the maximum pause duration tolerated by the configuration.

startupProbe:
  exec:
    command:
      - /opt/px/healthcheck.sh
      - live
  periodSeconds: 10
  timeoutSeconds: 15
  failureThreshold: 90
livenessProbe:
  exec:
    command:
      - /opt/px/healthcheck.sh
      - live
  periodSeconds: 10
  timeoutSeconds: 15
  failureThreshold: ${PX_M_LIVENESS_THRESHOLD}

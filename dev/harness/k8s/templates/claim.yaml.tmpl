# This template defines a persistent volume claim template entry for a StatefulSet, dynamically
# provisioned using the configured StorageClass. It is instantiated as the data claim for the data
# directory of each stateful role and as the tmp claim mounted at /tmp/px inside every pod.

- metadata:
    name: ${PX_M_CLAIM}
    labels:
${PX_M_LABELS}
  spec:
    accessModes:
      - ReadWriteOnce
    storageClassName: ${PX_M_STORAGE_CLASS}
    resources:
      requests:
        storage: ${PX_M_VOLUME_GIB}Gi

# This template defines the common pod specification shared across all workloads. It runs a single
# container named px under an unprivileged user identity with all capabilities dropped, and
# configures a dedicated DNS search domain for each headless Service to resolve the bare name of
# any peer.

restartPolicy: ${PX_M_RESTART}
automountServiceAccountToken: false
enableServiceLinks: false
terminationGracePeriodSeconds: ${PX_M_GRACE}
securityContext:
  runAsNonRoot: true
  runAsUser: ${PX_M_UID}
  runAsGroup: ${PX_M_GID}
  fsGroup: ${PX_M_GID}
  seccompProfile:
    type: RuntimeDefault
dnsConfig:
  searches:
${PX_M_SEARCHES}
containers:
  - name: px
    image: "${PX_M_IMAGE}"
    imagePullPolicy: Never
    securityContext:
      runAsNonRoot: true
      runAsUser: ${PX_M_UID}
      allowPrivilegeEscalation: false
      capabilities:
        drop:
          - ALL
    envFrom:
      - configMapRef:
          name: px-env
    env:
${PX_M_ENV}
    ports:
${PX_M_PORTS}
    resources:
      requests:
        cpu: ${PX_M_CPU}m
        memory: ${PX_M_MEM}Mi
      limits:
        cpu: ${PX_M_CPU}m
        memory: ${PX_M_MEM}Mi
${PX_M_PROBES}
    volumeMounts:
${PX_M_MOUNTS}
volumes:
${PX_M_VOLUMES}

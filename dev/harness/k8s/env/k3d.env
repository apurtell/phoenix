# Target configuration for a local k3d cluster. Specify this file with --config, for example:
#   px-cluster --backend k8s --config k8s/env/k3d.env render
# Because the k3d cluster is named px, its kubeconfig context is k3d-px, and k3d provides the local
# path provisioner under the StorageClass local-path.
PX_K8S_CONTEXT=k3d-px
PX_K8S_STORAGE_CLASS=local-path

# This file defines the target configuration for the local cluster managed by px-k3d. When the
# Kubernetes backend is active and PX_K8S_TARGET does not specify an alternate target file, the
# configuration loader reads this file before loading k8s/env/k8s.env. Because the local cluster is
# named px, its kubeconfig context is k3d-px, and persistent volumes are dynamically provisioned by
# the local path provisioner under the local-path StorageClass.
PX_K8S_CONTEXT=k3d-px
PX_K8S_STORAGE_CLASS=local-path
# The memory allowance reserved for the k3s server and its agents, which the local budget check in
# scripts/preflight-k8s.sh deducts from the container engine memory alongside the host headroom.
# This allowance accounts for node container memory consumed outside the pod working sets, including
# k3s, containerd, system pods, the kernel, and the image cache. Across a three-node cluster, this
# overhead measures approximately 780 MiB at idle and peaks at approximately 2210 MiB under load, so
# the configured value rounds that maximum up to the next 256 MiB multiple.
PX_K3S_ALLOWANCE_MIB=2304

# This file defines the default configuration values for the Kubernetes backend. When PX_BACKEND is
# set to k8s, the configuration loader reads this file after the run class and before
# docker/env/defaults.env, ensuring that operator-supplied values and run class settings take
# precedence. Both a cluster target file and the sibling k3d.env file for a local k3d cluster are
# supplied as --config files and override the defaults defined here.
#
# Two variables are intentionally left without defaults in this file:
#   PX_K8S_CONTEXT       This variable specifies the kubeconfig context for the target cluster. The
#                        backend never uses the current context of the kubeconfig, ensuring that a
#                        run cannot land on a cluster that the shell selected by chance.
#   PX_K8S_STORAGE_CLASS This variable defines the StorageClass assigned to every claim. A render
#                        without one terminates immediately with exit code 2.

# This setting defines the internal DNS domain of the cluster. Every pod resolves the bare hostname
# of a peer, such as zookeeper-0, through a dedicated search domain for each headless Service:
# <role>.<namespace>.svc.<domain>.
PX_K8S_CLUSTER_DOMAIN=cluster.local

# This setting specifies the persistent volume claim size allocated to each stateful role, in GiB.
PX_K8S_VOLUME_GIB=10

# This setting configures the CPU allocation for every container, measured in millicores per GiB of
# its memory limit. Both CPU and memory requests are set equal to their respective limits so that
# every pod is placed in the Guaranteed QoS class. Because the Compose deployment does not specify
# a CPU limit, this rule derives the allocation directly from the memory assigned to the role.
PX_K8S_CPU_MILLI_PER_GIB=250

# This setting specifies the maximum JVM pause duration, in seconds, that the liveness probe
# tolerates. A garbage collection pause or a STOP signal of this duration does not cause the
# kubelet to restart a daemon, whereas a longer pause triggers a restart.
PX_K8S_MAX_PAUSE_S=120

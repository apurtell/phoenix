# This file defines the default configuration values for the Kubernetes backend. When PX_BACKEND is
# set to k8s, the configuration loader reads this file after the run class and before
# docker/env/defaults.env, ensuring that operator-supplied values and run class settings take
# precedence. The defaults defined here are overridden either by an explicit cluster target file
# (PX_K8S_TARGET) or by the sibling k3d.env file for the local px-k3d cluster, which the loader
# reads first whenever PX_K8S_TARGET is unset.
#
# Two variables are intentionally left without defaults in this file:
#   PX_K8S_CONTEXT       This variable specifies the kubeconfig context for the target cluster. The
#                        backend never uses the current context of the kubeconfig, ensuring that a
#                        run cannot land on a cluster that the shell selected by chance.
#   PX_K8S_STORAGE_CLASS This variable defines the StorageClass assigned to every claim. A render
#                        without one terminates immediately with exit code 2.

# This setting defines the internal DNS domain of the cluster. Every pod resolves the bare hostname
# of a peer, such as zookeeper-0, through a dedicated search domain for each headless Service:
# <role>.<namespace>.svc.<domain>.
PX_K8S_CLUSTER_DOMAIN=cluster.local

# This setting specifies the persistent volume claim size allocated to each stateful role, in GiB.
PX_K8S_VOLUME_GIB=10

# This setting configures the CPU allocation for every container, measured in millicores per GiB of
# its memory limit. Both CPU and memory requests are set equal to their respective limits so that
# every pod is placed in the Guaranteed QoS class. Because the Compose deployment does not specify
# a CPU limit, this rule derives the allocation directly from the memory assigned to the role.
PX_K8S_CPU_MILLI_PER_GIB=250

# This setting defines the recovery time bound for the Kubernetes backend (recovery.seconds.max in
# the cluster checks, measured in seconds, compared to the 120 s baseline on Compose). It equals
# the Compose bound plus the additional time introduced by container CPU limits during the slowest
# recovery operation, a drain-aware RegionServer restart. Under a CPU limit of c millicores
# (c < 1000), a CPU-bound phase requiring W seconds on one core takes W x 1000 / c seconds. The
# restart launches two region mover JVMs in tooling 0 at 6.25 core-seconds each (45 to 50 s at
# 125m) and one RegionServer JVM requiring 16.7 s from start to ready on Compose. Under the
# validation sizing class, which allocates the least CPU (tooling at 125m and RegionServer at
# 625m), CPU throttling adds 2 x 6.25 x 7 + 16.7 x 0.6 = 97.5 s, producing a bound of 217.5 s that
# rounds up to 220. Because the readiness probe period, stop grace period, poll interval, and pause
# bound are identical across both backends, they add no extra time. This bound accounts solely for
# the CPU limits: the model treats each phase as single-core work even though JVM startup spans
# multiple threads, and it does not measure the time needed to reattach a persistent volume claim
# after pod replacement on remote storage. The resulting value provides a 51 s margin over the
# slowest measured restart (168.6 s on k3d), and the self-test recomputes it from the CPU ratio and
# the sizing files.
PX_THRESHOLD_RECOVERY_SECONDS_MAX=220

# This setting specifies the maximum JVM pause duration, in seconds, that the liveness probe
# tolerates. A garbage collection pause or a STOP signal of this duration does not cause the
# kubelet to restart a daemon, whereas a longer pause triggers a restart.
PX_K8S_MAX_PAUSE_S=120

# This setting declares whether the target cluster nodes run the deployment exclusively and nothing
# else. Because only a declared target produces authoritative time verdicts, px-run evaluates this
# setting in place of the quiet-host check. A dedicated target file sets this value to 1.
PX_K8S_DEDICATED_NODES=0

# These settings control the service mesh overlay. Setting PX_K8S_MESH to 1 labels the namespace
# for sidecar injection and annotates every pod in the core group, though the core daemons remain
# outside the mesh unless PX_K8S_MESH_CORE is also set to 1. By default, the rendered deployment is
# flat.
PX_K8S_MESH=0
PX_K8S_MESH_CORE=0

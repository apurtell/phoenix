# The harness writes nothing in the tree: every byte a run produces lands
# under $PX_OUT. These patterns catch an accident, so one mistake cannot
# commit an output directory, a local override or a generated file.

# An output root that was pointed at the tree by mistake. The resolver
# refuses such a path, so a directory with one of these names is a leftover
# from a hand-run command.
/out/
/runs/
/state/
/dist/
/images/

# Local overrides and generated environment files. A later round generates
# the port map, and the first retrieval of an unpinned artifact records its
# hash. Neither is committed.
*.local.env
*.generated.env

# Captured command output and editor leftovers.
*.log
*.swp
.DS_Store

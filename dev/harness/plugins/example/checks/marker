# Implements the cluster check script for the example plug-in, which suites/check-cluster.sh
# executes after the built-in subjects and steady-state checks. This script counts the marker files
# written into $PX_HOOK_OUT by the hooks of the current run and persists its outcome twice: once as
# a verdict row consumed by the merge step, and once as a metric record that preserves the measured
# value for post-run inspection. Its exit status indicates only that the script executed.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every check script}"
: "${PX_HOME:?the harness sets PX_HOME for every check script}"
# shellcheck source=SCRIPTDIR/../../../lib/bundle.sh
. "$PX_HOME/lib/bundle.sh"

count=0
names=""
for marker in "$PX_HOOK_OUT"/*.marker; do
  if [ -f "$marker" ]; then
    count=$((count + 1))
    names="$names ${marker##*/}"
  fi
done
pb_metric plugin.example.markers count "$count" markers
if [ "$count" -gt 0 ]; then
  sx_verdict_row plugin.example.marker PASS count "$count hook markers in this run:$names"
else
  sx_verdict_row plugin.example.marker FAIL count "no hook of the example plug-in fired in this run"
fi

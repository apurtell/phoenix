# Implements the image-check hook for the example plugin, which the deployment generator invokes
# once per render with the image assigned to every role. Validation succeeds only when the image
# reference is a local repository:tag with no registry host and no digest, since the harness
# executes only local images. Any check failure aborts the render pass so that the backend never
# provisions an instance of a refused deployment.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
image=${1:-}
case "$image" in
*@* | *.*/* | *:*/* | localhost/* | '' | *[!A-Za-z0-9._/:-]* | [!a-z0-9]*)
  printf 'example image-check: %s is not a local repository:tag\n' "${image:-(none)}" >&2
  exit 1
  ;;
*:*) ;;
*)
  printf 'example image-check: %s names no tag\n' "$image" >&2
  exit 1
  ;;
esac
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/image-check.marker"

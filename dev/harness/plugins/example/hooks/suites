# Implements the suites hook for the example plug-in. The px-suite command invokes this hook
# whenever it resolves a suite argument, including during a dry run. Each line written to stdout
# specifies the path to one suite file, relative to the plug-in directory.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
printf 'suites/example.suite\n'
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/suites.marker"

# Implements the pre-workload hook for the example plugin, invoked by px-run after prepare and
# before run. Validation succeeds only when the staged dataset has arrived and contains at least
# one row, ensuring that the run phase never measures an empty stage, and, in a cluster run, when
# the remote copy on client 0 is also non-empty.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
: "${PX_HOME:?the harness sets PX_HOME for every hook}"
data="$PX_HOOK_OUT/data/example.tsv"
rows="$(awk '!/^#/ && NF { n++ } END { print n + 0 }' "$data" 2>/dev/null || echo 0)"
if [ "$rows" -lt 1 ]; then
  printf 'example pre-workload: no staged row in %s\n' "$data" >&2
  exit 1
fi
if [ -n "${PX_SCOPE_ID:-}" ]; then
  # shellcheck source=SCRIPTDIR/../../../lib/common.sh
  . "$PX_HOME/lib/common.sh"
  # shellcheck source=SCRIPTDIR/../../../lib/backend/contract.sh
  . "$PX_HOME/lib/backend/contract.sh"
  sb_load "${PX_BACKEND:-}"
  if ! sb_exec "$PX_SCOPE_ID" client 0 "${PX_TIMEOUT_VERB:-300}" -- \
    test -s "/tmp/px/$PX_RUN_ID/example.tsv" >&2; then
    printf 'example pre-workload: client 0 holds no staged copy of the dataset\n' >&2
    exit 1
  fi
fi
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/pre-workload.marker"

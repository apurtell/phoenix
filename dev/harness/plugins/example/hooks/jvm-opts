# Implements the jvm-opts hook for the example plugin, invoked once per render by the deployment
# generator. Each line written to stdout specifies a role key followed by the JVM options for every
# instance of that role, which the generator appends after PX_CLIENT_JVM_OPTS from the manifest.
# Options emitted by this hook must never set a memory or heap size.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
printf 'CLIENT -Dpx.example.hook=jvm-opts\n'
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/jvm-opts.marker"

# Implements the conf-overlay hook for the example plugin, invoked once per render by the
# deployment generator. This hook copies the plugin's single template, an hbase-site.xml overlay,
# into the hook overlay directory. The deployment generator merges that directory into the
# deployment overlay, which every instance renders after its base templates so the renderer merges
# the contributed property into the instance's hbase-site.xml file.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
: "${PX_PLUGIN_DIR:?the harness sets PX_PLUGIN_DIR for every hook}"
mkdir -p "$PX_HOOK_OUT/conf-overlay"
cp "$PX_PLUGIN_DIR/conf-overlay/hbase-site.xml.tmpl" "$PX_HOOK_OUT/conf-overlay/"
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/conf-overlay.marker"

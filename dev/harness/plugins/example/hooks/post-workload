# Implements the post-workload hook for the example plugin, invoked by px-run after the run verb
# completes and before restore begins. This check verifies that the staged dataset remains in place
# so that the workload has not destructively consumed the input required for subsequent runs. When
# running with a cluster, the hook then removes the remote dataset copy from client 0.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
: "${PX_HOME:?the harness sets PX_HOME for every hook}"
if [ ! -s "$PX_HOOK_OUT/data/example.tsv" ]; then
  printf 'example post-workload: the staged dataset is gone after the run\n' >&2
  exit 1
fi
if [ -n "${PX_SCOPE_ID:-}" ]; then
  # shellcheck source=SCRIPTDIR/../../../lib/common.sh
  . "$PX_HOME/lib/common.sh"
  # shellcheck source=SCRIPTDIR/../../../lib/backend/contract.sh
  . "$PX_HOME/lib/backend/contract.sh"
  sb_load "${PX_BACKEND:-}"
  sb_exec "$PX_SCOPE_ID" client 0 "${PX_TIMEOUT_VERB:-300}" -- \
    rm -f "/tmp/px/$PX_RUN_ID/example.tsv" >&2
fi
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/post-workload.marker"

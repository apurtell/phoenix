# Implements the thresholds hook for the example plug-in, which suites/check-cluster.sh invokes
# once per run. Each line written to stdout overrides a single key in suites/thresholds.properties
# while leaving all other threshold keys unchanged. This example increases the maximum permitted
# number of WARN log lines to accommodate a plug-in that logs a deprecation warning on every call.

set -euo pipefail
: "${PX_HOOK_OUT:?the harness sets PX_HOOK_OUT for every hook}"
printf 'log.warnings.max=200\n'
date -u '+%Y-%m-%dT%H:%M:%SZ' >>"$PX_HOOK_OUT/thresholds.marker"

# Defines the test suite for the example plug-in. Because the suites hook reports this file path,
# px-suite resolves the suite name "example" to this definition whenever PX_PLUGINS enables the
# plug-in, and executes the plug-in's driver.

suite: example
description: The driver of the example plug-in
class: validation
timeout: 300

test: rows
  name: Count the staged rows with the example driver
  driver: example

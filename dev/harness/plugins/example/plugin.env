# Defines the manifest for the example plug-in, which serves as the worked example documented in
# docs/PLUGINS.md. Because the harness parses this file directly as text and never sources it as a
# shell script, every assigned value is treated as a literal string. Discovering the plug-in does
# not activate it automatically; setting PX_PLUGINS=example explicitly enables the plug-in.

# Declares the plug-in identifier, which matches the enclosing directory name, and the version of
# the plug-in contract that it implements.
PX_PLUGIN_ID=example
PX_PLUGIN_CONTRACT=1

# Specifies the six-verb workload driver script, which a suite definition selects by declaring
# "driver: example".
PX_PLUGIN_DRIVER=driver.sh

# Registers all nine lifecycle hooks, where each named entry maps to the executable at
# hooks/<name>. The hook list may continue across a second PX_PLUGIN_HOOKS declaration so that
# every line stays within the 100-column limit.
PX_PLUGIN_HOOKS=conf-overlay jvm-opts image-check fetch-data pre-workload
PX_PLUGIN_HOOKS=post-workload suites thresholds collect

# Overrides one entry in the heap table while retaining the default setup heap size for both run
# classes, allowing the example to demonstrate the key without changing any heap size.
PX_SETUP_HEAP_MIB=256

# Appends plug-in JVM options for the client role after the baseline JVM options supplied by the
# harness.
PX_CLIENT_JVM_OPTS=-Dpx.example=1

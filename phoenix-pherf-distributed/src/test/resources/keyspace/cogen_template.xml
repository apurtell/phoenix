<!-- A co-generated scenario for a fleet. The co-generation seed is fixed and the key columns use
     no slot token, so a key depends only on its global row index. The row offset of each slot
     comes from the slot token, so the slots write disjoint ranges of global indexes. -->
<datamodel name="keyspace_template">
    <datamapping>
        <column>
            <type>BIGINT</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000000000000</maxValue>
            <name>K1</name>
        </column>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>12</length>
            <prefix>k</prefix>
            <name>K2</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.KEYSPACE" rowCount="1000" name="keyspace">
            <coGeneration seed="11" offset="${pherf.slot.offset}" blockSize="50"/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1"
                      executionDurationInMs="1000">
                <query id="lookup"
                       statement="SELECT K2 FROM PHERF.KEYSPACE WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

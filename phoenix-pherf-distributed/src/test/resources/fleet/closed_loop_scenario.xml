<!-- A co-generated relational scenario with a closed loop query set of 2 workers. Each worker of
     the walk reads its own share of the committed rows, so a slot with 1 row gives worker 1 no
     row and no block, which Pherf's validator reports as cogen.walk. -->
<datamodel name="fleet_closed_loop">
    <datamapping>
        <column>
            <type>BIGINT</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000000000000</maxValue>
            <name>K1</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000</maxValue>
            <name>QTY</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.FLEET" rowCount="1000" name="fleetClosedLoop">
            <preScenarioDdls>
                <ddl tableName="PHERF.FLEET"
                     statement="CREATE TABLE IF NOT EXISTS ? (K1 BIGINT NOT NULL, K2 INTEGER NOT NULL, QTY INTEGER CONSTRAINT PK PRIMARY KEY (K1, K2))"/>
            </preScenarioDdls>
            <coGeneration seed="1" offset="${pherf.slot.offset}" blockSize="50"/>
            <querySet concurrency="2" executionType="SERIAL" numberOfExecutions="10"
                      executionDurationInMs="10000">
                <query id="lookup"
                       statement="SELECT QTY FROM PHERF.FLEET WHERE K1 = [K1] AND K2 = [K2]"/>
                <query id="rangeScan" kind="SCAN"
                       statement="SELECT K2, QTY FROM PHERF.FLEET WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

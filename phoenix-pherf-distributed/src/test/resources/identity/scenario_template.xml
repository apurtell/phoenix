<!-- A co-generated scenario that takes its seed, its row offset and its key prefix from the slot
     tokens of the data-plane identity. The primary key is (K1, K2). -->
<datamodel name="slot_template">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>12</length>
            <prefix>${pherf.slot.prefix}</prefix>
            <name>K1</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.SLOTS" rowCount="100" name="slots">
            <coGeneration seed="${pherf.slot.seed}" offset="${pherf.slot.offset}"/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1"
                      executionDurationInMs="1000">
                <query id="lookup"
                       statement="SELECT K2 FROM PHERF.SLOTS WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

# The disruption schedule of f1-disruptions without the restart, with a longer steady state.
# The suite also kills one region server JVM with SIGKILL, which tests crash recovery. A restart
# drains the server first and takes minutes, so it would overlap the kill. f1 tests the restart.
-Dsteady_state.duration=10m
-Ddisruption.schedule=1m:split,2m:move,3m:merge,4m:compact

# Load sizing. The quiesced sampler stops the writes while it scores, and at 100 queries per
# sample it was ten times the offered rate. Small samples let the mutations reach their rate.
-Drecall.sample.queries=10

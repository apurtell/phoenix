# The multi-tenant RAG profile at a size that fits the functional suite.
# The run covers every query family with a short rate sweep.
-Dcorpus.rows=100000
-Dcorpus.tenants=20
-Divf.lists=256
-Divf.sample_size=20000
-Drecall.panel.size=200
-Dsteady_state.duration=3m

# Load sizing for the IVF variant, which has the lowest capacity of the three variants. With 50
# mutations/s it sustains about 26 q/s, and the top stage and the sampler use about 45 % of that.
# The exact and HNSW variants add their own files with higher rates.
# The quiesced sampler stops the writes while it scores, so it scores few queries often.
# More mutation workers keep 50 mutations/s below the thread limit when write latency rises.
-Dquery.rate.values=4,8
-Drecall.sample.queries=3
-Drecall.sample.interval=20s
-Dmutation.threads=8

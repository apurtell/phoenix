# bin/vh-suite runs this file. Each line is one step: an id, an action and its arguments.
# Whitespace separates the words, and the runner does not interpret quotes.
# "@name" is the run id SESSION-name, so a resumed session finds the runs of earlier steps.
# The steps of one table pass the same overrides, so every phase sees the same settings.

# The scale suite runs the small synthetic profile with about 100 000 rows in each region.
# This row count is of the same order as the row count of a production region.
# At this count, the break-even point of the HNSW filter probe is inside the selectivity range.
# The suite compares filtered HNSW and IVF search with exact search near that point.
# It runs each variant in the schema VH_SCALE and takes about two hours.
# The overrides file scale.args holds the shared settings and gives their reasons.
# Near the break-even point, some HNSW searches read their regions without restriction.
# Thus the restriction check can warn about unrestricted searches. This result is expected.
# The qps steps compare the unfiltered throughput of each index with exact search.
# They are separate steps, so a missing exact run does not stop the other checks of an index.

setup-reset          cluster reset --yes
setup-up             cluster up
setup-verify         cluster verify

scale-exact-load     harness load smoke --variant exact --overrides scale
scale-exact-build    harness build-index smoke --variant exact --overrides scale
scale-exact-truth    harness truth smoke --variant exact --overrides scale
scale-exact-run      harness run smoke --variant exact --overrides scale --run-id @scale-exact
scale-exact-report   harness report - --run-id @scale-exact
scale-exact-check    check @scale-exact wrapper simd errors freshness recall-exact

scale-ivf-load       harness load smoke --variant ivf --overrides scale
scale-ivf-build      harness build-index smoke --variant ivf --overrides scale
scale-ivf-truth      harness truth smoke --variant ivf --overrides scale
scale-ivf-run        harness run smoke --variant ivf --overrides scale --run-id @scale-ivf
scale-ivf-report     harness report - --run-id @scale-ivf
scale-ivf-check      check @scale-ivf wrapper simd errors freshness recall-ivf-all probe-rise fsck statistics
scale-ivf-qps        needs=scale-exact-run check @scale-ivf qps-vs-exact:@scale-exact
scale-ivf-work       needs=scale-exact-run check @scale-ivf rows-vs-exact:@scale-exact rpcs-vs-exact:@scale-exact

scale-hnsw-load      harness load smoke --variant hnsw --overrides scale
scale-hnsw-build     harness build-index smoke --variant hnsw --overrides scale
scale-hnsw-truth     harness truth smoke --variant hnsw --overrides scale
scale-hnsw-run       harness run smoke --variant hnsw --overrides scale --run-id @scale-hnsw
scale-hnsw-report    harness report - --run-id @scale-hnsw
scale-hnsw-check     check @scale-hnsw wrapper simd errors freshness recall-hnsw-ef256 fsck uncovered restriction offheap statistics
scale-hnsw-qps       needs=scale-exact-run check @scale-hnsw qps-vs-exact:@scale-exact
scale-hnsw-work      needs=scale-exact-run check @scale-hnsw rows-vs-exact:@scale-exact rpcs-vs-exact:@scale-exact

scale-compare        needs=scale-exact-run,scale-ivf-run,scale-hnsw-run harness report - --run-id @scale-exact --compare @scale-ivf --compare @scale-hnsw

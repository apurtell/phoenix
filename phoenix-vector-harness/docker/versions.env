# This file pins every external input of the image build.
# The build scripts source it with bash. It holds only plain assignments.
# A gitignored versions.local.env, sourced after this file, can supply a pin that is empty here.

# Hadoop daemons. The arm64 release for this version is the lean tarball without the AWS SDK.
VH_HADOOP_VERSION=3.4.2
VH_HADOOP_TARBALL=hadoop-3.4.2-aarch64-lean.tar.gz
VH_HADOOP_URL=https://archive.apache.org/dist/hadoop/common/hadoop-3.4.2/hadoop-3.4.2-aarch64-lean.tar.gz
VH_HADOOP_SHA512_URL=https://archive.apache.org/dist/hadoop/common/hadoop-3.4.2/hadoop-3.4.2-aarch64-lean.tar.gz.sha512
VH_HADOOP_SHA512=d99a36c499d445152bb097531b3746d2bb4130c801d50fffa93aff63a13b43db135d06d636f9aaf6fcae5ebb882a069bd07ce53ade8edb66cff37b839049a2d9

# HBase daemons. The published checksum file uses the grouped gpg format; this pin is the
# normalized lowercase hex digest.
VH_HBASE_VERSION=2.6.7
VH_HBASE_TARBALL=hbase-2.6.7-hadoop3-bin.tar.gz
VH_HBASE_URL=https://archive.apache.org/dist/hbase/2.6.7/hbase-2.6.7-hadoop3-bin.tar.gz
VH_HBASE_SHA512_URL=https://archive.apache.org/dist/hbase/2.6.7/hbase-2.6.7-hadoop3-bin.tar.gz.sha512
VH_HBASE_SHA512=2e0835a3ed8e5a9114f5d878deafb2f7a6b1c8386ba422d1a307fcc5551d452dc7da468729a43acf75dcfe0b20424cb48f72ed424dfd15f81b1b3624454ed82d

# async-profiler release for linux/arm64. The project publishes no checksum file.
# The first download computes the digest and records it in versions.local.env.
VH_ASPROF_VERSION=4.4
VH_ASPROF_TARBALL=async-profiler-4.4-linux-arm64.tar.gz
VH_ASPROF_URL=https://github.com/async-profiler/async-profiler/releases/download/v4.4/async-profiler-4.4-linux-arm64.tar.gz
VH_ASPROF_SHA256=

# jHiccup release. The project publishes only a source tarball, so build-jhiccup.sh builds
# the agent jar from it. The jar holds a relocated copy of HdrHistogram, so it cannot clash
# with the copy on the harness class path.
VH_JHICCUP_VERSION=2.0.10
VH_JHICCUP_TARBALL=jHiccup-2.0.10.tar.gz
VH_JHICCUP_URL=https://github.com/giltene/jHiccup/archive/refs/tags/jHiccup-2.0.10.tar.gz
VH_JHICCUP_SHA256=6089ee15b667c71f7567cb7855613359b6e4f7c7bb641cdf707a59cd44b3cbe9
VH_JHICCUP_DIR=jHiccup-jHiccup-2.0.10
VH_JHICCUP_JAR=jhiccup-agent-2.0.10.jar
VH_JHICCUP_HDRHISTOGRAM_VERSION=2.1.12

# Base images. An empty PIN uses the tag; a PIN holds a digest such as sha256:<hex>.
VH_PLATFORM=linux/arm64
VH_BASE_JDK17_IMAGE=eclipse-temurin:17-jdk-noble
VH_BASE_JDK17_PIN=
VH_BASE_JDK21_IMAGE=eclipse-temurin:21-jdk-noble
VH_BASE_JDK21_PIN=
VH_BASE_UBUNTU_IMAGE=ubuntu:24.04
VH_BASE_UBUNTU_PIN=

# Phoenix artifacts from this branch. Staging copies these exact file names and never a glob.
VH_PHOENIX_VERSION=5.4.0-SNAPSHOT
VH_PHOENIX_HBASE_PROFILE=2.6
VH_PHOENIX_SERVER_JAR=phoenix-server-hbase-2.6-5.4.0-SNAPSHOT.jar
VH_HARNESS_JAR=phoenix-vector-harness-5.4.0-SNAPSHOT.jar
VH_HARNESS_COMPAT_JAR=phoenix-hbase-compat-2.6.4-5.4.0-SNAPSHOT.jar
# The harness client jars come from the Phoenix build, so their HBase version follows the
# Phoenix pom. It can differ from VH_HBASE_VERSION of the daemons.
VH_HARNESS_HBASE_CLIENT_JAR=hbase-client-2.6.5-hadoop3.jar

# The one user that runs every daemon and client.
VH_UID=1001
VH_GID=1001
VH_USER=vh

# Defaults for the host scripts and the compose file.
# The host scripts source env/local.env first and this file second, both with bash.
# Each line keeps a value that the caller or env/local.env already set.
# VH_ROOT and VH_REPO are set before this file is sourced.
# Values must not contain spaces or command substitutions.

# Host paths.
VH_WORK=${VH_WORK:-${VH_ROOT}/work}
VH_DATA=${VH_DATA:-${HOME}/vh-data}
VH_DIST_CACHE=${VH_DIST_CACHE:-${HOME}/.cache/phoenix-vector-harness/dist}
# Artifacts that the scripts build from cached sources, such as the jHiccup agent jar.
VH_BUILD_CACHE=${VH_BUILD_CACHE:-${HOME}/.cache/phoenix-vector-harness/build}
VH_CONTEXT=${VH_CONTEXT:-${VH_ROOT}/.context}

# Host build inputs. The build uses JDK 21 and a private Maven repository.
VH_M2=${VH_M2:-${HOME}/src/phoenix-m2-8035/repository}
VH_JDK21=${VH_JDK21:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home}
VH_MAVEN_TRUSTSTORE=${VH_MAVEN_TRUSTSTORE:-}

# Image and compose project.
VH_IMAGE=${VH_IMAGE:-phoenix-vh}
VH_IMAGE_TAG=${VH_IMAGE_TAG:-latest}
VH_PROJECT=${VH_PROJECT:-phoenix-vh}

# Operator settings.
VH_SUITE=${VH_SUITE:-adhoc}
VH_READY_TIMEOUT=${VH_READY_TIMEOUT:-900}
VH_STATS_INTERVAL=${VH_STATS_INTERVAL:-5}
# A rolling restart moves the regions of each region server with the region mover of HBase.
# The timeout applies to each drain and each load, in seconds. The threads value sets the
# number of parallel moves.
VH_RS_MOVE_THREADS=${VH_RS_MOVE_THREADS:-1}
VH_RS_MOVE_TIMEOUT=${VH_RS_MOVE_TIMEOUT:-600}
VH_ASPROF_EVENT=${VH_ASPROF_EVENT:-itimer}
# Sampling interval of the itimer, wall and cpu events of vh-profile. A prime number of
# microseconds does not stay in phase with the 50 ms query slots of the throttle. An empty value
# uses the asprof default.
VH_ASPROF_INTERVAL=${VH_ASPROF_INTERVAL-7919us}

# Preflight limits of the Docker VM.
VH_MIN_MEM_GIB=${VH_MIN_MEM_GIB:-46}
VH_MIN_CPUS=${VH_MIN_CPUS:-16}
VH_MIN_DISK_GIB=${VH_MIN_DISK_GIB:-40}
VH_MIN_DISK_GIB_PERF=${VH_MIN_DISK_GIB_PERF:-150}

# JVM heaps. Every daemon uses the same value for Xms and Xmx.
VH_HEAP_ZK=${VH_HEAP_ZK:-1g}
VH_HEAP_NN=${VH_HEAP_NN:-2g}
VH_HEAP_SNN=${VH_HEAP_SNN:-2g}
VH_HEAP_DN=${VH_HEAP_DN:-1g}
VH_HEAP_RM=${VH_HEAP_RM:-1g}
VH_HEAP_NM=${VH_HEAP_NM:-1g}
VH_HEAP_JHS=${VH_HEAP_JHS:-1g}
VH_HEAP_MASTER=${VH_HEAP_MASTER:-1g}
VH_HEAP_RS=${VH_HEAP_RS:-4g}
VH_DIRECT_RS=${VH_DIRECT_RS:-2g}
# G1 options of the region servers. The block cache holds less than the region data, so each
# young collection copies many new cache blocks. A larger reserve keeps free regions for this
# copy, and the young size limit bounds the copy. Set an empty value for the G1 defaults.
VH_RS_GC_OPTS=${VH_RS_GC_OPTS--XX:G1ReservePercent=25 -XX:+UnlockExperimentalVMOptions -XX:G1MaxNewSizePercent=30}
VH_HEAP_TOOLS=${VH_HEAP_TOOLS:-2g}
VH_DIRECT_TOOLS=${VH_DIRECT_TOOLS:-2g}
VH_HEAP_CLI=${VH_HEAP_CLI:-1g}
VH_HARNESS_HEAP=${VH_HARNESS_HEAP:-6g}
VH_HARNESS_DIRECT=${VH_HARNESS_DIRECT:-2g}
VH_HARNESS_CPUS=${VH_HARNESS_CPUS:-4}
VH_HARNESS_SIMD=${VH_HARNESS_SIMD:-true}
VH_HARNESS_EXTRA_OPTS=${VH_HARNESS_EXTRA_OPTS:-}

# Container memory limits. They are a backstop and not a reservation.
VH_MEM_ZK=${VH_MEM_ZK:-2g}
VH_MEM_NN=${VH_MEM_NN:-3g}
VH_MEM_SNN=${VH_MEM_SNN:-3g}
VH_MEM_DN=${VH_MEM_DN:-2g}
VH_MEM_RM=${VH_MEM_RM:-2g}
VH_MEM_NM=${VH_MEM_NM:-4g}
VH_MEM_JHS=${VH_MEM_JHS:-2g}
VH_MEM_MASTER=${VH_MEM_MASTER:-3g}
VH_MEM_RS=${VH_MEM_RS:-7g}
VH_MEM_TOOLS=${VH_MEM_TOOLS:-5g}
VH_MEM_CLI=${VH_MEM_CLI:-3g}
VH_HARNESS_MEM=${VH_HARNESS_MEM:-9g}

# Cluster settings that the rendered configuration uses.
VH_DFS_REPLICATION=${VH_DFS_REPLICATION:-3}
VH_BALANCER_PERIOD=${VH_BALANCER_PERIOD:-60000}
VH_HNSW_OFFHEAP_MAX_BYTES=${VH_HNSW_OFFHEAP_MAX_BYTES:-1073741824}
# This value sets the maximum size of the pool that does the data row lookups of uncovered
# index scans. Each region server has one pool. The default is the Phoenix default.
VH_UNCOVERED_INDEX_THREADS_MAX=${VH_UNCOVERED_INDEX_THREADS_MAX:-512}
VH_NM_MEMORY_MB=${VH_NM_MEMORY_MB:-2048}
VH_NM_VCORES=${VH_NM_VCORES:-2}
VH_ZK_MAX_CLIENT_CNXNS=${VH_ZK_MAX_CLIENT_CNXNS:-0}
# Default Phoenix metadata cache period in milliseconds for all servers and clients of the cluster.
# The default 0 is ALWAYS, the Phoenix default, as in production. Phoenix then reads the metadata
# for each statement. Use a value greater than 0 only for experiments.
# Keep the value equal to table.update_cache_frequency of the harness.
VH_UPDATE_CACHE_FREQUENCY_MS=${VH_UPDATE_CACHE_FREQUENCY_MS:-0}
# Statistics mode of the cluster and the harness: off or on.
# The off mode matches production. No server or client collects or reads statistics.
# The on mode collects statistics. The harness then sets small guideposts on its tables, and it
# updates the statistics after each index build and promotion.
# The harness gets the same mode, and it refuses a run against a cluster in the other mode.
VH_STATISTICS=${VH_STATISTICS:-off}

# Diagnostic switches. The value 1 turns a switch on.
VH_RS_SIMD=${VH_RS_SIMD:-1}
VH_JVECTOR_FORCE_PANAMA=${VH_JVECTOR_FORCE_PANAMA:-0}
VH_JFR=${VH_JFR:-0}
VH_HICCUP=${VH_HICCUP:-0}
VH_DEBUG=${VH_DEBUG:-0}

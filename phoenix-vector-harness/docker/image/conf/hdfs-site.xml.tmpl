<!--
  HDFS settings for the name node, the secondary name node, the data nodes, and all clients.
  All containers share the host network, so each data node instance has its own ports.
  The port values come from the port table of the image.
-->
<configuration>
  <!-- Name node. The RPC address is explicit. Service RPC, lifeline and backup stay off. -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>localhost:${VH_NN_RPC}</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:${VH_NN_HTTP}</value>
  </property>
  <property>
    <name>dfs.namenode.https-address</name>
    <value>0.0.0.0:${VH_NN_HTTPS}</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file://${VH_NN_DIR}</value>
  </property>
  <!-- A short safe mode extension makes restarts faster. -->
  <property>
    <name>dfs.namenode.safemode.extension</name>
    <value>5000</value>
  </property>

  <!-- Secondary name node. -->
  <property>
    <name>dfs.namenode.secondary.http-address</name>
    <value>0.0.0.0:${VH_SNN_HTTP}</value>
  </property>
  <property>
    <name>dfs.namenode.secondary.https-address</name>
    <value>0.0.0.0:${VH_SNN_HTTPS}</value>
  </property>
  <property>
    <name>dfs.namenode.checkpoint.dir</name>
    <value>file://${VH_SNN_DIR}</value>
  </property>

  <!-- Data node. Each instance has its own volume, which keeps its lock file and its UUID. -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file://${VH_DN_DIR}</value>
  </property>
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:${VH_DN_XFER}</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:${VH_DN_HTTP}</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>0.0.0.0:${VH_DN_IPC}</value>
  </property>
  <property>
    <name>dfs.datanode.https.address</name>
    <value>0.0.0.0:${VH_DN_HTTPS}</value>
  </property>
  <!--
    Block locations use the same host name as the region server names.
    HBase locality then matches the block hosts.
  -->
  <property>
    <name>dfs.datanode.hostname</name>
    <value>localhost</value>
  </property>

  <!-- Client settings. HBase and the harness read them too. -->
  <property>
    <name>dfs.replication</name>
    <value>${VH_DFS_REPLICATION}</value>
  </property>
  <!--
    With three data nodes and three replicas, no spare data node exists for a write pipeline.
    A data node restart must not fail the open write streams.
  -->
  <property>
    <name>dfs.client.block.write.replace-datanode-on-failure.best-effort</name>
    <value>true</value>
  </property>
</configuration>

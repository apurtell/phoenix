<!--
  Common Hadoop settings for every daemon, for HBase, and for the harness client.
  The entrypoint renders this template at each container start.
  hadoop.tmp.dir keeps its default. That directory is local to each container.
-->
<configuration>
  <!-- The default file system is HDFS. Bulk load and HFile output must not go to a local disk. -->
  <property>
    <name>fs.defaultFS</name>
    <value>${VH_FS_DEFAULT}</value>
  </property>
</configuration>

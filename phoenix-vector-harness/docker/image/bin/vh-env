# This script runs a command with the environment of the container role.
# "docker exec" does not run the entrypoint, so its commands do not get the role settings.
# Examples of these settings are the heap sizes, the JVM module flags, and the conf directories.
# The container environment must hold VH_ROLE, and VH_INDEX for an indexed role.
#
# Usage: vh-env [COMMAND [ARG...]]
#   With no command, the script prints the VH_* variables of the role.

set -euo pipefail

# shellcheck source=SCRIPTDIR/../lib/ports.sh
. /opt/vh/lib/ports.sh
# shellcheck source=SCRIPTDIR/../lib/roles.sh
. /opt/vh/lib/roles.sh

if [ "$#" -eq 0 ]; then
  env | grep -E '^VH_[A-Z0-9_]+=' | sort
  exit 0
fi
exec "$@"

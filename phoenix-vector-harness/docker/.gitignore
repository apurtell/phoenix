# Generated and local files of the cluster framework.
# The build context holds copies of jars and tarballs.
/.context/
# Run output, daemon logs and profiles.
/work/
# A local tarball cache, if VH_DIST_CACHE points here.
/.cache/
# Local settings and pins that fetch-dist.sh records.
/env/local.env
/versions.local.env
*.part

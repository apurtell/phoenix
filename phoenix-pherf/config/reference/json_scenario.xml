<!-- Reference co-generated scenario for JSON documents, with its smoke profile in the same
     directory. Run it from the source tree (in the cluster zip the path is config/reference/...):

       bin/pherf-standalone.py -l -q -z <zookeeper> -disableSchemaApply \
         -scenarioFile phoenix-pherf/config/reference/json_scenario.xml

     The data load (-l) creates the table and writes 1000 rows in blocks of 40. The query set then
     runs 60 operations on 1 worker: 30 point lookups, 18 range scans and 12 range deletes. Each
     DELETE removes the next block, and reads see only the rows that are left, so 520 rows are left.
     A next run with -l writes the deleted rows again. To scale up, add -threadCount,
     -runDurationMs or -targetRate. More arrivals give more deletes, and a read fails when no row
     is left. So the rows must stay above deletes x 40: -rowCountOverride must grow at least by
     the factor of the arrivals. For example, -runDurationMs 20000 gives 10 times the arrivals
     and needs -rowCountOverride 10000 or more. -->

<datamodel name="reference_json">
    <datamapping>
        <!-- K1 is the leading key and the range column of the SCAN and the DELETE. It increases
             with the row index and has one value for each row, so a block of rows is one key
             range. -->
        <column>
            <type>BIGINT</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000000000000</maxValue>
            <name>K1</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
        <!-- A RANDOM document has the fields s, n, d, b, a and o; the string fields have 8
             characters. -->
        <column>
            <type>JSON</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>8</length>
            <name>DOC</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.REF_JSON" rowCount="1000" name="referenceJson">
            <preScenarioDdls>
                <ddl tableName="PHERF.REF_JSON"
                     statement="CREATE TABLE IF NOT EXISTS ? (K1 BIGINT NOT NULL, K2 INTEGER NOT NULL, DOC JSON CONSTRAINT PK PRIMARY KEY (K1, K2))"/>
            </preScenarioDdls>
            <coGeneration seed="2" blockSize="40"/>
            <querySet concurrency="1" profile="json_smoke_profile.xml">
                <query id="lookup"
                       statement="SELECT JSON_VALUE(DOC, '$.s') FROM PHERF.REF_JSON WHERE K1 = [K1] AND K2 = [K2]"/>
                <query id="rangeScan" kind="SCAN"
                       statement="SELECT K2, JSON_VALUE(DOC, '$.n') FROM PHERF.REF_JSON WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
                <query id="rangeDelete" kind="DELETE"
                       statement="DELETE FROM PHERF.REF_JSON WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

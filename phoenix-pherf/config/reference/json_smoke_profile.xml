<!-- Smoke profile of json_scenario.xml: 1000 ms at 20/s, then 1000 ms from 20/s to 60/s, so
     20 + 40 = 60 arrivals. The mix gives 30 SELECT, 18 SCAN and 12 DELETE operations. LATE with no
     lag limit runs every arrival. -->
<workloadProfile>
    <openLoop arrival="UNIFORM" lagPolicy="LATE">
        <stage durationMs="1000" rate="20"/>
        <stage durationMs="1000" rate="20" endRate="60"/>
    </openLoop>
    <mix>
        <operation kind="SELECT" weight="50"/>
        <operation kind="SCAN" weight="30"/>
        <operation kind="DELETE" weight="20"/>
    </mix>
</workloadProfile>

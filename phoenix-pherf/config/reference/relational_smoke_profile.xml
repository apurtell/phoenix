<!-- Smoke profile of relational_scenario.xml: 2000 ms at 50/s, so 100 arrivals. The mix gives 70
     SELECT, 20 SCAN and 10 DELETE operations. LATE with no lag limit runs every arrival. -->
<workloadProfile>
    <openLoop arrival="UNIFORM" lagPolicy="LATE">
        <stage durationMs="2000" rate="50"/>
    </openLoop>
    <mix>
        <operation kind="SELECT" weight="70"/>
        <operation kind="SCAN" weight="20"/>
        <operation kind="DELETE" weight="10"/>
    </mix>
</workloadProfile>

<!-- A clean co-generated scenario for the validator: the DDL gives the primary key (K1, K2), the
     open loop query set takes its schedule and mix from clean_cogen_profile.xml, and a closed
     loop query set reads with 1 to 4 workers. The tests make each defect with a text replacement
     in a copy of this file. -->
<datamodel name="validation_clean">
    <datamapping>
        <column>
            <type>BIGINT</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000000000</maxValue>
            <name>K1</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>8</length>
            <name>V</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.VALIDATION_CLEAN" rowCount="1000" name="validationClean">
            <preScenarioDdls>
                <ddl tableName="PHERF.VALIDATION_CLEAN"
                     statement="CREATE TABLE IF NOT EXISTS ? (K1 BIGINT NOT NULL, K2 INTEGER NOT NULL, V VARCHAR CONSTRAINT PK PRIMARY KEY (K1, K2))"/>
            </preScenarioDdls>
            <coGeneration seed="7" blockSize="50"/>
            <querySet concurrency="1" profile="clean_cogen_profile.xml">
                <query id="lookup"
                       statement="SELECT V FROM PHERF.VALIDATION_CLEAN WHERE K1 = [K1] AND K2 = [K2]"/>
                <query id="scan" kind="SCAN"
                       statement="SELECT K2, V FROM PHERF.VALIDATION_CLEAN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
                <query id="delete" kind="DELETE"
                       statement="DELETE FROM PHERF.VALIDATION_CLEAN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
            </querySet>
            <querySet concurrency="1-4" executionType="SERIAL" numberOfExecutions="10">
                <query id="closedLookup"
                       statement="SELECT K1, V FROM PHERF.VALIDATION_CLEAN WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

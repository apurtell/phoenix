<!-- A valid scenario with the release attribute of older Pherf. The parser reads the attribute
     and does not use it, and the validator reports no finding. -->
<datamodel release="192" name="validation_release">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>8</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.TEST_TABLE" rowCount="10" name="releaseAttribute">
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="2">
                <query id="count" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

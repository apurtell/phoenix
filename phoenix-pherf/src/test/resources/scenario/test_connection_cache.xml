<datamodel name="test_connection_cache">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- Six threads run the query twenty times each. With -connectionCache, the query
             connections come from a cache of at most pherf.default.threadpool connections.
             Only the query connections get the scenario property, so it marks them in the
             connection records. -->
        <scenario tableName="PHERF.TEST_TABLE" rowCount="4" name="testConnectionCache">
            <phoenixProperties>
                <entry>
                    <key>pherf.test.group</key>
                    <value>C</value>
                </entry>
            </phoenixProperties>
            <querySet concurrency="6" executionType="SERIAL" numberOfExecutions="20">
                <query id="c1" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

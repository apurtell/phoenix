<datamodel name="test_warmup">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- Each thread runs warmupExecutions operations of each query before it measures
             numberOfExecutions operations. Warmup samples go only to the latency phase
             "warmup", and the legacy reports do not count them. -->
        <scenario tableName="PHERF.TEST_TABLE" rowCount="4" name="testWarmup">
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="3"
                      warmupExecutions="2">
                <query id="w1" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
            <querySet concurrency="2" executionType="SERIAL" numberOfExecutions="4"
                      warmupExecutions="3">
                <query id="w2" statement="select sum(SOME_INT) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

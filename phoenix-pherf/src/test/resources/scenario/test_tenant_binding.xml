<datamodel name="test_tenant_binding">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- Queries and DDLs without a tenant use the scenario tenant unless they ask for a
             global connection. -->
        <scenario tableName="PHERF.TEST_VIEW" tenantId="TENANT_A" rowCount="10"
                  name="testTenantBinding">
            <preScenarioDdls>
                <ddl statement="CREATE VIEW IF NOT EXISTS PHERF.TEST_VIEW (F1 VARCHAR) AS SELECT * FROM PHERF.TEST_TABLE"/>
                <ddl statement="CREATE INDEX IF NOT EXISTS IDX_BIND ON PHERF.TEST_TABLE (FIELD)"
                     useGlobalConnection="true"/>
            </preScenarioDdls>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1">
                <query id="q1" ddl="CREATE VIEW IF NOT EXISTS PHERF.TEST_VIEW2 (F2 VARCHAR) AS SELECT * FROM PHERF.TEST_TABLE"
                       statement="select count(*) from PHERF.TEST_VIEW"/>
                <query id="q2" tenantId="TENANT_B" statement="select count(*) from PHERF.TEST_VIEW"/>
                <query id="q3" useGlobalConnection="true"
                       statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

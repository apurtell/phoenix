<!-- One RANDOM rule and one LIST rule for each native type. Each rule is for one column. -->
<datamodel name="test_native_types">
    <datamapping>
        <!-- VARBINARY_ENCODED: length is the byte count. A LIST value is hex text. -->
        <column>
            <type>VARBINARY_ENCODED</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>16</length>
            <name>ID</name>
        </column>
        <column>
            <type>VARBINARY_ENCODED</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>VB_L</name>
            <valuelist>
                <datavalue><value>00ff00</value></datavalue>
                <datavalue><value>ff00</value></datavalue>
                <datavalue><value>0a</value></datavalue>
            </valuelist>
        </column>
        <!-- Arrays: length is the element count. Each element is in [minValue, maxValue].
             A LIST gives all its values as the elements of one array. -->
        <column>
            <type>FLOAT_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>4</length>
            <minValue>-100</minValue>
            <maxValue>100</maxValue>
            <name>FA</name>
        </column>
        <column>
            <type>FLOAT_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>FA_L</name>
            <valuelist>
                <datavalue><value>1.5</value></datavalue>
                <datavalue><value>-2.25</value></datavalue>
                <datavalue><value>0.0</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>DOUBLE_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>3</length>
            <minValue>0</minValue>
            <maxValue>1000</maxValue>
            <name>DA</name>
        </column>
        <column>
            <type>DOUBLE_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>DA_L</name>
            <valuelist>
                <datavalue><value>0.125</value></datavalue>
                <datavalue><value>999.5</value></datavalue>
            </valuelist>
        </column>
        <!-- JSON and BSON: length is the length of the string fields of a RANDOM document.
             A LIST value is document text. -->
        <column>
            <type>JSON</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>8</length>
            <prefix>p</prefix>
            <name>DOC</name>
        </column>
        <column>
            <type>JSON</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>DOC_L</name>
            <valuelist>
                <datavalue><value>{"k":"a","n":1}</value></datavalue>
                <datavalue><value>{"k":"b","v":[1,2]}</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>BSON</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>8</length>
            <name>BDOC</name>
        </column>
        <column>
            <type>BSON</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>BDOC_L</name>
            <valuelist>
                <datavalue><value>{"k":"c","o":{"x":true}}</value></datavalue>
                <datavalue><value>{"k":"d","d":2.5}</value></datavalue>
            </valuelist>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.NATIVE_TYPES" rowCount="20" name="testNativeTypes"/>
    </scenarios>
</datamodel>

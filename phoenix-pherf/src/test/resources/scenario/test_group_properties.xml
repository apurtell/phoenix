<datamodel name="test_group_properties">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- A querySet can add its own connection properties to the scenario properties. A
             querySet value replaces a scenario value with the same key. A querySet with no
             properties uses the scenario properties. -->
        <scenario tableName="PHERF.TEST_TABLE" rowCount="4" name="testGroupProperties">
            <phoenixProperties>
                <entry>
                    <key>pherf.test.shared</key>
                    <value>scenario</value>
                </entry>
                <entry>
                    <key>pherf.test.key</key>
                    <value>scenario</value>
                </entry>
            </phoenixProperties>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="3">
                <phoenixProperties>
                    <entry>
                        <key>pherf.test.group</key>
                        <value>A</value>
                    </entry>
                    <entry>
                        <key>pherf.test.key</key>
                        <value>A</value>
                    </entry>
                </phoenixProperties>
                <query id="qa" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="2">
                <phoenixProperties>
                    <entry>
                        <key>pherf.test.group</key>
                        <value>B</value>
                    </entry>
                </phoenixProperties>
                <query id="qb" statement="select sum(SOME_INT) from PHERF.TEST_TABLE"/>
            </querySet>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1">
                <query id="qc" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

<!-- One closed loop point lookup with co-generation. 20 executions on one thread read each of the 20
     loaded rows once. -->
<datamodel name="cogen_closed_loop">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>K1</name>
            <valuelist>
                <datavalue distribution="50"><value>a</value></datavalue>
                <datavalue distribution="30"><value>b</value></datavalue>
                <datavalue distribution="20"><value>c</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.COGEN" rowCount="20" name="cogenRun">
            <coGeneration seed="11"/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="20"
                      executionDurationInMs="600000">
                <query id="lookup" statement="SELECT V FROM PHERF.COGEN WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

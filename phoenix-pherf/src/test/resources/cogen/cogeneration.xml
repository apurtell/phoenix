<!-- Co-generation fixtures. This directory is outside the scenario directory, so the checks of all
     scenario fixtures do not read these files. -->
<datamodel name="cogeneration">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>10</length>
            <name>GENERAL_VARCHAR</name>
        </column>
        <!-- The primary key is (K1, K2). K2 is unique for each row index. -->
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>K1</name>
            <valuelist>
                <datavalue distribution="50"><value>a</value></datavalue>
                <datavalue distribution="30"><value>b</value></datavalue>
                <datavalue distribution="20"><value>c</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>0</minValue>
            <maxValue>2000000000</maxValue>
            <name>K2</name>
        </column>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>12</length>
            <prefix>v</prefix>
            <name>V</name>
        </column>
        <!-- Generator classes: G1 has no index interface, G2 has it. -->
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <name>G1</name>
            <generatorClass>org.apache.phoenix.pherf.rules.IndexedGeneratorTest$Plain</generatorClass>
        </column>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <name>G2</name>
            <generatorClass>org.apache.phoenix.pherf.rules.IndexedGeneratorTest$Indexed</generatorClass>
        </column>
        <!-- One rule for each other kind, for the reproducibility golden file. -->
        <column>
            <type>CHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>6</length>
            <prefix>c</prefix>
            <name>T_CHAR</name>
        </column>
        <column>
            <type>VARBINARY</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <length>8</length>
            <prefix>vb</prefix>
            <name>T_VARBINARY</name>
        </column>
        <column>
            <type>VARBINARY_ENCODED</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>4</length>
            <name>T_VBE</name>
        </column>
        <column>
            <type>DECIMAL</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>1</minValue>
            <maxValue>500</maxValue>
            <precision>6</precision>
            <name>T_DEC</name>
        </column>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>-5</minValue>
            <maxValue>5</maxValue>
            <name>T_INT</name>
        </column>
        <column>
            <type>TINYINT</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>-128</minValue>
            <maxValue>127</maxValue>
            <name>T_TINY</name>
        </column>
        <column>
            <type>BIGINT</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>10</minValue>
            <maxValue>1000000</maxValue>
            <name>T_BIG</name>
        </column>
        <column>
            <type>UNSIGNED_LONG</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <minValue>1</minValue>
            <maxValue>1000000</maxValue>
            <name>T_ULONG</name>
        </column>
        <column>
            <type>DATE</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>2000</minValue>
            <maxValue>2001</maxValue>
            <name>T_DATE</name>
        </column>
        <column>
            <type>TIMESTAMP</type>
            <userDefined>true</userDefined>
            <dataSequence>SEQUENTIAL</dataSequence>
            <name>T_TS</name>
        </column>
        <column>
            <type>DATE</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>T_DLIST</name>
            <valuelist>
                <datavalue distribution="50"><value>2019-09-19 00:01:00.000</value></datavalue>
                <datavalue distribution="50">
                    <minValue>2019-09-22 00:01:00.000</minValue>
                    <maxValue>2019-09-22 00:01:00.300</maxValue>
                </datavalue>
            </valuelist>
        </column>
        <column>
            <type>FLOAT_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>3</length>
            <minValue>-1</minValue>
            <maxValue>1</maxValue>
            <name>T_FA</name>
        </column>
        <column>
            <type>DOUBLE_ARRAY</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>2</length>
            <minValue>0</minValue>
            <maxValue>10</maxValue>
            <name>T_DA</name>
        </column>
        <column>
            <type>VARCHAR_ARRAY</type>
            <userDefined>true</userDefined>
            <name>T_VA</name>
            <valuelist>
                <datavalue><value>x</value></datavalue>
                <datavalue><value>y</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>JSON</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>5</length>
            <prefix>j</prefix>
            <name>T_JSON</name>
        </column>
        <column>
            <type>BSON</type>
            <userDefined>true</userDefined>
            <dataSequence>LIST</dataSequence>
            <name>T_BSON</name>
            <valuelist>
                <datavalue><value>{"k":1}</value></datavalue>
                <datavalue><value>{"k":2}</value></datavalue>
            </valuelist>
        </column>
        <column>
            <type>VARCHAR</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <length>4</length>
            <nullChance>50</nullChance>
            <name>T_NULL</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- An empty element: every setting has its default. -->
        <scenario tableName="PHERF.COGEN" rowCount="30" name="cogenDefaults">
            <coGeneration/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="30">
                <query id="lookup" statement="SELECT V FROM PHERF.COGEN WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
        <!-- Every setting is set. -->
        <scenario tableName="PHERF.COGEN_C" rowCount="30" name="cogenConfigured">
            <coGeneration seed="7" offset="1000" blockSize="7" clusterLimit="2" watermark="LOAD"
                          walk="SEQUENTIAL"/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="30">
                <query id="lookup" statement="SELECT V FROM PHERF.COGEN_C WHERE K1 = [K1] AND K2 = [K2]"/>
            </querySet>
        </scenario>
        <!-- Placeholders of the two generator class columns. -->
        <scenario tableName="PHERF.COGEN_G" rowCount="30" name="cogenClasses">
            <coGeneration/>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="30">
                <query id="classes" statement="SELECT V FROM PHERF.COGEN_G WHERE G1 = [G1] AND G2 = [G2]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

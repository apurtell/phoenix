<!-- Two scenarios that use the same profile. Each query set has 4 workers and three queries, one
     of each kind. The profile gives the rate curve and the mix, and the scenario gives the rest.
     This file is outside the scenario directory, because the fixture run of that directory uses a
     constant clock, on which a schedule cannot advance. -->
<datamodel name="profile_run">
    <datamapping>
        <column>
            <type>INTEGER</type>
            <userDefined>true</userDefined>
            <dataSequence>RANDOM</dataSequence>
            <minValue>0</minValue>
            <maxValue>1000</maxValue>
            <name>K1</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.PROFILE_RUN" rowCount="4" name="profileA">
            <querySet concurrency="4" profile="mix_profile.xml">
                <query id="get" statement="SELECT V FROM PHERF.PROFILE_RUN WHERE K1 = [K1]"/>
                <query id="scan" kind="SCAN"
                       statement="SELECT V FROM PHERF.PROFILE_RUN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
                <query id="delete" kind="DELETE"
                       statement="DELETE FROM PHERF.PROFILE_RUN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
            </querySet>
        </scenario>
        <scenario tableName="PHERF.PROFILE_RUN" rowCount="4" name="profileB">
            <querySet concurrency="4" profile="mix_profile.xml">
                <query id="get" statement="SELECT V FROM PHERF.PROFILE_RUN WHERE K1 = [K1]"/>
                <query id="scan" kind="SCAN"
                       statement="SELECT V FROM PHERF.PROFILE_RUN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
                <query id="delete" kind="DELETE"
                       statement="DELETE FROM PHERF.PROFILE_RUN WHERE K1 &gt;= [K1] AND K1 &lt;= [K1]"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

<!-- A 70/20/10 mix of SELECT, SCAN and DELETE on a rate curve of 500 ms at 1000/s, then 500 ms
     from 1000/s to 2000/s: 500 + 750 = 1250 arrivals. profile_run.xml uses it in two scenarios. -->
<workloadProfile>
    <openLoop>
        <stage durationMs="500" rate="1000"/>
        <stage durationMs="500" rate="1000" endRate="2000"/>
    </openLoop>
    <mix>
        <operation kind="SELECT" weight="70"/>
        <operation kind="SCAN" weight="20"/>
        <operation kind="DELETE" weight="10"/>
    </mix>
</workloadProfile>

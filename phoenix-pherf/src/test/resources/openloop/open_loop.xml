<datamodel name="open_loop">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <!-- One open loop query set: 4 workers, 1 warmup execution of each query per worker, then
             1000 arrivals per second for 50 ms. Arrivals alternate between o1 and o2. This file is
             outside the scenario directory, because the fixture run of that directory uses a
             constant clock, on which a schedule cannot advance. -->
        <scenario tableName="PHERF.TEST_TABLE" rowCount="4" name="openLoop">
            <querySet concurrency="4" warmupExecutions="1">
                <openLoop>
                    <stage durationMs="50" rate="1000"/>
                </openLoop>
                <query id="o1" statement="select count(*) from PHERF.TEST_TABLE"/>
                <query id="o2" statement="select sum(SOME_INT) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>

                <query expectedAggregateRowCount="100000" id="q3" statement="SELECT COUNT(*) FROM PHERF.USER_DEFINED_TEST" timeoutDuration="9223372036854775807" useGlobalConnection="false"/>
            </querySet>
            <udfs/>
            <upserts/>
        </scenario>
    </scenarios>
</datamodel>

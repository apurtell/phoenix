        <scenario generatorName="WEIGHTED" name="EVT_GEN1" rowCount="0" tableName="PHERF.EVT_GEN1">
            <idleTimes>
                <idleTime id="idleOp" idleTime="50"/>
            </idleTimes>
            <loadProfile>
                <batchSize>1</batchSize>
                <groupIdLength>6</groupIdLength>
                <numOperations>1000</numOperations>
                <opDistribution id="upsertOp" weight="40"/>
                <opDistribution id="queryOp1" weight="20"/>
                <opDistribution id="queryOp2" weight="20"/>
                <opDistribution id="idleOp" weight="10"/>
                <opDistribution id="udfOp" weight="10"/>
                <tenantDistribution id="tg1" numTenants="10" useGlobalConnection="false" weight="10"/>
                <tenantDistribution id="tg2" numTenants="10" useGlobalConnection="false" weight="10"/>
                <tenantDistribution id="tg3" numTenants="10" useGlobalConnection="false" weight="80"/>
                <tenantIdFormat>T%s%08d</tenantIdFormat>
                <tenantIdLength>15</tenantIdLength>
            </loadProfile>
            <phoenixProperties/>
            <postScenarioDdls/>
            <preScenarioDdls/>
            <querySet concurrency="1" executionDurationInMs="10000" executionType="SERIAL" numberOfExecutions="10">
                <query id="queryOp1" statement="select count(*) from PHERF.EVT_GEN1" timeoutDuration="9223372036854775807" useGlobalConnection="false"/>
                <query id="queryOp2" statement="select sum(SOME_INT) from PHERF.EVT_GEN1" timeoutDuration="9223372036854775807" useGlobalConnection="false"/>
            </querySet>
            <udfs>
                <udf id="udfOp">
                    <args>Hello</args>
                    <args>World</args>

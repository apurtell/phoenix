<!-- The launch overrides. Without an override, the open loop query set runs 50 arrivals (1000/s for
     50 ms) on 1 worker, and the closed loop query set runs 1 thread for 600 s. This file is outside
     the scenario directory, because the fixture run of that directory uses a constant clock. -->
<datamodel name="run_overrides">
    <datamapping>
        <column>
            <type>VARCHAR</type>
            <dataSequence>RANDOM</dataSequence>
            <length>15</length>
            <name>GENERAL_VARCHAR</name>
        </column>
    </datamapping>
    <scenarios>
        <scenario tableName="PHERF.TEST_TABLE" rowCount="4" name="overrides">
            <querySet concurrency="1">
                <openLoop>
                    <stage durationMs="50" rate="1000"/>
                </openLoop>
                <query id="open" statement="select count(*) from PHERF.TEST_TABLE"/>
            </querySet>
            <querySet concurrency="1" executionType="SERIAL" numberOfExecutions="1000000000"
                      executionDurationInMs="600000">
                <query id="closed" statement="select sum(SOME_INT) from PHERF.TEST_TABLE"/>
            </querySet>
        </scenario>
    </scenarios>
</datamodel>
